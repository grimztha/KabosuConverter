export component VolumeBar inherits Rectangle {
    in-out property <float> volume: 1.0;
    in-out property <bool> is_muted: false;
    callback volume_changed(float);
    callback toggle_mute();

    height: 28px;
    border-radius: 6px;
    background: #1c1c22;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: center;

        // Mute / Unmute Button with Speaker Icon
        mute_box := Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            background: mute_ta.has-hover ? #2a2a30 : #00000000;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: root.is_muted || root.volume <= 0.01 ? @image-url("../icons/volume-x.svg") : (root.volume > 0.5 ? @image-url("../icons/volume-2.svg") : @image-url("../icons/volume-1.svg"));
                colorize: root.is_muted || root.volume <= 0.01 ? #ef4444 : (mute_ta.has-hover ? #38bdf8 : #a1a1aa);
            }

            mute_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle_mute(); }
            }
        }

        // Interactive Volume Slider Bar Track
        slider_track := Rectangle {
            width: 60px;
            height: 18px;

            // Background Track
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 100%;
                height: 5px;
                border-radius: 2.5px;
                background: #2a2a30;

                // Filled Track (colored)
                Rectangle {
                    x: 0px;
                    y: 0px;
                    height: 100%;
                    width: root.is_muted || root.volume <= 0.0 ? 0px : min(parent.width, (parent.width - 12px) * root.volume.clamp(0.0, 1.0) + 6px);
                    border-radius: 2.5px;
                    background: root.is_muted ? #71717a : @linear-gradient(90deg, #0284c7 0%, #38bdf8 100%);
                }
            }

            // Draggable Knob / Thumb
            Rectangle {
                property <float> norm: root.is_muted ? 0.0 : root.volume.clamp(0.0, 1.0);
                x: max(0px, min(parent.width - 12px, (parent.width - 12px) * self.norm));
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.is_muted ? #a1a1aa : (slider_ta.has-hover || slider_ta.pressed ? #38bdf8 : #ffffff);
                border-width: 1.5px;
                border-color: root.is_muted ? #71717a : #0284c7;
            }

            slider_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if parent.width > 0px {
                        root.volume_changed((self.mouse-x / parent.width).clamp(0.0, 1.0));
                    }
                }
                moved => {
                    if self.pressed && parent.width > 0px {
                        root.volume_changed((self.mouse-x / parent.width).clamp(0.0, 1.0));
                    }
                }
                scroll-event(event) => {
                    if event.delta-y > 0px {
                        root.volume_changed((root.volume + 0.05).clamp(0.0, 1.0));
                        return accept;
                    }
                    if event.delta-y < 0px {
                        root.volume_changed((root.volume - 0.05).clamp(0.0, 1.0));
                        return accept;
                    }
                    reject
                }
            }
        }

        // Percentage Text Readout
        VerticalLayout {
            alignment: center;
            width: 32px;
            Text {
                text: root.is_muted ? "0%" : "\{Math.round(root.volume * 100)}%";
                font-size: 11px;
                font-weight: 700;
                color: root.is_muted ? #ef4444 : #a1a1aa;
                horizontal-alignment: right;
            }
        }
    }
}
