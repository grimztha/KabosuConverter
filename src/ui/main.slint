                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/audio.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: AppData.function_index >= 9 && AppData.function_index <= 11 ? #a78bfa : #94a3b8;
