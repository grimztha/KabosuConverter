export component VolumeMeter inherits Rectangle {
    in property <float> level_l_db: -60.0;
    in property <float> level_r_db: -60.0;
    in property <float> peak_l_db: -60.0;
    in property <float> peak_r_db: -60.0;

    width: 50px;
    height: 280px;
    border-radius: 8px;
    background: #12141e;
    border-width: 1px;
    border-color: #2b2f44;
    clip: true;

    // Helper calculations for normalized scale [0.0, 1.0] corresponding to [-60dB, 0dB]
    property <float> norm_l: max(0.0, min(1.0, (level_l_db + 60.0) / 60.0));
    property <float> norm_r: max(0.0, min(1.0, (level_r_db + 60.0) / 60.0));
    property <float> p_norm_l: max(0.0, min(1.0, (peak_l_db + 60.0) / 60.0));
    property <float> p_norm_r: max(0.0, min(1.0, (peak_r_db + 60.0) / 60.0));

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 5px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;

        // Bars Container (Left & Right Channels)
        bars_container := Rectangle {
            width: 13px;

            // Channel 1 / Left (L)
            bar_l := Rectangle {
                x: 0px;
                width: 5px;
                height: 100%;

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;
                    width: 100%;
                    height: 100%;

                    // 1. Red Zone: 0 dB to -6 dB (top 10%)
                    Rectangle {
                        height: 10%;
                        background: #3b070c;

                        if root.norm_l > 0.90 : Rectangle {
                            x: 0px;
                            width: 100%;
                            property <float> fill: min(1.0, max(0.0, (root.norm_l - 0.90) / 0.10));
                            y: parent.height * (1.0 - fill);
                            height: parent.height * fill;
                            background: #ef4444;
                        }
                    }

                    // 2. Yellow Zone: -6 dB to -18 dB (middle 20%)
                    Rectangle {
                        height: 20%;
                        background: #332405;

                        if root.norm_l > 0.70 : Rectangle {
                            x: 0px;
                            width: 100%;
                            property <float> fill: min(1.0, max(0.0, (root.norm_l - 0.70) / 0.20));
                            y: parent.height * (1.0 - fill);
                            height: parent.height * fill;
                            background: #eab308;
                        }
                    }

                    // 3. Green Zone: -18 dB to -60 dB (bottom 70%)
                    Rectangle {
                        height: 70%;
                        background: #062311;

                        if root.norm_l > 0.001 : Rectangle {
                            x: 0px;
                            width: 100%;
                            property <float> fill: min(1.0, max(0.0, root.norm_l / 0.70));
                            y: parent.height * (1.0 - fill);
                            height: parent.height * fill;
                            background: #22c55e;
                        }
                    }
                }

                // Black current-level indicator line
                if root.norm_l > 0.01 : Rectangle {
                    x: 0px;
                    y: max(0px, parent.height * (1.0 - root.norm_l) - 1px);
                    width: 100%;
                    height: 1.5px;
                    background: #000000;
                }

                // Peak hold marker
                if root.p_norm_l > 0.01 : Rectangle {
                    x: 0px;
                    y: max(0px, parent.height * (1.0 - root.p_norm_l) - 1px);
                    width: 100%;
                    height: 2px;
                    background: root.p_norm_l > 0.90 ? #f87171 : (root.p_norm_l > 0.70 ? #fde047 : #4ade80);
                }

                // Bottom silence/floor indicator
                Rectangle {
                    x: 0px;
                    y: parent.height - 2px;
                    width: 100%;
                    height: 2px;
                    background: #ef4444;
                }
            }

            // Channel 2 / Right (R)
            bar_r := Rectangle {
                x: 7px;
                width: 5px;
                height: 100%;

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;
                    width: 100%;
                    height: 100%;

                    // 1. Red Zone: 0 dB to -6 dB (top 10%)
                    Rectangle {
                        height: 10%;
                        background: #3b070c;

                        if root.norm_r > 0.90 : Rectangle {
                            x: 0px;
                            width: 100%;
                            property <float> fill: min(1.0, max(0.0, (root.norm_r - 0.90) / 0.10));
                            y: parent.height * (1.0 - fill);
                            height: parent.height * fill;
                            background: #ef4444;
                        }
                    }

                    // 2. Yellow Zone: -6 dB to -18 dB (middle 20%)
                    Rectangle {
                        height: 20%;
                        background: #332405;

                        if root.norm_r > 0.70 : Rectangle {
                            x: 0px;
                            width: 100%;
                            property <float> fill: min(1.0, max(0.0, (root.norm_r - 0.70) / 0.20));
                            y: parent.height * (1.0 - fill);
                            height: parent.height * fill;
                            background: #eab308;
                        }
                    }

                    // 3. Green Zone: -18 dB to -60 dB (bottom 70%)
                    Rectangle {
                        height: 70%;
                        background: #062311;

                        if root.norm_r > 0.001 : Rectangle {
                            x: 0px;
                            width: 100%;
                            property <float> fill: min(1.0, max(0.0, root.norm_r / 0.70));
                            y: parent.height * (1.0 - fill);
                            height: parent.height * fill;
                            background: #22c55e;
                        }
                    }
                }

                // Black current-level indicator line
                if root.norm_r > 0.01 : Rectangle {
                    x: 0px;
                    y: max(0px, parent.height * (1.0 - root.norm_r) - 1px);
                    width: 100%;
                    height: 1.5px;
                    background: #000000;
                }

                // Peak hold marker
                if root.p_norm_r > 0.01 : Rectangle {
                    x: 0px;
                    y: max(0px, parent.height * (1.0 - root.p_norm_r) - 1px);
                    width: 100%;
                    height: 2px;
                    background: root.p_norm_r > 0.90 ? #f87171 : (root.p_norm_r > 0.70 ? #fde047 : #4ade80);
                }

                // Bottom silence/floor indicator
                Rectangle {
                    x: 0px;
                    y: parent.height - 2px;
                    width: 100%;
                    height: 2px;
                    background: #ef4444;
                }
            }
        }

        // dB Scale Labels Column (with "-" tick marks)
        scale_column := VerticalLayout {
            horizontal-stretch: 1;
            alignment: space-between;

            Text { text: "- 0"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -6"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -12"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -18"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -24"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -30"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -36"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -42"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -48"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -54"; font-size: 8px; font-weight: 700; color: #94a3b8; }
            Text { text: "- -60"; font-size: 8px; font-weight: 700; color: #94a3b8; }
        }
    }
}
