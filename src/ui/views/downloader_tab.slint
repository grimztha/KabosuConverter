import { LineEdit, ScrollView } from "std-widgets.slint";
import { AppData, AppLogic } from "../globals.slint";
import { ActionButton } from "../components/action_button.slint";
import { Badge } from "../components/badge.slint";
import { DownloaderFormatDropdown } from "../components/downloader_format_dropdown.slint";

export component DownloaderTab inherits ScrollView {
    VerticalLayout {
        alignment: start;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;

        // CARD 1: URL INPUT & DISCOVERY CARD (Compact)
        Rectangle {
            border-radius: 6px;
            background: #141417;
            border-width: 1px;
            border-color: #0284c788;

            VerticalLayout {
                alignment: start;
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 5px;

                // Header row: Title + Subtitle + Engine Badge
                HorizontalLayout {
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 5px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/download.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #38bdf8;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Downloader";
                                font-size: 12.5px;
                                font-weight: 700;
                                color: #f4f4f5;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "— Paste any video, stream, or audio URL (YouTube, Twitch, Vimeo, TikTok, Bilibili, SoundCloud, HLS/M3U8)";
                            font-size: 10px;
                            color: #71717a;
                            overflow: elide;
                        }
                    }

                    // yt-dlp Local Engine Badge
                    Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: #0284c722;
                        border-width: 1px;
                        border-color: #38bdf8.with-alpha(0.4);
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/zap.svg");
                                    width: 9px;
                                    height: 9px;
                                    colorize: #38bdf8;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "yt-dlp 2026.08.19 (Local Binary)";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                }
                            }
                        }
                    }
                }

                // URL Input Box with Integrated Action Buttons (Full Width)
                HorizontalLayout {
                    spacing: 6px;

                    LineEdit {
                        height: 26px;
                        horizontal-stretch: 1;
                        font-size: 11px;
                        text <=> AppData.ytdlp_url;
                        placeholder-text: "Paste stream URL (e.g. https://www.youtube.com/watch?v=... or direct m3u8)";
                        accepted => { AppLogic.ytdlp_discover(); }
                        edited(val) => { AppLogic.ytdlp_url_changed(val); }
                    }

                    ActionButton {
                        width: 62px;
                        height: 26px;
                        title: "Paste";
                        icon_source: @image-url("../icons/layers.svg");
                        has_icon: true;
                        icon_size: 11px;
                        fill_color: #1c1c22;
                        hover_color: #2a2a32;
                        text_color: #38bdf8;
                        font_size: 10.5px;
                        clicked => { AppLogic.ytdlp_paste_clipboard(); }
                    }

                    ActionButton {
                        width: 62px;
                        height: 26px;
                        title: "Clear";
                        icon_source: @image-url("../icons/trash.svg");
                        has_icon: true;
                        icon_size: 11px;
                        fill_color: #1c1c22;
                        hover_color: #2a2a32;
                        text_color: #a1a1aa;
                        font_size: 10.5px;
                        clicked => { AppLogic.ytdlp_clear_url(); }
                    }

                    ActionButton {
                        width: 98px;
                        height: 26px;
                        title: AppData.ytdlp_is_discovering ? "Detecting..." : "Discover";
                        icon_source: @image-url("../icons/search.svg");
                        has_icon: true;
                        icon_size: 11px;
                        fill_color: #0284c7;
                        hover_color: #0369a1;
                        text_color: #ffffff;
                        font_size: 10.5px;
                        is_disabled: AppData.ytdlp_url == "" || AppData.ytdlp_is_discovering;
                        clicked => { AppLogic.ytdlp_discover(); }
                    }
                }

                // Supported Sites Pill Tags
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    Text {
                        text: "Supported:";
                        font-size: 9px;
                        color: #71717a;
                        vertical-alignment: center;
                    }

                    Badge { label: "YouTube"; bg_color: #141418; fg_color: #ef4444; height: 16px; }
                    Badge { label: "Twitch"; bg_color: #141418; fg_color: #a78bfa; height: 16px; }
                    Badge { label: "Vimeo"; bg_color: #141418; fg_color: #38bdf8; height: 16px; }
                    Badge { label: "TikTok"; bg_color: #141418; fg_color: #f43f5e; height: 16px; }
                    Badge { label: "Bilibili"; bg_color: #141418; fg_color: #38bdf8; height: 16px; }
                    Badge { label: "SoundCloud"; bg_color: #141418; fg_color: #f59e0b; height: 16px; }
                    Badge { label: "HLS / M3U8"; bg_color: #141418; fg_color: #34d399; height: 16px; }
                }
            }
        }

        // CARD 2: DISCOVERING STATE / ERROR / STREAM METADATA & CUSTOM SAVE FILENAME
        if AppData.ytdlp_is_discovering : Rectangle {
            border-radius: 6px;
            background: #0284c715;
            border-width: 1px;
            border-color: #0284c755;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/search.svg");
                        width: 13px;
                        height: 13px;
                        colorize: #38bdf8;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Querying stream URL and discovering available formats and audio tracks via yt-dlp...";
                        font-size: 10.5px;
                        font-weight: 600;
                        color: #38bdf8;
                    }
                }
            }
        }

        if AppData.ytdlp_has_error : Rectangle {
            border-radius: 6px;
            background: #ef444415;
            border-width: 1px;
            border-color: #ef444455;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/x.svg");
                        width: 13px;
                        height: 13px;
                        colorize: #ef4444;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "Error: " + AppData.ytdlp_error_message;
                        font-size: 10px;
                        font-weight: 600;
                        color: #fca5a5;
                        wrap: word-wrap;
                    }
                }

                ActionButton {
                    width: 56px;
                    height: 20px;
                    title: "Dismiss";
                    fill_color: #ef444433;
                    hover_color: #ef444455;
                    text_color: #fca5a5;
                    font_size: 9px;
                    clicked => { AppData.ytdlp_has_error = false; }
                }
            }
        }

        if AppData.ytdlp_has_discovered : Rectangle {
            border-radius: 6px;
            background: #141417;
            border-width: 1px;
            border-color: #34d39966;

            VerticalLayout {
                alignment: start;
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 5px;

                // Compact Header Row: DISCOVERED STREAM + Inline Metadata Badges + Ready Badge
                HorizontalLayout {
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/film.svg");
                            width: 13px;
                            height: 13px;
                            colorize: #34d399;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "DISCOVERED STREAM";
                            font-size: 10px;
                            font-weight: 800;
                            color: #34d399;
                        }
                    }

                    if AppData.ytdlp_uploader != "" : Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: #1c1c22;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;
                            Text {
                                text: "Author:";
                                font-size: 9px;
                                color: #a1a1aa;
                                vertical-alignment: center;
                            }
                            Text {
                                text: AppData.ytdlp_uploader;
                                font-size: 9.5px;
                                font-weight: 600;
                                color: #38bdf8;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if AppData.ytdlp_duration != "" : Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: #1c1c22;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 3px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/clock.svg");
                                    width: 9px;
                                    height: 9px;
                                    colorize: #a1a1aa;
                                }
                            }
                            Text {
                                text: AppData.ytdlp_duration;
                                font-size: 9.5px;
                                font-weight: 600;
                                color: #d4d4d8;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if AppData.ytdlp_discovered_id != "" : Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: #1c1c22;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: "ID: " + AppData.ytdlp_discovered_id;
                                font-size: 9px;
                                font-weight: 600;
                                color: #71717a;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Ready Status Badge
                    Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: #05966922;
                        border-width: 1px;
                        border-color: #34d399;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/check.svg");
                                    width: 9px;
                                    height: 9px;
                                    colorize: #34d399;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Ready to Download";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: #34d399;
                                }
                            }
                        }
                    }
                }

                // Title Text
                Text {
                    text: AppData.ytdlp_title;
                    font-size: 12px;
                    font-weight: 700;
                    color: #f4f4f5;
                    overflow: elide;
                }

                // COMPACT SAVE FILE NAME SECTION (Full Width Input)
                Rectangle {
                    border-radius: 5px;
                    background: #111114;
                    border-width: 1px;
                    border-color: #0284c744;

                    VerticalLayout {
                        alignment: start;
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 5px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/sliders.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: #38bdf8;
                                }
                            }

                            Text {
                                text: "Save File Name (Customizable):";
                                font-size: 10px;
                                font-weight: 700;
                                color: #38bdf8;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: "(Extension auto-appended based on format)";
                                font-size: 9px;
                                color: #71717a;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            LineEdit {
                                horizontal-stretch: 1;
                                height: 26px;
                                font-size: 11px;
                                placeholder-text: "Enter custom file name (without extension)...";
                                text <=> AppData.ytdlp_custom_filename;
                            }

                            ActionButton {
                                width: 68px;
                                height: 26px;
                                title: "Reset";
                                icon_source: @image-url("../icons/reset.svg");
                                has_icon: true;
                                icon_size: 10px;
                                fill_color: #1c1c22;
                                hover_color: #2a2a32;
                                text_color: #a1a1aa;
                                font_size: 10px;
                                clicked => { AppData.ytdlp_custom_filename = AppData.ytdlp_title; }
                            }
                        }
                    }
                }
            }
        }

        // CARD 3: FORMAT SELECTION & DESTINATION FOLDER (Compact)
        Rectangle {
            border-radius: 6px;
            background: #141417;
            border-width: 1px;
            border-color: #1c1c22;

            VerticalLayout {
                alignment: start;
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 5px;

                // Header row: Title + Contextual Mode Pill + Right Hint
                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Download Format & Quality Options";
                        font-size: 12px;
                        font-weight: 700;
                        color: #f4f4f5;
                        vertical-alignment: center;
                    }

                    property <bool> is_audio_format: AppData.ytdlp_format_options.length > 0 && AppData.ytdlp_selected_format_index < AppData.ytdlp_format_options.length && AppData.ytdlp_format_options[AppData.ytdlp_selected_format_index].starts-with("[Audio]");
                    Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: is_audio_format ? #7c3aed22 : #0284c722;
                        border-width: 1px;
                        border-color: is_audio_format ? #7c3aed55 : #0284c755;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: is_audio_format ? @image-url("../icons/audio.svg") : @image-url("../icons/video.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: is_audio_format ? #a78bfa : #38bdf8;
                                }
                            }
                            Text {
                                text: is_audio_format ? "Audio Extraction Mode" : "Video + Audio Merge (MP4)";
                                font-size: 9px;
                                font-weight: 600;
                                color: is_audio_format ? #c4b5fd : #7dd3fc;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: "Options queried by yt-dlp";
                        font-size: 9.5px;
                        color: #71717a;
                        vertical-alignment: center;
                    }
                }

                // Quality Preset / Stream Dropdown with colorized type tags
                DownloaderFormatDropdown {
                    height: 26px;
                    model: AppData.ytdlp_format_options;
                    current-index <=> AppData.ytdlp_selected_format_index;
                }

                // Destination Folder Row (Full Width)
                VerticalLayout {
                    alignment: start;
                    spacing: 3px;

                    Text {
                        text: "Save Destination Folder:";
                        font-size: 10px;
                        font-weight: 600;
                        color: #a1a1aa;
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            horizontal-stretch: 1;
                            height: 26px;
                            font-size: 11px;
                            placeholder-text: "Choose or paste folder path to save downloaded media";
                            text <=> AppData.ytdlp_output_dir;
                        }

                        ActionButton {
                            width: 80px;
                            height: 26px;
                            title: "Browse...";
                            icon_source: @image-url("../icons/folder.svg");
                            has_icon: true;
                            icon_size: 11px;
                            fill_color: #1c1c22;
                            hover_color: #2a2a32;
                            text_color: #38bdf8;
                            font_size: 10.5px;
                            clicked => { AppLogic.ytdlp_select_output_dir(); }
                        }

                        ActionButton {
                            width: 96px;
                            height: 26px;
                            title: "Open Folder";
                            icon_source: @image-url("../icons/folder-open.svg");
                            has_icon: true;
                            icon_size: 11px;
                            fill_color: #1c1c22;
                            hover_color: #2a2a32;
                            text_color: #a1a1aa;
                            font_size: 10.5px;
                            clicked => { AppLogic.ytdlp_open_output_dir(); }
                        }
                    }
                }
            }
        }

        // CARD 4: DOWNLOAD ENGINE EXECUTION & PROGRESS (Compact)
        Rectangle {
            border-radius: 6px;
            background: #141417;
            border-width: 1px;
            border-color: #1c1c22;

            VerticalLayout {
                alignment: start;
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                // Action Button + Status Message + Telemetry Badges on a Single Row
                HorizontalLayout {
                    spacing: 8px;

                    if !AppData.ytdlp_is_downloading : ActionButton {
                        width: 148px;
                        height: 26px;
                        title: "START DOWNLOAD";
                        icon_source: @image-url("../icons/download.svg");
                        has_icon: true;
                        icon_size: 12px;
                        fill_color: #10b981;
                        hover_color: #059669;
                        font_size: 11px;
                        clicked => { AppLogic.ytdlp_start_download(); }
                    }

                    if AppData.ytdlp_is_downloading : ActionButton {
                        width: 148px;
                        height: 26px;
                        title: "CANCEL DOWNLOAD";
                        icon_source: @image-url("../icons/stop.svg");
                        has_icon: true;
                        icon_size: 12px;
                        fill_color: #ef4444;
                        hover_color: #dc2626;
                        font_size: 11px;
                        clicked => { AppLogic.ytdlp_cancel_download(); }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: AppData.ytdlp_status_message;
                        font-size: 10.5px;
                        font-weight: 600;
                        color: AppData.ytdlp_is_downloading ? #38bdf8 : #a1a1aa;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;
                        VerticalLayout {
                            alignment: center;
                            Badge { label: AppData.ytdlp_progress_text; bg_color: #141418; fg_color: #38bdf8; height: 18px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Badge { label: AppData.ytdlp_speed_text; bg_color: #141418; fg_color: #a78bfa; height: 18px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Badge { label: AppData.ytdlp_eta_text; bg_color: #141418; fg_color: #34d399; height: 18px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Badge { label: AppData.ytdlp_size_text; bg_color: #141418; fg_color: #d4d4d8; height: 18px; }
                        }
                    }
                }

                // Real-time Progress Bar
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: #141418;

                    Rectangle {
                        x: 0px;
                        width: parent.width * (AppData.ytdlp_progress / 100.0).clamp(0.0, 1.0);
                        height: parent.height;
                        border-radius: 3px;
                        background: @linear-gradient(90deg, #0284c7 0%, #10b981 100%);
                    }
                }
            }
        }

        // CARD 5: POST-DOWNLOAD QUICK ACTIONS (Celebration Banner, Compact)
        if AppData.ytdlp_download_finished : Rectangle {
            border-radius: 6px;
            background: #05966915;
            border-width: 1px;
            border-color: #10b98188;

            VerticalLayout {
                alignment: start;
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 5px;

                HorizontalLayout {
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/check.svg");
                            width: 13px;
                            height: 13px;
                            colorize: #34d399;
                        }
                    }

                    Text {
                        text: "Download Completed Successfully!";
                        font-size: 11.5px;
                        font-weight: 700;
                        color: #34d399;
                        vertical-alignment: center;
                    }

                    if AppData.ytdlp_last_downloaded_file != "" : Text {
                        horizontal-stretch: 1;
                        text: "— Saved: " + AppData.ytdlp_last_downloaded_file;
                        font-size: 10px;
                        color: #d4d4d8;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Quick Action Integration Buttons
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    ActionButton {
                        height: 26px;
                        title: "Load in View & Edit";
                        icon_source: @image-url("../icons/film.svg");
                        has_icon: true;
                        icon_size: 11px;
                        fill_color: #0284c7;
                        hover_color: #0369a1;
                        text_color: #ffffff;
                        font_size: 10.5px;
                        clicked => { AppLogic.ytdlp_load_in_player(); }
                    }

                    ActionButton {
                        height: 26px;
                        title: "Add to Transcoder Queue";
                        icon_source: @image-url("../icons/plus.svg");
                        has_icon: true;
                        icon_size: 11px;
                        fill_color: #1c1c22;
                        hover_color: #2a2a32;
                        text_color: #38bdf8;
                        font_size: 10.5px;
                        clicked => { AppLogic.ytdlp_send_to_queue(); }
                    }

                    ActionButton {
                        height: 26px;
                        title: "Open Folder";
                        icon_source: @image-url("../icons/folder-open.svg");
                        has_icon: true;
                        icon_size: 11px;
                        fill_color: #1c1c22;
                        hover_color: #2a2a32;
                        text_color: #a1a1aa;
                        font_size: 10.5px;
                        clicked => { AppLogic.ytdlp_open_output_dir(); }
                    }
                }
            }
        }
    }
}
