import { Button, CheckBox, ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";

export struct QueueFile {
    id: int,
    file_name: string,
    file_path: string,
    file_size_formatted: string,
    resolution: string,
    duration: string,
    codecs: string,
    status: string,
    progress: float,
    duration_seconds: float,
    is_video: bool,
    is_audio: bool,
}

export global AppData {
    in-out property <[QueueFile]> queue;
    in-out property <int> selected_file_index: -1;
    in-out property <bool> is_processing: false;
    in-out property <float> progress_percent: 0.0;
    in-out property <string> progress_text: "Ready";
    in-out property <string> speed_text: "0.0x";
    in-out property <string> fps_text: "0 fps";
    in-out property <string> time_text: "00:00 / 00:00";
    in-out property <string> status_summary: "No files loaded";
    in-out property <string> output_directory: "Same as source";
    in-out property <string> log_preview: "";
    in-out property <bool> show_logs: false;

    // Navigation tab: 0 = Player & Trimmer, 1 = Downloader, 2 = Transcoder Settings
    in-out property <int> active_tab: 0;

    // yt-dlp Web Downloader state
    in-out property <string> ytdlp_url: "";
    in-out property <bool> ytdlp_is_discovering: false;
    in-out property <bool> ytdlp_has_discovered: false;
    in-out property <string> ytdlp_title: "";
    in-out property <string> ytdlp_uploader: "";
    in-out property <string> ytdlp_duration: "";
    in-out property <string> ytdlp_discovered_id: "";
    in-out property <string> ytdlp_webpage_url: "";
    in-out property <string> ytdlp_custom_filename: "";
    in-out property <[string]> ytdlp_format_options: [
        "Best Quality (Auto Best Video + Best Audio, Recommended)",
        "4K UHD 2160p (Best Video <= 2160p + Best Audio)",
        "1440p QHD (Best Video <= 1440p + Best Audio)",
        "1080p Full HD (Best Video <= 1080p + Best Audio)",
        "720p HD (Best Video <= 720p + Best Audio)",
        "480p SD (Fast / Mobile Compact)",
        "Audio Only — MP3 (High Quality 320 kbps)",
        "Audio Only — M4A / AAC (Best Source Audio)",
        "Audio Only — FLAC (Lossless Audio)",
        "Audio Only — WAV (Lossless PCM)"
    ];
    in-out property <int> ytdlp_selected_format_index: 0;
    in-out property <string> ytdlp_output_dir: "";
    in-out property <bool> ytdlp_is_downloading: false;
    in-out property <float> ytdlp_progress: 0.0;
    in-out property <string> ytdlp_progress_text: "0.0%";
    in-out property <string> ytdlp_speed_text: "0.0 MiB/s";
    in-out property <string> ytdlp_eta_text: "--:--";
    in-out property <string> ytdlp_size_text: "-- / --";
    in-out property <string> ytdlp_status_message: "Ready. Paste video or stream URL to discover formats.";
    in-out property <string> ytdlp_error_message: "";
    in-out property <bool> ytdlp_has_error: false;
    in-out property <string> ytdlp_last_downloaded_file: "";
    in-out property <bool> ytdlp_download_finished: false;

    // Player and Media Preview state
    in-out property <bool> player_has_media: false;
    in-out property <string> selected_file_name: "";
    in-out property <string> selected_file_path: "";
    in-out property <bool> selected_is_video: false;
    in-out property <bool> selected_is_audio: false;
    in-out property <string> selected_resolution: "";
    in-out property <string> selected_audio_desc: "";
    in-out property <float> player_duration: 0.0;
    in-out property <float> player_current_time: 0.0;
    in-out property <string> player_time_text: "00:00.000";
    in-out property <string> player_duration_text: "00:00.000";
    in-out property <bool> player_is_playing: false;
    in-out property <image> preview_frame;
    in-out property <bool> preview_frame_loading: false;
    in-out property <image> timeline_waveform;
    in-out property <bool> has_waveform: false;

    // Trimming In / Out state
    in-out property <float> in_point_seconds: -1.0;
    in-out property <float> out_point_seconds: -1.0;
    in-out property <float> in_point_normalized: 0.0;
    in-out property <float> out_point_normalized: 1.0;
    in-out property <bool> has_active_trim: false;
    in-out property <string> trim_duration_text: "Full Media";
    in-out property <string> in_point: "";
    in-out property <string> out_point: "";

    // Controls state
    in-out property <int> function_index: 0;
    in-out property <int> hw_accel_index: 0;
    in-out property <int> rate_control_index: 0;
    in-out property <float> crf_value: 23.0;
    in-out property <int> video_bitrate_index: 2; // 6000 kbps
    in-out property <int> preset_index: 3; // medium
    in-out property <int> resolution_index: 0; // original
    in-out property <int> fps_index: 0; // original
    in-out property <int> deinterlace_index: 0; // none
    in-out property <int> prores_profile_index: 2; // standard
    in-out property <bool> faststart: true;

    in-out property <int> audio_codec_index: 0; // AAC
    in-out property <int> audio_bitrate_index: 2; // 192k
    in-out property <int> audio_channels_index: 0; // keep
    in-out property <int> audio_sample_rate_index: 0; // keep
    in-out property <int> normalize_index: 0; // disabled

    in-out property <int> container_index: 0; // mp4
}

export global AppLogic {
    callback add_files();
    callback remove_file(int);
    callback select_file(int);
    callback clear_queue();
    callback select_output_dir();
    callback open_output_dir();
    callback start_processing();
    callback cancel_processing();
    callback toggle_logs();
    callback switch_tab(int);
    callback quick_lossless_cut();

    // Player and Trim callbacks
    callback player_seek(float);
    callback player_play_pause();
    callback player_stop();
    callback player_step(float);
    callback set_in_point_current();
    callback set_out_point_current();
    callback jump_to_in_point();
    callback jump_to_out_point();
    callback clear_trim_points();
    callback play_trimmed_range();
    callback launch_ffplay();
    callback in_point_text_changed(string);
    callback out_point_text_changed(string);
    callback set_in_point_from_timeline(float);
    callback set_out_point_from_timeline(float);

    // yt-dlp Web Downloader Callbacks
    callback ytdlp_url_changed(string);
    callback ytdlp_paste_clipboard();
    callback ytdlp_clear_url();
    callback ytdlp_discover();
    callback ytdlp_select_output_dir();
    callback ytdlp_open_output_dir();
    callback ytdlp_start_download();
    callback ytdlp_cancel_download();
    callback ytdlp_load_in_player();
    callback ytdlp_send_to_queue();
}

component IconButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon_source;
    in property <bool> has_icon: false;
    in property <length> icon_size: 14px;
    in property <color> text_color: #94a3b8;
    in property <color> hover_bg: #334155;
    in property <length> btn_width: 28px;
    in property <length> btn_height: 28px;
    in property <length> font_size: 13px;
    callback clicked();

    width: root.btn_width;
    height: root.btn_height;
    border-radius: 6px;
    background: ta.has-hover ? hover_bg : #00000000;

    animate background { duration: 150ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-left: 3px;
        padding-right: 3px;

        if root.has_icon : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon_source;
                width: root.icon_size;
                height: root.icon_size;
                colorize: ta.has-hover ? #f8fafc : root.text_color;
            }
        }

        if root.text != "" : VerticalLayout {
            alignment: center;
            Text {
                text: root.text;
                color: ta.has-hover ? #f8fafc : root.text_color;
                font-size: root.font_size;
                font-weight: 600;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Badge inherits Rectangle {
    in property <string> label: "";
    in property <color> bg_color: #1e293b;
    in property <color> fg_color: #94a3b8;

    height: 22px;
    border-radius: 4px;
    background: bg_color;
    border-width: 1px;
    border-color: bg_color.brighter(0.3);

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-size: 11px;
                color: root.fg_color;
                font-weight: 500;
            }
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> title: "Button";
    in property <image> icon_source;
    in property <bool> has_icon: false;
    in property <length> icon_size: 14px;
    in property <color> fill_color: #0284c7;
    in property <color> hover_color: #0369a1;
    in property <color> text_color: #ffffff;
    in property <length> font_size: 13px;
    in property <bool> is_disabled: false;
    callback clicked();

    height: 38px;
    border-radius: 8px;
    background: is_disabled ? #334155 : (ta.has-hover ? hover_color : fill_color);

    animate background { duration: 150ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 10px;
        padding-right: 10px;

        if root.has_icon : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon_source;
                width: root.icon_size;
                height: root.icon_size;
                colorize: root.is_disabled ? #64748b : root.text_color;
            }
        }

        if root.title != "" : VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                color: root.is_disabled ? #64748b : root.text_color;
                font-size: root.font_size;
                font-weight: 600;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: is_disabled ? default : pointer;
        enabled: !is_disabled;
        clicked => { root.clicked(); }
    }
}

component VisualTimeline inherits Rectangle {
    in property <float> duration: 1.0;
    in property <float> current_time: 0.0;
    in property <float> in_point_norm: 0.0;
    in property <float> out_point_norm: 1.0;
    in property <float> in_point_sec: -1.0;
    in property <float> out_point_sec: -1.0;
    in property <bool> has_trim: false;
    callback seek(float);
    callback in_point_dragged(float);
    callback out_point_dragged(float);

    height: 44px;
    border-radius: 8px;
    background: #090e1a;
    border-width: 1px;
    border-color: #334155;
    clip: true;

    // Audio Waveform Visualization Layer
    if AppData.has_waveform : Image {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        source: AppData.timeline_waveform;
        image-fit: fill;
        opacity: 0.9;
    }

    // Timeline Track Background with subtle tick guides (ambient when no audio waveform)
    if !AppData.has_waveform : HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: space-between;
        Rectangle { width: 1px; height: 8px; background: #334155; }
        Rectangle { width: 1px; height: 8px; background: #334155; }
        Rectangle { width: 1px; height: 8px; background: #334155; }
        Rectangle { width: 1px; height: 8px; background: #334155; }
        Rectangle { width: 1px; height: 8px; background: #334155; }
    }


    // Active Trim Region Highlight
    if root.has_trim : Rectangle {
        x: max(0px, root.width * root.in_point_norm);
        width: max(4px, root.width * (root.out_point_norm - root.in_point_norm));
        height: 100%;
        background: @linear-gradient(90deg, #d9770633 0%, #f59e0b55 50%, #d9770633 100%);
        border-width: 1px;
        border-color: #f59e0b88;

        // Left boundary edge line
        Rectangle {
            x: 0px;
            width: 2px;
            height: 100%;
            background: #f59e0b;
        }

        // Right boundary edge line
        Rectangle {
            x: parent.width - 2px;
            width: 2px;
            height: 100%;
            background: #f59e0b;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 5px;
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("icons/scissors.svg");
                    width: 11px;
                    height: 11px;
                    colorize: #fbbf24;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "TRIMMED SELECTION";
                    font-size: 10px;
                    font-weight: 800;
                    color: #fbbf24;
                }
            }
        }
    }

    // Interactive TouchArea over Visual Timeline Track for Scrubbing
    track_ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.width > 0px && root.duration > 0.0 {
                root.seek((self.mouse-x / root.width).clamp(0.0, 1.0) * root.duration);
            }
        }
        moved => {
            if self.pressed && root.width > 0px && root.duration > 0.0 {
                root.seek((self.mouse-x / root.width).clamp(0.0, 1.0) * root.duration);
            }
        }
    }

    // Playhead Needle & Scrubber Cursor
    Rectangle {
        property <float> norm: root.duration > 0.0 ? (root.current_time / root.duration).clamp(0.0, 1.0) : 0.0;
        x: max(0px, min(root.width - 2px, (root.width - 2px) * self.norm));
        width: 2px;
        height: 100%;
        background: #38bdf8;

        // Playhead Knob Cap
        Rectangle {
            x: -5px;
            y: 0px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: #38bdf8;
            border-width: 2px;
            border-color: #ffffff;
        }
    }

    // In-Point Flag Marker & Drag Handle
    Rectangle {
        property <float> norm: root.in_point_sec >= 0.0 ? root.in_point_norm : 0.0;
        x: max(0px, min(root.width - 28px, root.width * self.norm - (root.in_point_sec >= 0.0 ? 14px : 0px)));
        y: 2px;
        width: root.in_point_sec >= 0.0 ? 28px : 16px;
        height: 20px;
        border-radius: 3px;
        background: in_ta.has-hover || in_ta.pressed ? #fbbf24 : (root.in_point_sec >= 0.0 ? #f59e0b : #78350f88);
        border-width: 1px;
        border-color: root.in_point_sec >= 0.0 ? #ffffff : #f59e0b88;

        Text {
            text: root.in_point_sec >= 0.0 ? "[ IN" : "[";
            font-size: root.in_point_sec >= 0.0 ? 9px : 11px;
            font-weight: 800;
            color: root.in_point_sec >= 0.0 ? #000000 : #fbbf24;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        in_ta := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed && root.width > 0px && root.duration > 0.0 {
                    root.in_point_dragged(((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0) * root.duration);
                }
            }
        }
    }

    // Out-Point Flag Marker & Drag Handle
    Rectangle {
        property <float> norm: root.out_point_sec >= 0.0 ? root.out_point_norm : 1.0;
        x: max(0px, min(root.width - (root.out_point_sec >= 0.0 ? 32px : 16px), root.width * self.norm - (root.out_point_sec >= 0.0 ? 16px : 16px)));
        y: 2px;
        width: root.out_point_sec >= 0.0 ? 32px : 16px;
        height: 20px;
        border-radius: 3px;
        background: out_ta.has-hover || out_ta.pressed ? #fbbf24 : (root.out_point_sec >= 0.0 ? #f59e0b : #78350f88);
        border-width: 1px;
        border-color: root.out_point_sec >= 0.0 ? #ffffff : #f59e0b88;

        Text {
            text: root.out_point_sec >= 0.0 ? "OUT ]" : "]";
            font-size: root.out_point_sec >= 0.0 ? 9px : 11px;
            font-weight: 800;
            color: root.out_point_sec >= 0.0 ? #000000 : #fbbf24;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        out_ta := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed && root.width > 0px && root.duration > 0.0 {
                    root.out_point_dragged(((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0) * root.duration);
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Another Encoder — Professional Media Transcoder";
    min-width: 1100px;
    min-height: 750px;
    preferred-width: 1280px;
    preferred-height: 850px;
    background: #0f172a; // Deep slate background

    VerticalLayout {
        spacing: 0px;

        // TOP HEADER BAR
        Rectangle {
            height: 60px;
            background: #1e293b;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;
                alignment: center;

                // Brand Logo & Title
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: @linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
                        Text {
                            text: "AE";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "ANOTHER ENCODER";
                            font-size: 15px;
                            font-weight: 700;
                            color: #f8fafc;
                        }
                        Text {
                            text: "Rust & FFmpeg High-Performance Engine";
                            font-size: 11px;
                            color: #94a3b8;
                        }
                    }
                }

                // Spacer
                Rectangle { horizontal-stretch: 1; }

                // Top Header Status Badges
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Badge {
                        label: "v1.0.0";
                        bg_color: #0f172a;
                        fg_color: #94a3b8;
                    }
                }
            }
        }

        // Header Divider
        Rectangle { height: 1px; background: #334155; }

        // WORKSPACE TABS BAR
        Rectangle {
            height: 46px;
            background: #111827;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                alignment: center;

                // Tab 0: Player & Trimming Studio
                Rectangle {
                    width: 230px;
                    height: 36px;
                    border-radius: 6px;
                    background: AppData.active_tab == 0 ? #1e293b : #00000000;
                    border-width: 1px;
                    border-color: AppData.active_tab == 0 ? #38bdf8 : #00000000;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("icons/film.svg");
                                width: 15px;
                                height: 15px;
                                colorize: AppData.active_tab == 0 ? #38bdf8 : #94a3b8;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Media Player & Trimmer";
                                font-size: 13px;
                                font-weight: AppData.active_tab == 0 ? 700 : 500;
                                color: AppData.active_tab == 0 ? #38bdf8 : #94a3b8;
                            }
                        }
                        if AppData.has_active_trim : VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #f59e0b;
                            }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.switch_tab(0); }
                    }
                }

                // Tab 1: Downloader
                Rectangle {
                    width: 140px;
                    height: 36px;
                    border-radius: 6px;
                    background: AppData.active_tab == 1 ? #1e293b : #00000000;
                    border-width: 1px;
                    border-color: AppData.active_tab == 1 ? #38bdf8 : #00000000;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("icons/download.svg");
                                width: 15px;
                                height: 15px;
                                colorize: AppData.active_tab == 1 ? #38bdf8 : #94a3b8;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Downloader";
                                font-size: 13px;
                                font-weight: AppData.active_tab == 1 ? 700 : 500;
                                color: AppData.active_tab == 1 ? #38bdf8 : #94a3b8;
                            }
                        }
                        if AppData.ytdlp_is_downloading : VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #34d399;
                            }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.switch_tab(1); }
                    }
                }

                // Tab 2: Transcoder Settings
                Rectangle {
                    width: 190px;
                    height: 36px;
                    border-radius: 6px;
                    background: AppData.active_tab == 2 ? #1e293b : #00000000;
                    border-width: 1px;
                    border-color: AppData.active_tab == 2 ? #38bdf8 : #00000000;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("icons/settings.svg");
                                width: 15px;
                                height: 15px;
                                colorize: AppData.active_tab == 2 ? #38bdf8 : #94a3b8;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Transcoder Settings";
                                font-size: 13px;
                                font-weight: AppData.active_tab == 2 ? 700 : 500;
                                color: AppData.active_tab == 2 ? #38bdf8 : #94a3b8;
                            }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.switch_tab(2); }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Tab Divider
        Rectangle { height: 1px; background: #1f2937; }

        // MAIN BODY (Split Left: Queue, Right: Inspector)
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // LEFT PANEL: FILE QUEUE (340px width)
            Rectangle {
                width: 340px;
                background: #111827;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Section Title
                    HorizontalLayout {
                        Text {
                            text: "Input Files Queue";
                            font-size: 14px;
                            font-weight: 600;
                            color: #f1f5f9;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "\{AppData.queue.length} file(s)";
                            font-size: 12px;
                            color: #64748b;
                        }
                    }

                    // Empty State if no files
                    if AppData.queue.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        border-radius: 8px;
                        background: #1f2937.with-alpha(0.3);
                        border-width: 1px;
                        border-color: #374151;

                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: "No files in queue";
                                font-size: 15px;
                                font-weight: 600;
                                color: #94a3b8;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Click '+ Add Files' to load videos or audio clips";
                                font-size: 12px;
                                color: #64748b;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Scrollable File List
                    if AppData.queue.length > 0 : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 8px;

                            for file[idx] in AppData.queue : Rectangle {
                                height: 52px;
                                border-radius: 6px;
                                background: AppData.selected_file_index == idx ? #1e293b : (card_ta.has-hover ? #1f293d : #182234);
                                border-width: 1px;
                                border-color: AppData.selected_file_index == idx ? #38bdf8 : (card_ta.has-hover ? #475569 : #1f2937);
                                clip: true;

                                animate background { duration: 150ms; }
                                animate border-color { duration: 150ms; }

                                card_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.select_file(idx); }
                                }

                                // Status Accent Bar on left edge
                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: 3px;
                                    height: 100%;
                                    background: AppData.selected_file_index == idx ? #38bdf8 : (file.status == "Completed" ? #10b981 : (file.status == "Failed" ? #ef4444 : (file.status == "Processing" ? #f59e0b : #334155)));
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    padding-top: 5px;
                                    padding-bottom: 5px;
                                    spacing: 8px;
                                    alignment: center;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;

                                        // Row 1: File Name + Active Pill + Duration
                                        HorizontalLayout {
                                            spacing: 6px;

                                            Text {
                                                horizontal-stretch: 1;
                                                text: file.file_name;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: AppData.selected_file_index == idx ? #38bdf8 : #f8fafc;
                                                overflow: elide;
                                            }

                                            if AppData.selected_file_index == idx : Rectangle {
                                                height: 16px;
                                                border-radius: 3px;
                                                background: #0284c733;
                                                border-width: 1px;
                                                border-color: #38bdf888;
                                                HorizontalLayout {
                                                    padding-left: 5px;
                                                    padding-right: 5px;
                                                    alignment: center;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: "ACTIVE";
                                                            font-size: 8px;
                                                            font-weight: 800;
                                                            color: #38bdf8;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: file.duration;
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Row 2: Metadata chips + Status
                                        HorizontalLayout {
                                            spacing: 5px;

                                            Badge { label: file.resolution; bg_color: #0f172a; fg_color: #38bdf8; }
                                            Badge { label: file.codecs; bg_color: #0f172a; fg_color: #94a3b8; }
                                            Badge { label: file.file_size_formatted; bg_color: #0f172a; fg_color: #cbd5e1; }

                                            Rectangle { horizontal-stretch: 1; }

                                            Text {
                                                text: file.status;
                                                font-size: 10px;
                                                font-weight: 500;
                                                color: file.status == "Completed" ? #34d399 : (file.status == "Failed" ? #f87171 : #64748b);
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Remove Item Button
                                    IconButton {
                                        icon_source: @image-url("icons/x.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        btn_width: 22px;
                                        btn_height: 22px;
                                        hover_bg: #ef444433;
                                        clicked => { AppLogic.remove_file(idx); }
                                    }
                                }
                            }
                        }
                    }

                    // Bottom Queue Actions: Add Files & Clear List
                    HorizontalLayout {
                        spacing: 8px;
                        height: 38px;

                        ActionButton {
                            horizontal-stretch: 2;
                            height: 38px;
                            title: "Add Files";
                            icon_source: @image-url("icons/plus.svg");
                            has_icon: true;
                            icon_size: 14px;
                            fill_color: #0284c7;
                            hover_color: #0369a1;
                            font_size: 13px;
                            clicked => { AppLogic.add_files(); }
                        }

                        ActionButton {
                            horizontal-stretch: 1;
                            height: 38px;
                            title: "Clear List";
                            icon_source: @image-url("icons/trash.svg");
                            has_icon: true;
                            icon_size: 13px;
                            fill_color: #1e293b;
                            hover_color: #334155;
                            text_color: #94a3b8;
                            font_size: 12px;
                            is_disabled: AppData.queue.length == 0;
                            clicked => { AppLogic.clear_queue(); }
                        }
                    }
                }
            }

            // Vertical Split Divider
            Rectangle { width: 1px; background: #1f2937; }

            // RIGHT PANEL: FUNCTION & PARAMETERS (Stretch)
            Rectangle {
                horizontal-stretch: 1;
                background: #0b1120;

                // TAB 0: MEDIA PLAYER & TRIMMING STUDIO
                if AppData.active_tab == 0 : ScrollView {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        // MEDIA PLAYER & TRIMMING STUDIO EMPTY STATE
                        if !AppData.player_has_media : Rectangle {
                            border-radius: 12px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: #1e293b;
                            min-height: 440px;

                            VerticalLayout {
                                padding: 36px;
                                spacing: 18px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 32px;
                                        background: @linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
                                        Image {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("icons/film.svg");
                                            width: 28px;
                                            height: 28px;
                                            colorize: #ffffff;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    alignment: center;
                                    Text {
                                        text: "Media Player & Trimming Studio";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: #f8fafc;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Load any audio or video file to preview frame-by-frame, scrub the interactive timeline, and trim.";
                                        font-size: 13px;
                                        color: #94a3b8;
                                        horizontal-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    ActionButton {
                                        width: 240px;
                                        height: 42px;
                                        title: "Open Audio or Video File";
                                        icon_source: @image-url("icons/folder-open.svg");
                                        has_icon: true;
                                        icon_size: 16px;
                                        fill_color: #0284c7;
                                        hover_color: #0369a1;
                                        font_size: 13px;
                                        clicked => { AppLogic.add_files(); }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Badge { label: "MP4"; bg_color: #0f172a; fg_color: #38bdf8; }
                                    Badge { label: "MKV"; bg_color: #0f172a; fg_color: #38bdf8; }
                                    Badge { label: "MOV"; bg_color: #0f172a; fg_color: #38bdf8; }
                                    Badge { label: "WEBM"; bg_color: #0f172a; fg_color: #38bdf8; }
                                    Badge { label: "MP3"; bg_color: #0f172a; fg_color: #a78bfa; }
                                    Badge { label: "WAV"; bg_color: #0f172a; fg_color: #a78bfa; }
                                    Badge { label: "FLAC"; bg_color: #0f172a; fg_color: #a78bfa; }
                                    Badge { label: "AAC"; bg_color: #0f172a; fg_color: #a78bfa; }
                                }
                            }
                        }

                        if AppData.player_has_media : Rectangle {
                            border-radius: 10px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: AppData.has_active_trim ? #f59e0b : #1e293b;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                // Header row
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;

                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: AppData.selected_is_video ? @linear-gradient(135deg, #0284c7 0%, #38bdf8 100%) : @linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
                                        Image {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: AppData.selected_is_video ? @image-url("icons/video.svg") : @image-url("icons/audio.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: #ffffff;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: AppData.selected_file_name;
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: #f8fafc;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Badge {
                                                label: AppData.selected_is_video ? "VIDEO" : "AUDIO";
                                                bg_color: AppData.selected_is_video ? #0369a1 : #6d28d9;
                                                fg_color: #ffffff;
                                            }
                                            if AppData.selected_is_video : Badge {
                                                label: AppData.selected_resolution;
                                                bg_color: #0f172a;
                                                fg_color: #38bdf8;
                                            }
                                            Badge {
                                                label: AppData.selected_audio_desc;
                                                bg_color: #0f172a;
                                                fg_color: #a78bfa;
                                            }
                                            Badge {
                                                label: "Duration: " + AppData.player_duration_text;
                                                bg_color: #0f172a;
                                                fg_color: #cbd5e1;
                                            }
                                        }
                                    }

                                    ActionButton {
                                        width: 135px;
                                        height: 30px;
                                        title: "Native FFplay";
                                        icon_source: @image-url("icons/external-link.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        fill_color: #1e293b;
                                        hover_color: #334155;
                                        font_size: 11px;
                                        clicked => { AppLogic.launch_ffplay(); }
                                    }
                                }

                                // Media Screen Area (Expanded height for comfortable viewing)
                                Rectangle {
                                    height: 440px;
                                    border-radius: 8px;
                                    background: #080d1a;
                                    border-width: 1px;
                                    border-color: #1e293b;
                                    clip: true;

                                    // Video Canvas
                                    if AppData.selected_is_video : Rectangle {
                                        Image {
                                            source: AppData.preview_frame;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: contain;
                                        }


                                        // Loading indicator
                                        if AppData.preview_frame_loading : Rectangle {
                                            background: #00000099;
                                            Text {
                                                text: "Seeking frame...";
                                                font-size: 12px;
                                                color: #94a3b8;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Audio Visualizer Screen
                                    if !AppData.selected_is_video : Rectangle {
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 24px;
                                            padding: 24px;

                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                height: 100px;

                                                Rectangle { width: 5px; height: 20px; border-radius: 2px; background: #38bdf8; }
                                                Rectangle { width: 5px; height: 38px; border-radius: 2px; background: #38bdf8; }
                                                Rectangle { width: 5px; height: 60px; border-radius: 2px; background: #60a5fa; }
                                                Rectangle { width: 5px; height: 82px; border-radius: 2px; background: #818cf8; }
                                                Rectangle { width: 5px; height: 50px; border-radius: 2px; background: #a78bfa; }
                                                Rectangle { width: 5px; height: 74px; border-radius: 2px; background: #c084fc; }
                                                Rectangle { width: 5px; height: 96px; border-radius: 2px; background: #818cf8; }
                                                Rectangle { width: 5px; height: 58px; border-radius: 2px; background: #38bdf8; }
                                                Rectangle { width: 5px; height: 32px; border-radius: 2px; background: #38bdf8; }
                                                Rectangle { width: 5px; height: 68px; border-radius: 2px; background: #818cf8; }
                                                Rectangle { width: 5px; height: 92px; border-radius: 2px; background: #c084fc; }
                                                Rectangle { width: 5px; height: 64px; border-radius: 2px; background: #a78bfa; }
                                                Rectangle { width: 5px; height: 40px; border-radius: 2px; background: #60a5fa; }
                                                Rectangle { width: 5px; height: 78px; border-radius: 2px; background: #818cf8; }
                                                Rectangle { width: 5px; height: 96px; border-radius: 2px; background: #c084fc; }
                                                Rectangle { width: 5px; height: 48px; border-radius: 2px; background: #818cf8; }
                                                Rectangle { width: 5px; height: 26px; border-radius: 2px; background: #38bdf8; }
                                                Rectangle { width: 5px; height: 64px; border-radius: 2px; background: #60a5fa; }
                                                Rectangle { width: 5px; height: 84px; border-radius: 2px; background: #818cf8; }
                                                Rectangle { width: 5px; height: 54px; border-radius: 2px; background: #a78bfa; }
                                                Rectangle { width: 5px; height: 32px; border-radius: 2px; background: #38bdf8; }
                                                Rectangle { width: 5px; height: 20px; border-radius: 2px; background: #38bdf8; }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                Text {
                                                    text: AppData.player_time_text;
                                                    font-size: 26px;
                                                    font-weight: 800;
                                                    color: #38bdf8;
                                                    horizontal-alignment: center;
                                                }
                                                Text {
                                                    text: AppData.player_is_playing ? "Playing Audio Stream..." : "Audio Preview Paused";
                                                    font-size: 13px;
                                                    color: AppData.player_is_playing ? #34d399 : #94a3b8;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Visual Timeline Track
                                VerticalLayout {
                                    spacing: 8px;

                                    // Time Readouts Header Bar: PLAYHEAD on left, TOTAL and yellow TRIM on right
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        // Left: Playhead Pill
                                        Rectangle {
                                            height: 28px;
                                            border-radius: 6px;
                                            background: #1e293b;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 6px;
                                                alignment: center;
                                                Text { text: "PLAYHEAD:"; font-size: 11px; font-weight: 700; color: #64748b; vertical-alignment: center; }
                                                Text { text: AppData.player_time_text; font-size: 13px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        // Right: Total Duration Pill
                                        Rectangle {
                                            height: 28px;
                                            border-radius: 6px;
                                            background: #1e293b;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 6px;
                                                alignment: center;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text { text: "TOTAL:"; font-size: 11px; font-weight: 700; color: #64748b; }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text { text: AppData.player_duration_text; font-size: 13px; font-weight: 700; color: #cbd5e1; }
                                                }
                                            }
                                        }

                                        // Right: Yellow Trim Pill (Directly following TOTAL)
                                        if AppData.has_active_trim : Rectangle {
                                            height: 28px;
                                            border-radius: 6px;
                                            background: #d9770633;
                                            border-width: 1px;
                                            border-color: #f59e0b;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 6px;
                                                alignment: center;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("icons/scissors.svg");
                                                        width: 13px;
                                                        height: 13px;
                                                        colorize: #f59e0b;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text { text: "TRIM:"; font-size: 11px; font-weight: 700; color: #f59e0b; }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text { text: AppData.trim_duration_text; font-size: 13px; font-weight: 800; color: #fbbf24; }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text { text: "(" + AppData.in_point + " → " + AppData.out_point + ")"; font-size: 11px; color: #fde68a; }
                                                }
                                            }
                                        }
                                    }

                                    // Full Visual Timeline Track with In/Out Markers & Needle
                                    VisualTimeline {
                                        duration: AppData.player_duration;
                                        current_time: AppData.player_current_time;
                                        in_point_norm: AppData.in_point_normalized;
                                        out_point_norm: AppData.out_point_normalized;
                                        in_point_sec: AppData.in_point_seconds;
                                        out_point_sec: AppData.out_point_seconds;
                                        has_trim: AppData.has_active_trim;
                                        seek(val) => {
                                            AppLogic.player_seek(val);
                                        }
                                        in_point_dragged(val) => {
                                            AppLogic.set_in_point_from_timeline(val);
                                        }
                                        out_point_dragged(val) => {
                                            AppLogic.set_out_point_from_timeline(val);
                                        }
                                    }
                                }

                                // Row 1: Unified Transport & Marker Deck
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    IconButton {
                                        btn_width: 52px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevrons-left.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        text: "-1s";
                                        font_size: 11px;
                                        hover_bg: #334155;
                                        clicked => { AppLogic.player_step(-1.0); }
                                    }
                                    IconButton {
                                        btn_width: 56px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevron-left.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        text: "-0.1s";
                                        font_size: 10px;
                                        hover_bg: #334155;
                                        clicked => { AppLogic.player_step(-0.1); }
                                    }

                                    // Play / Pause Button
                                    ActionButton {
                                        width: 90px;
                                        height: 30px;
                                        title: AppData.player_is_playing ? "Pause" : "Play";
                                        icon_source: AppData.player_is_playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        fill_color: AppData.player_is_playing ? #e11d48 : #0284c7;
                                        hover_color: AppData.player_is_playing ? #be123c : #0369a1;
                                        font_size: 12px;
                                        clicked => { AppLogic.player_play_pause(); }
                                    }

                                    IconButton {
                                        btn_width: 34px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/stop.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        hover_bg: #334155;
                                        clicked => { AppLogic.player_stop(); }
                                    }

                                    IconButton {
                                        btn_width: 56px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevron-right.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        text: "+0.1s";
                                        font_size: 10px;
                                        hover_bg: #334155;
                                        clicked => { AppLogic.player_step(0.1); }
                                    }
                                    IconButton {
                                        btn_width: 52px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevrons-right.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        text: "+1s";
                                        font_size: 11px;
                                        hover_bg: #334155;
                                        clicked => { AppLogic.player_step(1.0); }
                                    }

                                    Rectangle { width: 1px; height: 18px; background: #334155; }

                                    ActionButton {
                                        width: 82px;
                                        height: 30px;
                                        title: "[ Set In";
                                        fill_color: #d97706;
                                        hover_color: #b45309;
                                        font_size: 11px;
                                        clicked => { AppLogic.set_in_point_current(); }
                                    }

                                    ActionButton {
                                        width: 82px;
                                        height: 30px;
                                        title: "Set Out ]";
                                        fill_color: #d97706;
                                        hover_color: #b45309;
                                        font_size: 11px;
                                        clicked => { AppLogic.set_out_point_current(); }
                                    }

                                    IconButton {
                                        btn_width: 48px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevrons-left.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        text: "In";
                                        font_size: 11px;
                                        hover_bg: #334155;
                                        clicked => { AppLogic.jump_to_in_point(); }
                                    }

                                    IconButton {
                                        btn_width: 50px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevrons-right.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        text: "Out";
                                        font_size: 11px;
                                        hover_bg: #334155;
                                        clicked => { AppLogic.jump_to_out_point(); }
                                    }

                                    ActionButton {
                                        width: 95px;
                                        height: 30px;
                                        title: "Play Trim";
                                        icon_source: @image-url("icons/play.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #059669;
                                        hover_color: #047857;
                                        font_size: 11px;
                                        clicked => { AppLogic.play_trimmed_range(); }
                                    }

                                    IconButton {
                                        btn_width: 65px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/reset.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        text: "Reset";
                                        font_size: 11px;
                                        hover_bg: #334155;
                                        clicked => { AppLogic.clear_trim_points(); }
                                    }
                                }

                                // Row 2: Precision In/Out Timecodes & Instant Actions Deck
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: "In:";
                                        font_size: 11px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }

                                    LineEdit {
                                        width: 105px;
                                        height: 28px;
                                        font-size: 11px;
                                        text <=> AppData.in_point;
                                        placeholder-text: "00:00:00.000";
                                        edited(txt) => { AppLogic.in_point_text_changed(txt); }
                                    }

                                    Text {
                                        text: "Out:";
                                        font_size: 11px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }

                                    LineEdit {
                                        width: 105px;
                                        height: 28px;
                                        font-size: 11px;
                                        text <=> AppData.out_point;
                                        placeholder-text: "00:00:00.000";
                                        edited(txt) => { AppLogic.out_point_text_changed(txt); }
                                    }

                                    Rectangle { width: 1px; height: 18px; background: #334155; }

                                    ActionButton {
                                        width: 140px;
                                        height: 28px;
                                        title: "Lossless Cut Now";
                                        icon_source: @image-url("icons/scissors.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        fill_color: #059669;
                                        hover_color: #047857;
                                        font_size: 11px;
                                        is_disabled: !AppData.has_active_trim;
                                        clicked => { AppLogic.quick_lossless_cut(); }
                                    }

                                    ActionButton {
                                        width: 135px;
                                        height: 28px;
                                        title: "Codec Settings";
                                        icon_source: @image-url("icons/settings.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        fill_color: #1e293b;
                                        hover_color: #334155;
                                        text_color: #38bdf8;
                                        font_size: 11px;
                                        clicked => { AppLogic.switch_tab(2); }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 1: WEB DOWNLOADER (YT-DLP)
                if AppData.active_tab == 1 : ScrollView {
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 12px;
                        spacing: 8px;

                        // CARD 1: URL INPUT & DISCOVERY CARD (Compact)
                        Rectangle {
                            border-radius: 8px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: #1e293b;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 7px;

                                // Header row: Title + Engine Badge
                                HorizontalLayout {
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("icons/download.svg");
                                                width: 15px;
                                                height: 15px;
                                                colorize: #38bdf8;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Downloader";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: #f8fafc;
                                            }
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    // yt-dlp Local Engine Badge
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #0284c722;
                                        border-width: 1px;
                                        border-color: #38bdf8.with-alpha(0.4);
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/zap.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: #38bdf8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "yt-dlp 2026.08.19 (Local Binary)";
                                                    font-size: 9.5px;
                                                    font-weight: 700;
                                                    color: #38bdf8;
                                                }
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: "Paste any video, stream, or audio URL from YouTube, Twitch, Vimeo, Bilibili, TikTok, SoundCloud, or direct HLS/M3U8.";
                                    font-size: 10.5px;
                                    color: #94a3b8;
                                }

                                // URL Input Box with Integrated Action Buttons
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    LineEdit {
                                        height: 28px;
                                        horizontal-stretch: 1;
                                        font-size: 11px;
                                        text <=> AppData.ytdlp_url;
                                        placeholder-text: "Paste stream URL (e.g. https://www.youtube.com/watch?v=... or direct m3u8)";
                                        accepted => { AppLogic.ytdlp_discover(); }
                                        edited(val) => { AppLogic.ytdlp_url_changed(val); }
                                    }

                                    ActionButton {
                                        width: 65px;
                                        height: 28px;
                                        title: "Paste";
                                        icon_source: @image-url("icons/layers.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #1e293b;
                                        hover_color: #334155;
                                        text_color: #38bdf8;
                                        font_size: 11px;
                                        clicked => { AppLogic.ytdlp_paste_clipboard(); }
                                    }

                                    ActionButton {
                                        width: 65px;
                                        height: 28px;
                                        title: "Clear";
                                        icon_source: @image-url("icons/trash.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #1e293b;
                                        hover_color: #334155;
                                        text_color: #94a3b8;
                                        font_size: 11px;
                                        clicked => { AppLogic.ytdlp_clear_url(); }
                                    }

                                    ActionButton {
                                        width: 105px;
                                        height: 28px;
                                        title: AppData.ytdlp_is_discovering ? "Detecting..." : "Discover";
                                        icon_source: @image-url("icons/search.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        fill_color: #0284c7;
                                        hover_color: #0369a1;
                                        text_color: #ffffff;
                                        font_size: 11px;
                                        is_disabled: AppData.ytdlp_url == "" || AppData.ytdlp_is_discovering;
                                        clicked => { AppLogic.ytdlp_discover(); }
                                    }
                                }

                                // Supported Sites Pill Tags
                                HorizontalLayout {
                                    spacing: 5px;
                                    alignment: start;

                                    Text {
                                        text: "Supported:";
                                        font-size: 9.5px;
                                        color: #64748b;
                                        vertical-alignment: center;
                                    }

                                    Badge { label: "YouTube"; bg_color: #0f172a; fg_color: #ef4444; height: 18px; }
                                    Badge { label: "Twitch"; bg_color: #0f172a; fg_color: #a78bfa; height: 18px; }
                                    Badge { label: "Vimeo"; bg_color: #0f172a; fg_color: #38bdf8; height: 18px; }
                                    Badge { label: "TikTok"; bg_color: #0f172a; fg_color: #f43f5e; height: 18px; }
                                    Badge { label: "Bilibili"; bg_color: #0f172a; fg_color: #38bdf8; height: 18px; }
                                    Badge { label: "SoundCloud"; bg_color: #0f172a; fg_color: #f59e0b; height: 18px; }
                                    Badge { label: "HLS / M3U8"; bg_color: #0f172a; fg_color: #34d399; height: 18px; }
                                }
                            }
                        }

                        // CARD 2: DISCOVERING STATE / ERROR / STREAM METADATA & CUSTOM SAVE FILENAME
                        if AppData.ytdlp_is_discovering : Rectangle {
                            border-radius: 8px;
                            background: #0284c715;
                            border-width: 1px;
                            border-color: #0284c755;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 8px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/search.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: #38bdf8;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Querying stream URL and discovering available formats and audio tracks via yt-dlp...";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #38bdf8;
                                    }
                                }
                            }
                        }

                        if AppData.ytdlp_has_error : Rectangle {
                            border-radius: 8px;
                            background: #ef444415;
                            border-width: 1px;
                            border-color: #ef444455;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/x.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: #ef4444;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "Error: " + AppData.ytdlp_error_message;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        color: #fca5a5;
                                        wrap: word-wrap;
                                    }
                                }

                                ActionButton {
                                    width: 60px;
                                    height: 22px;
                                    title: "Dismiss";
                                    fill_color: #ef444433;
                                    hover_color: #ef444455;
                                    text_color: #fca5a5;
                                    font_size: 9.5px;
                                    clicked => { AppData.ytdlp_has_error = false; }
                                }
                            }
                        }

                        if AppData.ytdlp_has_discovered : Rectangle {
                            border-radius: 8px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: #34d39966;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/film.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #34d399;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "DISCOVERED STREAM";
                                            font-size: 10.5px;
                                            font-weight: 800;
                                            color: #34d399;
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    // Ready Status Badge
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #05966922;
                                        border-width: 1px;
                                        border-color: #34d399;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/check.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: #34d399;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Ready to Download";
                                                    font-size: 9.5px;
                                                    font-weight: 700;
                                                    color: #34d399;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Title Text
                                Text {
                                    text: AppData.ytdlp_title;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    wrap: word-wrap;
                                }

                                // Stream Metadata Badges Row
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    if AppData.ytdlp_uploader != "" : Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #1e293b;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Author:";
                                                    font-size: 9.5px;
                                                    color: #94a3b8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: AppData.ytdlp_uploader;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    color: #38bdf8;
                                                }
                                            }
                                        }
                                    }

                                    if AppData.ytdlp_duration != "" : Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #1e293b;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/clock.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: #94a3b8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: AppData.ytdlp_duration;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    color: #cbd5e1;
                                                }
                                            }
                                        }
                                    }

                                    if AppData.ytdlp_discovered_id != "" : Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #1e293b;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            Text {
                                                text: "ID: " + AppData.ytdlp_discovered_id;
                                                font-size: 9.5px;
                                                font-weight: 600;
                                                color: #64748b;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // EXPANDED SECTION: USER EDITABLE SAVE FILE NAME
                                Rectangle {
                                    border-radius: 6px;
                                    background: #0b1329;
                                    border-width: 1px;
                                    border-color: #0284c744;

                                    VerticalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 7px;
                                        padding-bottom: 7px;
                                        spacing: 5px;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/sliders.svg");
                                                    width: 12px;
                                                    height: 12px;
                                                    colorize: #38bdf8;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Save File Name (Customizable):";
                                                    font-size: 10.5px;
                                                    font-weight: 700;
                                                    color: #38bdf8;
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            Text {
                                                text: "(Extension auto-appended based on format)";
                                                font-size: 9.5px;
                                                color: #64748b;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: center;

                                            LineEdit {
                                                height: 28px;
                                                horizontal-stretch: 1;
                                                font-size: 11px;
                                                placeholder-text: "Enter custom file name (without extension)...";
                                                text <=> AppData.ytdlp_custom_filename;
                                            }

                                            ActionButton {
                                                width: 75px;
                                                height: 28px;
                                                title: "Reset";
                                                icon_source: @image-url("icons/reset.svg");
                                                has_icon: true;
                                                icon_size: 11px;
                                                fill_color: #1e293b;
                                                hover_color: #334155;
                                                text_color: #94a3b8;
                                                font_size: 10.5px;
                                                clicked => { AppData.ytdlp_custom_filename = AppData.ytdlp_title; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // CARD 3: FORMAT SELECTION & DESTINATION FOLDER (Compact)
                        Rectangle {
                            border-radius: 8px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: #1e293b;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 7px;

                                // Header row
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Download Format & Quality Options";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #f8fafc;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: "Options queried by yt-dlp";
                                        font-size: 9.5px;
                                        color: #64748b;
                                    }
                                }

                                // Quality Preset / Stream Dropdown
                                ComboBox {
                                    height: 28px;
                                    model: AppData.ytdlp_format_options;
                                    current-index <=> AppData.ytdlp_selected_format_index;
                                }

                                // Contextual Format Description Banner
                                Rectangle {
                                    border-radius: 6px;
                                    background: AppData.ytdlp_selected_format_index >= 6 ? #7c3aed15 : #0284c715;
                                    border-width: 1px;
                                    border-color: AppData.ytdlp_selected_format_index >= 6 ? #7c3aed44 : #0284c744;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        spacing: 6px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: AppData.ytdlp_selected_format_index >= 6 ? @image-url("icons/audio.svg") : @image-url("icons/video.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: AppData.ytdlp_selected_format_index >= 6 ? #a78bfa : #38bdf8;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: AppData.ytdlp_selected_format_index >= 6 ?
                                                    "Audio Extraction Mode: Downloads audio stream and converts to high-quality audio file." :
                                                    "Video Download Mode: Combines best available video track with highest quality audio track into standard MP4.";
                                                font-size: 10px;
                                                color: AppData.ytdlp_selected_format_index >= 6 ? #c4b5fd : #bae6fd;
                                            }
                                        }
                                    }
                                }

                                // Destination Folder Row
                                VerticalLayout {
                                    spacing: 5px;

                                    Text {
                                        text: "Save Destination Folder:";
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        color: #94a3b8;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        LineEdit {
                                            height: 28px;
                                            horizontal-stretch: 1;
                                            font-size: 11px;
                                            placeholder-text: "Choose or paste folder path to save downloaded media";
                                            text <=> AppData.ytdlp_output_dir;
                                        }

                                        ActionButton {
                                            width: 85px;
                                            height: 28px;
                                            title: "Browse...";
                                            icon_source: @image-url("icons/folder.svg");
                                            has_icon: true;
                                            icon_size: 11px;
                                            fill_color: #1e293b;
                                            hover_color: #334155;
                                            text_color: #38bdf8;
                                            font_size: 11px;
                                            clicked => { AppLogic.ytdlp_select_output_dir(); }
                                        }

                                        ActionButton {
                                            width: 95px;
                                            height: 28px;
                                            title: "Open Folder";
                                            icon_source: @image-url("icons/folder-open.svg");
                                            has_icon: true;
                                            icon_size: 11px;
                                            fill_color: #1e293b;
                                            hover_color: #334155;
                                            text_color: #94a3b8;
                                            font_size: 11px;
                                            clicked => { AppLogic.ytdlp_open_output_dir(); }
                                        }
                                    }
                                }
                            }
                        }

                        // CARD 4: DOWNLOAD ENGINE EXECUTION & PROGRESS (Compact)
                        Rectangle {
                            border-radius: 8px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: #1e293b;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 7px;

                                // Action Buttons Row
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 10px;

                                    if !AppData.ytdlp_is_downloading : ActionButton {
                                        width: 160px;
                                        height: 30px;
                                        title: "START DOWNLOAD";
                                        icon_source: @image-url("icons/download.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        fill_color: #10b981;
                                        hover_color: #059669;
                                        font_size: 11.5px;
                                        clicked => { AppLogic.ytdlp_start_download(); }
                                    }

                                    if AppData.ytdlp_is_downloading : ActionButton {
                                        width: 160px;
                                        height: 30px;
                                        title: "CANCEL DOWNLOAD";
                                        icon_source: @image-url("icons/stop.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        fill_color: #ef4444;
                                        hover_color: #dc2626;
                                        font_size: 11.5px;
                                        clicked => { AppLogic.ytdlp_cancel_download(); }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    Text {
                                        text: AppData.ytdlp_status_message;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: AppData.ytdlp_is_downloading ? #38bdf8 : #94a3b8;
                                        vertical-alignment: center;
                                    }
                                }

                                // Real-time Progress Bar
                                Rectangle {
                                    height: 7px;
                                    border-radius: 3.5px;
                                    background: #0f172a;

                                    Rectangle {
                                        x: 0px;
                                        width: parent.width * (AppData.ytdlp_progress / 100.0).clamp(0.0, 1.0);
                                        height: parent.height;
                                        border-radius: 3.5px;
                                        background: @linear-gradient(90deg, #0284c7 0%, #10b981 100%);
                                    }
                                }

                                // Stats Badges Row
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    Badge { label: AppData.ytdlp_progress_text; bg_color: #0f172a; fg_color: #38bdf8; height: 20px; }
                                    Badge { label: AppData.ytdlp_speed_text; bg_color: #0f172a; fg_color: #a78bfa; height: 20px; }
                                    Badge { label: AppData.ytdlp_eta_text; bg_color: #0f172a; fg_color: #34d399; height: 20px; }
                                    Badge { label: AppData.ytdlp_size_text; bg_color: #0f172a; fg_color: #cbd5e1; height: 20px; }

                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }

                        // CARD 5: POST-DOWNLOAD QUICK ACTIONS (Celebration Banner, Compact)
                        if AppData.ytdlp_download_finished : Rectangle {
                            border-radius: 8px;
                            background: #05966915;
                            border-width: 1px;
                            border-color: #10b98188;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 7px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/check.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #34d399;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Download Completed Successfully!";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #34d399;
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }
                                }

                                if AppData.ytdlp_last_downloaded_file != "" : Text {
                                    text: "Saved: " + AppData.ytdlp_last_downloaded_file;
                                    font-size: 10.5px;
                                    color: #cbd5e1;
                                    wrap: word-wrap;
                                }

                                // Quick Action Integration Buttons
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    ActionButton {
                                        height: 28px;
                                        title: "Load in Media Player & Trimmer";
                                        icon_source: @image-url("icons/film.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #0284c7;
                                        hover_color: #0369a1;
                                        text_color: #ffffff;
                                        font_size: 11px;
                                        clicked => { AppLogic.ytdlp_load_in_player(); }
                                    }

                                    ActionButton {
                                        height: 28px;
                                        title: "Add to Transcoder Queue";
                                        icon_source: @image-url("icons/plus.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #1e293b;
                                        hover_color: #334155;
                                        text_color: #38bdf8;
                                        font_size: 11px;
                                        clicked => { AppLogic.ytdlp_send_to_queue(); }
                                    }

                                    ActionButton {
                                        height: 28px;
                                        title: "Open Folder";
                                        icon_source: @image-url("icons/folder-open.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #1e293b;
                                        hover_color: #334155;
                                        text_color: #94a3b8;
                                        font_size: 11px;
                                        clicked => { AppLogic.ytdlp_open_output_dir(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 2: TRANSCODER & CODEC SETTINGS
                if AppData.active_tab == 2 : ScrollView {
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 12px;
                        spacing: 8px;

                        // FUNCTION SELECTOR CARD (Visually grouped & color-coded, Compact)
                        Rectangle {
                            border-radius: 8px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: AppData.function_index <= 5 ? #0284c788 : (AppData.function_index <= 8 ? #05966988 : (AppData.function_index <= 11 ? #7c3aed88 : #d9770688));

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
