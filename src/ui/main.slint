                                        border-color: #fbbf24;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/subtitles.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: #fbbf24;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "SUBTITLES & STREAMS";
                                                    font-size: 9.5px;
                                                    font-weight: 700;
                                                    color: #fbbf24;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Interactive Category Quick-Pills (Compact)
                                HorizontalLayout {
                                    spacing: 6px;

                                    // Video Category Tab
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 26px;
                                        border-radius: 5px;
                                        background: AppData.function_index <= 5 ? #0284c733 : #1e293b;
                                        border-width: 1px;
                                        border-color: AppData.function_index <= 5 ? #38bdf8 : #334155;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/video.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: AppData.function_index <= 5 ? #38bdf8 : #94a3b8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Video Codecs";
                                                    font-size: 10.5px;
                                                    font-weight: AppData.function_index <= 5 ? 700 : 500;
                                                    color: AppData.function_index <= 5 ? #38bdf8 : #cbd5e1;
                                                }
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppData.function_index = 0; }
                                        }
                                    }

                                    // Remux Category Tab
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 26px;
                                        border-radius: 5px;
                                        background: AppData.function_index >= 6 && AppData.function_index <= 8 ? #05966933 : #1e293b;
                                        border-width: 1px;
                                        border-color: AppData.function_index >= 6 && AppData.function_index <= 8 ? #34d399 : #334155;
                                        HorizontalLayout {
                                            alignment: center;
