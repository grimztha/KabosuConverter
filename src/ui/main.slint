                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Audio Suite";
                                                    font-size: 10.5px;
                                                    font-weight: AppData.function_index >= 9 && AppData.function_index <= 11 ? 700 : 500;
                                                    color: AppData.function_index >= 9 && AppData.function_index <= 11 ? #a78bfa : #cbd5e1;
                                                }
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppData.function_index = 9; }
                                        }
                                    }

                                    // Subtitle Category Tab
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 26px;
                                        border-radius: 5px;
                                        background: AppData.function_index == 12 ? #d9770633 : #1e293b;
                                        border-width: 1px;
                                        border-color: AppData.function_index == 12 ? #fbbf24 : #334155;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/subtitles.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: AppData.function_index == 12 ? #fbbf24 : #94a3b8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Subtitles";
                                                    font-size: 10.5px;
                                                    font-weight: AppData.function_index == 12 ? 700 : 500;
                                                    color: AppData.function_index == 12 ? #fbbf24 : #cbd5e1;
                                                }
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppData.function_index = 12; }
                                        }
                                    }
                                }

                                // Dropdown ComboBox with grouped entries (Compact)
                                ComboBox {
                                    height: 28px;
                                    model: [
                                        "[Video] H.264 (AVC) — Universal Web & Playback",
                                        "[Video] H.265 (HEVC) — High Efficiency Video",
                                        "[Video] AV1 — Next-Gen Open Video Codec",
                                        "[Video] Apple ProRes — Professional Editing Intermediate",
                                        "[Video] Avid DNxHD / DNxHR — Broadcast & NLE Intermediate",
                                        "[Video] VP9 — Open Web Video Codec",
                                        "[Remux] Rewrap / Remux — Instant Container Change (No Re-encode)",
                                        "[Remux] Lossless Cut — Fast Trim Without Re-encoding",
                                        "[Remux] Extract Video Track (Drop Audio/Subs)",
                                        "[Audio] Extract Audio Track (Lossless / AAC / MP3)",
                                        "[Audio] Audio Normalization (EBU R128 / LUFS)",
                                        "[Audio] Audio Conversion (AAC / MP3 / FLAC / WAV)",
                                        "[Subtitle] Extract Subtitle Stream (SRT / VTT / ASS)"
                                    ];
                                    current-index <=> AppData.function_index;
                                }

                                // Category Pipeline Description Banner (Compact)
                                Rectangle {
                                    border-radius: 5px;
                                    background: AppData.function_index <= 5 ? #0284c715 : (AppData.function_index <= 8 ? #05966915 : (AppData.function_index <= 11 ? #7c3aed15 : #d9770615));
                                    border-width: 1px;
                                    border-color: AppData.function_index <= 5 ? #0284c755 : (AppData.function_index <= 8 ? #05966955 : (AppData.function_index <= 11 ? #7c3aed55 : #d9770655));

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 5px;
                                        padding-bottom: 5px;
                                        spacing: 8px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: AppData.function_index <= 5 ? @image-url("icons/video.svg") : (AppData.function_index <= 8 ? @image-url("icons/layers.svg") : (AppData.function_index <= 11 ? @image-url("icons/audio.svg") : @image-url("icons/subtitles.svg")));
                                                width: 13px;
                                                height: 13px;
                                                colorize: AppData.function_index <= 5 ? #38bdf8 : (AppData.function_index <= 8 ? #34d399 : (AppData.function_index <= 11 ? #a78bfa : #fbbf24));
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: AppData.function_index <= 5 ?
                                                    "Video Transcoding Pipeline: Accelerated full video encode with CRF/bitrate control, resolution scaling, and filters." :
                                                    (AppData.function_index <= 8 ?
                                                        "Lossless Stream Copy Pipeline: High-speed container repacking and lossless cut with zero generation loss." :
                                                        (AppData.function_index <= 11 ?
                                                            "Audio Processing Pipeline: High-fidelity audio demux, conversion, and EBU R128 / LUFS broadcast loudness normalization." :
                                                            "Subtitle Extraction Pipeline: Extracts embedded text or bitmap subtitle streams into clean external subtitle files (.srt)."));
                                                font-size: 10.5px;
                                                font-weight: 500;
                                                color: AppData.function_index <= 5 ? #93c5fd : (AppData.function_index <= 8 ? #a7f3d0 : (AppData.function_index <= 11 ? #ddd6fe : #fde68a));
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // VIDEO PARAMETERS CARD (Compact 4-column layout)
                        if AppData.function_index <= 5 : Rectangle {
                            border-radius: 8px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: #1e293b;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 8px;

                                Text {
                                    text: "Video Encoding Parameters";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                }

                                // Row 1: Hardware Acceleration, Preset, Resolution, Framerate (4 columns)
                                HorizontalLayout {
                                    spacing: 10px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Hardware Acceleration"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        ComboBox {
                                            height: 28px;
                                            model: ["Auto Detect", "NVIDIA NVENC (CUDA)", "Intel QuickSync (QSV)", "AMD AMF", "CPU Software Only"];
                                            current-index <=> AppData.hw_accel_index;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Encoder Preset / Speed"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        ComboBox {
                                            height: 28px;
                                            model: ["ultrafast", "faster", "fast", "medium", "slow", "veryslow"];
                                            current-index <=> AppData.preset_index;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Resolution Scaling"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        ComboBox {
                                            height: 28px;
                                            model: ["Original Source", "4K UHD (3840x2160)", "1440p QHD (2560x1440)", "1080p FHD (1920x1080)", "720p HD (1280x720)", "480p SD (854x480)"];
                                            current-index <=> AppData.resolution_index;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Framerate Conform"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        ComboBox {
                                            height: 28px;
                                            model: ["Original Source", "23.976 fps", "24.0 fps", "25.0 fps (PAL)", "29.97 fps (NTSC)", "30.0 fps", "50.0 fps", "59.94 fps", "60.0 fps"];
                                            current-index <=> AppData.fps_index;
                                        }
                                    }
                                }

                                // Row 2: Rate Control Mode, Quality/Bitrate, Deinterlacing, Web Faststart (4 columns)
                                HorizontalLayout {
                                    spacing: 10px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Rate Control Mode"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        ComboBox {
                                            height: 28px;
                                            model: ["Constant Quality (CRF)", "Constant Bitrate (CBR)", "Variable Bitrate (VBR)"];
                                            current-index <=> AppData.rate_control_index;
                                        }
                                    }

                                    if AppData.rate_control_index == 0 : VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        HorizontalLayout {
                                            Text { text: "CRF Quality: "; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                            Text { text: "\{Math.round(AppData.crf_value)}"; font-size: 11px; font-weight: 700; color: #38bdf8; }
                                            Text { text: " (0-51)"; font-size: 10px; color: #64748b; }
                                        }
                                        Slider {
                                            height: 28px;
                                            minimum: 0;
                                            maximum: 51;
                                            value <=> AppData.crf_value;
                                        }
                                    }

                                    if AppData.rate_control_index > 0 : VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Target Video Bitrate"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        ComboBox {
                                            height: 28px;
                                            model: ["15000 kbps (High 4K)", "10000 kbps (2K)", "6000 kbps (1080p)", "4000 kbps (Good 1080p)", "2500 kbps (720p)", "1200 kbps (Low)"];
                                            current-index <=> AppData.video_bitrate_index;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Deinterlacing Filter"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        ComboBox {
                                            height: 28px;
                                            model: ["None (Keep Progressive)", "Yadif (Adaptive)", "Bwdif (Bob Weaver)"];
                                            current-index <=> AppData.deinterlace_index;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Web Optimization"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        Rectangle {
                                            height: 28px;
                                            HorizontalLayout {
                                                alignment: start;
                                                CheckBox {
                                                    text: "FastStart (moov atom)";
                                                    checked <=> AppData.faststart;
                                                }
                                            }
                                        }
                                    }
                                }

                                // ProRes Specific Profile Row (Compact)
                                if AppData.function_index == 3 : HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Apple ProRes Profile"; font-size: 11px; font-weight: 600; color: #f59e0b; }
                                        ComboBox {
                                            height: 28px;
                                            model: ["ProRes 422 Proxy", "ProRes 422 LT", "ProRes 422 (Standard)", "ProRes 422 HQ (High Quality)", "ProRes 4444 (RGBA 12-bit)", "ProRes 4444 XQ"];
                                            current-index <=> AppData.prores_profile_index;
                                        }
                                    }
                                }
                            }
                        }

                        // AUDIO PARAMETERS CARD (Compact 4-column row)
                        if AppData.function_index <= 5 || AppData.function_index == 9 || AppData.function_index == 10 || AppData.function_index == 11 : Rectangle {
                            border-radius: 8px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: #1e293b;

                            VerticalLayout {
                                padding-left: 12px;
