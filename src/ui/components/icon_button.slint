import { Theme } from "../theme.slint";

export component IconButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon_source;
    in property <bool> has_icon: false;
    in property <length> icon_size: 13px;
    in property <color> text_color: Theme.text_secondary;
    in property <color> hover_bg: Theme.control_hover;
    in property <color> pressed_bg: Theme.control_pressed;
    in property <length> btn_width: 28px;
    in property <length> btn_height: 28px;
    in property <length> font_size: Theme.font_caption;
    in property <bool> is_disabled: false;
    callback clicked();

    width: root.btn_width;
    height: root.btn_height;
    border-radius: 6px;
    background: is_disabled ? transparent : (ta.pressed ? pressed_bg : (ta.has-hover ? hover_bg : #00000000));
    border-width: fs.has-focus ? 1.5px : 0px;
    border-color: Theme.focus_ring;

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-left: 3px;
        padding-right: 3px;

        if root.has_icon : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon_source;
                width: root.icon_size;
                height: root.icon_size;
                colorize: is_disabled ? Theme.text_faint : (ta.has-hover ? Theme.text_primary : root.text_color);
            }
        }

        if root.text != "" : VerticalLayout {
            alignment: center;
            Text {
                text: root.text;
                color: is_disabled ? Theme.text_faint : (ta.has-hover ? Theme.text_primary : root.text_color);
                font-size: root.font_size;
                font-weight: 600;
            }
        }
    }

    fs := FocusScope {
        enabled: !root.is_disabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }

        ta := TouchArea {
            enabled: !root.is_disabled;
            mouse-cursor: is_disabled ? default : pointer;
            clicked => {
                fs.focus();
                root.clicked();
            }
        }
    }
}
