import { Theme } from "../theme.slint";

export component Badge inherits Rectangle {
    in property <string> label: "";
    in property <color> bg_color: Theme.card_secondary_bg;
    in property <color> fg_color: Theme.text_secondary;

    height: 22px;
    border-radius: 4px;
    background: bg_color;
    border-width: 1px;
    border-color: bg_color.brighter(0.3);

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-size: Theme.font_badge;
                color: root.fg_color;
                font-weight: 600;
            }
        }
    }
}
