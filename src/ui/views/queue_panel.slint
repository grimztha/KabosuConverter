import { ScrollView } from "std-widgets.slint";
import { AppData, AppLogic, Theme } from "../globals.slint";
import { Badge } from "../components/badge.slint";
import { IconButton } from "../components/icon_button.slint";
import { ActionButton } from "../components/action_button.slint";

export component QueuePanel inherits Rectangle {
    callback request_focus();
    background: Theme.panel_bg;
    horizontal-stretch: 0;

    property <bool> confirm_clear: false;

    // COLLAPSED STRIP STATE
    if !AppData.queue_panel_expanded : VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        alignment: start;

        HorizontalLayout {
            alignment: center;
            IconButton {
                btn_width: 26px;
                btn_height: 26px;
                icon_source: @image-url("../icons/chevron-right.svg");
                has_icon: true;
                text_color: Theme.text_muted;
                hover_bg: Theme.control_hover;
                clicked => { AppLogic.toggle_queue_panel(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: AppData.queue.length > 0 ? Theme.accent_surface : Theme.card_secondary_bg;
                border-width: 1px;
                border-color: AppData.queue.length > 0 ? Theme.accent_border : Theme.card_secondary_border;

                Text {
                    text: "\{AppData.queue.length}";
                    font-size: Theme.font_badge;
                    font-weight: 700;
                    font-family: Theme.font_mono;
                    color: AppData.queue.length > 0 ? Theme.accent_lime : Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // EXPANDED STATE
    if AppData.queue_panel_expanded : VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // Section Title & Collapse Control
        HorizontalLayout {
            padding-left: 2px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Text {
                    text: "Input Queue";
                    font-size: Theme.font_body;
                    font-weight: 700;
                    color: Theme.text_primary;
                }
            }

            VerticalLayout {
                alignment: center;
                Badge {
                    label: AppData.queue.length == 1 ? "1 file" : "\{AppData.queue.length} files";
                    bg_color: Theme.card_secondary_bg;
                    fg_color: Theme.text_muted;
                    border_col: Theme.card_border;
                    height: 20px;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                IconButton {
                    btn_width: 24px;
                    btn_height: 24px;
                    icon_source: @image-url("../icons/chevron-left.svg");
                    has_icon: true;
                    icon_size: 12px;
                    text_color: Theme.text_muted;
                    hover_bg: Theme.control_hover;
                    clicked => { AppLogic.toggle_queue_panel(); }
                }
            }
        }

        // Queue Container Box (Concentric: Outer 14px = Inner 6px + Padding 8px)
        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius_lg;
            background: Theme.card_bg;
            border-width: 1px;
            border-color: Theme.card_border;

            TouchArea {
                clicked => {
                    root.confirm_clear = false;
                    root.request_focus();
                }
            }

            VerticalLayout {
                padding: 8px;
                spacing: 8px;

                // Empty State
                if AppData.queue.length == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 10px;
                    padding-left: 14px;
                    padding-right: 14px;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 42px;
                            height: 42px;
                            border-radius: 21px;
                            background: Theme.card_secondary_bg;
                            border-width: 1px;
                            border-color: Theme.card_secondary_border;

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../icons/folder-open.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.text_muted;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Queue is empty";
                            font-size: Theme.font_body;
                            font-weight: 600;
                            color: Theme.text_primary;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Drop video or audio files here, or use Add Files below.";
                            font-size: Theme.font_caption;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // Scrollable File List
                if AppData.queue.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 5px;
                        alignment: start;

                        for file[idx] in AppData.queue : Rectangle {
                            height: 44px;
                            border-radius: Theme.radius_sm;
                            background: AppData.selected_file_index == idx ? Theme.accent_surface : (card_ta.has-hover ? Theme.card_secondary_bg : Theme.card_subtle_bg);
                            border-width: 1px;
                            border-color: AppData.selected_file_index == idx ? Theme.accent_border : (card_ta.has-hover ? Theme.card_secondary_border : Theme.card_subtle_border);
                            clip: true;

                            animate background { duration: 120ms; easing: ease-out; }
                            animate border-color { duration: 120ms; easing: ease-out; }

                            card_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.confirm_clear = false;
                                    AppLogic.select_file(idx);
                                    root.request_focus();
                                }
                            }

                            // Bottom inline encoding progress bar
                            if file.progress > 0.0 && file.progress < 1.0 : Rectangle {
                                x: 0px;
                                y: parent.height - 2px;
                                width: max(4px, parent.width * file.progress);
                                height: 2px;
                                background: @linear-gradient(90deg, Theme.accent_primary 0%, Theme.accent_lime 100%);
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 6px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 8px;

                                // Media Type Leading Icon Tile
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 5px;
                                        background: file.is_video
                                            ? (AppData.selected_file_index == idx ? Theme.accent_primary.with-alpha(0.18) : Theme.card_secondary_bg)
                                            : (AppData.selected_file_index == idx ? Theme.purple_surface : Theme.card_secondary_bg);

                                        Image {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: file.is_video ? @image-url("../icons/video.svg") : @image-url("../icons/audio.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: file.is_video
                                                ? (AppData.selected_file_index == idx ? Theme.accent_lime : Theme.text_muted)
                                                : Theme.accent_purple;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    spacing: 1px;
                                    alignment: center;

                                    Text {
                                        text: file.file_name;
                                        font-size: Theme.font_caption;
                                        font-weight: 600;
                                        color: AppData.selected_file_index == idx ? Theme.accent_lime : Theme.text_primary;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: file.file_path;
                                        font-size: Theme.font_badge;
                                        color: AppData.selected_file_index == idx ? Theme.text_secondary : Theme.text_muted;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }
                                }

                                // Remove Item Button
                                VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon_source: @image-url("../icons/x.svg");
                                        has_icon: true;
                                        icon_size: 10px;
                                        btn_width: 22px;
                                        btn_height: 22px;
                                        text_color: Theme.text_muted;
                                        hover_bg: Theme.red_surface;
                                        is_disabled: AppData.is_processing;
                                        clicked => {
                                            AppLogic.remove_file(idx);
                                            root.request_focus();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Bottom Queue Actions: Add Files (Tinted Secondary) & Clear Queue (Two-Click Safe)
                HorizontalLayout {
                    spacing: 6px;
                    height: Theme.btn_height_md;

                    ActionButton {
                        min-width: 0px;
                        horizontal-stretch: 13;
                        height: Theme.btn_height_md;
                        title: "Add Files";
                        icon_source: @image-url("../icons/plus.svg");
                        has_icon: true;
                        icon_size: 12px;
                        fill_color: Theme.accent_surface;
                        hover_color: Theme.accent_surface_hover;
                        text_color: Theme.accent_lime;
                        border_col: Theme.accent_border;
                        hover_border_col: Theme.accent_primary;
                        normal_border_width: 1px;
                        font_size: Theme.font_caption;
                        clicked => {
                            root.confirm_clear = false;
                            AppLogic.add_files();
                            root.request_focus();
                        }
                    }

                    ActionButton {
                        min-width: 0px;
                        horizontal-stretch: 11;
                        height: Theme.btn_height_md;
                        title: root.confirm_clear ? "Confirm?" : "Clear Queue";
                        icon_source: @image-url("../icons/trash.svg");
                        has_icon: true;
                        icon_size: 12px;
                        fill_color: root.confirm_clear ? Theme.accent_red_solid : Theme.btn_neutral_bg;
                        hover_color: root.confirm_clear ? Theme.accent_red_hover : Theme.btn_neutral_hover;
                        text_color: root.confirm_clear ? #ffffff : Theme.btn_neutral_text;
                        border_col: root.confirm_clear ? Theme.accent_red : Theme.btn_neutral_border;
                        hover_border_col: root.confirm_clear ? Theme.accent_red_hover : Theme.input_hover_border;
                        normal_border_width: 1px;
                        font_size: Theme.font_badge;
                        is_disabled: AppData.queue.length == 0 || AppData.is_processing;
                        clicked => {
                            if root.confirm_clear {
                                root.confirm_clear = false;
                                AppLogic.clear_queue();
                            } else {
                                root.confirm_clear = true;
                            }
                            root.request_focus();
                        }
                    }
                }
            }
        }

        // SELECTED ITEM METADATA CARD
        if AppData.selected_file_index >= 0 && AppData.selected_file_index < AppData.queue.length : Rectangle {
            height: 116px;
            border-radius: Theme.radius_md;
            background: Theme.card_bg;
            border-width: 1px;
            border-color: Theme.card_border;

            TouchArea {
                clicked => { root.request_focus(); }
            }

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 8px;
                alignment: start;

                // Header Row: Media Type Pill + Label + Status
                HorizontalLayout {
                    height: 20px;
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        Badge {
                            label: AppData.queue[AppData.selected_file_index].is_video ? "Video" : "Audio";
                            bg_color: AppData.queue[AppData.selected_file_index].is_video ? Theme.accent_surface : Theme.purple_surface;
                            fg_color: AppData.queue[AppData.selected_file_index].is_video ? Theme.accent_lime : Theme.accent_purple;
                            border_col: AppData.queue[AppData.selected_file_index].is_video ? Theme.accent_border : Theme.purple_border;
                            height: 18px;
                        }
                    }

                    Text {
                        text: "Media Specs";
                        font-size: Theme.font_badge;
                        font-weight: 600;
                        color: Theme.text_secondary;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: AppData.queue[AppData.selected_file_index].status;
                        font-size: Theme.font_badge;
                        font-weight: 700;
                        color: AppData.queue[AppData.selected_file_index].status == "Completed" ? Theme.accent_green
                            : (AppData.queue[AppData.selected_file_index].status == "Probing..." ? Theme.accent_purple
                            : (AppData.queue[AppData.selected_file_index].status == "Ready" ? Theme.accent_lime
                            : (AppData.queue[AppData.selected_file_index].progress > 0.0 && AppData.queue[AppData.selected_file_index].progress < 1.0 ? Theme.accent_amber
                            : Theme.accent_red_text)));
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Row 1: Resolution, Duration, File Size
                HorizontalLayout {
                    height: 32px;
                    spacing: 8px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Resolution";
                            font-size: Theme.font_badge;
                            color: Theme.text_muted;
                        }
                        Text {
                            text: AppData.queue[AppData.selected_file_index].resolution;
                            font-size: Theme.font_caption;
                            font-weight: 600;
                            font-family: Theme.font_mono;
                            color: Theme.text_primary;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Duration";
                            font-size: Theme.font_badge;
                            color: Theme.text_muted;
                        }
                        Text {
                            text: AppData.queue[AppData.selected_file_index].duration;
                            font-size: Theme.font_caption;
                            font-weight: 600;
                            font-family: Theme.font_mono;
                            color: Theme.text_primary;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Size";
                            font-size: Theme.font_badge;
                            color: Theme.text_muted;
                        }
                        Text {
                            text: AppData.queue[AppData.selected_file_index].file_size_formatted;
                            font-size: Theme.font_caption;
                            font-weight: 600;
                            font-family: Theme.font_mono;
                            color: Theme.text_secondary;
                            overflow: elide;
                        }
                    }
                }

                // Row 2: Codecs
                VerticalLayout {
                    height: 30px;
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "Streams";
                        font-size: Theme.font_badge;
                        color: Theme.text_muted;
                    }
                    Text {
                        text: AppData.queue[AppData.selected_file_index].codecs;
                        font-size: Theme.font_caption;
                        font-weight: 600;
                        font-family: Theme.font_mono;
                        color: Theme.text_secondary;
                        overflow: elide;
                    }
                }
            }
        }

        // PRIMARY HERO CTA: RUN TASK (Full-width inset for balanced commercial hierarchy)
        if !AppData.is_processing : ActionButton {
            height: Theme.btn_height_lg;
            title: "Run Task";
            icon_source: @image-url("../icons/play.svg");
            has_icon: true;
            fill_color: Theme.accent_primary;
            hover_color: Theme.accent_primary_hover;
            pressed_color: Theme.accent_primary_pressed;
            text_color: Theme.text_on_accent;
            is_disabled: AppData.queue.length == 0;
            font_size: Theme.font_body;
            btn_radius: Theme.radius_md;
            clicked => { AppLogic.run_task(); }
        }

        if AppData.is_processing : ActionButton {
            height: Theme.btn_height_lg;
            title: "Stop / Cancel";
            icon_source: @image-url("../icons/stop.svg");
            has_icon: true;
            fill_color: Theme.accent_red_solid;
            hover_color: Theme.accent_red_hover;
            text_color: #ffffff;
            font_size: Theme.font_body;
            btn_radius: Theme.radius_md;
            clicked => { AppLogic.cancel_processing(); }
        }
    }
}
