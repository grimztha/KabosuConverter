import { LineEdit, ScrollView } from "std-widgets.slint";
import { AppData, AppLogic } from "../globals.slint";
import { Badge } from "../components/badge.slint";
import { IconButton } from "../components/icon_button.slint";
import { ActionButton } from "../components/action_button.slint";

export component QueuePanel inherits Rectangle {
    background: #0f0f12;
    min-width: 300px;
    max-width: 300px;
    horizontal-stretch: 0;

                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;

                    // Section Title
                    HorizontalLayout {
                        padding-left: 2px;
                        padding-right: 2px;
                        Text {
                            text: "Input Files Queue";
                            font-size: 13px;
                            font-weight: 600;
                            color: #fafafa;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "\{AppData.queue.length} file(s)";
                            font-size: 11px;
                            color: #71717a;
                        }
                    }

                    // Queue Container Box (Surrounds file list AND Add Files/Clear List buttons)
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 8px;
                        background: #141417;
                        border-width: 1px;
                        border-color: #2a2a30;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 8px;

                            // Empty State if no files
                            if AppData.queue.length == 0 : VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: "No files in queue";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #a1a1aa;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Drag & drop media files here, or click '+ Add Files'";
                                    font-size: 11px;
                                    color: #71717a;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            // Scrollable File List
                            if AppData.queue.length > 0 : ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 4px;

                                    for file[idx] in AppData.queue : Rectangle {
                                        height: 38px;
                                        border-radius: 5px;
                                        background: AppData.selected_file_index == idx ? #222227 : (card_ta.has-hover ? #1e1e24 : #141418);
                                        border-width: 1px;
                                        border-color: AppData.selected_file_index == idx ? #38bdf8 : (card_ta.has-hover ? #383840 : #18181c);
                                        clip: true;

                                        animate background { duration: 150ms; }
                                        animate border-color { duration: 150ms; }

                                        card_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppLogic.select_file(idx); }
                                        }

                                        // Selection Accent Bar on left edge
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            width: 3px;
                                            height: 100%;
                                            background: AppData.selected_file_index == idx ? #38bdf8 : #2a2a30;
                                        }

                                        // Bottom inline encoding progress bar
                                        if file.progress > 0.0 && file.progress < 1.0 : Rectangle {
                                            x: 3px;
                                            y: parent.height - 2px;
                                            width: max(4px, (parent.width - 3px) * file.progress);
                                            height: 2px;
                                            background: @linear-gradient(90deg, #0284c7 0%, #38bdf8 50%, #10b981 100%);
                                        }

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 6px;
                                            padding-top: 3px;
                                            padding-bottom: 3px;
                                            spacing: 6px;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 1px;
                                                alignment: center;

                                                // Row 1: File Name
                                                Text {
                                                    text: file.file_name;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    color: AppData.selected_file_index == idx ? #38bdf8 : #f4f4f5;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }

                                                // Row 2: File Path
                                                Text {
                                                    text: file.file_path;
                                                    font-size: 9.5px;
                                                    color: AppData.selected_file_index == idx ? #a1a1aa : #71717a;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }
                                            }

                                            // Remove Item Button
                                            VerticalLayout {
                                                alignment: center;
                                                IconButton {
                                                    icon_source: @image-url("../icons/x.svg");
                                                    has_icon: true;
                                                    icon_size: 10px;
                                                    btn_width: 20px;
                                                    btn_height: 20px;
                                                    hover_bg: #ef444433;
                                                    clicked => { AppLogic.remove_file(idx); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Bottom Queue Actions: Add Files & Clear List (inside queue container box)
                            HorizontalLayout {
                                spacing: 6px;
                                height: 30px;

                                ActionButton {
                                    min-width: 0px;
                                    horizontal-stretch: 13;
                                    height: 30px;
                                    title: "Add Files";
                                    icon_source: @image-url("../icons/plus.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    fill_color: #0284c7;
                                    hover_color: #0369a1;
                                    font_size: 11.5px;
                                    clicked => { AppLogic.add_files(); }
                                }

                                ActionButton {
                                    min-width: 0px;
                                    horizontal-stretch: 10;
                                    height: 30px;
                                    title: "Clear List";
                                    icon_source: @image-url("../icons/trash.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    fill_color: #1c1c22;
                                    hover_color: #2a2a32;
                                    text_color: #a1a1aa;
                                    font_size: 11px;
                                    is_disabled: AppData.queue.length == 0;
                                    clicked => { AppLogic.clear_queue(); }
                                }
                            }
                        }
                    }

                    // SELECTED ITEM METADATA BOX (Displayed when an item on the queue list is selected)
                    if AppData.selected_file_index >= 0 && AppData.selected_file_index < AppData.queue.length : Rectangle {
                        height: 112px;
                        border-radius: 8px;
                        background: #141417;
                        border-width: 1px;
                        border-color: #38bdf866;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            alignment: start;

                            // Header Row: Media Type Badge + Section Title + Status
                            HorizontalLayout {
                                height: 18px;
                                spacing: 6px;

                                VerticalLayout {
                                    alignment: center;
                                    Badge {
                                        label: AppData.queue[AppData.selected_file_index].is_video ? "VIDEO" : "AUDIO";
                                        bg_color: AppData.queue[AppData.selected_file_index].is_video ? #0369a1 : #6d28d9;
                                        fg_color: #ffffff;
                                        height: 16px;
                                    }
                                }

                                Text {
                                    text: "Selected Item Metadata";
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    color: #d4d4d8;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Text {
                                    text: AppData.queue[AppData.selected_file_index].status;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: AppData.queue[AppData.selected_file_index].status == "Completed" ? #34d399 : (AppData.queue[AppData.selected_file_index].status == "Probing..." ? #818cf8 : (AppData.queue[AppData.selected_file_index].status == "Ready" ? #38bdf8 : (AppData.queue[AppData.selected_file_index].progress > 0.0 && AppData.queue[AppData.selected_file_index].progress < 1.0 ? #fbbf24 : #f87171)));
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            Rectangle { height: 1px; background: #1c1c22; }

                            // Row 1: Resolution, Duration, File Size
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: center;
                                    Text {
                                        text: "Resolution";
                                        font-size: 9.5px;
                                        color: #71717a;
                                    }
                                    Text {
                                        text: AppData.queue[AppData.selected_file_index].resolution;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #38bdf8;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: center;
                                    Text {
                                        text: "Duration";
                                        font-size: 9.5px;
                                        color: #71717a;
                                    }
                                    Text {
                                        text: AppData.queue[AppData.selected_file_index].duration;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #f4f4f5;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: center;
                                    Text {
                                        text: "File Size";
                                        font-size: 9.5px;
                                        color: #71717a;
                                    }
                                    Text {
                                        text: AppData.queue[AppData.selected_file_index].file_size_formatted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #d4d4d8;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Row 2: Codecs
                            VerticalLayout {
                                height: 30px;
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: "Codecs";
                                    font-size: 9.5px;
                                    color: #71717a;
                                }
                                Text {
                                    text: AppData.queue[AppData.selected_file_index].codecs;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #a78bfa;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // RUN TASK Button: Under the queue box, aligned with queue list column
                    HorizontalLayout {
                        alignment: center;
                        height: 34px;

                        if !AppData.is_processing : ActionButton {
                            width: 160px;
                            height: 34px;
                            title: "RUN TASK";
                            icon_source: @image-url("../icons/play.svg");
                            has_icon: true;
                            icon_size: 13px;
                            fill_color: AppData.queue.length == 0 ? #2a2a30 : #10b981;
                            hover_color: AppData.queue.length == 0 ? #2a2a30 : #059669;
                            text_color: AppData.queue.length == 0 ? #71717a : #ffffff;
                            is_disabled: AppData.queue.length == 0;
                            font_size: 12px;
                            clicked => { AppLogic.run_task(); }
                        }

                        if AppData.is_processing : ActionButton {
                            width: 160px;
                            height: 34px;
                            title: "STOP / CANCEL";
                            icon_source: @image-url("../icons/stop.svg");
                            has_icon: true;
                            icon_size: 13px;
                            fill_color: #ef4444;
                            hover_color: #dc2626;
                            font_size: 12px;
                            clicked => { AppLogic.cancel_processing(); }
                        }
                    }
                }
            }
