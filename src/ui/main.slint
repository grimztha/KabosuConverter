import { Button, CheckBox, ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";

export struct QueueFile {
    id: int,
    file_name: string,
    file_path: string,
    file_size_formatted: string,
    resolution: string,
    duration: string,
    codecs: string,
    status: string,
    progress: float,
    duration_seconds: float,
    is_video: bool,
    is_audio: bool,
    video_width: int,
    video_height: int,
}

export global AppData {
    in-out property <[QueueFile]> queue;
    in-out property <int> selected_file_index: -1;
    in-out property <bool> is_processing: false;
    in-out property <float> progress_percent: 0.0;
    in-out property <string> progress_text: "Ready";
    in-out property <string> speed_text: "0.0x";
    in-out property <string> fps_text: "0 fps";
    in-out property <string> time_text: "00:00 / 00:00";
    in-out property <string> status_summary: "No files loaded";
    in-out property <string> output_directory: "Same as source";
    in-out property <string> log_preview: "";
    in-out property <bool> show_logs: false;

    // Navigation tab: 0 = Player & Trimmer, 1 = Downloader, 2 = Transcoder Settings
    in-out property <int> active_tab: 0;

    // yt-dlp Web Downloader state
    in-out property <string> ytdlp_url: "";
    in-out property <bool> ytdlp_is_discovering: false;
    in-out property <bool> ytdlp_has_discovered: false;
    in-out property <string> ytdlp_title: "";
    in-out property <string> ytdlp_uploader: "";
    in-out property <string> ytdlp_duration: "";
    in-out property <string> ytdlp_discovered_id: "";
    in-out property <string> ytdlp_webpage_url: "";
    in-out property <string> ytdlp_custom_filename: "";
    in-out property <[string]> ytdlp_format_options: [
        "[Video] Best Quality (Auto Best Video + Best Audio, Recommended)",
        "[Video] 4K UHD 2160p (Best Video <= 2160p + Best Audio)",
        "[Video] 1440p QHD (Best Video <= 1440p + Best Audio)",
        "[Video] 1080p Full HD (Best Video <= 1080p + Best Audio)",
        "[Video] 720p HD (Best Video <= 720p + Best Audio)",
        "[Video] 480p SD (Fast / Mobile Compact)",
        "[Audio] MP3 (High Quality 320 kbps)",
        "[Audio] M4A / AAC (Best Source Audio)",
        "[Audio] FLAC (Lossless Audio)",
        "[Audio] WAV (Lossless PCM)"
    ];
    in-out property <int> ytdlp_selected_format_index: 0;
    in-out property <string> ytdlp_output_dir: "";
    in-out property <bool> ytdlp_is_downloading: false;
    in-out property <float> ytdlp_progress: 0.0;
    in-out property <string> ytdlp_progress_text: "0.0%";
    in-out property <string> ytdlp_speed_text: "0.0 MiB/s";
    in-out property <string> ytdlp_eta_text: "--:--";
    in-out property <string> ytdlp_size_text: "-- / --";
    in-out property <string> ytdlp_status_message: "Ready. Paste video or stream URL to discover formats.";
    in-out property <string> ytdlp_error_message: "";
    in-out property <bool> ytdlp_has_error: false;
    in-out property <string> ytdlp_last_downloaded_file: "";
    in-out property <bool> ytdlp_download_finished: false;

    // Player and Media Preview state
    in-out property <bool> player_has_media: false;
    in-out property <string> selected_file_name: "";
    in-out property <string> selected_file_path: "";
    in-out property <bool> selected_is_video: false;
    in-out property <bool> selected_is_audio: false;
    in-out property <string> selected_resolution: "";
    in-out property <string> selected_audio_desc: "";
    in-out property <float> player_duration: 0.0;
    in-out property <float> player_current_time: 0.0;
    in-out property <string> player_time_text: "00:00.000";
    in-out property <string> player_duration_text: "00:00.000";
    in-out property <bool> player_is_playing: false;
    in-out property <float> player_volume: 1.0;
    in-out property <bool> player_is_muted: false;
    in-out property <float> player_pre_mute_volume: 1.0;
    in-out property <image> preview_frame;
    in-out property <bool> preview_frame_loading: false;
    in-out property <image> timeline_waveform;
    in-out property <bool> has_waveform: false;
    in-out property <float> timeline_zoom: 1.0;
    in-out property <int> center_timeline_trigger: 0;

    // Trimming In / Out state
    in-out property <float> in_point_seconds: -1.0;
    in-out property <float> out_point_seconds: -1.0;
    in-out property <float> in_point_normalized: 0.0;
    in-out property <float> out_point_normalized: 1.0;
    in-out property <bool> has_active_trim: false;
    in-out property <string> trim_duration_text: "Full Media";
    in-out property <string> in_point: "";
    in-out property <string> out_point: "";

    // Controls state
    in-out property <int> function_index: 0;
    in-out property <int> hw_accel_index: 0;
    in-out property <int> rate_control_index: 0;
    in-out property <float> crf_value: 23.0;
    in-out property <int> video_bitrate_index: 2; // 6000 kbps
    in-out property <int> preset_index: 3; // medium
    in-out property <int> resolution_index: 0; // original
    in-out property <int> fps_index: 0; // original
    in-out property <int> deinterlace_index: 0; // none
    in-out property <int> prores_profile_index: 2; // standard
    in-out property <bool> faststart: true;

    in-out property <int> audio_codec_index: 0; // AAC
    in-out property <int> audio_bitrate_index: 2; // 192k
    in-out property <int> audio_channels_index: 0; // keep
    in-out property <int> audio_sample_rate_index: 0; // keep
    in-out property <int> normalize_index: 0; // disabled

    in-out property <int> container_index: 0; // mp4

    // Video Editing & Transform Panel state
    in-out property <bool> edit_panel_expanded: true;
    in-out property <int> selected_video_width: 1920;
    in-out property <int> selected_video_height: 1080;
    in-out property <int> effective_video_width: 1920;
    in-out property <int> effective_video_height: 1080;

    // Active video viewport inside the 640x360 preview image (normalized 0..1)
    in-out property <float> preview_video_norm_x: 0.0;
    in-out property <float> preview_video_norm_y: 0.0;
    in-out property <float> preview_video_norm_w: 1.0;
    in-out property <float> preview_video_norm_h: 1.0;

    // Rotation & Mirror Flip state
    // 0 = 0 deg, 1 = 90 deg, 2 = -90 deg, 3 = 180 deg
    in-out property <int> video_rotation_index: 0;
    in-out property <bool> video_flip_horizontal: false;
    in-out property <bool> video_flip_vertical: false;

    // Crop state
    in-out property <bool> crop_enabled: false;
    // 0 = Free, 1 = 16:9, 2 = 9:16, 3 = 4:3, 4 = 3:4, 5 = 1:1, 6 = 2:3, 7 = 3:2, 8 = 21:9, 9 = 4:5
    in-out property <int> crop_aspect_index: 0;
    in-out property <[string]> crop_aspect_options: [
        "Free (Unlocked)",
        "16:9 — Widescreen (HD / 4K / YouTube)",
        "9:16 — Vertical (Shorts / Reels / TikTok)",
        "4:3 — Standard Broadcast / Classic",
        "3:4 — Portrait Standard",
        "1:1 — Square (Social / Feed)",
        "2:3 — Classic Portrait / Photo",
        "3:2 — 35mm Film / Landscape",
        "21:9 — Ultrawide Cinema",
        "4:5 — Social Portrait"
    ];
    in-out property <int> crop_x: 0;
    in-out property <int> crop_y: 0;
    in-out property <int> crop_width: 1920;
    in-out property <int> crop_height: 1080;
    in-out property <string> crop_width_text: "1920";
    in-out property <string> crop_height_text: "1080";
    in-out property <string> crop_x_text: "0";
    in-out property <string> crop_y_text: "0";

    // Normalized crop box within the active video viewport (0..1)
    in-out property <float> crop_norm_x: 0.0;
    in-out property <float> crop_norm_y: 0.0;
    in-out property <float> crop_norm_w: 1.0;
    in-out property <float> crop_norm_h: 1.0;

    // Arrow keys movement option
    in-out property <bool> crop_arrow_keys_enabled: true;
    in-out property <int> crop_nudge_step: 10;
    in-out property <bool> has_active_video_edits: false;

    // Audio Editing & Adjustment state
    in-out property <float> audio_gain_db: 0.0;
    in-out property <string> audio_gain_text: "0.0 dB";
    in-out property <bool> audio_normalize_enabled: false;
    in-out property <float> audio_normalize_lufs: -16.0;
    in-out property <int> audio_normalize_preset_index: 0;
    in-out property <bool> has_active_audio_edits: false;
}

export global AppLogic {
    callback add_files();
    callback remove_file(int);
    callback select_file(int);
    callback clear_queue();
    callback select_output_dir();
    callback open_output_dir();
    callback run_task();
    callback start_processing();
    callback cancel_processing();
    callback toggle_logs();
    callback switch_tab(int);
    callback quick_lossless_cut();

    // Player and Trim callbacks
    callback player_seek(float);
    callback player_play_pause();
    callback player_stop();
    callback player_step(float);
    callback player_volume_changed(float);
    callback player_toggle_mute();
    callback set_in_point_current();
    callback set_out_point_current();
    callback jump_to_in_point();
    callback jump_to_out_point();
    callback clear_trim_points();
    callback play_trimmed_range();
    callback launch_ffplay();
    callback in_point_text_changed(string);
    callback out_point_text_changed(string);
    callback set_in_point_from_timeline(float);
    callback set_out_point_from_timeline(float);

    // Video Editing (Rotate, Flip, Crop) Callbacks
    callback toggle_edit_panel();
    callback set_video_rotation(int);
    callback toggle_flip_horizontal();
    callback toggle_flip_vertical();
    callback toggle_crop_enabled();
    callback set_crop_aspect_preset(int);
    callback crop_width_edited(string);
    callback crop_height_edited(string);
    callback crop_x_edited(string);
    callback crop_y_edited(string);
    callback crop_box_drag_start();
    callback crop_box_drag_move(float, float);
    callback crop_handle_drag(int, float, float);
    callback crop_nudge(int, int);
    callback center_crop_box();
    callback reset_crop();
    callback reset_all_video_edits();
    callback reset_all_edits();

    // Audio Editing (Volume dB, Normalization) Callbacks
    callback set_audio_gain_db(float);
    callback step_audio_gain_db(float);
    callback toggle_audio_normalize();
    callback set_audio_normalize_preset(int);
    callback reset_audio_edits();

    // yt-dlp Web Downloader Callbacks
    callback ytdlp_url_changed(string);
    callback ytdlp_paste_clipboard();
    callback ytdlp_clear_url();
    callback ytdlp_discover();
    callback ytdlp_select_output_dir();
    callback ytdlp_open_output_dir();
    callback ytdlp_start_download();
    callback ytdlp_cancel_download();
    callback ytdlp_load_in_player();
    callback ytdlp_send_to_queue();
}

component IconButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon_source;
    in property <bool> has_icon: false;
    in property <length> icon_size: 14px;
    in property <color> text_color: #a1a1aa;
    in property <color> hover_bg: #26262e;
    in property <length> btn_width: 28px;
    in property <length> btn_height: 28px;
    in property <length> font_size: 13px;
    callback clicked();

    width: root.btn_width;
    height: root.btn_height;
    border-radius: 6px;
    background: ta.has-hover ? hover_bg : #00000000;

    animate background { duration: 150ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-left: 3px;
        padding-right: 3px;

        if root.has_icon : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon_source;
                width: root.icon_size;
                height: root.icon_size;
                colorize: ta.has-hover ? #f4f4f5 : root.text_color;
            }
        }

        if root.text != "" : VerticalLayout {
            alignment: center;
            Text {
                text: root.text;
                color: ta.has-hover ? #f4f4f5 : root.text_color;
                font-size: root.font_size;
                font-weight: 600;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Badge inherits Rectangle {
    in property <string> label: "";
    in property <color> bg_color: #1c1c22;
    in property <color> fg_color: #a1a1aa;

    height: 22px;
    border-radius: 4px;
    background: bg_color;
    border-width: 1px;
    border-color: bg_color.brighter(0.3);

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-size: 11px;
                color: root.fg_color;
                font-weight: 500;
            }
        }
    }
}

// Compact numeric/text input with zero min-width constraint
component NumInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    callback edited(string);
    callback accepted();

    height: 26px;
    border-radius: 5px;
    background: #141418;
    border-width: 1px;
    border-color: ti.has-focus ? #38bdf8 : #2a2a30;

    ti := TextInput {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        vertical-alignment: center;
        text <=> root.text;
        font-size: 11px;
        color: #f4f4f5;
        selection-background-color: #0284c7;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }

    if root.text == "" && !ti.has-focus : Text {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        vertical-alignment: center;
        text: root.placeholder;
        font-size: 11px;
        color: #71717a;
    }
}

struct WorkflowOption {
    group: string,
    label: string,
}

component WorkflowDropdown inherits Rectangle {
    in-out property <int> current-index: 0;
    callback selected(int);

    property <[WorkflowOption]> options: [
        { group: "[Video]", label: "H.264 (AVC) — Universal Web & Playback" },
        { group: "[Video]", label: "H.265 (HEVC) — High Efficiency Video" },
        { group: "[Video]", label: "AV1 — Next-Gen Open Video Codec" },
        { group: "[Video]", label: "Apple ProRes — Professional Editing Intermediate" },
        { group: "[Video]", label: "Avid DNxHD / DNxHR — Broadcast & NLE Intermediate" },
        { group: "[Video]", label: "VP9 — Open Web Video Codec" },
        { group: "[Remux]", label: "Rewrap / Remux — Instant Container Change (No Re-encode)" },
        { group: "[Remux]", label: "Lossless Cut — Fast Trim Without Re-encoding" },
        { group: "[Remux]", label: "Extract Video Track (Drop Audio/Subs)" },
        { group: "[Audio]", label: "Extract Audio Track (Lossless / AAC / MP3)" },
        { group: "[Audio]", label: "Audio Normalization (EBU R128 / LUFS)" },
        { group: "[Audio]", label: "Audio Conversion (AAC / MP3 / FLAC / WAV)" },
        { group: "[Subtitle]", label: "Extract Subtitle Stream (SRT / VTT / ASS)" }
    ];

    pure function get_color(idx: int) -> color {
        idx <= 5 ? #38bdf8 : (idx <= 8 ? #34d399 : (idx <= 11 ? #a78bfa : #fbbf24))
    }

    property <int> safe_index: Math.max(0, Math.min(root.current-index, root.options.length - 1));
    property <string> current_group: root.options[root.safe_index].group;
    property <string> current_label: root.options[root.safe_index].label;
    property <color> current_color: root.get_color(root.safe_index);

    height: 26px;
    border-radius: 4px;
    background: ta.has-hover ? #1c1c22 : #141418;
    border-width: 1px;
    border-color: ta.has-hover ? #38bdf8.with-alpha(0.6) : #2a2a30;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        // Group name text (Colorized!)
        VerticalLayout {
            alignment: center;
            Text {
                text: root.current_group;
                font-size: 11px;
                font-weight: 700;
                color: root.current_color;
            }
        }

        // Item label text
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.current_label;
                font-size: 11px;
                font-weight: 500;
                color: #f4f4f5;
                overflow: elide;
            }
        }

        // Dropdown Chevron Icon
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/chevron-down.svg");
                width: 10px;
                height: 10px;
                colorize: ta.has-hover ? #f4f4f5 : #a1a1aa;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 3px;
        width: root.width;
        height: 330px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 6px;
            background: #141418;
            border-width: 1px;
            border-color: #2a2a32;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #000000aa;
            clip: true;

            ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    alignment: start;

                    for opt[idx] in root.options : Rectangle {
                        height: 25px;
                        border-radius: 4px;
                        background: idx == root.safe_index ? #27272a : (item_ta.has-hover ? #1f1f24 : #00000000);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            // Group name text in dropdown menu (Colorized!)
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: opt.group;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    color: root.get_color(idx);
                                }
                            }

                            // Item label text
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: opt.label;
                                    font-size: 10.5px;
                                    font-weight: idx == root.safe_index ? 600 : 400;
                                    color: idx == root.safe_index ? #ffffff : (item_ta.has-hover ? #f4f4f5 : #d4d4d8);
                                    overflow: elide;
                                }
                            }

                            // Active checkmark
                            if idx == root.safe_index : VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/check.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: root.get_color(idx);
                                }
                            }
                        }

                        item_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current-index = idx;
                                root.selected(idx);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

component DownloaderFormatDropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(int);

    pure function get_tag(s: string) -> string {
        s.starts-with("[Audio]") ? "[Audio]" : (s.starts-with("[Video]") ? "[Video]" : "")
    }

    pure function get_tag_color(s: string) -> color {
        s.starts-with("[Audio]") ? #a78bfa : (s.starts-with("[Video]") ? #38bdf8 : #f4f4f5)
    }

    pure function get_label(s: string) -> string {
        s.starts-with("[Audio] ") ? s.replace-all("[Audio] ", "") : (s.starts-with("[Video] ") ? s.replace-all("[Video] ", "") : (s.starts-with("[Audio]") ? s.replace-all("[Audio]", "") : (s.starts-with("[Video]") ? s.replace-all("[Video]", "") : s)))
    }

    property <int> safe_index: Math.max(0, Math.min(root.current-index, root.model.length - 1));
    property <string> current_raw: root.model.length > 0 ? root.model[root.safe_index] : "";
    property <string> current_tag: root.get_tag(root.current_raw);
    property <string> current_label: root.get_label(root.current_raw);
    property <color> current_color: root.get_tag_color(root.current_raw);

    height: 26px;
    border-radius: 4px;
    background: ta.has-hover ? #1c1c22 : #141418;
    border-width: 1px;
    border-color: ta.has-hover ? #38bdf8.with-alpha(0.6) : #2a2a30;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        // Group name tag (Colorized: Blue for [Video], Purple for [Audio])
        if root.current_tag != "" : VerticalLayout {
            alignment: center;
            Text {
                text: root.current_tag;
                font-size: 11px;
                font-weight: 700;
                color: root.current_color;
            }
        }

        // Format label text
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.current_label;
                font-size: 11px;
                font-weight: 500;
                color: #f4f4f5;
                overflow: elide;
            }
        }

        // Dropdown Chevron Icon
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/chevron-down.svg");
                width: 10px;
                height: 10px;
                colorize: ta.has-hover ? #f4f4f5 : #a1a1aa;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 3px;
        width: root.width;
        height: 280px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 6px;
            background: #141418;
            border-width: 1px;
            border-color: #2a2a32;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #000000aa;
            clip: true;

            ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    alignment: start;

                    for opt[idx] in root.model : Rectangle {
                        height: 25px;
                        border-radius: 4px;
                        background: idx == root.safe_index ? #27272a : (item_ta.has-hover ? #1f1f24 : #00000000);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            // Group tag in dropdown list (Colorized: Blue for [Video], Purple for [Audio])
                            if root.get_tag(opt) != "" : VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.get_tag(opt);
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    color: root.get_tag_color(opt);
                                }
                            }

                            // Format description text
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.get_label(opt);
                                    font-size: 10.5px;
                                    font-weight: idx == root.safe_index ? 600 : 400;
                                    color: idx == root.safe_index ? #ffffff : (item_ta.has-hover ? #f4f4f5 : #d4d4d8);
                                    overflow: elide;
                                }
                            }

                            // Active checkmark
                            if idx == root.safe_index : VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/check.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: root.get_tag_color(opt);
                                }
                            }
                        }

                        item_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current-index = idx;
                                root.selected(idx);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> title: "Button";
    in property <image> icon_source;
    in property <bool> has_icon: false;
    in property <length> icon_size: 14px;
    in property <color> fill_color: #0284c7;
    in property <color> hover_color: #0369a1;
    in property <color> text_color: #ffffff;
    in property <length> font_size: 13px;
    in property <bool> is_disabled: false;
    callback clicked();

    height: 38px;
    border-radius: 8px;
    background: is_disabled ? #2a2a30 : (ta.has-hover ? hover_color : fill_color);

    animate background { duration: 150ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        padding-left: 6px;
        padding-right: 6px;

        if root.has_icon : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon_source;
                width: root.icon_size;
                height: root.icon_size;
                colorize: root.is_disabled ? #71717a : root.text_color;
            }
        }

        if root.title != "" : VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                color: root.is_disabled ? #71717a : root.text_color;
                font-size: root.font_size;
                font-weight: 600;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: is_disabled ? default : pointer;
        enabled: !is_disabled;
        clicked => { root.clicked(); }
    }
}

component VolumeBar inherits Rectangle {
    in-out property <float> volume: 1.0;
    in-out property <bool> is_muted: false;
    callback volume_changed(float);
    callback toggle_mute();

    height: 28px;
    border-radius: 6px;
    background: #1c1c22;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: center;

        // Mute / Unmute Button with Speaker Icon
        mute_box := Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            background: mute_ta.has-hover ? #2a2a30 : #00000000;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: root.is_muted || root.volume <= 0.01 ? @image-url("icons/volume-x.svg") : (root.volume > 0.5 ? @image-url("icons/volume-2.svg") : @image-url("icons/volume-1.svg"));
                colorize: root.is_muted || root.volume <= 0.01 ? #ef4444 : (mute_ta.has-hover ? #38bdf8 : #a1a1aa);
            }

            mute_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle_mute(); }
            }
        }

        // Interactive Volume Slider Bar Track
        slider_track := Rectangle {
            width: 60px;
            height: 18px;

            // Background Track
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 100%;
                height: 5px;
                border-radius: 2.5px;
                background: #2a2a30;

                // Filled Track (colored)
                Rectangle {
                    x: 0px;
                    y: 0px;
                    height: 100%;
                    width: root.is_muted || root.volume <= 0.0 ? 0px : min(parent.width, (parent.width - 12px) * root.volume.clamp(0.0, 1.0) + 6px);
                    border-radius: 2.5px;
                    background: root.is_muted ? #71717a : @linear-gradient(90deg, #0284c7 0%, #38bdf8 100%);
                }
            }

            // Draggable Knob / Thumb
            Rectangle {
                property <float> norm: root.is_muted ? 0.0 : root.volume.clamp(0.0, 1.0);
                x: max(0px, min(parent.width - 12px, (parent.width - 12px) * self.norm));
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.is_muted ? #a1a1aa : (slider_ta.has-hover || slider_ta.pressed ? #38bdf8 : #ffffff);
                border-width: 1.5px;
                border-color: root.is_muted ? #71717a : #0284c7;
            }

            slider_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if parent.width > 0px {
                        root.volume_changed((self.mouse-x / parent.width).clamp(0.0, 1.0));
                    }
                }
                moved => {
                    if self.pressed && parent.width > 0px {
                        root.volume_changed((self.mouse-x / parent.width).clamp(0.0, 1.0));
                    }
                }
                scroll-event(event) => {
                    if event.delta-y > 0px {
                        root.volume_changed((root.volume + 0.05).clamp(0.0, 1.0));
                        return accept;
                    }
                    if event.delta-y < 0px {
                        root.volume_changed((root.volume - 0.05).clamp(0.0, 1.0));
                        return accept;
                    }
                    reject
                }
            }
        }

        // Percentage Text Readout
        VerticalLayout {
            alignment: center;
            width: 32px;
            Text {
                text: root.is_muted ? "0%" : "\{Math.round(root.volume * 100)}%";
                font-size: 11px;
                font-weight: 700;
                color: root.is_muted ? #ef4444 : #a1a1aa;
                horizontal-alignment: right;
            }
        }
    }
}

component TimelineScrollBar inherits Rectangle {
    in property <length> track_width;
    in property <length> viewport_width;
    in property <float> zoom_level: 1.0;
    in property <length> content_x: 0px;
    in property <float> duration: 1.0;
    in property <float> current_time: 0.0;
    in property <bool> has_trim: false;
    in property <float> in_point_norm: 0.0;
    in property <float> out_point_norm: 1.0;
    callback scroll_to(length);

    height: 12px;
    background: #09090d;
    border-radius: 4px;
    border-width: 1px;
    border-color: #1c1c24;
    clip: true;

    property <length> max_scroll: max(0px, root.track_width - root.viewport_width);
    property <length> current_scroll: (-root.content_x).clamp(0px, self.max_scroll);
    property <float> scroll_ratio: self.max_scroll > 0px ? (self.current_scroll / self.max_scroll) : 0.0;
    property <length> thumb_w: root.width > 0px ? min(root.width, max(28px, root.width / max(1.0, root.zoom_level))) : 0px;
    property <length> max_travel: max(0px, root.width - self.thumb_w);
    property <length> thumb_x: self.max_travel * self.scroll_ratio;

    // Overview Minimap Elements on the Scrollbar Track:
    // Active Trim Region Indicator (amber highlight)
    if root.has_trim : Rectangle {
        x: max(0px, root.width * root.in_point_norm);
        width: max(2px, root.width * (root.out_point_norm - root.in_point_norm));
        height: 100%;
        background: #f59e0b33;
    }

    // Current Playhead Position Indicator (subtle vertical cyan needle)
    Rectangle {
        property <float> pnorm: root.duration > 0.0 ? (root.current_time / root.duration).clamp(0.0, 1.0) : 0.0;
        x: max(0px, min(root.width - 2px, (root.width - 2px) * self.pnorm));
        y: 1px;
        width: 2px;
        height: root.height - 2px;
        border-radius: 1px;
        background: #38bdf888;
    }

    // Draggable Thumb Handle representing the current viewport
    thumb := Rectangle {
        x: root.thumb_x;
        y: 1.5px;
        width: root.thumb_w;
        height: root.height - 3px;
        border-radius: 3px;
        background: sb_ta.pressed ? #38bdf8 : (sb_ta.has-hover ? #52525b : #383842);
        border-width: 1px;
        border-color: sb_ta.pressed ? #7dd3fc : (sb_ta.has-hover ? #71717a : #27272e);

        animate background, border-color { duration: 120ms; }

        // Center grip dots on the thumb when wide enough
        if root.thumb_w > 36px : HorizontalLayout {
            alignment: center;
            spacing: 3px;
            for i in 3 : Rectangle {
                width: 1.5px;
                height: 5px;
                border-radius: 0.5px;
                background: sb_ta.pressed ? #0369a1 : (sb_ta.has-hover ? #a1a1aa : #71717a);
            }
        }
    }

    sb_ta := TouchArea {
        mouse-cursor: pointer;
        property <length> drag_offset: 0px;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                if self.mouse-x >= root.thumb_x && self.mouse-x <= root.thumb_x + root.thumb_w {
                    self.drag_offset = self.mouse-x - root.thumb_x;
                } else {
                    self.drag_offset = root.thumb_w / 2;
                    if root.max_travel > 0px && root.max_scroll > 0px {
                        let target_x = (self.mouse-x - self.drag_offset).clamp(0px, root.max_travel);
                        let r = target_x / root.max_travel;
                        root.scroll_to(- (r * root.max_scroll));
                    }
                }
            }
        }

        moved => {
            if self.pressed && root.max_travel > 0px && root.max_scroll > 0px {
                let target_x = (self.mouse-x - self.drag_offset).clamp(0px, root.max_travel);
                let r = target_x / root.max_travel;
                root.scroll_to(- (r * root.max_scroll));
            }
        }

        scroll-event(event) => {
            if root.max_travel > 0px && root.max_scroll > 0px {
                let delta = event.delta-x != 0px ? event.delta-x : event.delta-y;
                if delta != 0px {
                    let new_val = (root.content_x + delta).clamp(-root.max_scroll, 0px);
                    root.scroll_to(new_val);
                    return accept;
                }
            }
            return reject;
        }
    }
}

component VisualTimeline inherits Rectangle {
    in property <float> duration: 1.0;
    in property <float> current_time: 0.0;
    in property <float> in_point_norm: 0.0;
    in property <float> out_point_norm: 1.0;
    in property <float> in_point_sec: -1.0;
    in property <float> out_point_sec: -1.0;
    in property <bool> has_trim: false;
    in-out property <float> zoom_level: AppData.timeline_zoom;
    in property <int> center_trigger: AppData.center_timeline_trigger;
    callback seek(float);
    callback in_point_dragged(float);
    callback out_point_dragged(float);

    changed center_trigger => {
        root.center_playhead();
    }

    changed zoom_level => {
        if sv.width > 0px {
            let tw = max(sv.width, sv.width * root.zoom_level);
            let max_s = max(0px, tw - sv.width);
            sv.content-x = sv.content-x.clamp(-max_s, 0px);
        }
    }

    public function zoom_in() {
        root.zoom_level = min(8.0, root.zoom_level + 0.5);
        AppData.timeline_zoom = root.zoom_level;
    }
    public function zoom_out() {
        root.zoom_level = max(1.0, root.zoom_level - 0.5);
        AppData.timeline_zoom = root.zoom_level;
    }
    public function set_zoom(val: float) {
        root.zoom_level = val.clamp(1.0, 8.0);
        AppData.timeline_zoom = root.zoom_level;
    }
    public function center_playhead() {
        if root.duration > 0.0 && sv.width > 0px {
            let norm = (root.current_time / root.duration).clamp(0.0, 1.0);
            let tw = max(sv.width, sv.width * root.zoom_level);
            sv.content-x = min(0px, max(sv.width - tw, (sv.width / 2) - (tw * norm)));
        }
    }

    height: root.zoom_level > 1.01 ? 87px : 68px;
    border-radius: 8px;
    background: #09090b;
    border-width: 1px;
    border-color: #2a2a30;
    clip: true;

    animate height { duration: 150ms; easing: ease-out; }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        sv := ScrollView {
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            vertical-stretch: 1;

            track := Rectangle {
                width: max(parent.width, parent.width * root.zoom_level);
                height: 100%;
                background: #09090b;

            // Subtle center horizontal baseline
            Rectangle {
                y: track.height * 0.5 - 0.5px;
                width: 100%;
                height: 1px;
                background: #22222788;
            }

            // Audio Waveform Visualization Layer
            if AppData.has_waveform : Image {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                source: AppData.timeline_waveform;
                image-fit: fill;
                opacity: 0.9;
            }

            // Timeline Track Background with subtle tick guides (ambient when no audio waveform)
            if !AppData.has_waveform : HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;
                for i in 12 : Rectangle {
                    width: 1px;
                    height: 12px;
                    background: #2a2a30;
                }
            }

            // Active Trim Region Highlight
            if root.has_trim : Rectangle {
                x: max(0px, track.width * root.in_point_norm);
                width: max(4px, track.width * (root.out_point_norm - root.in_point_norm));
                height: 100%;
                background: @linear-gradient(90deg, #d9770633 0%, #f59e0b55 50%, #d9770633 100%);
                border-width: 1px;
                border-color: #f59e0b88;

                // Left boundary edge line
                Rectangle {
                    x: 0px;
                    width: 2px;
                    height: 100%;
                    background: #f59e0b;
                }

                // Right boundary edge line
                Rectangle {
                    x: parent.width - 2px;
                    width: 2px;
                    height: 100%;
                    background: #f59e0b;
                }
            }

            // Interactive TouchArea over Visual Timeline Track for Scrubbing
            track_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if track.width > 0px && root.duration > 0.0 {
                        root.seek((self.mouse-x / track.width).clamp(0.0, 1.0) * root.duration);
                    }
                }
                moved => {
                    if self.pressed && track.width > 0px && root.duration > 0.0 {
                        root.seek((self.mouse-x / track.width).clamp(0.0, 1.0) * root.duration);
                    }
                }
                scroll-event(event) => {
                    if event.modifiers.control {
                        if event.delta_y > 0px {
                            root.zoom_in();
                        } else if event.delta_y < 0px {
                            root.zoom_out();
                        }
                        return accept;
                    } else if root.zoom_level > 1.01 && sv.width > 0px {
                        let tw = max(sv.width, sv.width * root.zoom_level);
                        let max_s = max(0px, tw - sv.width);
                        if max_s > 0px {
                            let delta = event.delta-x != 0px ? event.delta-x : event.delta-y;
                            sv.content-x = (sv.content-x + delta).clamp(-max_s, 0px);
                            return accept;
                        }
                    }
                    return reject;
                }
            }

            // Playhead Needle & Scrubber Cursor
            Rectangle {
                property <float> norm: root.duration > 0.0 ? (root.current_time / root.duration).clamp(0.0, 1.0) : 0.0;
                x: max(0px, min(track.width - 2px, (track.width - 2px) * self.norm));
                width: 2px;
                height: 100%;
                background: #38bdf8;

                // Playhead Knob Cap
                Rectangle {
                    x: -5px;
                    y: 0px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #38bdf8;
                    border-width: 2px;
                    border-color: #ffffff;
                }
            }

            // In-Point Flag Marker & Drag Handle
            Rectangle {
                property <float> norm: root.in_point_sec >= 0.0 ? root.in_point_norm : 0.0;
                x: max(0px, min(track.width - 32px, track.width * self.norm - (root.in_point_sec >= 0.0 ? 16px : 0px)));
                y: 2px;
                width: root.in_point_sec >= 0.0 ? 32px : 18px;
                height: 22px;
                border-radius: 3px;
                background: in_ta.has-hover || in_ta.pressed ? #fbbf24 : (root.in_point_sec >= 0.0 ? #f59e0b : #78350f88);
                border-width: 1px;
                border-color: root.in_point_sec >= 0.0 ? #ffffff : #f59e0b88;

                Text {
                    text: root.in_point_sec >= 0.0 ? "[ IN" : "[";
                    font-size: root.in_point_sec >= 0.0 ? 9.5px : 11px;
                    font-weight: 800;
                    color: root.in_point_sec >= 0.0 ? #000000 : #fbbf24;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                in_ta := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if self.pressed && track.width > 0px && root.duration > 0.0 {
                            root.in_point_dragged(((self.absolute-position.x + self.mouse-x - track.absolute-position.x) / track.width).clamp(0.0, 1.0) * root.duration);
                        }
                    }
                }
            }

            // Out-Point Flag Marker & Drag Handle
            Rectangle {
                property <float> norm: root.out_point_sec >= 0.0 ? root.out_point_norm : 1.0;
                x: max(0px, min(track.width - (root.out_point_sec >= 0.0 ? 36px : 18px), track.width * self.norm - (root.out_point_sec >= 0.0 ? 18px : 18px)));
                y: 2px;
                width: root.out_point_sec >= 0.0 ? 36px : 18px;
                height: 22px;
                border-radius: 3px;
                background: out_ta.has-hover || out_ta.pressed ? #fbbf24 : (root.out_point_sec >= 0.0 ? #f59e0b : #78350f88);
                border-width: 1px;
                border-color: root.out_point_sec >= 0.0 ? #ffffff : #f59e0b88;

                Text {
                    text: root.out_point_sec >= 0.0 ? "OUT ]" : "]";
                    font-size: root.out_point_sec >= 0.0 ? 9.5px : 11px;
                    font-weight: 800;
                    color: root.out_point_sec >= 0.0 ? #000000 : #fbbf24;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                out_ta := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if self.pressed && track.width > 0px && root.duration > 0.0 {
                            root.out_point_dragged(((self.absolute-position.x + self.mouse-x - track.absolute-position.x) / track.width).clamp(0.0, 1.0) * root.duration);
                        }
                    }
                }
            }
        }
    }

    if root.zoom_level > 1.01 : Rectangle {
            height: 1px;
            background: #1c1c22;
        }

        if root.zoom_level > 1.01 : HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 3px;
            padding-bottom: 3px;

            TimelineScrollBar {
                height: 12px;
                track_width: track.width;
                viewport_width: sv.width;
                zoom_level: root.zoom_level;
                content_x: sv.content-x;
                duration: root.duration;
                current_time: root.current_time;
                has_trim: root.has_trim;
                in_point_norm: root.in_point_norm;
                out_point_norm: root.out_point_norm;
                scroll_to(val) => {
                    sv.content-x = val;
                }
            }
        }
    }
}

component AudioWaveformStudio inherits Rectangle {
    in property <float> duration: 1.0;
    in property <float> current_time: 0.0;
    in property <float> in_point_norm: 0.0;
    in property <float> out_point_norm: 1.0;
    in property <float> in_point_sec: -1.0;
    in property <float> out_point_sec: -1.0;
    in property <bool> has_trim: false;
    in-out property <float> zoom_level: AppData.timeline_zoom;
    in property <int> center_trigger: AppData.center_timeline_trigger;
    callback seek(float);
    callback in_point_dragged(float);
    callback out_point_dragged(float);

    changed center_trigger => {
        root.center_playhead();
    }

    changed zoom_level => {
        if sv.width > 0px {
            let tw = max(sv.width, sv.width * root.zoom_level);
            let max_s = max(0px, tw - sv.width);
            sv.content-x = sv.content-x.clamp(-max_s, 0px);
        }
    }

    public function zoom_in() {
        root.zoom_level = min(8.0, root.zoom_level + 0.5);
        AppData.timeline_zoom = root.zoom_level;
    }
    public function zoom_out() {
        root.zoom_level = max(1.0, root.zoom_level - 0.5);
        AppData.timeline_zoom = root.zoom_level;
    }
    public function set_zoom(val: float) {
        root.zoom_level = val.clamp(1.0, 8.0);
        AppData.timeline_zoom = root.zoom_level;
    }

    public function center_playhead() {
        if root.duration > 0.0 && sv.width > 0px {
            let norm = (root.current_time / root.duration).clamp(0.0, 1.0);
            let tw = max(sv.width, sv.width * root.zoom_level);
            sv.content-x = min(0px, max(sv.width - tw, (sv.width / 2) - (tw * norm)));
        }
    }

    border-radius: 8px;
    background: #09090b;
    border-width: 1px;
    border-color: #1c1c22;
    clip: true;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // Center Waveform Track & Scale Layout
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // Left Amplitude Scale & Channel Guide
            Rectangle {
                width: 38px;
                background: #09090b;
                border-radius: 4px;
                border-width: 1px;
                border-color: #1c1c22;
                
                VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    padding-left: 2px;
                    padding-right: 2px;
                    alignment: space-between;

                    // Channel 1 / Left Top
                    Text { text: "L / CH1"; font-size: 8px; font-weight: 800; color: #38bdf8; horizontal-alignment: center; }
                    Text { text: "0 dB"; font-size: 7.5px; font-weight: 600; color: #71717a; horizontal-alignment: center; }
                    Text { text: "-6 dB"; font-size: 7.5px; font-weight: 600; color: #383840; horizontal-alignment: center; }

                    // Center 0.0 Baseline
                    Rectangle {
                        height: 12px;
                        border-radius: 2px;
                        background: #1c1c22;
                        Text { text: "0.0"; font-size: 7.5px; font-weight: 800; color: #a1a1aa; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // Channel 2 / Right Bottom
                    Text { text: "-6 dB"; font-size: 7.5px; font-weight: 600; color: #383840; horizontal-alignment: center; }
                    Text { text: "0 dB"; font-size: 7.5px; font-weight: 600; color: #71717a; horizontal-alignment: center; }
                    Text { text: "R / CH2"; font-size: 8px; font-weight: 800; color: #c084fc; horizontal-alignment: center; }
                }
            }

            Rectangle { width: 4px; }

            // Scrollable High-Detail Waveform Viewport
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                background: #09090b;
                border-width: 1px;
                border-color: #1c1c22;
                clip: true;

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    sv := ScrollView {
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        vertical-stretch: 1;

                        track := Rectangle {
                            width: max(parent.width, parent.width * root.zoom_level);
                            height: 100%;
                            background: #09090b;

                        // Grid lines
                        // Top 25% dB guide
                        Rectangle {
                            y: track.height * 0.25;
                            width: 100%;
                            height: 1px;
                            background: #22222766;
                        }

                        // Center 50% Divider line
                        Rectangle {
                            y: track.height * 0.5 - 0.5px;
                            width: 100%;
                            height: 1px;
                            background: #2a2a30;
                        }

                        // Bottom 75% dB guide
                        Rectangle {
                            y: track.height * 0.75;
                            width: 100%;
                            height: 1px;
                            background: #22222766;
                        }

                        // Ambient vertical time tick lines across the track
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            alignment: space-between;
                            for i in 24 : Rectangle {
                                width: 1px;
                                height: 100%;
                                background: #1c1c22;
                            }
                        }

                        // Detailed Stereo Waveform Image
                        if AppData.has_waveform : Image {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            source: AppData.timeline_waveform;
                            image-fit: fill;
                            opacity: 0.92;
                        }

                        // Active Trim Region Highlight
                        if root.has_trim : Rectangle {
                            x: max(0px, track.width * root.in_point_norm);
                            width: max(4px, track.width * (root.out_point_norm - root.in_point_norm));
                            height: 100%;
                            background: @linear-gradient(90deg, #d9770633 0%, #f59e0b55 50%, #d9770633 100%);
                            border-width: 1px;
                            border-color: #f59e0b88;

                            // Left boundary edge line
                            Rectangle {
                                x: 0px;
                                width: 2px;
                                height: 100%;
                                background: #f59e0b;
                            }

                            // Right boundary edge line
                            Rectangle {
                                x: parent.width - 2px;
                                width: 2px;
                                height: 100%;
                                background: #f59e0b;
                            }
                        }

                        // Interactive TouchArea over Visual Timeline Track for Scrubbing
                        track_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if track.width > 0px && root.duration > 0.0 {
                                    root.seek((self.mouse-x / track.width).clamp(0.0, 1.0) * root.duration);
                                }
                            }
                            moved => {
                                if self.pressed && track.width > 0px && root.duration > 0.0 {
                                    root.seek((self.mouse-x / track.width).clamp(0.0, 1.0) * root.duration);
                                }
                            }
                            scroll-event(event) => {
                                if event.modifiers.control {
                                    if event.delta_y > 0px {
                                        AppData.timeline_zoom = min(8.0, AppData.timeline_zoom + 0.5);
                                    } else if event.delta_y < 0px {
                                        AppData.timeline_zoom = max(1.0, AppData.timeline_zoom - 0.5);
                                    }
                                    return accept;
                                } else if root.zoom_level > 1.01 && sv.width > 0px {
                                    let tw = max(sv.width, sv.width * root.zoom_level);
                                    let max_s = max(0px, tw - sv.width);
                                    if max_s > 0px {
                                        let delta = event.delta-x != 0px ? event.delta-x : event.delta-y;
                                        sv.content-x = (sv.content-x + delta).clamp(-max_s, 0px);
                                        return accept;
                                    }
                                }
                                return reject;
                            }
                        }

                        // Playhead Needle & Floating Badge
                        Rectangle {
                            property <float> norm: root.duration > 0.0 ? (root.current_time / root.duration).clamp(0.0, 1.0) : 0.0;
                            x: max(0px, min(track.width - 2px, (track.width - 2px) * self.norm));
                            width: 2px;
                            height: 100%;
                            background: #38bdf8;

                            // Glowing playhead knob
                            Rectangle {
                                x: -6px;
                                y: 0px;
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: #38bdf8;
                                border-width: 2px;
                                border-color: #ffffff;
                            }

                            // Floating time bubble badge
                            Rectangle {
                                x: -30px;
                                y: 16px;
                                width: 62px;
                                height: 18px;
                                border-radius: 4px;
                                background: #000000dd;
                                border-width: 1px;
                                border-color: #38bdf8aa;
                                Text {
                                    text: AppData.player_time_text;
                                    font-size: 9.5px;
                                    font-weight: 800;
                                    color: #38bdf8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Large In-Point Flag Marker & Drag Handle
                        Rectangle {
                            property <float> norm: root.in_point_sec >= 0.0 ? root.in_point_norm : 0.0;
                            x: max(0px, min(track.width - 46px, track.width * self.norm - (root.in_point_sec >= 0.0 ? 23px : 0px)));
                            y: 2px;
                            width: root.in_point_sec >= 0.0 ? 46px : 24px;
                            height: 26px;
                            border-radius: 4px;
                            background: ain_ta.has-hover || ain_ta.pressed ? #fbbf24 : (root.in_point_sec >= 0.0 ? #f59e0b : #78350f88);
                            border-width: 1px;
                            border-color: root.in_point_sec >= 0.0 ? #ffffff : #f59e0b88;

                            Text {
                                text: root.in_point_sec >= 0.0 ? "[ IN" : "[";
                                font-size: root.in_point_sec >= 0.0 ? 11px : 13px;
                                font-weight: 800;
                                color: root.in_point_sec >= 0.0 ? #000000 : #fbbf24;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            ain_ta := TouchArea {
                                mouse-cursor: ew-resize;
                                moved => {
                                    if self.pressed && track.width > 0px && root.duration > 0.0 {
                                        root.in_point_dragged(((self.absolute-position.x + self.mouse-x - track.absolute-position.x) / track.width).clamp(0.0, 1.0) * root.duration);
                                    }
                                }
                            }
                        }

                        // Large Out-Point Flag Marker & Drag Handle
                        Rectangle {
                            property <float> norm: root.out_point_sec >= 0.0 ? root.out_point_norm : 1.0;
                            x: max(0px, min(track.width - (root.out_point_sec >= 0.0 ? 52px : 24px), track.width * self.norm - (root.out_point_sec >= 0.0 ? 26px : 24px)));
                            y: 2px;
                            width: root.out_point_sec >= 0.0 ? 52px : 24px;
                            height: 26px;
                            border-radius: 4px;
                            background: aout_ta.has-hover || aout_ta.pressed ? #fbbf24 : (root.out_point_sec >= 0.0 ? #f59e0b : #78350f88);
                            border-width: 1px;
                            border-color: root.out_point_sec >= 0.0 ? #ffffff : #f59e0b88;

                            Text {
                                text: root.out_point_sec >= 0.0 ? "OUT ]" : "]";
                                font-size: root.out_point_sec >= 0.0 ? 11px : 13px;
                                font-weight: 800;
                                color: root.out_point_sec >= 0.0 ? #000000 : #fbbf24;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            aout_ta := TouchArea {
                                mouse-cursor: ew-resize;
                                moved => {
                                    if self.pressed && track.width > 0px && root.duration > 0.0 {
                                        root.out_point_dragged(((self.absolute-position.x + self.mouse-x - track.absolute-position.x) / track.width).clamp(0.0, 1.0) * root.duration);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.zoom_level > 1.01 : Rectangle {
                    height: 1px;
                    background: #1c1c22;
                }

                if root.zoom_level > 1.01 : HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 3px;
                    padding-bottom: 3px;

                    TimelineScrollBar {
                        height: 12px;
                        track_width: track.width;
                        viewport_width: sv.width;
                        zoom_level: root.zoom_level;
                        content_x: sv.content-x;
                        duration: root.duration;
                        current_time: root.current_time;
                        has_trim: root.has_trim;
                        in_point_norm: root.in_point_norm;
                        out_point_norm: root.out_point_norm;
                        scroll_to(val) => {
                            sv.content-x = val;
                        }
                    }
                }
            }
        }
    }
}
}

component CropOverlayView inherits Rectangle {
    in property <float> norm_x: 0.0;
    in property <float> norm_y: 0.0;
    in property <float> norm_w: 1.0;
    in property <float> norm_h: 1.0;
    in property <int> crop_px_w: 1920;
    in property <int> crop_px_h: 1080;
    in property <int> crop_px_x: 0;
    in property <int> crop_px_y: 0;
    callback focus_requested();

    property <length> box_x: root.width * root.norm_x.clamp(0.0, 1.0);
    property <length> box_y: root.height * root.norm_y.clamp(0.0, 1.0);
    property <length> box_w: max(16px, root.width * root.norm_w.clamp(0.02, 1.0));
    property <length> box_h: max(16px, root.height * root.norm_h.clamp(0.02, 1.0));

    // Top dark mask outside crop area
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: max(0px, root.box_y);
        background: #000000aa;
    }

    // Bottom dark mask outside crop area
    Rectangle {
        x: 0px;
        y: root.box_y + root.box_h;
        width: root.width;
        height: max(0px, root.height - (root.box_y + root.box_h));
        background: #000000aa;
    }

    // Left dark mask outside crop area
    Rectangle {
        x: 0px;
        y: root.box_y;
        width: max(0px, root.box_x);
        height: root.box_h;
        background: #000000aa;
    }

    // Right dark mask outside crop area
    Rectangle {
        x: root.box_x + root.box_w;
        y: root.box_y;
        width: max(0px, root.width - (root.box_x + root.box_w));
        height: root.box_h;
        background: #000000aa;
    }

    // Crop Box Frame
    crop_box := Rectangle {
        x: root.box_x;
        y: root.box_y;
        width: root.box_w;
        height: root.box_h;
        border-width: 2px;
        border-color: #38bdf8;
        background: #38bdf80a;

        // Rule of thirds vertical lines
        Rectangle {
            x: parent.width / 3;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: #ffffff44;
        }
        Rectangle {
            x: (parent.width * 2) / 3;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: #ffffff44;
        }

        // Rule of thirds horizontal lines
        Rectangle {
            x: 0px;
            y: parent.height / 3;
            width: parent.width;
            height: 1px;
            background: #ffffff44;
        }
        Rectangle {
            x: 0px;
            y: (parent.height * 2) / 3;
            width: parent.width;
            height: 1px;
            background: #ffffff44;
        }

        // Center Crosshair
        Rectangle {
            x: (parent.width - 12px) / 2;
            y: (parent.height - 1px) / 2;
            width: 12px;
            height: 1px;
            background: #38bdf8aa;
        }
        Rectangle {
            x: (parent.width - 1px) / 2;
            y: (parent.height - 12px) / 2;
            width: 1px;
            height: 12px;
            background: #38bdf8aa;
        }

        // Live Dimensions & Coordinates Readout Pill inside Crop Box
        if parent.width > 95px && parent.height > 32px : Rectangle {
            x: 6px;
            y: 6px;
            height: 20px;
            width: dim_txt.preferred-width + 12px;
            border-radius: 4px;
            background: #141418cc;
            border-width: 1px;
            border-color: #38bdf888;

            dim_txt := Text {
                x: 6px;
                y: (parent.height - self.height) / 2;
                text: "\{root.crop_px_w} × \{root.crop_px_h}  (\{root.crop_px_x}, \{root.crop_px_y})";
                font-size: 10px;
                font-weight: 700;
                color: #38bdf8;
            }
        }

        // Interior Drag TouchArea to move the crop box around
        move_ta := TouchArea {
            mouse-cursor: move;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    AppLogic.crop_box_drag_start();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_box_drag_move(
                        (self.mouse-x - self.pressed-x) / root.width,
                        (self.mouse-y - self.pressed-y) / root.height
                    );
                }
            }
        }
    }

    // 8 Resize Handles (0=TL, 1=TR, 2=BL, 3=BR, 4=Top, 5=Bottom, 6=Left, 7=Right)
    // Top-Left Corner (0)
    Rectangle {
        x: root.box_x - 6px;
        y: root.box_y - 6px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: tl_ta.has-hover || tl_ta.pressed ? #fbbf24 : #ffffff;
        border-width: 2px;
        border-color: #0284c7;
        tl_ta := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { root.focus_requested(); }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        0,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Top-Right Corner (1)
    Rectangle {
        x: root.box_x + root.box_w - 6px;
        y: root.box_y - 6px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: tr_ta.has-hover || tr_ta.pressed ? #fbbf24 : #ffffff;
        border-width: 2px;
        border-color: #0284c7;
        tr_ta := TouchArea {
            mouse-cursor: nesw-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { root.focus_requested(); }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        1,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Bottom-Left Corner (2)
    Rectangle {
        x: root.box_x - 6px;
        y: root.box_y + root.box_h - 6px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: bl_ta.has-hover || bl_ta.pressed ? #fbbf24 : #ffffff;
        border-width: 2px;
        border-color: #0284c7;
        bl_ta := TouchArea {
            mouse-cursor: nesw-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { root.focus_requested(); }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        2,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Bottom-Right Corner (3)
    Rectangle {
        x: root.box_x + root.box_w - 6px;
        y: root.box_y + root.box_h - 6px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: br_ta.has-hover || br_ta.pressed ? #fbbf24 : #ffffff;
        border-width: 2px;
        border-color: #0284c7;
        br_ta := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { root.focus_requested(); }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        3,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Top Edge (4)
    Rectangle {
        x: root.box_x + (root.box_w - 24px) / 2;
        y: root.box_y - 4px;
        width: 24px;
        height: 8px;
        border-radius: 2px;
        background: t_ta.has-hover || t_ta.pressed ? #fbbf24 : #38bdf8;
        t_ta := TouchArea {
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { root.focus_requested(); }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        4,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Bottom Edge (5)
    Rectangle {
        x: root.box_x + (root.box_w - 24px) / 2;
        y: root.box_y + root.box_h - 4px;
        width: 24px;
        height: 8px;
        border-radius: 2px;
        background: b_ta.has-hover || b_ta.pressed ? #fbbf24 : #38bdf8;
        b_ta := TouchArea {
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { root.focus_requested(); }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        5,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Left Edge (6)
    Rectangle {
        x: root.box_x - 4px;
        y: root.box_y + (root.box_h - 24px) / 2;
        width: 8px;
        height: 24px;
        border-radius: 2px;
        background: l_ta.has-hover || l_ta.pressed ? #fbbf24 : #38bdf8;
        l_ta := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { root.focus_requested(); }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        6,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Right Edge (7)
    Rectangle {
        x: root.box_x + root.box_w - 4px;
        y: root.box_y + (root.box_h - 24px) / 2;
        width: 8px;
        height: 24px;
        border-radius: 2px;
        background: r_ta.has-hover || r_ta.pressed ? #fbbf24 : #38bdf8;
        r_ta := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { root.focus_requested(); }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        7,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Another Encoder — Professional Media Transcoder";
    min-width: 960px;
    min-height: 650px;
    preferred-width: 1280px;
    preferred-height: 850px;
    background: #09090b; // Deep dark neutral background

    forward-focus: fs;

    property <length> queue_panel_width: (AppData.active_tab == 0 && AppData.player_has_media && AppData.selected_is_video && AppData.edit_panel_expanded) ? 260px : 300px;

    fs := FocusScope {
        key-pressed(event) => {
            if event.text == " " {
                if AppData.active_tab == 0 && AppData.player_has_media {
                    AppLogic.player_play_pause();
                    return accept;
                }
            }
            if AppData.active_tab == 0 && AppData.player_has_media && AppData.selected_is_video && AppData.crop_enabled && AppData.crop_arrow_keys_enabled {
                if event.text == Key.LeftArrow {
                    AppLogic.crop_nudge(event.modifiers.shift ? -AppData.crop_nudge_step * 4 : -AppData.crop_nudge_step, 0);
                    return accept;
                }
                if event.text == Key.RightArrow {
                    AppLogic.crop_nudge(event.modifiers.shift ? AppData.crop_nudge_step * 4 : AppData.crop_nudge_step, 0);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    AppLogic.crop_nudge(0, event.modifiers.shift ? -AppData.crop_nudge_step * 4 : -AppData.crop_nudge_step);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    AppLogic.crop_nudge(0, event.modifiers.shift ? AppData.crop_nudge_step * 4 : AppData.crop_nudge_step);
                    return accept;
                }
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

        // TOP HEADER BAR (Brand Title on Left + Workspace Navigation Tabs)
        Rectangle {
            height: 42px;
            background: #121215;

            // Left: Brand Logo & Title (Top-Left Corner)
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 16px;
                spacing: 8px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: @linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
                        Text {
                            text: "AE";
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "ANOTHER ENCODER";
                        font-size: 13px;
                        font-weight: 700;
                        color: #f4f4f5;
                        vertical-alignment: center;
                    }
                }
            }

            // Center-Right: Workspace Navigation Tabs (aligned above right workspace panel)
            HorizontalLayout {
                x: root.queue_panel_width + 1px;
                width: parent.width - root.queue_panel_width - 1px;
                height: 100%;
                spacing: 14px;
                alignment: center;

                // Tab 0: View & Edit
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 114px;
                        height: 30px;
                        border-radius: 6px;
                        background: AppData.active_tab == 0 ? #141418 : #00000000;
                        border-width: 1px;
                        border-color: AppData.active_tab == 0 ? #38bdf8 : #00000000;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/film.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: AppData.active_tab == 0 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "View & Edit";
                                    font-size: 12px;
                                    font-weight: AppData.active_tab == 0 ? 700 : 500;
                                    color: AppData.active_tab == 0 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            if AppData.has_active_trim : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #f59e0b;
                                }
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.switch_tab(0); }
                        }
                    }
                }

                // Tab 1: Downloader
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 114px;
                        height: 30px;
                        border-radius: 6px;
                        background: AppData.active_tab == 1 ? #141418 : #00000000;
                        border-width: 1px;
                        border-color: AppData.active_tab == 1 ? #38bdf8 : #00000000;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/download.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: AppData.active_tab == 1 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Downloader";
                                    font-size: 12px;
                                    font-weight: AppData.active_tab == 1 ? 700 : 500;
                                    color: AppData.active_tab == 1 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            if AppData.ytdlp_is_downloading : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #34d399;
                                }
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.switch_tab(1); }
                        }
                    }
                }

                // Tab 2: Transcoder Settings
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 160px;
                        height: 30px;
                        border-radius: 6px;
                        background: AppData.active_tab == 2 ? #141418 : #00000000;
                        border-width: 1px;
                        border-color: AppData.active_tab == 2 ? #38bdf8 : #00000000;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/settings.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: AppData.active_tab == 2 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Transcoder Settings";
                                    font-size: 12px;
                                    font-weight: AppData.active_tab == 2 ? 700 : 500;
                                    color: AppData.active_tab == 2 ? #38bdf8 : #a1a1aa;
                                }
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.switch_tab(2); }
                        }
                    }
                }
            }
        }

        // Header Divider
        Rectangle { height: 1px; background: #2a2a30; }

        // MAIN BODY (Split Left: Queue, Right: Inspector)
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // LEFT PANEL: FILE QUEUE
            Rectangle {
                width: root.queue_panel_width;
                background: #0f0f12;

                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;

                    // Section Title
                    HorizontalLayout {
                        padding-left: 2px;
                        padding-right: 2px;
                        Text {
                            text: "Input Files Queue";
                            font-size: 13px;
                            font-weight: 600;
                            color: #fafafa;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "\{AppData.queue.length} file(s)";
                            font-size: 11px;
                            color: #71717a;
                        }
                    }

                    // Queue Container Box (Surrounds file list AND Add Files/Clear List buttons)
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 8px;
                        background: #141417;
                        border-width: 1px;
                        border-color: #2a2a30;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 8px;

                            // Empty State if no files
                            if AppData.queue.length == 0 : VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: "No files in queue";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #a1a1aa;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Drag & drop media files here, or click '+ Add Files'";
                                    font-size: 11px;
                                    color: #71717a;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            // Scrollable File List
                            if AppData.queue.length > 0 : ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 4px;

                                    for file[idx] in AppData.queue : Rectangle {
                                        height: 38px;
                                        border-radius: 5px;
                                        background: AppData.selected_file_index == idx ? #222227 : (card_ta.has-hover ? #1e1e24 : #141418);
                                        border-width: 1px;
                                        border-color: AppData.selected_file_index == idx ? #38bdf8 : (card_ta.has-hover ? #383840 : #18181c);
                                        clip: true;

                                        animate background { duration: 150ms; }
                                        animate border-color { duration: 150ms; }

                                        card_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppLogic.select_file(idx); }
                                        }

                                        // Selection Accent Bar on left edge
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            width: 3px;
                                            height: 100%;
                                            background: AppData.selected_file_index == idx ? #38bdf8 : #2a2a30;
                                        }

                                        // Bottom inline encoding progress bar
                                        if file.progress > 0.0 && file.progress < 1.0 : Rectangle {
                                            x: 3px;
                                            y: parent.height - 2px;
                                            width: max(4px, (parent.width - 3px) * file.progress);
                                            height: 2px;
                                            background: @linear-gradient(90deg, #0284c7 0%, #38bdf8 50%, #10b981 100%);
                                        }

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 6px;
                                            padding-top: 3px;
                                            padding-bottom: 3px;
                                            spacing: 6px;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 1px;
                                                alignment: center;

                                                // Row 1: File Name
                                                Text {
                                                    text: file.file_name;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    color: AppData.selected_file_index == idx ? #38bdf8 : #f4f4f5;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }

                                                // Row 2: File Path
                                                Text {
                                                    text: file.file_path;
                                                    font-size: 9.5px;
                                                    color: AppData.selected_file_index == idx ? #a1a1aa : #71717a;
                                                    horizontal-alignment: left;
                                                    overflow: elide;
                                                }
                                            }

                                            // Remove Item Button
                                            VerticalLayout {
                                                alignment: center;
                                                IconButton {
                                                    icon_source: @image-url("icons/x.svg");
                                                    has_icon: true;
                                                    icon_size: 10px;
                                                    btn_width: 20px;
                                                    btn_height: 20px;
                                                    hover_bg: #ef444433;
                                                    clicked => { AppLogic.remove_file(idx); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Bottom Queue Actions: Add Files & Clear List (inside queue container box)
                            HorizontalLayout {
                                spacing: 6px;
                                height: 30px;

                                ActionButton {
                                    min-width: 0px;
                                    horizontal-stretch: 13;
                                    height: 30px;
                                    title: "Add Files";
                                    icon_source: @image-url("icons/plus.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    fill_color: #0284c7;
                                    hover_color: #0369a1;
                                    font_size: 11.5px;
                                    clicked => { AppLogic.add_files(); }
                                }

                                ActionButton {
                                    min-width: 0px;
                                    horizontal-stretch: 10;
                                    height: 30px;
                                    title: "Clear List";
                                    icon_source: @image-url("icons/trash.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    fill_color: #1c1c22;
                                    hover_color: #2a2a32;
                                    text_color: #a1a1aa;
                                    font_size: 11px;
                                    is_disabled: AppData.queue.length == 0;
                                    clicked => { AppLogic.clear_queue(); }
                                }
                            }
                        }
                    }

                    // SELECTED ITEM METADATA BOX (Displayed when an item on the queue list is selected)
                    if AppData.selected_file_index >= 0 && AppData.selected_file_index < AppData.queue.length : Rectangle {
                        height: 112px;
                        border-radius: 8px;
                        background: #141417;
                        border-width: 1px;
                        border-color: #38bdf866;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            alignment: start;

                            // Header Row: Media Type Badge + Section Title + Status
                            HorizontalLayout {
                                height: 18px;
                                spacing: 6px;

                                VerticalLayout {
                                    alignment: center;
                                    Badge {
                                        label: AppData.queue[AppData.selected_file_index].is_video ? "VIDEO" : "AUDIO";
                                        bg_color: AppData.queue[AppData.selected_file_index].is_video ? #0369a1 : #6d28d9;
                                        fg_color: #ffffff;
                                        height: 16px;
                                    }
                                }

                                Text {
                                    text: "Selected Item Metadata";
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    color: #d4d4d8;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Text {
                                    text: AppData.queue[AppData.selected_file_index].status;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: AppData.queue[AppData.selected_file_index].status == "Completed" ? #34d399 : (AppData.queue[AppData.selected_file_index].status == "Probing..." ? #818cf8 : (AppData.queue[AppData.selected_file_index].status == "Ready" ? #38bdf8 : (AppData.queue[AppData.selected_file_index].progress > 0.0 && AppData.queue[AppData.selected_file_index].progress < 1.0 ? #fbbf24 : #f87171)));
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle { height: 1px; background: #1c1c22; }

                            // Row 1: Resolution, Duration, File Size
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: center;
                                    Text {
                                        text: "Resolution";
                                        font-size: 9.5px;
                                        color: #71717a;
                                    }
                                    Text {
                                        text: AppData.queue[AppData.selected_file_index].resolution;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #38bdf8;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: center;
                                    Text {
                                        text: "Duration";
                                        font-size: 9.5px;
                                        color: #71717a;
                                    }
                                    Text {
                                        text: AppData.queue[AppData.selected_file_index].duration;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #f4f4f5;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: center;
                                    Text {
                                        text: "File Size";
                                        font-size: 9.5px;
                                        color: #71717a;
                                    }
                                    Text {
                                        text: AppData.queue[AppData.selected_file_index].file_size_formatted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #d4d4d8;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Row 2: Codecs
                            VerticalLayout {
                                height: 30px;
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: "Codecs";
                                    font-size: 9.5px;
                                    color: #71717a;
                                }
                                Text {
                                    text: AppData.queue[AppData.selected_file_index].codecs;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #a78bfa;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // RUN TASK Button: Under the queue box, aligned with queue list column
                    HorizontalLayout {
                        alignment: center;
                        height: 34px;

                        if !AppData.is_processing : ActionButton {
                            width: 160px;
                            height: 34px;
                            title: "RUN TASK";
                            icon_source: @image-url("icons/play.svg");
                            has_icon: true;
                            icon_size: 13px;
                            fill_color: AppData.queue.length == 0 ? #2a2a30 : #10b981;
                            hover_color: AppData.queue.length == 0 ? #2a2a30 : #059669;
                            text_color: AppData.queue.length == 0 ? #71717a : #ffffff;
                            is_disabled: AppData.queue.length == 0;
                            font_size: 12px;
                            clicked => { AppLogic.run_task(); }
                        }

                        if AppData.is_processing : ActionButton {
                            width: 160px;
                            height: 34px;
                            title: "STOP / CANCEL";
                            icon_source: @image-url("icons/stop.svg");
                            has_icon: true;
                            icon_size: 13px;
                            fill_color: #ef4444;
                            hover_color: #dc2626;
                            font_size: 12px;
                            clicked => { AppLogic.cancel_processing(); }
                        }
                    }
                }
            }

            // Vertical Split Divider
            Rectangle { width: 1px; background: #18181c; }

            // RIGHT PANEL: FUNCTION & PARAMETERS (Stretch)
            Rectangle {
                min-width: 0px;
                horizontal-stretch: 1;
                background: #0c0c0e;
                clip: true;

                // TAB 0: MEDIA PLAYER & TRIMMING STUDIO (Dynamic Height, No Vertical Scroll)
                if AppData.active_tab == 0 : VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 0px;

                    // MEDIA PLAYER & TRIMMING STUDIO EMPTY STATE
                    if !AppData.player_has_media : Rectangle {
                        vertical-stretch: 1;
                        min-height: 240px;
                            border-radius: 12px;
                            background: #141417;
                            border-width: 1px;
                            border-color: #1c1c22;

                            VerticalLayout {
                                padding: 36px;
                                spacing: 18px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 32px;
                                        background: @linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
                                        Image {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("icons/film.svg");
                                            width: 28px;
                                            height: 28px;
                                            colorize: #ffffff;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    alignment: center;
                                    Text {
                                        text: "View & Edit";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: #f4f4f5;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Load any audio or video file to preview frame-by-frame, scrub the interactive timeline, and trim.";
                                        font-size: 13px;
                                        color: #a1a1aa;
                                        horizontal-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    ActionButton {
                                        width: 240px;
                                        height: 42px;
                                        title: "Open Audio or Video File";
                                        icon_source: @image-url("icons/folder-open.svg");
                                        has_icon: true;
                                        icon_size: 16px;
                                        fill_color: #0284c7;
                                        hover_color: #0369a1;
                                        font_size: 13px;
                                        clicked => { AppLogic.add_files(); }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Badge { label: "MP4"; bg_color: #141418; fg_color: #38bdf8; }
                                    Badge { label: "MKV"; bg_color: #141418; fg_color: #38bdf8; }
                                    Badge { label: "MOV"; bg_color: #141418; fg_color: #38bdf8; }
                                    Badge { label: "WEBM"; bg_color: #141418; fg_color: #38bdf8; }
                                    Badge { label: "MP3"; bg_color: #141418; fg_color: #a78bfa; }
                                    Badge { label: "WAV"; bg_color: #141418; fg_color: #a78bfa; }
                                    Badge { label: "FLAC"; bg_color: #141418; fg_color: #a78bfa; }
                                    Badge { label: "AAC"; bg_color: #141418; fg_color: #a78bfa; }
                                }
                            }
                        }

                        if AppData.player_has_media : Rectangle {
                            vertical-stretch: 1;
                            border-radius: 10px;
                            background: #141417;
                            border-width: 1px;
                            border-color: AppData.has_active_trim ? #f59e0b : #1c1c22;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 8px;

                                // Header row
                                HorizontalLayout {
                                    spacing: 10px;

                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: AppData.selected_is_video ? @linear-gradient(135deg, #0284c7 0%, #38bdf8 100%) : @linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
                                        Image {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: AppData.selected_is_video ? @image-url("icons/video.svg") : @image-url("icons/audio.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: #ffffff;
                                        }
                                    }

                                    VerticalLayout {
                                        min-width: 0px;
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: AppData.selected_file_name;
                                            font-size: 13.5px;
                                            font-weight: 700;
                                            color: #f4f4f5;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Right-Side Editing Panel Expand / Collapse Quick Toggle Button
                                    if AppData.player_has_media : VerticalLayout {
                                        alignment: center;
                                        ActionButton {
                                            width: AppData.edit_panel_expanded ? 32px : 84px;
                                            height: 28px;
                                            title: AppData.edit_panel_expanded ? "" : "Editing";
                                            icon_source: @image-url("icons/sliders.svg");
                                            has_icon: true;
                                            icon_size: 13px;
                                            fill_color: AppData.edit_panel_expanded ? #0284c7 : #1c1c22;
                                            hover_color: AppData.edit_panel_expanded ? #0369a1 : #2a2a30;
                                            text_color: #ffffff;
                                            font_size: 10.5px;
                                            clicked => { AppLogic.toggle_edit_panel(); }
                                        }
                                    }
                                }

                                // Media Screen Area (Dynamic height: stretches to fill all available vertical space, no vertical scroll)
                                Rectangle {
                                    vertical-stretch: 1;
                                    min-height: 120px;
                                    border-radius: 8px;
                                    background: #000000;
                                    border-width: 1px;
                                    border-color: #1c1c22;
                                    clip: true;

                                    // Video Canvas
                                    if AppData.selected_is_video : video_screen := Rectangle {
                                        property <length> img_box_w: min(self.width, self.height * 16 / 9);
                                        property <length> img_box_h: min(self.height, self.width * 9 / 16);
                                        property <length> img_box_x: (self.width - self.img_box_w) / 2;
                                        property <length> img_box_y: (self.height - self.img_box_h) / 2;

                                        property <length> active_vid_x: self.img_box_x + self.img_box_w * AppData.preview_video_norm_x;
                                        property <length> active_vid_y: self.img_box_y + self.img_box_h * AppData.preview_video_norm_y;
                                        property <length> active_vid_w: max(16px, self.img_box_w * AppData.preview_video_norm_w);
                                        property <length> active_vid_h: max(16px, self.img_box_h * AppData.preview_video_norm_h);

                                        Image {
                                            source: AppData.preview_frame;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: contain;
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                fs.focus();
                                                AppLogic.player_play_pause();
                                            }
                                        }

                                        // Interactive Drag & Drop Visual Crop Overlay Box
                                        if AppData.crop_enabled : CropOverlayView {
                                            x: video_screen.active_vid_x;
                                            y: video_screen.active_vid_y;
                                            width: video_screen.active_vid_w;
                                            height: video_screen.active_vid_h;
                                            norm_x: AppData.crop_norm_x;
                                            norm_y: AppData.crop_norm_y;
                                            norm_w: AppData.crop_norm_w;
                                            norm_h: AppData.crop_norm_h;
                                            crop_px_w: AppData.crop_width;
                                            crop_px_h: AppData.crop_height;
                                            crop_px_x: AppData.crop_x;
                                            crop_px_y: AppData.crop_y;
                                            focus_requested => {
                                                fs.focus();
                                            }
                                        }

                                        // Loading indicator
                                        if AppData.preview_frame_loading : Rectangle {
                                            background: #00000099;
                                            Text {
                                                text: "Seeking frame...";
                                                font-size: 12px;
                                                color: #a1a1aa;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Audio Waveform Studio (for audio files)
                                    if !AppData.selected_is_video : audio_studio := AudioWaveformStudio {
                                        duration: AppData.player_duration;
                                        current_time: AppData.player_current_time;
                                        in_point_norm: AppData.in_point_normalized;
                                        out_point_norm: AppData.out_point_normalized;
                                        in_point_sec: AppData.in_point_seconds;
                                        out_point_sec: AppData.out_point_seconds;
                                        has_trim: AppData.has_active_trim;
                                        seek(val) => {
                                            AppLogic.player_seek(val);
                                        }
                                        in_point_dragged(val) => {
                                            AppLogic.set_in_point_from_timeline(val);
                                        }
                                        out_point_dragged(val) => {
                                            AppLogic.set_out_point_from_timeline(val);
                                        }
                                    }
                                }

                                // Visual Timeline Track
                                VerticalLayout {
                                    spacing: 8px;

                                    // Time Readouts Header Bar: PLAYHEAD / TOTAL on left, Volume in middle, TRIM on right
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        // Left: Combined Playhead & Duration Pill
                                        Rectangle {
                                            height: 28px;
                                            border-radius: 6px;
                                            background: #1c1c22;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 5px;
                                                alignment: center;
                                                Text { text: AppData.player_time_text; font-size: 12px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                                                Text { text: "/"; font-size: 11px; font-weight: 600; color: #71717a; vertical-alignment: center; }
                                                Text { text: AppData.player_duration_text; font-size: 11.5px; font-weight: 700; color: #d4d4d8; vertical-alignment: center; }
                                            }
                                        }

                                        // Volume Control Bar Pill
                                        VolumeBar {
                                            volume: AppData.player_volume;
                                            is_muted: AppData.player_is_muted;
                                            volume_changed(val) => {
                                                AppLogic.player_volume_changed(val);
                                            }
                                            toggle_mute() => {
                                                AppLogic.player_toggle_mute();
                                            }
                                        }

                                        // Zoom Controls (for both audio waveform and video timeline)
                                        Rectangle {
                                            height: 28px;
                                            border-radius: 6px;
                                            background: #1c1c22;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 3px;
                                                alignment: center;

                                                Text { text: "ZOOM:"; font-size: 10px; font-weight: 700; color: #71717a; vertical-alignment: center; }

                                                Rectangle {
                                                    width: 20px;
                                                    height: 20px;
                                                    border-radius: 3px;
                                                    background: vzm_ta.has-hover ? #2a2a30 : transparent;
                                                    Text { text: "−"; font-size: 13px; font-weight: 800; color: #a1a1aa; horizontal-alignment: center; vertical-alignment: center; }
                                                    vzm_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = max(1.0, AppData.timeline_zoom - 0.5); } }
                                                }

                                                Rectangle {
                                                    width: 24px;
                                                    height: 18px;
                                                    border-radius: 3px;
                                                    background: AppData.timeline_zoom <= 1.05 ? #38bdf822 : (vz1_ta.has-hover ? #2a2a30 : transparent);
                                                    border-width: AppData.timeline_zoom <= 1.05 ? 1px : 0px;
                                                    border-color: #38bdf866;
                                                    Text { text: "1x"; font-size: 9.5px; font-weight: 700; color: AppData.timeline_zoom <= 1.05 ? #38bdf8 : #a1a1aa; horizontal-alignment: center; vertical-alignment: center; }
                                                    vz1_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = 1.0; } }
                                                }

                                                Rectangle {
                                                    width: 24px;
                                                    height: 18px;
                                                    border-radius: 3px;
                                                    background: (AppData.timeline_zoom > 1.95 && AppData.timeline_zoom < 2.05) ? #38bdf822 : (vz2_ta.has-hover ? #2a2a30 : transparent);
                                                    border-width: (AppData.timeline_zoom > 1.95 && AppData.timeline_zoom < 2.05) ? 1px : 0px;
                                                    border-color: #38bdf866;
                                                    Text { text: "2x"; font-size: 9.5px; font-weight: 700; color: (AppData.timeline_zoom > 1.95 && AppData.timeline_zoom < 2.05) ? #38bdf8 : #a1a1aa; horizontal-alignment: center; vertical-alignment: center; }
                                                    vz2_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = 2.0; } }
                                                }

                                                Rectangle {
                                                    width: 24px;
                                                    height: 18px;
                                                    border-radius: 3px;
                                                    background: (AppData.timeline_zoom > 3.95 && AppData.timeline_zoom < 4.05) ? #38bdf822 : (vz4_ta.has-hover ? #2a2a30 : transparent);
                                                    border-width: (AppData.timeline_zoom > 3.95 && AppData.timeline_zoom < 4.05) ? 1px : 0px;
                                                    border-color: #38bdf866;
                                                    Text { text: "4x"; font-size: 9.5px; font-weight: 700; color: (AppData.timeline_zoom > 3.95 && AppData.timeline_zoom < 4.05) ? #38bdf8 : #a1a1aa; horizontal-alignment: center; vertical-alignment: center; }
                                                    vz4_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = 4.0; } }
                                                }

                                                Rectangle {
                                                    width: 20px;
                                                    height: 20px;
                                                    border-radius: 3px;
                                                    background: vzp_ta.has-hover ? #2a2a30 : transparent;
                                                    Text { text: "+"; font-size: 13px; font-weight: 800; color: #a1a1aa; horizontal-alignment: center; vertical-alignment: center; }
                                                    vzp_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = min(8.0, AppData.timeline_zoom + 0.5); } }
                                                }

                                                Rectangle {
                                                    width: 22px;
                                                    height: 20px;
                                                    border-radius: 3px;
                                                    background: vzc_ta.has-hover ? #2a2a30 : transparent;
                                                    Text { text: "⊙"; font-size: 12px; font-weight: 800; color: #38bdf8; horizontal-alignment: center; vertical-alignment: center; }
                                                    vzc_ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            AppData.center_timeline_trigger += 1;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        // Right: Yellow Trim Pill (when active)
                                        if AppData.has_active_trim : Rectangle {
                                            height: 28px;
                                            border-radius: 6px;
                                            background: #d9770633;
                                            border-width: 1px;
                                            border-color: #f59e0b;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 4px;
                                                alignment: center;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("icons/scissors.svg");
                                                        width: 12px;
                                                        height: 12px;
                                                        colorize: #f59e0b;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text { text: "TRIM:"; font-size: 10px; font-weight: 700; color: #f59e0b; }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text { text: AppData.trim_duration_text; font-size: 11.5px; font-weight: 800; color: #fbbf24; }
                                                }
                                            }
                                        }
                                    }

                                    // Full Visual Timeline Track with In/Out Markers & Needle (for Video)
                                    if AppData.selected_is_video : vid_timeline := VisualTimeline {
                                        duration: AppData.player_duration;
                                        current_time: AppData.player_current_time;
                                        in_point_norm: AppData.in_point_normalized;
                                        out_point_norm: AppData.out_point_normalized;
                                        in_point_sec: AppData.in_point_seconds;
                                        out_point_sec: AppData.out_point_seconds;
                                        has_trim: AppData.has_active_trim;
                                        seek(val) => {
                                            AppLogic.player_seek(val);
                                        }
                                        in_point_dragged(val) => {
                                            AppLogic.set_in_point_from_timeline(val);
                                        }
                                        out_point_dragged(val) => {
                                            AppLogic.set_out_point_from_timeline(val);
                                        }
                                    }
                                }

                                // Row 1: Playback Transport Deck
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    IconButton {
                                        btn_width: 52px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevrons-left.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        text: "-1s";
                                        font_size: 11px;
                                        hover_bg: #26262e;
                                        clicked => { AppLogic.player_step(-1.0); }
                                    }
                                    IconButton {
                                        btn_width: 56px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevron-left.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        text: "-0.1s";
                                        font_size: 10px;
                                        hover_bg: #26262e;
                                        clicked => { AppLogic.player_step(-0.1); }
                                    }

                                    // Play / Pause Button
                                    ActionButton {
                                        width: 90px;
                                        height: 30px;
                                        title: AppData.player_is_playing ? "Pause" : "Play";
                                        icon_source: AppData.player_is_playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        fill_color: AppData.player_is_playing ? #e11d48 : #0284c7;
                                        hover_color: AppData.player_is_playing ? #be123c : #0369a1;
                                        font_size: 12px;
                                        clicked => { AppLogic.player_play_pause(); }
                                    }

                                    IconButton {
                                        btn_width: 34px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/stop.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        hover_bg: #26262e;
                                        clicked => { AppLogic.player_stop(); }
                                    }

                                    IconButton {
                                        btn_width: 56px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevron-right.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        text: "+0.1s";
                                        font_size: 10px;
                                        hover_bg: #26262e;
                                        clicked => { AppLogic.player_step(0.1); }
                                    }
                                    IconButton {
                                        btn_width: 52px;
                                        btn_height: 30px;
                                        icon_source: @image-url("icons/chevrons-right.svg");
                                        has_icon: true;
                                        icon_size: 13px;
                                        text: "+1s";
                                        font_size: 11px;
                                        hover_bg: #26262e;
                                        clicked => { AppLogic.player_step(1.0); }
                                    }
                                }

                                // Row 2: In/Out Trim Markers & Range Deck
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;

                                    ActionButton {
                                        width: 62px;
                                        height: 26px;
                                        title: "[ Set In";
                                        fill_color: #d97706;
                                        hover_color: #b45309;
                                        font_size: 10px;
                                        clicked => { AppLogic.set_in_point_current(); }
                                    }

                                    ActionButton {
                                        width: 62px;
                                        height: 26px;
                                        title: "Set Out ]";
                                        fill_color: #d97706;
                                        hover_color: #b45309;
                                        font_size: 10px;
                                        clicked => { AppLogic.set_out_point_current(); }
                                    }

                                    IconButton {
                                        btn_width: 38px;
                                        btn_height: 26px;
                                        icon_source: @image-url("icons/chevrons-left.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        text: "In";
                                        font_size: 10px;
                                        hover_bg: #26262e;
                                        clicked => { AppLogic.jump_to_in_point(); }
                                    }

                                    IconButton {
                                        btn_width: 40px;
                                        btn_height: 26px;
                                        icon_source: @image-url("icons/chevrons-right.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        text: "Out";
                                        font_size: 10px;
                                        hover_bg: #26262e;
                                        clicked => { AppLogic.jump_to_out_point(); }
                                    }

                                    ActionButton {
                                        width: 74px;
                                        height: 26px;
                                        title: "Play Trim";
                                        icon_source: @image-url("icons/play.svg");
                                        has_icon: true;
                                        icon_size: 10px;
                                        fill_color: #059669;
                                        hover_color: #047857;
                                        font_size: 10px;
                                        clicked => { AppLogic.play_trimmed_range(); }
                                    }

                                    IconButton {
                                        btn_width: 52px;
                                        btn_height: 26px;
                                        icon_source: @image-url("icons/reset.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        text: "Reset";
                                        font_size: 10px;
                                        hover_bg: #26262e;
                                        clicked => { AppLogic.clear_trim_points(); }
                                    }
                                }

                                // Row 2: Precision In/Out Timecodes & Instant Actions Deck
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: "In:";
                                        font_size: 11px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }

                                    LineEdit {
                                        width: 105px;
                                        height: 28px;
                                        font-size: 11px;
                                        text <=> AppData.in_point;
                                        placeholder-text: "00:00:00.000";
                                        edited(txt) => { AppLogic.in_point_text_changed(txt); }
                                    }

                                    Text {
                                        text: "Out:";
                                        font_size: 11px;
                                        font-weight: 700;
                                        color: #fbbf24;
                                        vertical-alignment: center;
                                    }

                                    LineEdit {
                                        width: 105px;
                                        height: 28px;
                                        font-size: 11px;
                                        text <=> AppData.out_point;
                                        placeholder-text: "00:00:00.000";
                                        edited(txt) => { AppLogic.out_point_text_changed(txt); }
                                    }

                                    Rectangle { width: 1px; height: 18px; background: #2a2a30; }

                                    ActionButton {
                                        width: 128px;
                                        height: 28px;
                                        title: "Lossless Cut Now";
                                        icon_source: @image-url("icons/scissors.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        fill_color: #059669;
                                        hover_color: #047857;
                                        font_size: 10.5px;
                                        is_disabled: !AppData.has_active_trim;
                                        clicked => { AppLogic.quick_lossless_cut(); }
                                    }

                                    ActionButton {
                                        width: 120px;
                                        height: 28px;
                                        title: "Codec Settings";
                                        icon_source: @image-url("icons/settings.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        fill_color: #1c1c22;
                                        hover_color: #2a2a32;
                                        text_color: #38bdf8;
                                        font_size: 10.5px;
                                        clicked => { AppLogic.switch_tab(2); }
                                    }
                                }
                            }
                        }
                    }

                // TAB 1: WEB DOWNLOADER (YT-DLP)
                if AppData.active_tab == 1 : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 6px;

                        // CARD 1: URL INPUT & DISCOVERY CARD (Compact)
                        Rectangle {
                            border-radius: 6px;
                            background: #141417;
                            border-width: 1px;
                            border-color: #0284c788;

                            VerticalLayout {
                                alignment: start;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 5px;

                                // Header row: Title + Subtitle + Engine Badge
                                HorizontalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 5px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("icons/download.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: #38bdf8;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Downloader";
                                                font-size: 12.5px;
                                                font-weight: 700;
                                                color: #f4f4f5;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "— Paste any video, stream, or audio URL (YouTube, Twitch, Vimeo, TikTok, Bilibili, SoundCloud, HLS/M3U8)";
                                            font-size: 10px;
                                            color: #71717a;
                                            overflow: elide;
                                        }
                                    }

                                    // yt-dlp Local Engine Badge
                                    Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: #0284c722;
                                        border-width: 1px;
                                        border-color: #38bdf8.with-alpha(0.4);
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/zap.svg");
                                                    width: 9px;
                                                    height: 9px;
                                                    colorize: #38bdf8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "yt-dlp 2026.08.19 (Local Binary)";
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    color: #38bdf8;
                                                }
                                            }
                                        }
                                    }
                                }

                                // URL Input Box with Integrated Action Buttons (Full Width)
                                HorizontalLayout {
                                    spacing: 6px;

                                    LineEdit {
                                        height: 26px;
                                        horizontal-stretch: 1;
                                        font-size: 11px;
                                        text <=> AppData.ytdlp_url;
                                        placeholder-text: "Paste stream URL (e.g. https://www.youtube.com/watch?v=... or direct m3u8)";
                                        accepted => { AppLogic.ytdlp_discover(); }
                                        edited(val) => { AppLogic.ytdlp_url_changed(val); }
                                    }

                                    ActionButton {
                                        width: 62px;
                                        height: 26px;
                                        title: "Paste";
                                        icon_source: @image-url("icons/layers.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #1c1c22;
                                        hover_color: #2a2a32;
                                        text_color: #38bdf8;
                                        font_size: 10.5px;
                                        clicked => { AppLogic.ytdlp_paste_clipboard(); }
                                    }

                                    ActionButton {
                                        width: 62px;
                                        height: 26px;
                                        title: "Clear";
                                        icon_source: @image-url("icons/trash.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #1c1c22;
                                        hover_color: #2a2a32;
                                        text_color: #a1a1aa;
                                        font_size: 10.5px;
                                        clicked => { AppLogic.ytdlp_clear_url(); }
                                    }

                                    ActionButton {
                                        width: 98px;
                                        height: 26px;
                                        title: AppData.ytdlp_is_discovering ? "Detecting..." : "Discover";
                                        icon_source: @image-url("icons/search.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #0284c7;
                                        hover_color: #0369a1;
                                        text_color: #ffffff;
                                        font_size: 10.5px;
                                        is_disabled: AppData.ytdlp_url == "" || AppData.ytdlp_is_discovering;
                                        clicked => { AppLogic.ytdlp_discover(); }
                                    }
                                }

                                // Supported Sites Pill Tags
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;

                                    Text {
                                        text: "Supported:";
                                        font-size: 9px;
                                        color: #71717a;
                                        vertical-alignment: center;
                                    }

                                    Badge { label: "YouTube"; bg_color: #141418; fg_color: #ef4444; height: 16px; }
                                    Badge { label: "Twitch"; bg_color: #141418; fg_color: #a78bfa; height: 16px; }
                                    Badge { label: "Vimeo"; bg_color: #141418; fg_color: #38bdf8; height: 16px; }
                                    Badge { label: "TikTok"; bg_color: #141418; fg_color: #f43f5e; height: 16px; }
                                    Badge { label: "Bilibili"; bg_color: #141418; fg_color: #38bdf8; height: 16px; }
                                    Badge { label: "SoundCloud"; bg_color: #141418; fg_color: #f59e0b; height: 16px; }
                                    Badge { label: "HLS / M3U8"; bg_color: #141418; fg_color: #34d399; height: 16px; }
                                }
                            }
                        }

                        // CARD 2: DISCOVERING STATE / ERROR / STREAM METADATA & CUSTOM SAVE FILENAME
                        if AppData.ytdlp_is_discovering : Rectangle {
                            border-radius: 6px;
                            background: #0284c715;
                            border-width: 1px;
                            border-color: #0284c755;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/search.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: #38bdf8;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Querying stream URL and discovering available formats and audio tracks via yt-dlp...";
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        color: #38bdf8;
                                    }
                                }
                            }
                        }

                        if AppData.ytdlp_has_error : Rectangle {
                            border-radius: 6px;
                            background: #ef444415;
                            border-width: 1px;
                            border-color: #ef444455;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 8px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/x.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: #ef4444;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "Error: " + AppData.ytdlp_error_message;
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: #fca5a5;
                                        wrap: word-wrap;
                                    }
                                }

                                ActionButton {
                                    width: 56px;
                                    height: 20px;
                                    title: "Dismiss";
                                    fill_color: #ef444433;
                                    hover_color: #ef444455;
                                    text_color: #fca5a5;
                                    font_size: 9px;
                                    clicked => { AppData.ytdlp_has_error = false; }
                                }
                            }
                        }

                        if AppData.ytdlp_has_discovered : Rectangle {
                            border-radius: 6px;
                            background: #141417;
                            border-width: 1px;
                            border-color: #34d39966;

                            VerticalLayout {
                                alignment: start;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 5px;

                                // Compact Header Row: DISCOVERED STREAM + Inline Metadata Badges + Ready Badge
                                HorizontalLayout {
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/film.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #34d399;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "DISCOVERED STREAM";
                                            font-size: 10px;
                                            font-weight: 800;
                                            color: #34d399;
                                        }
                                    }

                                    if AppData.ytdlp_uploader != "" : Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: #1c1c22;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 3px;
                                            alignment: center;
                                            Text {
                                                text: "Author:";
                                                font-size: 9px;
                                                color: #a1a1aa;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: AppData.ytdlp_uploader;
                                                font-size: 9.5px;
                                                font-weight: 600;
                                                color: #38bdf8;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if AppData.ytdlp_duration != "" : Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: #1c1c22;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 3px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/clock.svg");
                                                    width: 9px;
                                                    height: 9px;
                                                    colorize: #a1a1aa;
                                                }
                                            }
                                            Text {
                                                text: AppData.ytdlp_duration;
                                                font-size: 9.5px;
                                                font-weight: 600;
                                                color: #d4d4d8;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if AppData.ytdlp_discovered_id != "" : Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: #1c1c22;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;
                                            Text {
                                                text: "ID: " + AppData.ytdlp_discovered_id;
                                                font-size: 9px;
                                                font-weight: 600;
                                                color: #71717a;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    // Ready Status Badge
                                    Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: #05966922;
                                        border-width: 1px;
                                        border-color: #34d399;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/check.svg");
                                                    width: 9px;
                                                    height: 9px;
                                                    colorize: #34d399;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Ready to Download";
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    color: #34d399;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Title Text
                                Text {
                                    text: AppData.ytdlp_title;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #f4f4f5;
                                    overflow: elide;
                                }

                                // COMPACT SAVE FILE NAME SECTION (Full Width Input)
                                Rectangle {
                                    border-radius: 5px;
                                    background: #111114;
                                    border-width: 1px;
                                    border-color: #0284c744;

                                    VerticalLayout {
                                        alignment: start;
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 5px;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/sliders.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: #38bdf8;
                                                }
                                            }

                                            Text {
                                                text: "Save File Name (Customizable):";
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #38bdf8;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            Text {
                                                text: "(Extension auto-appended based on format)";
                                                font-size: 9px;
                                                color: #71717a;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            LineEdit {
                                                horizontal-stretch: 1;
                                                height: 26px;
                                                font-size: 11px;
                                                placeholder-text: "Enter custom file name (without extension)...";
                                                text <=> AppData.ytdlp_custom_filename;
                                            }

                                            ActionButton {
                                                width: 68px;
                                                height: 26px;
                                                title: "Reset";
                                                icon_source: @image-url("icons/reset.svg");
                                                has_icon: true;
                                                icon_size: 10px;
                                                fill_color: #1c1c22;
                                                hover_color: #2a2a32;
                                                text_color: #a1a1aa;
                                                font_size: 10px;
                                                clicked => { AppData.ytdlp_custom_filename = AppData.ytdlp_title; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // CARD 3: FORMAT SELECTION & DESTINATION FOLDER (Compact)
                        Rectangle {
                            border-radius: 6px;
                            background: #141417;
                            border-width: 1px;
                            border-color: #1c1c22;

                            VerticalLayout {
                                alignment: start;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 5px;

                                // Header row: Title + Contextual Mode Pill + Right Hint
                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: "Download Format & Quality Options";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #f4f4f5;
                                        vertical-alignment: center;
                                    }

                                    property <bool> is_audio_format: AppData.ytdlp_format_options.length > 0 && AppData.ytdlp_selected_format_index < AppData.ytdlp_format_options.length && AppData.ytdlp_format_options[AppData.ytdlp_selected_format_index].starts-with("[Audio]");
                                    Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: is_audio_format ? #7c3aed22 : #0284c722;
                                        border-width: 1px;
                                        border-color: is_audio_format ? #7c3aed55 : #0284c755;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: is_audio_format ? @image-url("icons/audio.svg") : @image-url("icons/video.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: is_audio_format ? #a78bfa : #38bdf8;
                                                }
                                            }
                                            Text {
                                                text: is_audio_format ? "Audio Extraction Mode" : "Video + Audio Merge (MP4)";
                                                font-size: 9px;
                                                font-weight: 600;
                                                color: is_audio_format ? #c4b5fd : #7dd3fc;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    Text {
                                        text: "Options queried by yt-dlp";
                                        font-size: 9.5px;
                                        color: #71717a;
                                        vertical-alignment: center;
                                    }
                                }

                                // Quality Preset / Stream Dropdown with colorized type tags
                                DownloaderFormatDropdown {
                                    height: 26px;
                                    model: AppData.ytdlp_format_options;
                                    current-index <=> AppData.ytdlp_selected_format_index;
                                }

                                // Destination Folder Row (Full Width)
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 3px;

                                    Text {
                                        text: "Save Destination Folder:";
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: #a1a1aa;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        LineEdit {
                                            horizontal-stretch: 1;
                                            height: 26px;
                                            font-size: 11px;
                                            placeholder-text: "Choose or paste folder path to save downloaded media";
                                            text <=> AppData.ytdlp_output_dir;
                                        }

                                        ActionButton {
                                            width: 80px;
                                            height: 26px;
                                            title: "Browse...";
                                            icon_source: @image-url("icons/folder.svg");
                                            has_icon: true;
                                            icon_size: 11px;
                                            fill_color: #1c1c22;
                                            hover_color: #2a2a32;
                                            text_color: #38bdf8;
                                            font_size: 10.5px;
                                            clicked => { AppLogic.ytdlp_select_output_dir(); }
                                        }

                                        ActionButton {
                                            width: 96px;
                                            height: 26px;
                                            title: "Open Folder";
                                            icon_source: @image-url("icons/folder-open.svg");
                                            has_icon: true;
                                            icon_size: 11px;
                                            fill_color: #1c1c22;
                                            hover_color: #2a2a32;
                                            text_color: #a1a1aa;
                                            font_size: 10.5px;
                                            clicked => { AppLogic.ytdlp_open_output_dir(); }
                                        }
                                    }
                                }
                            }
                        }

                        // CARD 4: DOWNLOAD ENGINE EXECUTION & PROGRESS (Compact)
                        Rectangle {
                            border-radius: 6px;
                            background: #141417;
                            border-width: 1px;
                            border-color: #1c1c22;

                            VerticalLayout {
                                alignment: start;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 6px;

                                // Action Button + Status Message + Telemetry Badges on a Single Row
                                HorizontalLayout {
                                    spacing: 8px;

                                    if !AppData.ytdlp_is_downloading : ActionButton {
                                        width: 148px;
                                        height: 26px;
                                        title: "START DOWNLOAD";
                                        icon_source: @image-url("icons/download.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        fill_color: #10b981;
                                        hover_color: #059669;
                                        font_size: 11px;
                                        clicked => { AppLogic.ytdlp_start_download(); }
                                    }

                                    if AppData.ytdlp_is_downloading : ActionButton {
                                        width: 148px;
                                        height: 26px;
                                        title: "CANCEL DOWNLOAD";
                                        icon_source: @image-url("icons/stop.svg");
                                        has_icon: true;
                                        icon_size: 12px;
                                        fill_color: #ef4444;
                                        hover_color: #dc2626;
                                        font_size: 11px;
                                        clicked => { AppLogic.ytdlp_cancel_download(); }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: AppData.ytdlp_status_message;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        color: AppData.ytdlp_is_downloading ? #38bdf8 : #a1a1aa;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;
                                        VerticalLayout {
                                            alignment: center;
                                            Badge { label: AppData.ytdlp_progress_text; bg_color: #141418; fg_color: #38bdf8; height: 18px; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Badge { label: AppData.ytdlp_speed_text; bg_color: #141418; fg_color: #a78bfa; height: 18px; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Badge { label: AppData.ytdlp_eta_text; bg_color: #141418; fg_color: #34d399; height: 18px; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Badge { label: AppData.ytdlp_size_text; bg_color: #141418; fg_color: #d4d4d8; height: 18px; }
                                        }
                                    }
                                }

                                // Real-time Progress Bar
                                Rectangle {
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #141418;

                                    Rectangle {
                                        x: 0px;
                                        width: parent.width * (AppData.ytdlp_progress / 100.0).clamp(0.0, 1.0);
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: @linear-gradient(90deg, #0284c7 0%, #10b981 100%);
                                    }
                                }
                            }
                        }

                        // CARD 5: POST-DOWNLOAD QUICK ACTIONS (Celebration Banner, Compact)
                        if AppData.ytdlp_download_finished : Rectangle {
                            border-radius: 6px;
                            background: #05966915;
                            border-width: 1px;
                            border-color: #10b98188;

                            VerticalLayout {
                                alignment: start;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 5px;

                                HorizontalLayout {
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/check.svg");
                                            width: 13px;
                                            height: 13px;
                                            colorize: #34d399;
                                        }
                                    }

                                    Text {
                                        text: "Download Completed Successfully!";
                                        font-size: 11.5px;
                                        font-weight: 700;
                                        color: #34d399;
                                        vertical-alignment: center;
                                    }

                                    if AppData.ytdlp_last_downloaded_file != "" : Text {
                                        horizontal-stretch: 1;
                                        text: "— Saved: " + AppData.ytdlp_last_downloaded_file;
                                        font-size: 10px;
                                        color: #d4d4d8;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // Quick Action Integration Buttons
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    ActionButton {
                                        height: 26px;
                                        title: "Load in View & Edit";
                                        icon_source: @image-url("icons/film.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #0284c7;
                                        hover_color: #0369a1;
                                        text_color: #ffffff;
                                        font_size: 10.5px;
                                        clicked => { AppLogic.ytdlp_load_in_player(); }
                                    }

                                    ActionButton {
                                        height: 26px;
                                        title: "Add to Transcoder Queue";
                                        icon_source: @image-url("icons/plus.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #1c1c22;
                                        hover_color: #2a2a32;
                                        text_color: #38bdf8;
                                        font_size: 10.5px;
                                        clicked => { AppLogic.ytdlp_send_to_queue(); }
                                    }

                                    ActionButton {
                                        height: 26px;
                                        title: "Open Folder";
                                        icon_source: @image-url("icons/folder-open.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: #1c1c22;
                                        hover_color: #2a2a32;
                                        text_color: #a1a1aa;
                                        font_size: 10.5px;
                                        clicked => { AppLogic.ytdlp_open_output_dir(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // TAB 2: TRANSCODER & CODEC SETTINGS
                if AppData.active_tab == 2 : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 6px;

                        // FUNCTION SELECTOR CARD (Visually grouped & color-coded, Compact)
                        Rectangle {
                            border-radius: 6px;
                            background: #141417;
                            border-width: 1px;
                            border-color: AppData.function_index <= 5 ? #0284c788 : (AppData.function_index <= 8 ? #05966988 : (AppData.function_index <= 11 ? #7c3aed88 : #d9770688));

                            VerticalLayout {
                                alignment: start;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 5px;

                                // Header row: Title + Color-coded Workflow Category Badge
                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: "Workflow & Codec Function";
                                        font-size: 12.5px;
                                        font-weight: 700;
                                        color: #f4f4f5;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    // Video Badge
                                    if AppData.function_index <= 5 : Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: #0284c722;
                                        border-width: 1px;
                                        border-color: #38bdf8;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/video.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: #38bdf8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "VIDEO ENCODING";
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    color: #38bdf8;
                                                }
                                            }
                                        }
                                    }

                                    // Remux Badge
                                    if AppData.function_index >= 6 && AppData.function_index <= 8 : Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: #05966922;
                                        border-width: 1px;
                                        border-color: #34d399;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/layers.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: #34d399;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "LOSSLESS REMUX & CUT";
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    color: #34d399;
                                                }
                                            }
                                        }
                                    }

                                    // Audio Badge
                                    if AppData.function_index >= 9 && AppData.function_index <= 11 : Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: #7c3aed22;
                                        border-width: 1px;
                                        border-color: #a78bfa;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/audio.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: #a78bfa;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "AUDIO PROCESSING";
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    color: #a78bfa;
                                                }
                                            }
                                        }
                                    }

                                    // Subtitle Badge
                                    if AppData.function_index == 12 : Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: #d9770622;
                                        border-width: 1px;
                                        border-color: #fbbf24;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/subtitles.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: #fbbf24;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "SUBTITLES & STREAMS";
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    color: #fbbf24;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Interactive Category Quick-Pills (Compact)
                                HorizontalLayout {
                                    spacing: 6px;

                                    // Video Category Tab
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: AppData.function_index <= 5 ? #0284c733 : #1c1c22;
                                        border-width: 1px;
                                        border-color: AppData.function_index <= 5 ? #38bdf8 : #2a2a30;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/video.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: AppData.function_index <= 5 ? #38bdf8 : #a1a1aa;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Video Codecs";
                                                    font-size: 10px;
                                                    font-weight: AppData.function_index <= 5 ? 700 : 500;
                                                    color: AppData.function_index <= 5 ? #38bdf8 : #d4d4d8;
                                                }
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppData.function_index = 0; }
                                        }
                                    }

                                    // Remux Category Tab
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: AppData.function_index >= 6 && AppData.function_index <= 8 ? #05966933 : #1c1c22;
                                        border-width: 1px;
                                        border-color: AppData.function_index >= 6 && AppData.function_index <= 8 ? #34d399 : #2a2a30;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/layers.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: AppData.function_index >= 6 && AppData.function_index <= 8 ? #34d399 : #a1a1aa;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Remux & Cut";
                                                    font-size: 10px;
                                                    font-weight: AppData.function_index >= 6 && AppData.function_index <= 8 ? 700 : 500;
                                                    color: AppData.function_index >= 6 && AppData.function_index <= 8 ? #34d399 : #d4d4d8;
                                                }
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppData.function_index = 6; }
                                        }
                                    }

                                    // Audio Category Tab
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: AppData.function_index >= 9 && AppData.function_index <= 11 ? #7c3aed33 : #1c1c22;
                                        border-width: 1px;
                                        border-color: AppData.function_index >= 9 && AppData.function_index <= 11 ? #a78bfa : #2a2a30;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/audio.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: AppData.function_index >= 9 && AppData.function_index <= 11 ? #a78bfa : #a1a1aa;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Audio Suite";
                                                    font-size: 10px;
                                                    font-weight: AppData.function_index >= 9 && AppData.function_index <= 11 ? 700 : 500;
                                                    color: AppData.function_index >= 9 && AppData.function_index <= 11 ? #a78bfa : #d4d4d8;
                                                }
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppData.function_index = 9; }
                                        }
                                    }

                                    // Subtitle Category Tab
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: AppData.function_index == 12 ? #d9770633 : #1c1c22;
                                        border-width: 1px;
                                        border-color: AppData.function_index == 12 ? #fbbf24 : #2a2a30;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/subtitles.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: AppData.function_index == 12 ? #fbbf24 : #a1a1aa;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Subtitles";
                                                    font-size: 10px;
                                                    font-weight: AppData.function_index == 12 ? 700 : 500;
                                                    color: AppData.function_index == 12 ? #fbbf24 : #d4d4d8;
                                                }
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppData.function_index = 12; }
                                        }
                                    }
                                }

                                // Dropdown with colorized group names (Compact)
                                WorkflowDropdown {
                                    height: 26px;
                                    current-index <=> AppData.function_index;
                                }

                                // Category Pipeline Description Banner (Single-line Compact)
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: AppData.function_index <= 5 ? #0284c715 : (AppData.function_index <= 8 ? #05966915 : (AppData.function_index <= 11 ? #7c3aed15 : #d9770615));
                                    border-width: 1px;
                                    border-color: AppData.function_index <= 5 ? #0284c744 : (AppData.function_index <= 8 ? #05966944 : (AppData.function_index <= 11 ? #7c3aed44 : #d9770644));

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: AppData.function_index <= 5 ? @image-url("icons/video.svg") : (AppData.function_index <= 8 ? @image-url("icons/layers.svg") : (AppData.function_index <= 11 ? @image-url("icons/audio.svg") : @image-url("icons/subtitles.svg")));
                                                width: 11px;
                                                height: 11px;
                                                colorize: AppData.function_index <= 5 ? #38bdf8 : (AppData.function_index <= 8 ? #34d399 : (AppData.function_index <= 11 ? #a78bfa : #fbbf24));
                                            }
                                        }

                                        Text {
                                            text: AppData.function_index <= 5 ?
                                                "Video Transcoding Pipeline: Accelerated full video encode with CRF/bitrate control, resolution scaling, and filters." :
                                                (AppData.function_index <= 8 ?
                                                    "Lossless Stream Copy Pipeline: High-speed container repacking and lossless cut with zero generation loss." :
                                                    (AppData.function_index <= 11 ?
                                                        "Audio Processing Pipeline: High-fidelity audio demux, conversion, and EBU R128 / LUFS broadcast loudness normalization." :
                                                        "Subtitle Extraction Pipeline: Extracts embedded text or bitmap subtitle streams into clean external subtitle files (.srt)."));
                                            font-size: 9.5px;
                                            font-weight: 500;
                                            color: AppData.function_index <= 5 ? #93c5fd : (AppData.function_index <= 8 ? #a7f3d0 : (AppData.function_index <= 11 ? #ddd6fe : #fde68a));
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }

                        // VIDEO PARAMETERS CARD (Compact 4-column layout)
                        if AppData.function_index <= 5 : Rectangle {
                            border-radius: 6px;
                            background: #141417;
                            border-width: 1px;
                            border-color: #1c1c22;

                            VerticalLayout {
                                alignment: start;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 5px;

                                Text {
                                    text: "Video Encoding Parameters";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                }

                                // Row 1: Hardware Acceleration, Preset, Resolution, Framerate (4 columns)
                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Hardware Acceleration"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["Auto Detect", "NVIDIA NVENC (CUDA)", "Intel QuickSync (QSV)", "AMD AMF", "CPU Software Only"];
                                            current-index <=> AppData.hw_accel_index;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Encoder Preset / Speed"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["ultrafast", "faster", "fast", "medium", "slow", "veryslow"];
                                            current-index <=> AppData.preset_index;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Resolution Scaling"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["Original Source", "4K UHD (3840x2160)", "1440p QHD (2560x1440)", "1080p FHD (1920x1080)", "720p HD (1280x720)", "480p SD (854x480)"];
                                            current-index <=> AppData.resolution_index;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Framerate Conform"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["Original Source", "23.976 fps", "24.0 fps", "25.0 fps (PAL)", "29.97 fps (NTSC)", "30.0 fps", "50.0 fps", "59.94 fps", "60.0 fps"];
                                            current-index <=> AppData.fps_index;
                                        }
                                    }
                                }

                                // Row 2: Rate Control Mode, Quality/Bitrate, Deinterlacing, Web Faststart (4 columns)
                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Rate Control Mode"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["Constant Quality (CRF)", "Constant Bitrate (CBR)", "Variable Bitrate (VBR)"];
                                            current-index <=> AppData.rate_control_index;
                                        }
                                    }

                                    if AppData.rate_control_index == 0 : VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 4px;
                                            Text { text: "CRF Quality:"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                            Text { text: "\{Math.round(AppData.crf_value)}"; font-size: 10px; font-weight: 700; color: #38bdf8; }
                                            Text { text: "(0-51)"; font-size: 9.5px; color: #71717a; }
                                        }
                                        Slider {
                                            height: 26px;
                                            minimum: 0;
                                            maximum: 51;
                                            value <=> AppData.crf_value;
                                        }
                                    }

                                    if AppData.rate_control_index > 0 : VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Target Video Bitrate"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["15000 kbps (High 4K)", "10000 kbps (2K)", "6000 kbps (1080p)", "4000 kbps (Good 1080p)", "2500 kbps (720p)", "1200 kbps (Low)"];
                                            current-index <=> AppData.video_bitrate_index;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Deinterlacing Filter"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["None (Keep Progressive)", "Yadif (Adaptive)", "Bwdif (Bob Weaver)"];
                                            current-index <=> AppData.deinterlace_index;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Web Optimization"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        Rectangle {
                                            height: 26px;
                                            border-radius: 4px;
                                            background: AppData.faststart ? #0284c722 : #1c1c22;
                                            border-width: 1px;
                                            border-color: AppData.faststart ? #38bdf8 : #2a2a30;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 6px;
                                                alignment: start;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 13px;
                                                        height: 13px;
                                                        border-radius: 3px;
                                                        background: AppData.faststart ? #0284c7 : #141418;
                                                        border-width: 1px;
                                                        border-color: AppData.faststart ? #38bdf8 : #383840;
                                                        if AppData.faststart : Image {
                                                            x: 1.5px;
                                                            y: 1.5px;
                                                            width: 10px;
                                                            height: 10px;
                                                            source: @image-url("icons/check.svg");
                                                            colorize: #ffffff;
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: "FastStart (moov atom)";
                                                    font-size: 10px;
                                                    font-weight: AppData.faststart ? 600 : 500;
                                                    color: AppData.faststart ? #e0f2fe : #a1a1aa;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { AppData.faststart = !AppData.faststart; }
                                            }
                                        }
                                    }
                                }

                                // ProRes Specific Profile Row (Compact)
                                if AppData.function_index == 3 : HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Apple ProRes Profile"; font-size: 10px; font-weight: 600; color: #f59e0b; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["ProRes 422 Proxy", "ProRes 422 LT", "ProRes 422 (Standard)", "ProRes 422 HQ (High Quality)", "ProRes 4444 (RGBA 12-bit)", "ProRes 4444 XQ"];
                                            current-index <=> AppData.prores_profile_index;
                                        }
                                    }
                                }
                            }
                        }

                        // AUDIO PARAMETERS CARD (Compact 4-column row)
                        if AppData.function_index <= 5 || AppData.function_index == 9 || AppData.function_index == 10 || AppData.function_index == 11 : Rectangle {
                            border-radius: 6px;
                            background: #141417;
                            border-width: 1px;
                            border-color: #1c1c22;

                            VerticalLayout {
                                alignment: start;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 5px;

                                Text {
                                    text: "Audio Parameters & Normalization";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #a78bfa;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Audio Codec"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["AAC (Standard)", "MP3 (libmp3lame)", "Opus (High Quality Web)", "FLAC (Lossless)", "WAV PCM 24-bit", "WAV PCM 16-bit", "AC3 (Dolby Digital)", "Copy (Passthrough)"];
                                            current-index <=> AppData.audio_codec_index;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Audio Bitrate"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["320 kbps (High Fidelity)", "256 kbps", "192 kbps (Standard)", "128 kbps", "96 kbps", "64 kbps (Speech)"];
                                            current-index <=> AppData.audio_bitrate_index;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Sample Rate"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["Keep Source", "48000 Hz (Video Standard)", "44100 Hz (CD Audio)", "96000 Hz (Studio Master)"];
                                            current-index <=> AppData.audio_sample_rate_index;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Loudness Normalization (EBU R128)"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            height: 26px;
                                            model: ["Disabled", "EBU R128 (-23.0 LUFS Broadcast)", "YouTube / Spotify (-14.0 LUFS)", "Apple Music / Podcast (-16.0 LUFS)", "Loud Web (-12.0 LUFS)"];
                                            current-index <=> AppData.normalize_index;
                                        }
                                    }
                                }
                            }
                        }

                        // ACTIVE TRIM STATUS REMINDER BANNER (Compact)
                        Rectangle {
                            border-radius: 6px;
                            background: AppData.has_active_trim ? #d9770622 : #141417;
                            border-width: 1px;
                            border-color: AppData.has_active_trim ? #f59e0b : #1c1c22;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 8px;

                                if AppData.has_active_trim : VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/scissors.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: #fbbf24;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: AppData.has_active_trim ?
                                            "Active Trim Applied: In " + AppData.in_point + " → Out " + AppData.out_point + " (" + AppData.trim_duration_text + ") will be exported." :
                                            "Full Media Export — No trim points set. To trim this clip, use the View & Edit tab.";
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        color: AppData.has_active_trim ? #fbbf24 : #a1a1aa;
                                        overflow: elide;
                                    }
                                }

                                ActionButton {
                                    width: 140px;
                                    height: 24px;
                                    border-radius: 4px;
                                    title: AppData.has_active_trim ? "Adjust on Timeline" : "Open Timeline Trimmer";
                                    icon_source: @image-url("icons/scissors.svg");
                                    has_icon: true;
                                    icon_size: 11px;
                                    fill_color: #1c1c22;
                                    hover_color: #2a2a32;
                                    font_size: 10.5px;
                                    clicked => { AppLogic.switch_tab(0); }
                                }
                            }
                        }

                        // OUTPUT DESTINATION CARD (Unified Single-Row Container + Destination Folder)
                        Rectangle {
                            border-radius: 6px;
                            background: #141417;
                            border-width: 1px;
                            border-color: #1c1c22;

                            VerticalLayout {
                                alignment: start;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 5px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: "Output Container & Destination";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #10b981;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    Text {
                                        text: AppData.container_index == 0 ? "Standard MPEG-4 (.mp4) — universal compatibility" :
                                              AppData.container_index == 1 ? "Matroska (.mkv) — multi-track & subtitle container" :
                                              AppData.container_index == 2 ? "Apple QuickTime (.mov) — ProRes & NLE workflow" :
                                              AppData.container_index == 3 ? "WebM (.webm) — HTML5 & VP9/AV1 streaming" :
                                              AppData.container_index == 4 ? "AVI (.avi) — legacy Windows container" :
                                              AppData.container_index == 5 ? "MPEG-TS (.ts) — broadcast transport stream" :
                                              AppData.container_index == 6 ? "MP3 (.mp3) — universal compressed audio" :
                                              AppData.container_index == 7 ? "WAV (.wav) — uncompressed PCM lossless audio" :
                                              "FLAC (.flac) — compressed lossless audio";
                                        font-size: 9.5px;
                                        color: #71717a;
                                        vertical-alignment: center;
                                    }
                                }

                                // Unified Row: Container Format + Destination Folder + Browse/Open Buttons
                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: start;
                                        width: 140px;
                                        spacing: 2px;
                                        Text { text: "Container Format"; font-size: 10px; font-weight: 600; color: #a1a1aa; }
                                        ComboBox {
                                            width: 140px;
                                            height: 26px;
                                            model: [".mp4", ".mkv", ".mov", ".webm", ".avi", ".ts", ".mp3", ".wav", ".flac"];
                                            current-index <=> AppData.container_index;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        horizontal-stretch: 1;
                                        spacing: 2px;

                                        Text { text: "Destination Folder"; font-size: 10px; font-weight: 600; color: #a1a1aa; }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            LineEdit {
                                                height: 26px;
                                                horizontal-stretch: 1;
                                                font-size: 11px;
                                                text: AppData.output_directory;
                                                read-only: true;
                                            }

                                            ActionButton {
                                                width: 85px;
                                                height: 26px;
                                                border-radius: 4px;
                                                title: "Browse...";
                                                icon_source: @image-url("icons/folder.svg");
                                                has_icon: true;
                                                icon_size: 11px;
                                                font_size: 10.5px;
                                                fill_color: #1c1c22;
                                                hover_color: #2a2a32;
                                                clicked => { AppLogic.select_output_dir(); }
                                            }

                                            ActionButton {
                                                width: 95px;
                                                height: 26px;
                                                border-radius: 4px;
                                                title: "Open Folder";
                                                icon_source: @image-url("icons/folder-open.svg");
                                                has_icon: true;
                                                icon_size: 11px;
                                                font_size: 10.5px;
                                                fill_color: #1c1c22;
                                                hover_color: #2a2a32;
                                                clicked => { AppLogic.open_output_dir(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // RIGHT-SIDE EXPANDABLE / COLLAPSIBLE EDITING COLUMN (Shown when in player tab and media is loaded)
            if AppData.active_tab == 0 && AppData.player_has_media : HorizontalLayout {
                spacing: 0px;

                // Vertical Divider
                Rectangle { width: 1px; background: #18181c; }

                // Collapse / Expand Toggle Strip Bar + Panel Content
                Rectangle {
                    width: AppData.edit_panel_expanded ? 320px : 34px;
                    background: #0f0f12;
                    clip: true;

                    animate width { duration: 160ms; }

                    // COLLAPSED STATE: Slim Vertical Expand Strip
                    if !AppData.edit_panel_expanded : VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 8px;
                        alignment: start;

                        HorizontalLayout {
                            alignment: center;
                            IconButton {
                                btn_width: 26px;
                                btn_height: 26px;
                                icon_source: @image-url("icons/chevron-left.svg");
                                has_icon: true;
                                icon_size: 13px;
                                text_color: (AppData.has_active_video_edits || AppData.has_active_audio_edits) ? #38bdf8 : #a1a1aa;
                                hover_bg: #26262e;
                                clicked => { AppLogic.toggle_edit_panel(); }
                            }
                        }

                        if (AppData.has_active_video_edits || AppData.has_active_audio_edits) : HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #38bdf8;
                            }
                        }
                    }

                    // EXPANDED STATE: Full Video Editing Controls Column
                    if AppData.edit_panel_expanded : VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        // Panel Header Row
                        HorizontalLayout {
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/sliders.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: #38bdf8;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Editing";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #f4f4f5;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if (AppData.has_active_video_edits || AppData.has_active_audio_edits) : VerticalLayout {
                                alignment: center;
                                ActionButton {
                                    width: 58px;
                                    height: 22px;
                                    title: "Reset All";
                                    fill_color: #1c1c22;
                                    hover_color: #2a2a32;
                                    text_color: #f87171;
                                    font_size: 9.5px;
                                    clicked => { AppLogic.reset_all_edits(); }
                                }
                            }

                            IconButton {
                                btn_width: 24px;
                                btn_height: 24px;
                                icon_source: @image-url("icons/chevron-right.svg");
                                has_icon: true;
                                icon_size: 13px;
                                hover_bg: #26262e;
                                clicked => { AppLogic.toggle_edit_panel(); }
                            }
                        }

                        Rectangle { height: 1px; background: #1c1c22; }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding-right: 4px;
                                spacing: 8px;
                                alignment: start;

                                // SECTION 1: ROTATION (0, 90, -90, 180 DEGREES)
                                if AppData.selected_is_video : Rectangle {
                                    border-radius: 7px;
                                    background: #141417;
                                    border-width: 1px;
                                    border-color: AppData.video_rotation_index != 0 ? #38bdf866 : #1c1c22;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            Text {
                                                text: "Rotate Video";
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: #e2e8f0;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text {
                                                text: AppData.video_rotation_index == 0 ? "0° (Original)" :
                                                      (AppData.video_rotation_index == 1 ? "90° CW" :
                                                      (AppData.video_rotation_index == 2 ? "-90° CCW" : "180° Upside Down"));
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: AppData.video_rotation_index != 0 ? #38bdf8 : #71717a;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "0°";
                                                fill_color: AppData.video_rotation_index == 0 ? #0284c7 : #1c1c22;
                                                hover_color: AppData.video_rotation_index == 0 ? #0369a1 : #2a2a30;
                                                text_color: AppData.video_rotation_index == 0 ? #ffffff : #d4d4d8;
                                                font_size: 11px;
                                                clicked => { AppLogic.set_video_rotation(0); }
                                            }

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "90°";
                                                fill_color: AppData.video_rotation_index == 1 ? #0284c7 : #1c1c22;
                                                hover_color: AppData.video_rotation_index == 1 ? #0369a1 : #2a2a30;
                                                text_color: AppData.video_rotation_index == 1 ? #ffffff : #d4d4d8;
                                                font_size: 11px;
                                                clicked => { AppLogic.set_video_rotation(1); }
                                            }

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "-90°";
                                                fill_color: AppData.video_rotation_index == 2 ? #0284c7 : #1c1c22;
                                                hover_color: AppData.video_rotation_index == 2 ? #0369a1 : #2a2a30;
                                                text_color: AppData.video_rotation_index == 2 ? #ffffff : #d4d4d8;
                                                font_size: 11px;
                                                clicked => { AppLogic.set_video_rotation(2); }
                                            }

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "180°";
                                                fill_color: AppData.video_rotation_index == 3 ? #0284c7 : #1c1c22;
                                                hover_color: AppData.video_rotation_index == 3 ? #0369a1 : #2a2a30;
                                                text_color: AppData.video_rotation_index == 3 ? #ffffff : #d4d4d8;
                                                font_size: 11px;
                                                clicked => { AppLogic.set_video_rotation(3); }
                                            }
                                        }
                                    }
                                }

                                // SECTION 2: MIRROR / FLIP (HORIZONTAL & VERTICAL)
                                if AppData.selected_is_video : Rectangle {
                                    border-radius: 7px;
                                    background: #141417;
                                    border-width: 1px;
                                    border-color: (AppData.video_flip_horizontal || AppData.video_flip_vertical) ? #38bdf866 : #1c1c22;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            Text {
                                                text: "Mirror & Flip";
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: #e2e8f0;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text {
                                                text: (AppData.video_flip_horizontal && AppData.video_flip_vertical) ? "H + V Flipped" :
                                                      (AppData.video_flip_horizontal ? "Horizontal Mirror" :
                                                      (AppData.video_flip_vertical ? "Vertical Flip" : "Normal"));
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: (AppData.video_flip_horizontal || AppData.video_flip_vertical) ? #38bdf8 : #71717a;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "Flip Horizontal";
                                                fill_color: AppData.video_flip_horizontal ? #0284c7 : #1c1c22;
                                                hover_color: AppData.video_flip_horizontal ? #0369a1 : #2a2a30;
                                                text_color: AppData.video_flip_horizontal ? #ffffff : #d4d4d8;
                                                font_size: 10.5px;
                                                clicked => { AppLogic.toggle_flip_horizontal(); }
                                            }

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "Flip Vertical";
                                                fill_color: AppData.video_flip_vertical ? #0284c7 : #1c1c22;
                                                hover_color: AppData.video_flip_vertical ? #0369a1 : #2a2a30;
                                                text_color: AppData.video_flip_vertical ? #ffffff : #d4d4d8;
                                                font_size: 10.5px;
                                                clicked => { AppLogic.toggle_flip_vertical(); }
                                            }
                                        }
                                    }
                                }

                                // SECTION 3: VISUAL CROP OVERLAY & ASPECT RATIO LOCK
                                if AppData.selected_is_video : Rectangle {
                                    border-radius: 7px;
                                    background: #141417;
                                    border-width: 1px;
                                    border-color: AppData.crop_enabled ? #38bdf8 : #1c1c22;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        // Header + Crop Enable Toggle
                                        HorizontalLayout {
                                            spacing: 6px;
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Video Crop Zone";
                                                    font-size: 11.5px;
                                                    font-weight: 700;
                                                    color: #e2e8f0;
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            ActionButton {
                                                width: 106px;
                                                height: 24px;
                                                title: AppData.crop_enabled ? "Crop Active" : "Enable Crop";
                                                fill_color: AppData.crop_enabled ? #059669 : #1c1c22;
                                                hover_color: AppData.crop_enabled ? #047857 : #2a2a30;
                                                text_color: AppData.crop_enabled ? #ffffff : #38bdf8;
                                                font_size: 10.5px;
                                                clicked => {
                                                    AppLogic.toggle_crop_enabled();
                                                    fs.focus();
                                                }
                                            }
                                        }

                                        // Aspect Ratio Presets Dropdown
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text {
                                                text: "Aspect Ratio Lock Preset:";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: #a1a1aa;
                                            }
                                            ComboBox {
                                                height: 26px;
                                                model: AppData.crop_aspect_options;
                                                current-index <=> AppData.crop_aspect_index;
                                                selected(_) => {
                                                    AppLogic.set_crop_aspect_preset(self.current-index);
                                                    fs.focus();
                                                }
                                            }
                                        }

                                        // Popular Aspect Ratio Quick Pills (Row 1: Free, 16:9, 9:16, 4:3, 3:4)
                                        HorizontalLayout {
                                            spacing: 4px;
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "Free";
                                                fill_color: AppData.crop_aspect_index == 0 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(0); fs.focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "16:9";
                                                fill_color: AppData.crop_aspect_index == 1 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(1); fs.focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "9:16";
                                                fill_color: AppData.crop_aspect_index == 2 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(2); fs.focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "4:3";
                                                fill_color: AppData.crop_aspect_index == 3 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(3); fs.focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "3:4";
                                                fill_color: AppData.crop_aspect_index == 4 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(4); fs.focus(); }
                                            }
                                        }

                                        // Popular Aspect Ratio Quick Pills (Row 2: 1:1, 2:3, 3:2, 21:9, 4:5)
                                        HorizontalLayout {
                                            spacing: 4px;
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "1:1";
                                                fill_color: AppData.crop_aspect_index == 5 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(5); fs.focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "2:3";
                                                fill_color: AppData.crop_aspect_index == 6 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(6); fs.focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "3:2";
                                                fill_color: AppData.crop_aspect_index == 7 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(7); fs.focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "21:9";
                                                fill_color: AppData.crop_aspect_index == 8 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(8); fs.focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "4:5";
                                                fill_color: AppData.crop_aspect_index == 9 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(9); fs.focus(); }
                                            }
                                        }

                                        // Manual Width & Height Inputs
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "Crop Box Dimensions (Pixels):";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: #a1a1aa;
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 2px;
                                                    Text { text: "Width (W)"; font-size: 9.5px; color: #71717a; }
                                                    NumInput {
                                                        text <=> AppData.crop_width_text;
                                                        placeholder: "Width";
                                                        edited(val) => { AppLogic.crop_width_edited(val); }
                                                        accepted => { fs.focus(); }
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 2px;
                                                    Text { text: "Height (H)"; font-size: 9.5px; color: #71717a; }
                                                    NumInput {
                                                        text <=> AppData.crop_height_text;
                                                        placeholder: "Height";
                                                        edited(val) => { AppLogic.crop_height_edited(val); }
                                                        accepted => { fs.focus(); }
                                                    }
                                                }
                                            }
                                        }

                                        // Manual X & Y Position Inputs
                                        HorizontalLayout {
                                            spacing: 6px;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                Text { text: "Position X"; font-size: 9.5px; color: #71717a; }
                                                NumInput {
                                                    text <=> AppData.crop_x_text;
                                                    placeholder: "X";
                                                    edited(val) => { AppLogic.crop_x_edited(val); }
                                                    accepted => { fs.focus(); }
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                Text { text: "Position Y"; font-size: 9.5px; color: #71717a; }
                                                NumInput {
                                                    text <=> AppData.crop_y_text;
                                                    placeholder: "Y";
                                                    edited(val) => { AppLogic.crop_y_edited(val); }
                                                    accepted => { fs.focus(); }
                                                }
                                            }
                                        }

                                        // Arrow Keys Nudge Option & Directional Controls
                                        Rectangle {
                                            border-radius: 5px;
                                            background: #111114;
                                            border-width: 1px;
                                            border-color: #1c1c22;

                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 6px;

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        AppData.crop_arrow_keys_enabled = !AppData.crop_arrow_keys_enabled;
                                                        fs.focus();
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 7px;
                                                        alignment: start;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Rectangle {
                                                                width: 16px;
                                                                height: 16px;
                                                                border-radius: 4px;
                                                                background: AppData.crop_arrow_keys_enabled ? #0284c7 : #1c1c22;
                                                                border-width: 1px;
                                                                border-color: AppData.crop_arrow_keys_enabled ? #38bdf8 : #383840;
                                                                if AppData.crop_arrow_keys_enabled : Text {
                                                                    text: "✓";
                                                                    font-size: 11px;
                                                                    font-weight: 700;
                                                                    color: #ffffff;
                                                                    horizontal-alignment: center;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: "Use Arrow Keys to Move Crop Box";
                                                                font-size: 10.5px;
                                                                font-weight: 500;
                                                                color: #e2e8f0;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    alignment: center;

                                                    ActionButton {
                                                        width: 32px;
                                                        height: 24px;
                                                        title: "←";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        font_size: 11px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.crop_nudge(-AppData.crop_nudge_step, 0); fs.focus(); }
                                                    }
                                                    ActionButton {
                                                        width: 32px;
                                                        height: 24px;
                                                        title: "↑";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        font_size: 11px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.crop_nudge(0, -AppData.crop_nudge_step); fs.focus(); }
                                                    }
                                                    ActionButton {
                                                        width: 32px;
                                                        height: 24px;
                                                        title: "↓";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        font_size: 11px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.crop_nudge(0, AppData.crop_nudge_step); fs.focus(); }
                                                    }
                                                    ActionButton {
                                                        width: 32px;
                                                        height: 24px;
                                                        title: "→";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        font_size: 11px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.crop_nudge(AppData.crop_nudge_step, 0); fs.focus(); }
                                                    }
                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "Center";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        text_color: #38bdf8;
                                                        font_size: 10px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.center_crop_box(); fs.focus(); }
                                                    }
                                                }
                                            }
                                        }

                                        // Reset Crop Button
                                        HorizontalLayout {
                                            spacing: 6px;
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 26px;
                                                title: "Reset Crop to Full Frame";
                                                icon_source: @image-url("icons/reset.svg");
                                                has_icon: true;
                                                icon_size: 11px;
                                                fill_color: #1c1c22;
                                                hover_color: #2a2a32;
                                                text_color: #a1a1aa;
                                                font_size: 10.5px;
                                                clicked => { AppLogic.reset_crop(); fs.focus(); }
                                            }
                                        }
                                    }
                                }

                                // SECTION 4: AUDIO EDIT (Volume Gain in dB & Loudness Normalization)
                                Rectangle {
                                    border-radius: 7px;
                                    background: #141417;
                                    border-width: 1px;
                                    border-color: AppData.has_active_audio_edits ? #38bdf866 : #1c1c22;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 10px;

                                        // Section Title Row
                                        HorizontalLayout {
                                            spacing: 6px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/volume-2.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    colorize: #38bdf8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Audio Edit";
                                                    font-size: 11.5px;
                                                    font-weight: 700;
                                                    color: #e2e8f0;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if AppData.has_active_audio_edits : ActionButton {
                                                width: 48px;
                                                height: 20px;
                                                title: "Reset";
                                                fill_color: #1c1c22;
                                                hover_color: #2a2a32;
                                                text_color: #fbbf24;
                                                font_size: 9px;
                                                clicked => { AppLogic.reset_audio_edits(); }
                                            }
                                        }

                                        // Sub-section A: Sound Volume (dB)
                                        VerticalLayout {
                                            spacing: 6px;

                                            HorizontalLayout {
                                                Text {
                                                    text: "Volume Gain / Attenuation:";
                                                    font-size: 10.5px;
                                                    font-weight: 600;
                                                    color: #a1a1aa;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                Text {
                                                    text: AppData.audio_gain_text;
                                                    font-size: 11px;
                                                    font-weight: 800;
                                                    color: AppData.audio_gain_db > 0.05 ? #34d399 :
                                                          (AppData.audio_gain_db < -0.05 ? #fbbf24 : #38bdf8);
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Continuous Slider for dB (-24.0 to +24.0 dB)
                                            HorizontalLayout {
                                                spacing: 8px;

                                                Text { text: "-24dB"; font-size: 9px; color: #71717a; vertical-alignment: center; }

                                                Slider {
                                                    horizontal-stretch: 1;
                                                    minimum: -24.0;
                                                    maximum: 24.0;
                                                    value: AppData.audio_gain_db;
                                                    changed(val) => {
                                                        AppLogic.set_audio_gain_db(val);
                                                    }
                                                }

                                                Text { text: "+24dB"; font-size: 9px; color: #71717a; vertical-alignment: center; }
                                            }

                                            // Quick Preset dB Buttons
                                            HorizontalLayout {
                                                spacing: 4px;

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "-12dB";
                                                    fill_color: AppData.audio_gain_db == -12.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == -12.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == -12.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(-12.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "-6dB";
                                                    fill_color: AppData.audio_gain_db == -6.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == -6.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == -6.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(-6.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "0 dB";
                                                    fill_color: (AppData.audio_gain_db > -0.05 && AppData.audio_gain_db < 0.05) ? #0284c7 : #1c1c22;
                                                    hover_color: (AppData.audio_gain_db > -0.05 && AppData.audio_gain_db < 0.05) ? #0369a1 : #2a2a30;
                                                    text_color: (AppData.audio_gain_db > -0.05 && AppData.audio_gain_db < 0.05) ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(0.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "+3dB";
                                                    fill_color: AppData.audio_gain_db == 3.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == 3.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == 3.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(3.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "+6dB";
                                                    fill_color: AppData.audio_gain_db == 6.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == 6.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == 6.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(6.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "+12dB";
                                                    fill_color: AppData.audio_gain_db == 12.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == 12.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == 12.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(12.0); }
                                                }
                                            }

                                            // Fine tuning +/- 1dB buttons
                                            HorizontalLayout {
                                                spacing: 6px;
                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 22px;
                                                    title: "-1.0 dB";
                                                    fill_color: #1c1c22;
                                                    hover_color: #2a2a32;
                                                    text_color: #a1a1aa;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.step_audio_gain_db(-1.0); }
                                                }
                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 22px;
                                                    title: "+1.0 dB";
                                                    fill_color: #1c1c22;
                                                    hover_color: #2a2a32;
                                                    text_color: #a1a1aa;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.step_audio_gain_db(1.0); }
                                                }
                                            }
                                        }

                                        Rectangle { height: 1px; background: #1c1c22; }

                                        // Sub-section B: Loudness Normalization
                                        VerticalLayout {
                                            spacing: 6px;

                                            // Toggle Card
                                            Rectangle {
                                                height: 32px;
                                                border-radius: 5px;
                                                background: AppData.audio_normalize_enabled ? #0284c722 : #141418;
                                                border-width: 1px;
                                                border-color: AppData.audio_normalize_enabled ? #0284c766 : #1c1c22;

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { AppLogic.toggle_audio_normalize(); }
                                                }

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;

                                                    // Custom Checkbox
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            width: 16px;
                                                            height: 16px;
                                                            border-radius: 4px;
                                                            background: AppData.audio_normalize_enabled ? #0284c7 : #1c1c22;
                                                            border-width: 1px;
                                                            border-color: AppData.audio_normalize_enabled ? #38bdf8 : #383840;

                                                            if AppData.audio_normalize_enabled : Text {
                                                                text: "✓";
                                                                font-size: 11px;
                                                                font-weight: 800;
                                                                color: #ffffff;
                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: "Normalize Audio (EBU R128)";
                                                            font-size: 10.5px;
                                                            font-weight: 700;
                                                            color: AppData.audio_normalize_enabled ? #fafafa : #d4d4d8;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    Rectangle { horizontal-stretch: 1; }

                                                    if AppData.audio_normalize_enabled : VerticalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: "\{AppData.audio_normalize_lufs} LUFS";
                                                            font-size: 10px;
                                                            font-weight: 800;
                                                            color: #38bdf8;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            // Normalization Target Presets
                                            if AppData.audio_normalize_enabled : VerticalLayout {
                                                spacing: 4px;
                                                padding-top: 2px;

                                                Text {
                                                    text: "Target Loudness Level:";
                                                    font-size: 9.5px;
                                                    font-weight: 600;
                                                    color: #71717a;
                                                }

                                                HorizontalLayout {
                                                    spacing: 4px;

                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "-16 LUFS";
                                                        fill_color: AppData.audio_normalize_preset_index == 0 ? #0284c7 : #1c1c22;
                                                        hover_color: AppData.audio_normalize_preset_index == 0 ? #0369a1 : #2a2a30;
                                                        text_color: AppData.audio_normalize_preset_index == 0 ? #ffffff : #d4d4d8;
                                                        font_size: 9px;
                                                        clicked => { AppLogic.set_audio_normalize_preset(0); }
                                                    }

                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "-14 LUFS";
                                                        fill_color: AppData.audio_normalize_preset_index == 1 ? #0284c7 : #1c1c22;
                                                        hover_color: AppData.audio_normalize_preset_index == 1 ? #0369a1 : #2a2a30;
                                                        text_color: AppData.audio_normalize_preset_index == 1 ? #ffffff : #d4d4d8;
                                                        font_size: 9px;
                                                        clicked => { AppLogic.set_audio_normalize_preset(1); }
                                                    }

                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "-23 LUFS";
                                                        fill_color: AppData.audio_normalize_preset_index == 2 ? #0284c7 : #1c1c22;
                                                        hover_color: AppData.audio_normalize_preset_index == 2 ? #0369a1 : #2a2a30;
                                                        text_color: AppData.audio_normalize_preset_index == 2 ? #ffffff : #d4d4d8;
                                                        font_size: 9px;
                                                        clicked => { AppLogic.set_audio_normalize_preset(2); }
                                                    }

                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "-12 LUFS";
                                                        fill_color: AppData.audio_normalize_preset_index == 3 ? #0284c7 : #1c1c22;
                                                        hover_color: AppData.audio_normalize_preset_index == 3 ? #0369a1 : #2a2a30;
                                                        text_color: AppData.audio_normalize_preset_index == 3 ? #ffffff : #d4d4d8;
                                                        font_size: 9px;
                                                        clicked => { AppLogic.set_audio_normalize_preset(3); }
                                                    }
                                                }
                                            }
                                        }

                                        // Realtime Preview Status Indicator Pill
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: #141418;
                                            border-width: 1px;
                                            border-color: #1c1c22;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 5px;
                                                alignment: center;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("icons/play.svg");
                                                        width: 10px;
                                                        height: 10px;
                                                        colorize: #38bdf8;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "Real-time preview in player • Applied on RUN TASK";
                                                        font-size: 9px;
                                                        color: #a1a1aa;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Canvas Info Summary Footer
                                if AppData.selected_is_video : Rectangle {
                                    border-radius: 6px;
                                    background: #141418;
                                    border-width: 1px;
                                    border-color: #1c1c22;

                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 3px;

                                        Text {
                                            text: "Source Canvas: \{AppData.selected_video_width} × \{AppData.selected_video_height} px";
                                            font-size: 10px;
                                            color: #71717a;
                                        }
                                        Text {
                                            text: "Output Canvas: \{AppData.crop_enabled ? AppData.crop_width : AppData.effective_video_width} × \{AppData.crop_enabled ? AppData.crop_height : AppData.effective_video_height} px";
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            color: #38bdf8;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // LOG DRAWER (Collapsible)
        if AppData.show_logs : Rectangle {
            height: 120px;
            background: #09090b;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                HorizontalLayout {
                    Text { text: "Live FFmpeg Command & Stderr Stream"; font-size: 11px; font-weight: 600; color: #71717a; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        icon_source: @image-url("icons/x.svg");
                        has_icon: true;
                        icon_size: 12px;
                        btn_width: 24px;
                        btn_height: 24px;
                        clicked => { AppLogic.toggle_logs(); }
                    }
                }

                ScrollView {
                    Text {
                        text: AppData.log_preview;
                        font-size: 11px;
                        font-family: "Consolas";
                        color: #a5f3fc;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Bottom Divider
        Rectangle { height: 1px; background: #2a2a30; }

        // BOTTOM STATUS BAR
        Rectangle {
            height: 42px;
            background: #121215;

            // Left: Live Queue / Encoding Status Telemetry
            HorizontalLayout {
                x: 16px;
                y: 0px;
                height: parent.height;
                spacing: 8px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: AppData.is_processing ? #f59e0b : (AppData.queue.length > 0 ? #10b981 : #71717a);
                    }
                }

                Text {
                    text: AppData.is_processing ? (AppData.progress_text + "  •  " + AppData.speed_text + "  •  " + AppData.fps_text + "  •  " + AppData.time_text) : AppData.status_summary;
                    font-size: 11px;
                    font-weight: 600;
                    color: AppData.is_processing ? #fbbf24 : #d4d4d8;
                    vertical-alignment: center;
                }

                if AppData.is_processing : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 90px;
                        height: 6px;
                        border-radius: 3px;
                        background: #141418;
                        clip: true;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width * AppData.progress_percent.clamp(0.0, 1.0);
                            height: 100%;
                            border-radius: 3px;
                            background: @linear-gradient(90deg, #0284c7 0%, #38bdf8 50%, #10b981 100%);
                        }
                    }
                }
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 7px;
                padding-bottom: 7px;
                alignment: center;

                // Spacer pushing right-hand controls to the far right
                Rectangle { horizontal-stretch: 1; }

                // Bottom-Right Corner: FFmpeg Engine, GPU Acceleration, and Show Logs Toggle
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    // FFmpeg Engine Badge
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: #141418;
                        border-width: 1px;
                        border-color: #38bdf8.with-alpha(0.3);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "FFmpeg 7.x Engine";
                                    font-size: 11px;
                                    color: #38bdf8;
                                    font-weight: 600;
                                }
                            }
                        }
                    }

                    // GPU Acceleration Pill
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: #141418;
                        border-width: 1px;
                        border-color: #34d399.with-alpha(0.3);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 5px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/zap.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: #34d399;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "GPU Accelerated";
                                    font-size: 11px;
                                    color: #34d399;
                                    font-weight: 600;
                                }
                            }
                        }
                    }

                    // Compact "Show Logs" Toggle in Bottom-Right Corner
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: AppData.show_logs ? #2a2a30 : #141418;
                        border-width: 1px;
                        border-color: AppData.show_logs ? #38bdf8 : #2a2a30;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 5px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/logs.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: AppData.show_logs ? #38bdf8 : #a1a1aa;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: AppData.show_logs ? "Hide Logs" : "Show Logs";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: AppData.show_logs ? #f4f4f5 : #a1a1aa;
                                }
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.toggle_logs(); }
                        }
                    }
                }
            }

            // Bottom-Right Engine Subtitle
            Text {
                x: parent.width - self.width - 16px;
                y: (parent.height - self.height) / 2;
                text: "Rust & FFmpeg High-Performance Engine by SThao";
                font-size: 10px;
                color: #a1a1aa;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}
}
