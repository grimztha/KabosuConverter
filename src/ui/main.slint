import { ScrollView } from "std-widgets.slint";

import { QueueFile } from "types.slint";
export { QueueFile }

import { AppData, AppLogic } from "globals.slint";
export { AppData, AppLogic }

import { IconButton } from "components/icon_button.slint";

import { PlayerTab } from "views/player_tab.slint";
import { DownloaderTab } from "views/downloader_tab.slint";
import { TranscoderTab } from "views/transcoder_tab.slint";
import { EditPanel } from "views/edit_panel.slint";
import { QueuePanel } from "views/queue_panel.slint";

export component MainWindow inherits Window {
    title: "Another Encoder — Professional Media Transcoder";
    min-width: 960px;
    min-height: 650px;
    preferred-width: 1280px;
    preferred-height: 850px;
    background: #09090b; // Deep dark neutral background

    forward-focus: fs;

    property <length> queue_panel_width: 300px;

    fs := FocusScope {
        key-pressed(event) => {
            if event.text == " " {
                if AppData.active_tab == 0 && AppData.player_has_media {
                    AppLogic.player_play_pause();
                    return accept;
                }
            }
            if AppData.active_tab == 0 && AppData.player_has_media && AppData.selected_is_video && AppData.crop_enabled && AppData.crop_arrow_keys_enabled {
                if event.text == Key.LeftArrow {
                    AppLogic.crop_nudge(event.modifiers.shift ? -AppData.crop_nudge_step * 4 : -AppData.crop_nudge_step, 0);
                    return accept;
                }
                if event.text == Key.RightArrow {
                    AppLogic.crop_nudge(event.modifiers.shift ? AppData.crop_nudge_step * 4 : AppData.crop_nudge_step, 0);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    AppLogic.crop_nudge(0, event.modifiers.shift ? -AppData.crop_nudge_step * 4 : -AppData.crop_nudge_step);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    AppLogic.crop_nudge(0, event.modifiers.shift ? AppData.crop_nudge_step * 4 : AppData.crop_nudge_step);
                    return accept;
                }
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

        // TOP HEADER BAR (Brand Title on Left + Workspace Navigation Tabs)
        Rectangle {
            height: 42px;
            background: #121215;

            // Left: Brand Logo & Title (Top-Left Corner)
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 16px;
                spacing: 8px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: @linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
                        Text {
                            text: "AE";
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "ANOTHER ENCODER";
                        font-size: 13px;
                        font-weight: 700;
                        color: #f4f4f5;
                        vertical-alignment: center;
                    }
                }
            }

            // Center-Right: Workspace Navigation Tabs (aligned above right workspace panel)
            HorizontalLayout {
                x: root.queue_panel_width + 1px;
                width: parent.width - root.queue_panel_width - 1px;
                height: 100%;
                spacing: 14px;
                alignment: center;

                // Tab 0: View & Edit
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 114px;
                        height: 30px;
                        border-radius: 6px;
                        background: AppData.active_tab == 0 ? #141418 : #00000000;
                        border-width: 1px;
                        border-color: AppData.active_tab == 0 ? #38bdf8 : #00000000;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/film.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: AppData.active_tab == 0 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "View & Edit";
                                    font-size: 12px;
                                    font-weight: AppData.active_tab == 0 ? 700 : 500;
                                    color: AppData.active_tab == 0 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            if AppData.has_active_trim : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #f59e0b;
                                }
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.switch_tab(0); }
                        }
                    }
                }

                // Tab 1: Downloader
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 114px;
                        height: 30px;
                        border-radius: 6px;
                        background: AppData.active_tab == 1 ? #141418 : #00000000;
                        border-width: 1px;
                        border-color: AppData.active_tab == 1 ? #38bdf8 : #00000000;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/download.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: AppData.active_tab == 1 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Downloader";
                                    font-size: 12px;
                                    font-weight: AppData.active_tab == 1 ? 700 : 500;
                                    color: AppData.active_tab == 1 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            if AppData.ytdlp_is_downloading : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #34d399;
                                }
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.switch_tab(1); }
                        }
                    }
                }

                // Tab 2: Transcoder Settings
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 160px;
                        height: 30px;
                        border-radius: 6px;
                        background: AppData.active_tab == 2 ? #141418 : #00000000;
                        border-width: 1px;
                        border-color: AppData.active_tab == 2 ? #38bdf8 : #00000000;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 6px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/settings.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: AppData.active_tab == 2 ? #38bdf8 : #a1a1aa;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Transcoder Settings";
                                    font-size: 12px;
                                    font-weight: AppData.active_tab == 2 ? 700 : 500;
                                    color: AppData.active_tab == 2 ? #38bdf8 : #a1a1aa;
                                }
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.switch_tab(2); }
                        }
                    }
                }
            }
        }

        // Header Divider
        Rectangle { height: 1px; background: #2a2a30; }

        // MAIN BODY (Split Left: Queue, Right: Inspector)
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // LEFT PANEL: FILE QUEUE
            QueuePanel {
                min-width: root.queue_panel_width;
                max-width: root.queue_panel_width;
                horizontal-stretch: 0;
            }

            // Vertical Split Divider
            Rectangle { width: 1px; background: #18181c; }

            // RIGHT PANEL: FUNCTION & PARAMETERS (Stretch)
            Rectangle {
                min-width: 0px;
                horizontal-stretch: 1;
                background: #0c0c0e;
                clip: true;

                if AppData.active_tab == 0 : PlayerTab {
                    request_focus => { fs.focus(); }
                }
                if AppData.active_tab == 1 : DownloaderTab {}
                if AppData.active_tab == 2 : TranscoderTab {}
            }

            // RIGHT-SIDE EXPANDABLE / COLLAPSIBLE EDITING COLUMN (Shown when in player tab and media is loaded)
            if AppData.active_tab == 0 && AppData.player_has_media : EditPanel {
                request_focus => { fs.focus(); }
            }
        }

        // LOG DRAWER (Collapsible)
        if AppData.show_logs : Rectangle {
            height: 120px;
            background: #09090b;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                HorizontalLayout {
                    Text { text: "Live FFmpeg Command & Stderr Stream"; font-size: 11px; font-weight: 600; color: #71717a; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        icon_source: @image-url("icons/x.svg");
                        has_icon: true;
                        icon_size: 12px;
                        btn_width: 24px;
                        btn_height: 24px;
                        clicked => { AppLogic.toggle_logs(); }
                    }
                }

                ScrollView {
                    Text {
                        text: AppData.log_preview;
                        font-size: 11px;
                        font-family: "Consolas";
                        color: #a5f3fc;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Bottom Divider
        Rectangle { height: 1px; background: #2a2a30; }

        // BOTTOM STATUS BAR
        Rectangle {
            height: 42px;
            background: #121215;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 12px;

                // Left: Live Queue / Encoding Status Telemetry
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: AppData.is_processing ? #f59e0b : (AppData.queue.length > 0 ? #10b981 : #71717a);
                        }
                    }

                    Text {
                        text: AppData.is_processing ? (AppData.progress_text + "  •  " + AppData.speed_text + "  •  " + AppData.fps_text + "  •  " + AppData.time_text) : AppData.status_summary;
                        font-size: 11px;
                        font-weight: 600;
                        color: AppData.is_processing ? #fbbf24 : #d4d4d8;
                        vertical-alignment: center;
                    }

                    if AppData.is_processing : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 90px;
                            height: 6px;
                            border-radius: 3px;
                            background: #141418;
                            clip: true;

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width * AppData.progress_percent.clamp(0.0, 1.0);
                                height: 100%;
                                border-radius: 3px;
                                background: @linear-gradient(90deg, #0284c7 0%, #38bdf8 50%, #10b981 100%);
                            }
                        }
                    }
                }

                // Spacer pushing right-hand controls to the far right
                Rectangle { horizontal-stretch: 1; }

                // Bottom-Right Engine Subtitle
                VerticalLayout {
                    alignment: center;
                    padding-right: 6px;
                    Text {
                        text: "High Performance Rust Transcoder & Video Downloader by SThao";
                        font-size: 10.5px;
                        font-weight: 500;
                        color: #71717a;
                        overflow: elide;
                    }
                }

                // Bottom-Right Corner: FFmpeg Engine, GPU Acceleration, and Show Logs Toggle
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    // FFmpeg Engine Badge
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: #141418;
                        border-width: 1px;
                        border-color: #38bdf8.with-alpha(0.3);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: AppData.ffmpeg_version_badge;
                                    font-size: 11px;
                                    color: #38bdf8;
                                    font-weight: 600;
                                }
                            }
                        }
                    }

                    // GPU Acceleration Pill
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: #141418;
                        border-width: 1px;
                        border-color: #34d399.with-alpha(0.3);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 5px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/zap.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: #34d399;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "GPU Accelerated";
                                    font-size: 11px;
                                    color: #34d399;
                                    font-weight: 600;
                                }
                            }
                        }
                    }

                    // Compact "Show Logs" Toggle in Bottom-Right Corner
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: AppData.show_logs ? #2a2a30 : #141418;
                        border-width: 1px;
                        border-color: AppData.show_logs ? #38bdf8 : #2a2a30;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 5px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/logs.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: AppData.show_logs ? #38bdf8 : #a1a1aa;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: AppData.show_logs ? "Hide Logs" : "Show Logs";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: AppData.show_logs ? #f4f4f5 : #a1a1aa;
                                }
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.toggle_logs(); }
                        }
                    }
                }
            }
        }
    }
}
}
