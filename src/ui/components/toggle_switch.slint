import { Theme } from "../theme.slint";

export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> is_disabled: false;
    callback toggled(bool);

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.is_disabled ? Theme.control_bg : (root.checked ? (ta.has-hover ? Theme.accent_primary_hover : Theme.accent_primary) : (ta.has-hover ? Theme.control_hover : Theme.control_bg));
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.focus_ring : Theme.border_color;

    animate background { duration: 160ms; easing: ease-out; }
    animate border-color { duration: 160ms; easing: ease-out; }

    knob := Rectangle {
        x: root.checked ? (root.width - self.width - 3px) : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.is_disabled ? Theme.text_faint : #ffffff;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000044;

        animate x { duration: 160ms; easing: ease-out; }
    }

    fs := FocusScope {
        enabled: !root.is_disabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            reject
        }

        ta := TouchArea {
            width: 100%;
            height: 100%;
            enabled: !root.is_disabled;
            mouse-cursor: root.is_disabled ? default : pointer;
            clicked => {
                fs.focus();
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}
