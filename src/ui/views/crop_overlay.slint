import { AppLogic } from "../globals.slint";
import { Theme } from "../theme.slint";

component CropResizeHandle inherits Rectangle {
    in property <int> handle_id;
    in property <length> overlay_abs_x;
    in property <length> overlay_abs_y;
    in property <length> overlay_width;
    in property <length> overlay_height;
    in property <MouseCursor> cursor: default;
    in property <color> idle_bg: Theme.accent_lime;
    callback focus_requested();

    border-radius: 3px;
    background: ta.has-hover || ta.pressed ? Theme.accent_amber : root.idle_bg;

    ta := TouchArea {
        mouse-cursor: root.cursor;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                root.focus_requested();
                if root.overlay_width > 0px && root.overlay_height > 0px {
                    AppLogic.crop_handle_drag_start(
                        root.handle_id,
                        ((self.absolute-position.x + self.mouse-x - root.overlay_abs_x) / root.overlay_width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.overlay_abs_y) / root.overlay_height).clamp(0.0, 1.0)
                    );
                }
            } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                AppLogic.crop_handle_drag_end();
            }
        }
        moved => {
            if self.pressed && root.overlay_width > 0px && root.overlay_height > 0px {
                AppLogic.crop_handle_drag(
                    root.handle_id,
                    ((self.absolute-position.x + self.mouse-x - root.overlay_abs_x) / root.overlay_width).clamp(0.0, 1.0),
                    ((self.absolute-position.y + self.mouse-y - root.overlay_abs_y) / root.overlay_height).clamp(0.0, 1.0)
                );
            }
        }
    }
}

export component CropOverlayView inherits Rectangle {
    in property <float> norm_x: 0.0;
    in property <float> norm_y: 0.0;
    in property <float> norm_w: 1.0;
    in property <float> norm_h: 1.0;
    in property <int> crop_px_w: 1920;
    in property <int> crop_px_h: 1080;
    in property <int> crop_px_x: 0;
    in property <int> crop_px_y: 0;
    callback focus_requested();

    property <length> box_x: root.width * root.norm_x.clamp(0.0, 1.0);
    property <length> box_y: root.height * root.norm_y.clamp(0.0, 1.0);
    property <length> box_w: max(16px, root.width * root.norm_w.clamp(0.02, 1.0));
    property <length> box_h: max(16px, root.height * root.norm_h.clamp(0.02, 1.0));

    // Dimmed regions outside the crop frame
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: max(0px, root.box_y);
        background: Theme.overlay_mask;
    }
    Rectangle {
        x: 0px;
        y: root.box_y + root.box_h;
        width: root.width;
        height: max(0px, root.height - (root.box_y + root.box_h));
        background: Theme.overlay_mask;
    }
    Rectangle {
        x: 0px;
        y: root.box_y;
        width: max(0px, root.box_x);
        height: root.box_h;
        background: Theme.overlay_mask;
    }
    Rectangle {
        x: root.box_x + root.box_w;
        y: root.box_y;
        width: max(0px, root.width - (root.box_x + root.box_w));
        height: root.box_h;
        background: Theme.overlay_mask;
    }

    // Active crop frame
    crop_box := Rectangle {
        x: root.box_x;
        y: root.box_y;
        width: root.box_w;
        height: root.box_h;
        border-width: 1.5px;
        border-color: Theme.accent_lime;
        background: Theme.accent_lime.with-alpha(0.03);

        // Rule-of-thirds grid
        Rectangle {
            x: parent.width / 3;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: Theme.text_primary.with-alpha(0.22);
        }
        Rectangle {
            x: (parent.width * 2) / 3;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: Theme.text_primary.with-alpha(0.22);
        }
        Rectangle {
            x: 0px;
            y: parent.height / 3;
            width: parent.width;
            height: 1px;
            background: Theme.text_primary.with-alpha(0.22);
        }
        Rectangle {
            x: 0px;
            y: (parent.height * 2) / 3;
            width: parent.width;
            height: 1px;
            background: Theme.text_primary.with-alpha(0.22);
        }

        // Center crosshair
        Rectangle {
            x: (parent.width - 12px) / 2;
            y: (parent.height - 1px) / 2;
            width: 12px;
            height: 1px;
            background: Theme.accent_lime.with-alpha(0.65);
        }
        Rectangle {
            x: (parent.width - 1px) / 2;
            y: (parent.height - 12px) / 2;
            width: 1px;
            height: 12px;
            background: Theme.accent_lime.with-alpha(0.65);
        }

        // Live dimensions badge
        if parent.width > 95px && parent.height > 32px : Rectangle {
            x: 8px;
            y: 8px;
            height: 22px;
            width: dim_txt.preferred-width + 14px;
            border-radius: 5px;
            background: Theme.popup_bg.with-alpha(0.9);
            border-width: 1px;
            border-color: Theme.accent_border;

            dim_txt := Text {
                x: 7px;
                y: (parent.height - self.height) / 2;
                text: "\{root.crop_px_w} × \{root.crop_px_h}  (\{root.crop_px_x}, \{root.crop_px_y})";
                font-size: Theme.font_badge;
                font-family: Theme.font_mono;
                font-weight: 600;
                color: Theme.accent_lime;
            }
        }

        // Interior drag to reposition the crop box
        move_ta := TouchArea {
            mouse-cursor: move;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_box_drag_start(
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_box_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_box_drag_move(
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Corner handles: 0=TL, 1=TR, 2=BL, 3=BR
    CropResizeHandle {
        handle_id: 0;
        x: root.box_x - 6px;
        y: root.box_y - 6px;
        width: 12px;
        height: 12px;
        idle_bg: Theme.text_primary;
        border-width: 2px;
        border-color: Theme.accent_primary;
        cursor: nwse-resize;
        overlay_abs_x: root.absolute-position.x;
        overlay_abs_y: root.absolute-position.y;
        overlay_width: root.width;
        overlay_height: root.height;
        focus_requested => { root.focus_requested(); }
    }
    CropResizeHandle {
        handle_id: 1;
        x: root.box_x + root.box_w - 6px;
        y: root.box_y - 6px;
        width: 12px;
        height: 12px;
        idle_bg: Theme.text_primary;
        border-width: 2px;
        border-color: Theme.accent_primary;
        cursor: nesw-resize;
        overlay_abs_x: root.absolute-position.x;
        overlay_abs_y: root.absolute-position.y;
        overlay_width: root.width;
        overlay_height: root.height;
        focus_requested => { root.focus_requested(); }
    }
    CropResizeHandle {
        handle_id: 2;
        x: root.box_x - 6px;
        y: root.box_y + root.box_h - 6px;
        width: 12px;
        height: 12px;
        idle_bg: Theme.text_primary;
        border-width: 2px;
        border-color: Theme.accent_primary;
        cursor: nesw-resize;
        overlay_abs_x: root.absolute-position.x;
        overlay_abs_y: root.absolute-position.y;
        overlay_width: root.width;
        overlay_height: root.height;
        focus_requested => { root.focus_requested(); }
    }
    CropResizeHandle {
        handle_id: 3;
        x: root.box_x + root.box_w - 6px;
        y: root.box_y + root.box_h - 6px;
        width: 12px;
        height: 12px;
        idle_bg: Theme.text_primary;
        border-width: 2px;
        border-color: Theme.accent_primary;
        cursor: nwse-resize;
        overlay_abs_x: root.absolute-position.x;
        overlay_abs_y: root.absolute-position.y;
        overlay_width: root.width;
        overlay_height: root.height;
        focus_requested => { root.focus_requested(); }
    }

    // Edge handles: 4=Top, 5=Bottom, 6=Left, 7=Right
    CropResizeHandle {
        handle_id: 4;
        x: root.box_x + (root.box_w - 24px) / 2;
        y: root.box_y - 3.5px;
        width: 24px;
        height: 7px;
        cursor: ns-resize;
        overlay_abs_x: root.absolute-position.x;
        overlay_abs_y: root.absolute-position.y;
        overlay_width: root.width;
        overlay_height: root.height;
        focus_requested => { root.focus_requested(); }
    }
    CropResizeHandle {
        handle_id: 5;
        x: root.box_x + (root.box_w - 24px) / 2;
        y: root.box_y + root.box_h - 3.5px;
        width: 24px;
        height: 7px;
        cursor: ns-resize;
        overlay_abs_x: root.absolute-position.x;
        overlay_abs_y: root.absolute-position.y;
        overlay_width: root.width;
        overlay_height: root.height;
        focus_requested => { root.focus_requested(); }
    }
    CropResizeHandle {
        handle_id: 6;
        x: root.box_x - 3.5px;
        y: root.box_y + (root.box_h - 24px) / 2;
        width: 7px;
        height: 24px;
        cursor: ew-resize;
        overlay_abs_x: root.absolute-position.x;
        overlay_abs_y: root.absolute-position.y;
        overlay_width: root.width;
        overlay_height: root.height;
        focus_requested => { root.focus_requested(); }
    }
    CropResizeHandle {
        handle_id: 7;
        x: root.box_x + root.box_w - 3.5px;
        y: root.box_y + (root.box_h - 24px) / 2;
        width: 7px;
        height: 24px;
        cursor: ew-resize;
        overlay_abs_x: root.absolute-position.x;
        overlay_abs_y: root.absolute-position.y;
        overlay_width: root.width;
        overlay_height: root.height;
        focus_requested => { root.focus_requested(); }
    }
}
