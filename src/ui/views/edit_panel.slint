import { ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";
import { AppData, AppLogic, Theme } from "../globals.slint";
import { NumInput } from "../components/num_input.slint";
import { IconButton } from "../components/icon_button.slint";
import { ActionButton } from "../components/action_button.slint";

export component EditPanel inherits HorizontalLayout {
    callback request_focus();

                spacing: 0px;

                // Vertical Divider
                Rectangle { width: 1px; background: Theme.panel_border; }

                // Collapse / Expand Toggle Strip Bar + Panel Content
                Rectangle {
                    width: AppData.edit_panel_expanded ? 320px : 34px;
                    background: Theme.panel_bg;
                    clip: true;

                    animate width { duration: 160ms; }

                    // COLLAPSED STATE: Slim Vertical Expand Strip
                    if !AppData.edit_panel_expanded : VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 8px;
                        alignment: start;

                        HorizontalLayout {
                            alignment: center;
                            IconButton {
                                btn_width: 26px;
                                btn_height: 26px;
                                icon_source: @image-url("../icons/chevron-left.svg");
                                has_icon: true;
                                icon_size: 13px;
                                text_color: (AppData.has_active_video_edits || AppData.has_active_audio_edits) ? #38bdf8 : #a1a1aa;
                                hover_bg: #26262e;
                                clicked => { AppLogic.toggle_edit_panel(); }
                            }
                        }

                        if (AppData.has_active_video_edits || AppData.has_active_audio_edits) : HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #38bdf8;
                            }
                        }
                    }

                    // EXPANDED STATE: Full Video Editing Controls Column
                    if AppData.edit_panel_expanded : VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        // Panel Header Row
                        HorizontalLayout {
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/sliders.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: #38bdf8;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Editing";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.text_primary;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if (AppData.has_active_video_edits || AppData.has_active_audio_edits) : VerticalLayout {
                                alignment: center;
                                ActionButton {
                                    width: 58px;
                                    height: 22px;
                                    title: "Reset All";
                                    fill_color: Theme.btn_neutral_bg;
                                    hover_color: Theme.btn_neutral_hover;
                                    text_color: #f87171;
                                    font_size: 9.5px;
                                    clicked => { AppLogic.reset_all_edits(); }
                                }
                            }

                            IconButton {
                                btn_width: 24px;
                                btn_height: 24px;
                                icon_source: @image-url("../icons/chevron-right.svg");
                                has_icon: true;
                                icon_size: 13px;
                                hover_bg: Theme.control_hover;
                                clicked => { AppLogic.toggle_edit_panel(); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.card_border; }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding-right: 4px;
                                spacing: 8px;
                                alignment: start;

                                // SECTION 1: ROTATION (0, 90, -90, 180 DEGREES)
                                if AppData.selected_is_video : Rectangle {
                                    border-radius: 7px;
                                    background: Theme.card_bg;
                                    border-width: 1px;
                                    border-color: AppData.video_rotation_index != 0 ? #38bdf866 : Theme.card_border;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            Text {
                                                text: "Rotate Video";
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: Theme.text_primary;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text {
                                                text: AppData.video_rotation_index == 0 ? "0° (Original)" :
                                                      (AppData.video_rotation_index == 1 ? "90° CW" :
                                                      (AppData.video_rotation_index == 2 ? "-90° CCW" : "180° Upside Down"));
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: AppData.video_rotation_index != 0 ? #38bdf8 : Theme.text_muted;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "0°";
                                                fill_color: AppData.video_rotation_index == 0 ? #0284c7 : Theme.btn_neutral_bg;
                                                hover_color: AppData.video_rotation_index == 0 ? #0369a1 : Theme.btn_neutral_hover;
                                                text_color: AppData.video_rotation_index == 0 ? #ffffff : Theme.btn_neutral_text;
                                                font_size: 11px;
                                                clicked => { AppLogic.set_video_rotation(0); }
                                            }

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "90°";
                                                fill_color: AppData.video_rotation_index == 1 ? #0284c7 : Theme.btn_neutral_bg;
                                                hover_color: AppData.video_rotation_index == 1 ? #0369a1 : Theme.btn_neutral_hover;
                                                text_color: AppData.video_rotation_index == 1 ? #ffffff : Theme.btn_neutral_text;
                                                font_size: 11px;
                                                clicked => { AppLogic.set_video_rotation(1); }
                                            }

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "-90°";
                                                fill_color: AppData.video_rotation_index == 2 ? #0284c7 : Theme.btn_neutral_bg;
                                                hover_color: AppData.video_rotation_index == 2 ? #0369a1 : Theme.btn_neutral_hover;
                                                text_color: AppData.video_rotation_index == 2 ? #ffffff : Theme.btn_neutral_text;
                                                font_size: 11px;
                                                clicked => { AppLogic.set_video_rotation(2); }
                                            }

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "180°";
                                                fill_color: AppData.video_rotation_index == 3 ? #0284c7 : Theme.btn_neutral_bg;
                                                hover_color: AppData.video_rotation_index == 3 ? #0369a1 : Theme.btn_neutral_hover;
                                                text_color: AppData.video_rotation_index == 3 ? #ffffff : Theme.btn_neutral_text;
                                                font_size: 11px;
                                                clicked => { AppLogic.set_video_rotation(3); }
                                            }
                                        }
                                    }
                                }

                                // SECTION 2: MIRROR / FLIP (HORIZONTAL & VERTICAL)
                                if AppData.selected_is_video : Rectangle {
                                    border-radius: 7px;
                                    background: Theme.card_bg;
                                    border-width: 1px;
                                    border-color: (AppData.video_flip_horizontal || AppData.video_flip_vertical) ? #38bdf866 : Theme.card_border;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            Text {
                                                text: "Mirror & Flip";
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: Theme.text_primary;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text {
                                                text: (AppData.video_flip_horizontal && AppData.video_flip_vertical) ? "H + V Flipped" :
                                                      (AppData.video_flip_horizontal ? "Horizontal Mirror" :
                                                      (AppData.video_flip_vertical ? "Vertical Flip" : "Normal"));
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: (AppData.video_flip_horizontal || AppData.video_flip_vertical) ? #38bdf8 : Theme.text_muted;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "Flip Horizontal";
                                                fill_color: AppData.video_flip_horizontal ? #0284c7 : Theme.btn_neutral_bg;
                                                hover_color: AppData.video_flip_horizontal ? #0369a1 : Theme.btn_neutral_hover;
                                                text_color: AppData.video_flip_horizontal ? #ffffff : Theme.btn_neutral_text;
                                                font_size: 10.5px;
                                                clicked => { AppLogic.toggle_flip_horizontal(); }
                                            }

                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                title: "Flip Vertical";
                                                fill_color: AppData.video_flip_vertical ? #0284c7 : Theme.btn_neutral_bg;
                                                hover_color: AppData.video_flip_vertical ? #0369a1 : Theme.btn_neutral_hover;
                                                text_color: AppData.video_flip_vertical ? #ffffff : Theme.btn_neutral_text;
                                                font_size: 10.5px;
                                                clicked => { AppLogic.toggle_flip_vertical(); }
                                            }
                                        }
                                    }
                                }

                                // SECTION 3: VISUAL CROP OVERLAY & ASPECT RATIO LOCK
                                if AppData.selected_is_video : Rectangle {
                                    border-radius: 7px;
                                    background: Theme.card_bg;
                                    border-width: 1px;
                                    border-color: AppData.crop_enabled ? #38bdf8 : Theme.card_border;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        // Header + Crop Enable Toggle
                                        HorizontalLayout {
                                            spacing: 6px;
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Video Crop Zone";
                                                    font-size: 11.5px;
                                                    font-weight: 700;
                                                    color: #e2e8f0;
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            ActionButton {
                                                width: 106px;
                                                height: 24px;
                                                title: AppData.crop_enabled ? "Crop Active" : "Enable Crop";
                                                fill_color: AppData.crop_enabled ? #059669 : #1c1c22;
                                                hover_color: AppData.crop_enabled ? #047857 : #2a2a30;
                                                text_color: AppData.crop_enabled ? #ffffff : #38bdf8;
                                                font_size: 10.5px;
                                                clicked => {
                                                    AppLogic.toggle_crop_enabled();
                                                    root.request_focus();
                                                }
                                            }
                                        }

                                        // Aspect Ratio Presets Dropdown
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text {
                                                text: "Aspect Ratio Lock Preset:";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: #a1a1aa;
                                            }
                                            ComboBox {
                                                height: 26px;
                                                model: AppData.crop_aspect_options;
                                                current-index <=> AppData.crop_aspect_index;
                                                selected(_) => {
                                                    AppLogic.set_crop_aspect_preset(self.current-index);
                                                    root.request_focus();
                                                }
                                            }
                                        }

                                        // Popular Aspect Ratio Quick Pills (Row 1: Free, 16:9, 9:16, 4:3, 3:4)
                                        HorizontalLayout {
                                            spacing: 4px;
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "Free";
                                                fill_color: AppData.crop_aspect_index == 0 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(0); root.request_focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "16:9";
                                                fill_color: AppData.crop_aspect_index == 1 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(1); root.request_focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "9:16";
                                                fill_color: AppData.crop_aspect_index == 2 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(2); root.request_focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "4:3";
                                                fill_color: AppData.crop_aspect_index == 3 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(3); root.request_focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "3:4";
                                                fill_color: AppData.crop_aspect_index == 4 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(4); root.request_focus(); }
                                            }
                                        }

                                        // Popular Aspect Ratio Quick Pills (Row 2: 1:1, 2:3, 3:2, 21:9, 4:5)
                                        HorizontalLayout {
                                            spacing: 4px;
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "1:1";
                                                fill_color: AppData.crop_aspect_index == 5 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(5); root.request_focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "2:3";
                                                fill_color: AppData.crop_aspect_index == 6 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(6); root.request_focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "3:2";
                                                fill_color: AppData.crop_aspect_index == 7 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(7); root.request_focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "21:9";
                                                fill_color: AppData.crop_aspect_index == 8 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(8); root.request_focus(); }
                                            }
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                title: "4:5";
                                                fill_color: AppData.crop_aspect_index == 9 ? #0284c7 : #1c1c22;
                                                hover_color: #2a2a32;
                                                font_size: 9.5px;
                                                clicked => { AppLogic.set_crop_aspect_preset(9); root.request_focus(); }
                                            }
                                        }

                                        // Manual Width & Height Inputs
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "Crop Box Dimensions (Pixels):";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: #a1a1aa;
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 2px;
                                                    Text { text: "Width (W)"; font-size: 9.5px; color: #71717a; }
                                                    NumInput {
                                                        text <=> AppData.crop_width_text;
                                                        placeholder: "Width";
                                                        edited(val) => { AppLogic.crop_width_edited(val); }
                                                        accepted => { root.request_focus(); }
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 2px;
                                                    Text { text: "Height (H)"; font-size: 9.5px; color: #71717a; }
                                                    NumInput {
                                                        text <=> AppData.crop_height_text;
                                                        placeholder: "Height";
                                                        edited(val) => { AppLogic.crop_height_edited(val); }
                                                        accepted => { root.request_focus(); }
                                                    }
                                                }
                                            }
                                        }

                                        // Manual X & Y Position Inputs
                                        HorizontalLayout {
                                            spacing: 6px;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                Text { text: "Position X"; font-size: 9.5px; color: #71717a; }
                                                NumInput {
                                                    text <=> AppData.crop_x_text;
                                                    placeholder: "X";
                                                    edited(val) => { AppLogic.crop_x_edited(val); }
                                                    accepted => { root.request_focus(); }
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                Text { text: "Position Y"; font-size: 9.5px; color: #71717a; }
                                                NumInput {
                                                    text <=> AppData.crop_y_text;
                                                    placeholder: "Y";
                                                    edited(val) => { AppLogic.crop_y_edited(val); }
                                                    accepted => { root.request_focus(); }
                                                }
                                            }
                                        }

                                        // Arrow Keys Nudge Option & Directional Controls
                                        Rectangle {
                                            border-radius: 5px;
                                            background: #111114;
                                            border-width: 1px;
                                            border-color: #1c1c22;

                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 6px;

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        AppData.crop_arrow_keys_enabled = !AppData.crop_arrow_keys_enabled;
                                                        root.request_focus();
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 7px;
                                                        alignment: start;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Rectangle {
                                                                width: 16px;
                                                                height: 16px;
                                                                border-radius: 4px;
                                                                background: AppData.crop_arrow_keys_enabled ? #0284c7 : #1c1c22;
                                                                border-width: 1px;
                                                                border-color: AppData.crop_arrow_keys_enabled ? #38bdf8 : #383840;
                                                                if AppData.crop_arrow_keys_enabled : Text {
                                                                    text: "✓";
                                                                    font-size: 11px;
                                                                    font-weight: 700;
                                                                    color: #ffffff;
                                                                    horizontal-alignment: center;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: "Use Arrow Keys to Move Crop Box";
                                                                font-size: 10.5px;
                                                                font-weight: 500;
                                                                color: #e2e8f0;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    alignment: center;

                                                    ActionButton {
                                                        width: 32px;
                                                        height: 24px;
                                                        title: "←";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        font_size: 11px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.crop_nudge(-AppData.crop_nudge_step, 0); root.request_focus(); }
                                                    }
                                                    ActionButton {
                                                        width: 32px;
                                                        height: 24px;
                                                        title: "↑";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        font_size: 11px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.crop_nudge(0, -AppData.crop_nudge_step); root.request_focus(); }
                                                    }
                                                    ActionButton {
                                                        width: 32px;
                                                        height: 24px;
                                                        title: "↓";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        font_size: 11px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.crop_nudge(0, AppData.crop_nudge_step); root.request_focus(); }
                                                    }
                                                    ActionButton {
                                                        width: 32px;
                                                        height: 24px;
                                                        title: "→";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        font_size: 11px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.crop_nudge(AppData.crop_nudge_step, 0); root.request_focus(); }
                                                    }
                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "Center";
                                                        fill_color: #1c1c22;
                                                        hover_color: #2a2a32;
                                                        text_color: #38bdf8;
                                                        font_size: 10px;
                                                        is_disabled: !AppData.crop_enabled;
                                                        clicked => { AppLogic.center_crop_box(); root.request_focus(); }
                                                    }
                                                }
                                            }
                                        }

                                        // Reset Crop Button
                                        HorizontalLayout {
                                            spacing: 6px;
                                            ActionButton {
                                                horizontal-stretch: 1;
                                                height: 26px;
                                                title: "Reset Crop to Full Frame";
                                                icon_source: @image-url("../icons/reset.svg");
                                                has_icon: true;
                                                icon_size: 11px;
                                                fill_color: #1c1c22;
                                                hover_color: #2a2a32;
                                                text_color: #a1a1aa;
                                                font_size: 10.5px;
                                                clicked => { AppLogic.reset_crop(); root.request_focus(); }
                                            }
                                        }
                                    }
                                }

                                // SECTION 4: AUDIO EDIT (Volume Gain in dB & Loudness Normalization)
                                Rectangle {
                                    border-radius: 7px;
                                    background: Theme.card_bg;
                                    border-width: 1px;
                                    border-color: AppData.has_active_audio_edits ? #38bdf866 : Theme.card_border;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 10px;

                                        // Section Title Row
                                        HorizontalLayout {
                                            spacing: 6px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../icons/volume-2.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    colorize: #38bdf8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Audio Edit";
                                                    font-size: 11.5px;
                                                    font-weight: 700;
                                                    color: Theme.text_primary;
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if AppData.has_active_audio_edits : ActionButton {
                                                width: 48px;
                                                height: 20px;
                                                title: "Reset";
                                                fill_color: Theme.btn_neutral_bg;
                                                hover_color: Theme.btn_neutral_hover;
                                                text_color: #fbbf24;
                                                font_size: 9px;
                                                clicked => { AppLogic.reset_audio_edits(); }
                                            }
                                        }

                                        // Sub-section A: Sound Volume (dB)
                                        VerticalLayout {
                                            spacing: 6px;

                                            HorizontalLayout {
                                                Text {
                                                    text: "Volume Gain / Attenuation:";
                                                    font-size: 10.5px;
                                                    font-weight: 600;
                                                    color: #a1a1aa;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                Text {
                                                    text: AppData.audio_gain_text;
                                                    font-size: 11px;
                                                    font-weight: 800;
                                                    color: AppData.audio_gain_db > 0.05 ? #34d399 :
                                                          (AppData.audio_gain_db < -0.05 ? #fbbf24 : #38bdf8);
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Continuous Slider for dB (-24.0 to +24.0 dB)
                                            HorizontalLayout {
                                                spacing: 8px;

                                                Text { text: "-24dB"; font-size: 9px; color: #71717a; vertical-alignment: center; }

                                                Slider {
                                                    horizontal-stretch: 1;
                                                    minimum: -24.0;
                                                    maximum: 24.0;
                                                    value: AppData.audio_gain_db;
                                                    changed(val) => {
                                                        AppLogic.set_audio_gain_db(val);
                                                    }
                                                }

                                                Text { text: "+24dB"; font-size: 9px; color: #71717a; vertical-alignment: center; }
                                            }

                                            // Quick Preset dB Buttons
                                            HorizontalLayout {
                                                spacing: 4px;

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "-12dB";
                                                    fill_color: AppData.audio_gain_db == -12.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == -12.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == -12.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(-12.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "-6dB";
                                                    fill_color: AppData.audio_gain_db == -6.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == -6.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == -6.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(-6.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "0 dB";
                                                    fill_color: (AppData.audio_gain_db > -0.05 && AppData.audio_gain_db < 0.05) ? #0284c7 : #1c1c22;
                                                    hover_color: (AppData.audio_gain_db > -0.05 && AppData.audio_gain_db < 0.05) ? #0369a1 : #2a2a30;
                                                    text_color: (AppData.audio_gain_db > -0.05 && AppData.audio_gain_db < 0.05) ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(0.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "+3dB";
                                                    fill_color: AppData.audio_gain_db == 3.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == 3.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == 3.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(3.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "+6dB";
                                                    fill_color: AppData.audio_gain_db == 6.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == 6.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == 6.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(6.0); }
                                                }

                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    title: "+12dB";
                                                    fill_color: AppData.audio_gain_db == 12.0 ? #0284c7 : #1c1c22;
                                                    hover_color: AppData.audio_gain_db == 12.0 ? #0369a1 : #2a2a30;
                                                    text_color: AppData.audio_gain_db == 12.0 ? #ffffff : #d4d4d8;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.set_audio_gain_db(12.0); }
                                                }
                                            }

                                            // Fine tuning +/- 1dB buttons
                                            HorizontalLayout {
                                                spacing: 6px;
                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 22px;
                                                    title: "-1.0 dB";
                                                    fill_color: #1c1c22;
                                                    hover_color: #2a2a32;
                                                    text_color: #a1a1aa;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.step_audio_gain_db(-1.0); }
                                                }
                                                ActionButton {
                                                    horizontal-stretch: 1;
                                                    height: 22px;
                                                    title: "+1.0 dB";
                                                    fill_color: #1c1c22;
                                                    hover_color: #2a2a32;
                                                    text_color: #a1a1aa;
                                                    font_size: 9.5px;
                                                    clicked => { AppLogic.step_audio_gain_db(1.0); }
                                                }
                                            }
                                        }

                                        Rectangle { height: 1px; background: Theme.card_border; }

                                        // Sub-section B: Loudness Normalization
                                        VerticalLayout {
                                            spacing: 6px;

                                            // Toggle Card
                                            Rectangle {
                                                height: 32px;
                                                border-radius: 5px;
                                                background: AppData.audio_normalize_enabled ? #0284c722 : Theme.card_secondary_bg;
                                                border-width: 1px;
                                                border-color: AppData.audio_normalize_enabled ? #0284c766 : Theme.card_border;

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { AppLogic.toggle_audio_normalize(); }
                                                }

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;

                                                    // Custom Checkbox
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            width: 16px;
                                                            height: 16px;
                                                            border-radius: 4px;
                                                            background: AppData.audio_normalize_enabled ? #0284c7 : Theme.control_bg;
                                                            border-width: 1px;
                                                            border-color: AppData.audio_normalize_enabled ? #38bdf8 : Theme.border_color;

                                                            if AppData.audio_normalize_enabled : Text {
                                                                text: "✓";
                                                                font-size: 11px;
                                                                font-weight: 800;
                                                                color: #ffffff;
                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: "Normalize Audio (EBU R128)";
                                                            font-size: 10.5px;
                                                            font-weight: 700;
                                                            color: AppData.audio_normalize_enabled ? #fafafa : #d4d4d8;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    Rectangle { horizontal-stretch: 1; }

                                                    if AppData.audio_normalize_enabled : VerticalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: "\{AppData.audio_normalize_lufs} LUFS";
                                                            font-size: 10px;
                                                            font-weight: 800;
                                                            color: #38bdf8;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            // Normalization Target Presets
                                            if AppData.audio_normalize_enabled : VerticalLayout {
                                                spacing: 4px;
                                                padding-top: 2px;

                                                Text {
                                                    text: "Target Loudness Level:";
                                                    font-size: 9.5px;
                                                    font-weight: 600;
                                                    color: #71717a;
                                                }

                                                HorizontalLayout {
                                                    spacing: 4px;

                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "-16 LUFS";
                                                        fill_color: AppData.audio_normalize_preset_index == 0 ? #0284c7 : #1c1c22;
                                                        hover_color: AppData.audio_normalize_preset_index == 0 ? #0369a1 : #2a2a30;
                                                        text_color: AppData.audio_normalize_preset_index == 0 ? #ffffff : #d4d4d8;
                                                        font_size: 9px;
                                                        clicked => { AppLogic.set_audio_normalize_preset(0); }
                                                    }

                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "-14 LUFS";
                                                        fill_color: AppData.audio_normalize_preset_index == 1 ? #0284c7 : #1c1c22;
                                                        hover_color: AppData.audio_normalize_preset_index == 1 ? #0369a1 : #2a2a30;
                                                        text_color: AppData.audio_normalize_preset_index == 1 ? #ffffff : #d4d4d8;
                                                        font_size: 9px;
                                                        clicked => { AppLogic.set_audio_normalize_preset(1); }
                                                    }

                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "-23 LUFS";
                                                        fill_color: AppData.audio_normalize_preset_index == 2 ? #0284c7 : #1c1c22;
                                                        hover_color: AppData.audio_normalize_preset_index == 2 ? #0369a1 : #2a2a30;
                                                        text_color: AppData.audio_normalize_preset_index == 2 ? #ffffff : #d4d4d8;
                                                        font_size: 9px;
                                                        clicked => { AppLogic.set_audio_normalize_preset(2); }
                                                    }

                                                    ActionButton {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        title: "-12 LUFS";
                                                        fill_color: AppData.audio_normalize_preset_index == 3 ? #0284c7 : #1c1c22;
                                                        hover_color: AppData.audio_normalize_preset_index == 3 ? #0369a1 : #2a2a30;
                                                        text_color: AppData.audio_normalize_preset_index == 3 ? #ffffff : #d4d4d8;
                                                        font_size: 9px;
                                                        clicked => { AppLogic.set_audio_normalize_preset(3); }
                                                    }
                                                }
                                            }
                                        }

                                        // Realtime Preview Status Indicator Pill
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: #141418;
                                            border-width: 1px;
                                            border-color: #1c1c22;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 5px;
                                                alignment: center;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../icons/play.svg");
                                                        width: 10px;
                                                        height: 10px;
                                                        colorize: #38bdf8;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "Real-time preview in player • Applied on RUN TASK";
                                                        font-size: 9px;
                                                        color: #a1a1aa;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Canvas Info Summary Footer
                                if AppData.selected_is_video : Rectangle {
                                    border-radius: 6px;
                                    background: #141418;
                                    border-width: 1px;
                                    border-color: #1c1c22;

                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 3px;

                                        Text {
                                            text: "Source Canvas: \{AppData.selected_video_width} × \{AppData.selected_video_height} px";
                                            font-size: 10px;
                                            color: #71717a;
                                        }
                                        Text {
                                            text: "Output Canvas: \{AppData.crop_enabled ? AppData.crop_width : AppData.effective_video_width} × \{AppData.crop_enabled ? AppData.crop_height : AppData.effective_video_height} px";
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            color: #38bdf8;
                                        }
                                    }
                                }
                            }
                        }
                    }
    }
}
