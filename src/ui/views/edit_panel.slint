import { ScrollView } from "std-widgets.slint";
import { AppData, AppLogic, Theme } from "../globals.slint";
import { NumInput } from "../components/num_input.slint";
import { IconButton } from "../components/icon_button.slint";
import { ActionButton } from "../components/action_button.slint";
import { SelectBox } from "../components/select_box.slint";
import { RangeSlider } from "../components/range_slider.slint";

component ChoicePillButton inherits ActionButton {
    in property <bool> active: false;

    horizontal-stretch: 1;
    height: Theme.btn_height_sm;
    pad_horizontal: 4px;
    fill_color: root.active ? Theme.accent_surface : Theme.btn_neutral_bg;
    hover_color: root.active ? Theme.accent_surface_hover : Theme.btn_neutral_hover;
    text_color: root.active ? Theme.accent_lime : Theme.btn_neutral_text;
    border_col: root.active ? Theme.accent_border : Theme.btn_neutral_border;
    normal_border_width: 1px;
    font_size: Theme.font_badge;
}

export component EditPanel inherits HorizontalLayout {
    callback request_focus();
    property <bool> confirm_reset: false;

    horizontal-stretch: 0;

    Rectangle { width: 1px; background: Theme.panel_border; }

    Rectangle {
        width: AppData.edit_panel_expanded ? 320px : 34px;
        background: Theme.panel_bg;
        clip: true;

        animate width { duration: 160ms; easing: ease-out; }

        // Collapsed expand strip
        if !AppData.edit_panel_expanded : VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 8px;
            alignment: start;

            HorizontalLayout {
                alignment: center;
                IconButton {
                    btn_width: 26px;
                    btn_height: Theme.btn_height_sm;
                    icon_source: @image-url("../icons/chevron-left.svg");
                    has_icon: true;
                    text_color: (AppData.has_active_video_edits || AppData.has_active_audio_edits) ? Theme.accent_lime : Theme.text_muted;
                    hover_bg: Theme.control_hover;
                    clicked => { AppLogic.toggle_edit_panel(); }
                }
            }

            if (AppData.has_active_video_edits || AppData.has_active_audio_edits) : HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.accent_lime;
                }
            }
        }

        // Expanded editing controls
        if AppData.edit_panel_expanded : VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 7px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/sliders.svg");
                        width: 14px;
                        height: 14px;
                        colorize: Theme.accent_lime;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Editing";
                        font-size: Theme.font_body;
                        font-weight: 700;
                        color: Theme.text_heading;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if (AppData.has_active_video_edits || AppData.has_active_audio_edits) : VerticalLayout {
                    alignment: center;
                    ActionButton {
                        width: root.confirm_reset ? 78px : 68px;
                        height: Theme.btn_height_sm;
                        title: root.confirm_reset ? "Confirm?" : "Reset All";
                        fill_color: root.confirm_reset ? Theme.accent_red_solid : Theme.red_surface;
                        hover_color: root.confirm_reset ? Theme.accent_red_hover : Theme.red_surface_hover;
                        text_color: root.confirm_reset ? #ffffff : Theme.accent_red_text;
                        border_col: Theme.red_border;
                        normal_border_width: 1px;
                        font_size: Theme.font_badge;
                        clicked => {
                            if root.confirm_reset {
                                root.confirm_reset = false;
                                AppLogic.reset_all_edits();
                            } else {
                                root.confirm_reset = true;
                            }
                        }
                    }
                }

                IconButton {
                    btn_width: 24px;
                    btn_height: Theme.btn_height_sm;
                    icon_source: @image-url("../icons/chevron-right.svg");
                    has_icon: true;
                    text_color: Theme.text_muted;
                    hover_bg: Theme.control_hover;
                    clicked => { AppLogic.toggle_edit_panel(); }
                }
            }

            Rectangle { height: 1px; background: Theme.card_border; }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: 100%;
                    padding-right: 12px;
                    spacing: 10px;
                    alignment: start;

                    // Video rotation
                    if AppData.selected_is_video : Rectangle {
                        border-radius: Theme.radius_md;
                        background: Theme.card_bg;
                        border-width: 1px;
                        border-color: AppData.video_rotation_index != 0 ? Theme.accent_border : Theme.card_border;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                Text {
                                    text: "Rotate Video";
                                    font-size: Theme.font_caption;
                                    font-weight: 700;
                                    color: Theme.text_heading;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: AppData.video_rotation_index == 0 ? "0° (Original)" :
                                          (AppData.video_rotation_index == 1 ? "90° CW" :
                                          (AppData.video_rotation_index == 2 ? "-90° CCW" : "180°"));
                                    font-size: Theme.font_badge;
                                    font-weight: 600;
                                    color: AppData.video_rotation_index != 0 ? Theme.accent_lime : Theme.text_muted;
                                }
                            }

                            HorizontalLayout {
                                spacing: 5px;
                                ChoicePillButton { title: "0°"; active: AppData.video_rotation_index == 0; clicked => { AppLogic.set_video_rotation(0); } }
                                ChoicePillButton { title: "90°"; active: AppData.video_rotation_index == 1; clicked => { AppLogic.set_video_rotation(1); } }
                                ChoicePillButton { title: "-90°"; active: AppData.video_rotation_index == 2; clicked => { AppLogic.set_video_rotation(2); } }
                                ChoicePillButton { title: "180°"; active: AppData.video_rotation_index == 3; clicked => { AppLogic.set_video_rotation(3); } }
                            }
                        }
                    }

                    // Mirror & flip
                    if AppData.selected_is_video : Rectangle {
                        border-radius: Theme.radius_md;
                        background: Theme.card_bg;
                        border-width: 1px;
                        border-color: (AppData.video_flip_horizontal || AppData.video_flip_vertical) ? Theme.accent_border : Theme.card_border;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                Text {
                                    text: "Mirror & Flip";
                                    font-size: Theme.font_caption;
                                    font-weight: 700;
                                    color: Theme.text_heading;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: (AppData.video_flip_horizontal && AppData.video_flip_vertical) ? "H + V Flipped" :
                                          (AppData.video_flip_horizontal ? "Horizontal" :
                                          (AppData.video_flip_vertical ? "Vertical" : "Normal"));
                                    font-size: Theme.font_badge;
                                    font-weight: 600;
                                    color: (AppData.video_flip_horizontal || AppData.video_flip_vertical) ? Theme.accent_lime : Theme.text_muted;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                ChoicePillButton { title: "Flip Horizontal"; pad_horizontal: 10px; active: AppData.video_flip_horizontal; clicked => { AppLogic.toggle_flip_horizontal(); } }
                                ChoicePillButton { title: "Flip Vertical"; pad_horizontal: 10px; active: AppData.video_flip_vertical; clicked => { AppLogic.toggle_flip_vertical(); } }
                            }
                        }
                    }

                    // Visual crop zone
                    if AppData.selected_is_video : Rectangle {
                        border-radius: Theme.radius_md;
                        background: Theme.card_bg;
                        border-width: 1px;
                        border-color: Theme.card_border;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 9px;

                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Video Crop Zone";
                                        font-size: Theme.font_caption;
                                        font-weight: 700;
                                        color: Theme.text_heading;
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                ActionButton {
                                    width: 104px;
                                    height: Theme.btn_height_sm;
                                    title: AppData.crop_enabled ? "Crop Active" : "Enable Crop";
                                    fill_color: AppData.crop_enabled ? Theme.emerald_surface : Theme.btn_neutral_bg;
                                    hover_color: AppData.crop_enabled ? Theme.emerald_surface_hover : Theme.btn_neutral_hover;
                                    text_color: AppData.crop_enabled ? Theme.accent_green : Theme.btn_neutral_text;
                                    border_col: AppData.crop_enabled ? Theme.emerald_border : Theme.btn_neutral_border;
                                    normal_border_width: 1px;
                                    font_size: Theme.font_badge;
                                    clicked => {
                                        AppLogic.toggle_crop_enabled();
                                        root.request_focus();
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Aspect Ratio Preset";
                                    font-size: Theme.font_badge;
                                    font-weight: 600;
                                    color: Theme.text_muted;
                                }
                                SelectBox {
                                    height: Theme.btn_height_sm;
                                    font_size: Theme.font_badge;
                                    model: AppData.crop_aspect_options;
                                    current-index <=> AppData.crop_aspect_index;
                                    selected(_) => {
                                        AppLogic.set_crop_aspect_preset(self.current-index);
                                        root.request_focus();
                                    }
                                }
                            }

                            // Aspect ratio quick pills (row 1)
                            HorizontalLayout {
                                spacing: 4px;
                                ChoicePillButton { pad_horizontal: 3px; title: "Free"; active: AppData.crop_aspect_index == 0; clicked => { AppLogic.set_crop_aspect_preset(0); root.request_focus(); } }
                                ChoicePillButton { pad_horizontal: 3px; title: "16:9"; active: AppData.crop_aspect_index == 1; clicked => { AppLogic.set_crop_aspect_preset(1); root.request_focus(); } }
                                ChoicePillButton { pad_horizontal: 3px; title: "9:16"; active: AppData.crop_aspect_index == 2; clicked => { AppLogic.set_crop_aspect_preset(2); root.request_focus(); } }
                                ChoicePillButton { pad_horizontal: 3px; title: "4:3"; active: AppData.crop_aspect_index == 3; clicked => { AppLogic.set_crop_aspect_preset(3); root.request_focus(); } }
                                ChoicePillButton { pad_horizontal: 3px; title: "3:4"; active: AppData.crop_aspect_index == 4; clicked => { AppLogic.set_crop_aspect_preset(4); root.request_focus(); } }
                            }

                            // Aspect ratio quick pills (row 2)
                            HorizontalLayout {
                                spacing: 4px;
                                ChoicePillButton { pad_horizontal: 3px; title: "1:1"; active: AppData.crop_aspect_index == 5; clicked => { AppLogic.set_crop_aspect_preset(5); root.request_focus(); } }
                                ChoicePillButton { pad_horizontal: 3px; title: "2:3"; active: AppData.crop_aspect_index == 6; clicked => { AppLogic.set_crop_aspect_preset(6); root.request_focus(); } }
                                ChoicePillButton { pad_horizontal: 3px; title: "3:2"; active: AppData.crop_aspect_index == 7; clicked => { AppLogic.set_crop_aspect_preset(7); root.request_focus(); } }
                                ChoicePillButton { pad_horizontal: 3px; title: "21:9"; active: AppData.crop_aspect_index == 8; clicked => { AppLogic.set_crop_aspect_preset(8); root.request_focus(); } }
                                ChoicePillButton { pad_horizontal: 3px; title: "4:5"; active: AppData.crop_aspect_index == 9; clicked => { AppLogic.set_crop_aspect_preset(9); root.request_focus(); } }
                            }

                            // Manual width/height inputs
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Crop Dimensions (px)";
                                    font-size: Theme.font_badge;
                                    font-weight: 600;
                                    color: Theme.text_muted;
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Width"; font-size: Theme.font_badge; color: Theme.text_muted; }
                                        NumInput {
                                            text <=> AppData.crop_width_text;
                                            placeholder: "Width";
                                            edited(val) => { AppLogic.crop_width_edited(val); }
                                            accepted => { root.request_focus(); }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Height"; font-size: Theme.font_badge; color: Theme.text_muted; }
                                        NumInput {
                                            text <=> AppData.crop_height_text;
                                            placeholder: "Height";
                                            edited(val) => { AppLogic.crop_height_edited(val); }
                                            accepted => { root.request_focus(); }
                                        }
                                    }
                                }
                            }

                            // Manual X/Y offset inputs
                            HorizontalLayout {
                                spacing: 6px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text { text: "Offset X"; font-size: Theme.font_badge; color: Theme.text_muted; }
                                    NumInput {
                                        text <=> AppData.crop_x_text;
                                        placeholder: "X";
                                        edited(val) => { AppLogic.crop_x_edited(val); }
                                        accepted => { root.request_focus(); }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text { text: "Offset Y"; font-size: Theme.font_badge; color: Theme.text_muted; }
                                    NumInput {
                                        text <=> AppData.crop_y_text;
                                        placeholder: "Y";
                                        edited(val) => { AppLogic.crop_y_edited(val); }
                                        accepted => { root.request_focus(); }
                                    }
                                }
                            }

                            // Arrow key nudge controls
                            Rectangle {
                                border-radius: Theme.radius_sm;
                                background: Theme.card_subtle_bg;
                                border-width: 1px;
                                border-color: Theme.card_subtle_border;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 7px;

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppData.crop_arrow_keys_enabled = !AppData.crop_arrow_keys_enabled;
                                            root.request_focus();
                                        }
                                        HorizontalLayout {
                                            spacing: 7px;
                                            alignment: start;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 16px;
                                                    height: 16px;
                                                    border-radius: 4px;
                                                    background: AppData.crop_arrow_keys_enabled ? Theme.accent_primary : Theme.input_bg;
                                                    border-width: 1px;
                                                    border-color: AppData.crop_arrow_keys_enabled ? Theme.accent_primary : Theme.input_border;
                                                    if AppData.crop_arrow_keys_enabled : Image {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        source: @image-url("../icons/check.svg");
                                                        width: 10px;
                                                        height: 10px;
                                                        colorize: Theme.text_on_accent;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Arrow keys nudge crop box";
                                                    font-size: Theme.font_badge;
                                                    font-weight: 500;
                                                    color: Theme.text_secondary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: center;

                                        ActionButton {
                                            width: 32px;
                                            height: Theme.btn_height_sm;
                                            pad_horizontal: 4px;
                                            title: "←";
                                            fill_color: Theme.btn_neutral_bg;
                                            hover_color: Theme.btn_neutral_hover;
                                            text_color: Theme.btn_neutral_text;
                                            border_col: Theme.btn_neutral_border;
                                            normal_border_width: 1px;
                                            font_size: Theme.font_badge;
                                            is_disabled: !AppData.crop_enabled;
                                            clicked => { AppLogic.crop_nudge(-AppData.crop_nudge_step, 0); root.request_focus(); }
                                        }
                                        ActionButton {
                                            width: 32px;
                                            height: Theme.btn_height_sm;
                                            pad_horizontal: 4px;
                                            title: "↑";
                                            fill_color: Theme.btn_neutral_bg;
                                            hover_color: Theme.btn_neutral_hover;
                                            text_color: Theme.btn_neutral_text;
                                            border_col: Theme.btn_neutral_border;
                                            normal_border_width: 1px;
                                            font_size: Theme.font_badge;
                                            is_disabled: !AppData.crop_enabled;
                                            clicked => { AppLogic.crop_nudge(0, -AppData.crop_nudge_step); root.request_focus(); }
                                        }
                                        ActionButton {
                                            width: 32px;
                                            height: Theme.btn_height_sm;
                                            pad_horizontal: 4px;
                                            title: "↓";
                                            fill_color: Theme.btn_neutral_bg;
                                            hover_color: Theme.btn_neutral_hover;
                                            text_color: Theme.btn_neutral_text;
                                            border_col: Theme.btn_neutral_border;
                                            normal_border_width: 1px;
                                            font_size: Theme.font_badge;
                                            is_disabled: !AppData.crop_enabled;
                                            clicked => { AppLogic.crop_nudge(0, AppData.crop_nudge_step); root.request_focus(); }
                                        }
                                        ActionButton {
                                            width: 32px;
                                            height: Theme.btn_height_sm;
                                            pad_horizontal: 4px;
                                            title: "→";
                                            fill_color: Theme.btn_neutral_bg;
                                            hover_color: Theme.btn_neutral_hover;
                                            text_color: Theme.btn_neutral_text;
                                            border_col: Theme.btn_neutral_border;
                                            normal_border_width: 1px;
                                            font_size: Theme.font_badge;
                                            is_disabled: !AppData.crop_enabled;
                                            clicked => { AppLogic.crop_nudge(AppData.crop_nudge_step, 0); root.request_focus(); }
                                        }
                                        ActionButton {
                                            horizontal-stretch: 1;
                                            height: Theme.btn_height_sm;
                                            pad_horizontal: 6px;
                                            title: "Center";
                                            fill_color: Theme.btn_neutral_bg;
                                            hover_color: Theme.btn_neutral_hover;
                                            text_color: Theme.accent_lime;
                                            border_col: Theme.btn_neutral_border;
                                            normal_border_width: 1px;
                                            font_size: Theme.font_badge;
                                            is_disabled: !AppData.crop_enabled;
                                            clicked => { AppLogic.center_crop_box(); root.request_focus(); }
                                        }
                                    }
                                }
                            }

                            ActionButton {
                                height: Theme.btn_height_sm;
                                title: "Reset Crop to Full Frame";
                                icon_source: @image-url("../icons/reset.svg");
                                has_icon: true;
                                icon_size: 11px;
                                fill_color: Theme.btn_neutral_bg;
                                hover_color: Theme.btn_neutral_hover;
                                text_color: Theme.text_secondary;
                                border_col: Theme.btn_neutral_border;
                                normal_border_width: 1px;
                                font_size: Theme.font_badge;
                                clicked => { AppLogic.reset_crop(); root.request_focus(); }
                            }
                        }
                    }

                    // Audio gain & loudness normalization
                    Rectangle {
                        border-radius: Theme.radius_md;
                        background: Theme.card_bg;
                        border-width: 1px;
                        border-color: AppData.has_active_audio_edits ? Theme.accent_border : Theme.card_border;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/volume-2.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: Theme.accent_lime;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Audio Edit";
                                        font-size: Theme.font_caption;
                                        font-weight: 700;
                                        color: Theme.text_heading;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if AppData.has_active_audio_edits : ActionButton {
                                    width: 52px;
                                    height: 22px;
                                    pad_horizontal: 4px;
                                    title: "Reset";
                                    fill_color: Theme.amber_surface;
                                    hover_color: Theme.amber_surface_hover;
                                    text_color: Theme.accent_amber;
                                    border_col: Theme.amber_border;
                                    normal_border_width: 1px;
                                    font_size: Theme.font_badge;
                                    clicked => { AppLogic.reset_audio_edits(); }
                                }
                            }

                            // Volume gain (dB)
                            VerticalLayout {
                                spacing: 7px;

                                HorizontalLayout {
                                    Text {
                                        text: "Volume Gain";
                                        font-size: Theme.font_badge;
                                        font-weight: 600;
                                        color: Theme.text_muted;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: AppData.audio_gain_text;
                                        font-size: Theme.font_badge;
                                        font-weight: 700;
                                        font-family: Theme.font_mono;
                                        color: AppData.audio_gain_db > 0.05 ? Theme.accent_green :
                                              (AppData.audio_gain_db < -0.05 ? Theme.accent_amber : Theme.accent_lime);
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    Text { text: "-24"; font-size: Theme.font_badge; font-family: Theme.font_mono; color: Theme.text_muted; vertical-alignment: center; }

                                    RangeSlider {
                                        horizontal-stretch: 1;
                                        minimum: -24.0;
                                        maximum: 24.0;
                                        step: 0.5;
                                        is_centered: true;
                                        value: AppData.audio_gain_db;
                                        changed(val) => { AppLogic.set_audio_gain_db(val); }
                                    }

                                    Text { text: "+24"; font-size: Theme.font_badge; font-family: Theme.font_mono; color: Theme.text_muted; vertical-alignment: center; }
                                }

                                // Quick Preset dB Scale (-12dB to +12dB)
                                HorizontalLayout {
                                    spacing: 4px;
                                    ChoicePillButton { height: 24px; btn_radius: 4px; pad_horizontal: 2px; font_size: 10px; title: "-12dB"; active: AppData.audio_gain_db == -12.0; clicked => { AppLogic.set_audio_gain_db(-12.0); } }
                                    ChoicePillButton { height: 24px; btn_radius: 4px; pad_horizontal: 2px; font_size: 10px; title: "-6dB"; active: AppData.audio_gain_db == -6.0; clicked => { AppLogic.set_audio_gain_db(-6.0); } }
                                    ChoicePillButton { height: 24px; btn_radius: 4px; pad_horizontal: 2px; font_size: 10px; title: "0 dB"; active: AppData.audio_gain_db > -0.05 && AppData.audio_gain_db < 0.05; clicked => { AppLogic.set_audio_gain_db(0.0); } }
                                    ChoicePillButton { height: 24px; btn_radius: 4px; pad_horizontal: 2px; font_size: 10px; title: "+6dB"; active: AppData.audio_gain_db == 6.0; clicked => { AppLogic.set_audio_gain_db(6.0); } }
                                    ChoicePillButton { height: 24px; btn_radius: 4px; pad_horizontal: 2px; font_size: 10px; title: "+12dB"; active: AppData.audio_gain_db == 12.0; clicked => { AppLogic.set_audio_gain_db(12.0); } }
                                }

                                // Fine-Tuning Step Nudge (-1.0 dB / +1.0 dB)
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Text {
                                        text: "Fine Tune:";
                                        font-size: Theme.font_badge;
                                        font-weight: 500;
                                        color: Theme.text_muted;
                                        vertical-alignment: center;
                                    }

                                    ActionButton {
                                        width: 68px;
                                        height: 24px;
                                        btn_radius: 4px;
                                        pad_horizontal: 4px;
                                        title: "-1.0 dB";
                                        fill_color: Theme.btn_neutral_bg;
                                        hover_color: Theme.btn_neutral_hover;
                                        text_color: Theme.text_secondary;
                                        border_col: Theme.btn_neutral_border;
                                        normal_border_width: 1px;
                                        font_size: 10px;
                                        clicked => { AppLogic.step_audio_gain_db(-1.0); }
                                    }

                                    ActionButton {
                                        width: 68px;
                                        height: 24px;
                                        btn_radius: 4px;
                                        pad_horizontal: 4px;
                                        title: "+1.0 dB";
                                        fill_color: Theme.btn_neutral_bg;
                                        hover_color: Theme.btn_neutral_hover;
                                        text_color: Theme.text_secondary;
                                        border_col: Theme.btn_neutral_border;
                                        normal_border_width: 1px;
                                        font_size: 10px;
                                        clicked => { AppLogic.step_audio_gain_db(1.0); }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.card_border; }

                            // Loudness normalization (EBU R128)
                            VerticalLayout {
                                spacing: 6px;

                                Rectangle {
                                    height: 32px;
                                    border-radius: Theme.radius_sm;
                                    background: AppData.audio_normalize_enabled ? Theme.accent_surface : Theme.card_subtle_bg;
                                    border-width: 1px;
                                    border-color: AppData.audio_normalize_enabled ? Theme.accent_border : Theme.card_border;

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppLogic.toggle_audio_normalize(); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 4px;
                                                background: AppData.audio_normalize_enabled ? Theme.accent_primary : Theme.input_bg;
                                                border-width: 1px;
                                                border-color: AppData.audio_normalize_enabled ? Theme.accent_primary : Theme.input_border;

                                                if AppData.audio_normalize_enabled : Image {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    source: @image-url("../icons/check.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: Theme.text_on_accent;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Normalize (EBU R128)";
                                                font-size: Theme.font_badge;
                                                font-weight: 600;
                                                color: AppData.audio_normalize_enabled ? Theme.text_primary : Theme.btn_neutral_text;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        if AppData.audio_normalize_enabled : VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "\{AppData.audio_normalize_lufs} LUFS";
                                                font-size: Theme.font_badge;
                                                font-weight: 700;
                                                font-family: Theme.font_mono;
                                                color: Theme.accent_lime;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if AppData.audio_normalize_enabled : VerticalLayout {
                                    spacing: 4px;
                                    padding-top: 2px;

                                    Text {
                                        text: "Target Loudness";
                                        font-size: Theme.font_badge;
                                        font-weight: 600;
                                        color: Theme.text_muted;
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        ChoicePillButton { title: "-16 LUFS"; active: AppData.audio_normalize_preset_index == 0; clicked => { AppLogic.set_audio_normalize_preset(0); } }
                                        ChoicePillButton { title: "-14 LUFS"; active: AppData.audio_normalize_preset_index == 1; clicked => { AppLogic.set_audio_normalize_preset(1); } }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        ChoicePillButton { title: "-23 LUFS"; active: AppData.audio_normalize_preset_index == 2; clicked => { AppLogic.set_audio_normalize_preset(2); } }
                                        ChoicePillButton { title: "-12 LUFS"; active: AppData.audio_normalize_preset_index == 3; clicked => { AppLogic.set_audio_normalize_preset(3); } }
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: Theme.radius_sm;
                                background: Theme.card_subtle_bg;
                                border-width: 1px;
                                border-color: Theme.card_subtle_border;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 5px;
                                    padding-bottom: 5px;
                                    spacing: 6px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../icons/play.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: Theme.accent_lime;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Live preview in player · Applied on Run Task";
                                            font-size: Theme.font_badge;
                                            color: Theme.text_muted;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Canvas summary footer
                    if AppData.selected_is_video : Rectangle {
                        border-radius: Theme.radius_sm;
                        background: Theme.card_subtle_bg;
                        border-width: 1px;
                        border-color: Theme.card_border;

                        VerticalLayout {
                            padding: 9px;
                            spacing: 3px;

                            Text {
                                text: "Source: \{AppData.selected_video_width} × \{AppData.selected_video_height} px";
                                font-size: Theme.font_badge;
                                font-family: Theme.font_mono;
                                color: Theme.text_muted;
                                overflow: elide;
                            }
                            Text {
                                text: "Output: \{AppData.crop_enabled ? AppData.crop_width : AppData.effective_video_width} × \{AppData.crop_enabled ? AppData.crop_height : AppData.effective_video_height} px";
                                font-size: Theme.font_badge;
                                font-family: Theme.font_mono;
                                font-weight: 700;
                                color: Theme.accent_lime;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
