import { Theme } from "../theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> title: "Button";
    in property <image> icon_source;
    in property <bool> has_icon: false;
    in property <length> icon_size: 13px;
    in property <color> fill_color: Theme.accent_primary;
    in property <color> hover_color: Theme.accent_primary_hover;
    in property <color> pressed_color: fill_color.darker(0.25);
    in property <color> text_color: #ffffff;
    in property <length> font_size: Theme.font_body;
    in property <bool> is_disabled: false;
    in property <length> btn_radius: 6px;
    in property <length> pad_horizontal: 8px;
    callback clicked();

    height: 34px;
    border-radius: root.btn_radius;
    background: is_disabled ? Theme.control_bg : (ta.pressed ? pressed_color : (ta.has-hover ? hover_color : fill_color));
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Theme.focus_ring;

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-left: root.pad_horizontal;
        padding-right: root.pad_horizontal;

        if root.has_icon : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon_source;
                width: root.icon_size;
                height: root.icon_size;
                colorize: root.is_disabled ? Theme.text_muted : root.text_color;
            }
        }

        if root.title != "" : VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                color: root.is_disabled ? Theme.text_muted : root.text_color;
                font-size: root.font_size;
                font-weight: 600;
                overflow: elide;
            }
        }
    }

    fs := FocusScope {
        enabled: !root.is_disabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }

        ta := TouchArea {
            mouse-cursor: is_disabled ? default : pointer;
            enabled: !is_disabled;
            clicked => {
                fs.focus();
                root.clicked();
            }
        }
    }
}
