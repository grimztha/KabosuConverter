                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/layers.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: AppData.function_index >= 6 && AppData.function_index <= 8 ? #34d399 : #94a3b8;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Remux & Cut";
                                                    font-size: 10.5px;
