import { ScrollView } from "std-widgets.slint";
import { AppData, AppLogic, Theme } from "../globals.slint";
import { Badge } from "../components/badge.slint";
import { IconButton } from "../components/icon_button.slint";
import { ActionButton } from "../components/action_button.slint";

export component QueuePanel inherits Rectangle {
    callback request_focus();
    background: Theme.panel_bg;
    horizontal-stretch: 0;

    property <bool> confirm_clear: false;

    // COLLAPSED STRIP STATE
    if !AppData.queue_panel_expanded : VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        alignment: start;

        HorizontalLayout {
            alignment: center;
            IconButton {
                btn_width: 26px;
                btn_height: 26px;
                icon_source: @image-url("../icons/chevron-right.svg");
                has_icon: true;
                icon_size: 13px;
                text_color: Theme.text_muted;
                hover_bg: Theme.control_hover;
                clicked => { AppLogic.toggle_queue_panel(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.card_secondary_bg;
                border-width: 1px;
                border-color: Theme.card_secondary_border;

                Text {
                    text: "\{AppData.queue.length}";
                    font-size: Theme.font_badge;
                    font-weight: 700;
                    color: AppData.queue.length > 0 ? Theme.accent_cyan : Theme.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // EXPANDED STATE
    if AppData.queue_panel_expanded : VerticalLayout {
        padding: 10px;
        spacing: 10px;

        // Section Title & Collapse Control
        HorizontalLayout {
            padding-left: 2px;
            padding-right: 0px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Text {
                    text: "Input Queue";
                    font-size: Theme.font_body;
                    font-weight: 700;
                    color: Theme.text_primary;
                }
            }

            VerticalLayout {
                alignment: center;
                Badge {
                    label: "\{AppData.queue.length} file(s)";
                    bg_color: Theme.card_secondary_bg;
                    fg_color: Theme.text_muted;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                IconButton {
                    btn_width: 24px;
                    btn_height: 24px;
                    icon_source: @image-url("../icons/chevron-left.svg");
                    has_icon: true;
                    icon_size: 12px;
                    text_color: Theme.text_muted;
                    hover_bg: Theme.control_hover;
                    clicked => { AppLogic.toggle_queue_panel(); }
                }
            }
        }

        // Queue Container Box (Concentric: Outer 14px = Inner 6px + Padding 8px)
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            background: Theme.card_bg;
            border-width: 1px;
            border-color: Theme.card_border;

            TouchArea {
                clicked => {
                    root.confirm_clear = false;
                    root.request_focus();
                }
            }

            VerticalLayout {
                padding: 8px;
                spacing: 8px;

                // Empty State if no files
                if AppData.queue.length == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: "No files in queue";
                        font-size: Theme.font_body;
                        font-weight: 600;
                        color: Theme.text_secondary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Drag & drop media files here, or click '+ Add Files'";
                        font-size: Theme.font_caption;
                        color: Theme.text_muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Scrollable File List
                if AppData.queue.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;

                        for file[idx] in AppData.queue : Rectangle {
                            height: 40px;
                            border-radius: 6px;
                            background: AppData.selected_file_index == idx ? Theme.card_secondary_bg : (card_ta.has-hover ? Theme.control_hover : Theme.card_subtle_bg);
                            border-width: 1px;
                            border-color: AppData.selected_file_index == idx ? Theme.accent_cyan : (card_ta.has-hover ? Theme.control_border : Theme.card_subtle_border);
                            clip: true;

                            animate background { duration: 120ms; easing: ease-out; }
                            animate border-color { duration: 120ms; easing: ease-out; }

                            card_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.confirm_clear = false;
                                    AppLogic.select_file(idx);
                                    root.request_focus();
                                }
                            }

                            // Selection Accent Bar on left edge
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: 3px;
                                height: 100%;
                                background: AppData.selected_file_index == idx ? Theme.accent_cyan : Theme.border_color;
                            }

                            // Bottom inline encoding progress bar
                            if file.progress > 0.0 && file.progress < 1.0 : Rectangle {
                                x: 3px;
                                y: parent.height - 2px;
                                width: max(4px, (parent.width - 3px) * file.progress);
                                height: 2px;
                                background: @linear-gradient(90deg, Theme.accent_primary 0%, Theme.accent_cyan 50%, Theme.accent_emerald 100%);
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 6px;
                                padding-top: 3px;
                                padding-bottom: 3px;
                                spacing: 6px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    alignment: center;

                                    // Row 1: File Name
                                    Text {
                                        text: file.file_name;
                                        font-size: Theme.font_caption;
                                        font-weight: 600;
                                        color: AppData.selected_file_index == idx ? Theme.accent_cyan : Theme.text_primary;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }

                                    // Row 2: File Path (Elevated from 9.5px to 11px)
                                    Text {
                                        text: file.file_path;
                                        font-size: Theme.font_badge;
                                        color: AppData.selected_file_index == idx ? Theme.text_secondary : Theme.text_muted;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                    }
                                }

                                // Remove Item Button
                                VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon_source: @image-url("../icons/x.svg");
                                        has_icon: true;
                                        icon_size: 10px;
                                        btn_width: 20px;
                                        btn_height: 20px;
                                        hover_bg: Theme.accent_red.with-alpha(0.2);
                                        clicked => {
                                            AppLogic.remove_file(idx);
                                            root.request_focus();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Bottom Queue Actions: Add Files & Clear Queue (Two-Click Safe)
                HorizontalLayout {
                    spacing: 6px;
                    height: Theme.btn_height_md;

                    ActionButton {
                        min-width: 0px;
                        horizontal-stretch: 13;
                        height: Theme.btn_height_md;
                        title: "Add Files";
                        icon_source: @image-url("../icons/plus.svg");
                        has_icon: true;
                        icon_size: 12px;
                        fill_color: Theme.accent_primary;
                        hover_color: Theme.accent_primary_hover;
                        font_size: Theme.font_caption;
                        clicked => {
                            root.confirm_clear = false;
                            AppLogic.add_files();
                            root.request_focus();
                        }
                    }

                    ActionButton {
                        min-width: 0px;
                        horizontal-stretch: 11;
                        height: Theme.btn_height_md;
                        title: root.confirm_clear ? "Confirm Clear?" : "Clear Queue";
                        icon_source: @image-url("../icons/trash.svg");
                        has_icon: true;
                        icon_size: 12px;
                        fill_color: root.confirm_clear ? Theme.accent_red : Theme.btn_neutral_bg;
                        hover_color: root.confirm_clear ? Theme.accent_red_hover : Theme.btn_neutral_hover;
                        text_color: root.confirm_clear ? #ffffff : Theme.btn_neutral_text;
                        font_size: Theme.font_badge;
                        is_disabled: AppData.queue.length == 0;
                        clicked => {
                            if root.confirm_clear {
                                root.confirm_clear = false;
                                AppLogic.clear_queue();
                            } else {
                                root.confirm_clear = true;
                            }
                            root.request_focus();
                        }
                    }
                }
            }
        }

        // SELECTED ITEM METADATA BOX
        if AppData.selected_file_index >= 0 && AppData.selected_file_index < AppData.queue.length : Rectangle {
            height: 112px;
            border-radius: 10px;
            background: Theme.card_bg;
            border-width: 1px;
            border-color: Theme.accent_cyan.with-alpha(0.35);

            TouchArea {
                clicked => { root.request_focus(); }
            }

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                alignment: start;

                // Header Row: Media Type Badge + Section Title + Status
                HorizontalLayout {
                    height: 18px;
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        Badge {
                            label: AppData.queue[AppData.selected_file_index].is_video ? "Video" : "Audio";
                            bg_color: AppData.queue[AppData.selected_file_index].is_video ? Theme.accent_primary : Theme.accent_purple.darker(0.3);
                            fg_color: #ffffff;
                            height: 16px;
                        }
                    }

                    Text {
                        text: "Selected Item Metadata";
                        font-size: Theme.font_badge;
                        font-weight: 700;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: AppData.queue[AppData.selected_file_index].status;
                        font-size: Theme.font_badge;
                        font-weight: 700;
                        color: AppData.queue[AppData.selected_file_index].status == "Completed" ? Theme.accent_green : (AppData.queue[AppData.selected_file_index].status == "Probing..." ? Theme.accent_purple : (AppData.queue[AppData.selected_file_index].status == "Ready" ? Theme.accent_cyan : (AppData.queue[AppData.selected_file_index].progress > 0.0 && AppData.queue[AppData.selected_file_index].progress < 1.0 ? Theme.accent_amber : Theme.accent_red)));
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { height: 1px; background: Theme.card_border; }

                // Row 1: Resolution, Duration, File Size
                HorizontalLayout {
                    height: 30px;
                    spacing: 8px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Resolution";
                            font-size: Theme.font_badge;
                            color: Theme.text_muted;
                        }
                        Text {
                            text: AppData.queue[AppData.selected_file_index].resolution;
                            font-size: Theme.font_caption;
                            font-weight: 600;
                            font-family: Theme.font_mono;
                            color: Theme.accent_cyan;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Duration";
                            font-size: Theme.font_badge;
                            color: Theme.text_muted;
                        }
                        Text {
                            text: AppData.queue[AppData.selected_file_index].duration;
                            font-size: Theme.font_caption;
                            font-weight: 600;
                            font-family: Theme.font_mono;
                            color: Theme.text_primary;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "File Size";
                            font-size: Theme.font_badge;
                            color: Theme.text_muted;
                        }
                        Text {
                            text: AppData.queue[AppData.selected_file_index].file_size_formatted;
                            font-size: Theme.font_caption;
                            font-weight: 600;
                            font-family: Theme.font_mono;
                            color: Theme.text_secondary;
                            overflow: elide;
                        }
                    }
                }

                // Row 2: Codecs
                VerticalLayout {
                    height: 30px;
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "Codecs";
                        font-size: Theme.font_badge;
                        color: Theme.text_muted;
                    }
                    Text {
                        text: AppData.queue[AppData.selected_file_index].codecs;
                        font-size: Theme.font_caption;
                        font-weight: 600;
                        font-family: Theme.font_mono;
                        color: Theme.accent_purple;
                        overflow: elide;
                    }
                }
            }
        }

        // RUN TASK Button
        HorizontalLayout {
            alignment: center;
            height: Theme.btn_height_lg;

            if !AppData.is_processing : ActionButton {
                width: 170px;
                height: Theme.btn_height_lg;
                title: "Run Task";
                icon_source: @image-url("../icons/play.svg");
                has_icon: true;
                icon_size: 13px;
                fill_color: AppData.queue.length == 0 ? Theme.control_bg : Theme.accent_emerald;
                hover_color: AppData.queue.length == 0 ? Theme.control_bg : Theme.accent_emerald_hover;
                text_color: AppData.queue.length == 0 ? Theme.text_muted : #ffffff;
                is_disabled: AppData.queue.length == 0;
                font_size: Theme.font_caption;
                clicked => { AppLogic.run_task(); }
            }

            if AppData.is_processing : ActionButton {
                width: 170px;
                height: Theme.btn_height_lg;
                title: "Stop / Cancel";
                icon_source: @image-url("../icons/stop.svg");
                has_icon: true;
                icon_size: 13px;
                fill_color: Theme.accent_red;
                hover_color: Theme.accent_red_hover;
                font_size: Theme.font_caption;
                clicked => { AppLogic.cancel_processing(); }
            }
        }
    }
}
