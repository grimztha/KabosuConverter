import { Palette, ScrollView } from "std-widgets.slint";

import { QueueFile, DownloadHistoryItem } from "types.slint";
export { QueueFile, DownloadHistoryItem }

import { AppData, AppLogic, Theme } from "globals.slint";
export { AppData, AppLogic, Theme }

import { IconButton } from "components/icon_button.slint";
import { WindowControls } from "components/window_controls.slint";

import { PlayerTab } from "views/player_tab.slint";
import { DownloaderTab } from "views/downloader_tab.slint";
import { TranscoderTab } from "views/transcoder_tab.slint";
import { EditPanel } from "views/edit_panel.slint";
import { QueuePanel } from "views/queue_panel.slint";

export component MainWindow inherits Window {
    title: "Kabosu Converter — Professional Media Transcoder";
    icon: @image-url("icons/app-icon.png");
    min-width: 960px;
    min-height: 650px;
    preferred-width: 1280px;
    preferred-height: 850px;
    background: transparent;
    no-frame: true;
    resize-border-width: AppData.is_window_maximized ? 0px : 6px;
    maximized <=> AppData.is_window_maximized;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    forward-focus: fs;

    property <length> queue_panel_width: AppData.queue_panel_expanded ? 300px : 38px;
    out property <float> tabs_hit_start: tabs_nav_layout.x / 1px;
    out property <float> tabs_hit_end: (tabs_nav_layout.x + tabs_nav_layout.width) / 1px;

    Rectangle {
        border-radius: AppData.is_window_maximized ? 0px : 12px;
        border-width: AppData.is_window_maximized ? 0px : 1px;
        border-color: Theme.window_border;
        background: Theme.app_bg;
        clip: true;

        fs := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Delete || event.text == "\u{7f}" {
                    if AppData.selected_file_index >= 0 && AppData.selected_file_index < AppData.queue.length {
                        AppLogic.remove_file(AppData.selected_file_index);
                        return accept;
                    }
                }
                if event.text == " " {
                    if AppData.active_tab == 1 && AppData.player_has_media {
                        AppLogic.player_play_pause();
                        return accept;
                    }
                }
                if AppData.active_tab == 1 && AppData.player_has_media && AppData.selected_is_video && AppData.crop_enabled && AppData.crop_arrow_keys_enabled {
                    if event.text == Key.LeftArrow {
                        AppLogic.crop_nudge(event.modifiers.shift ? -AppData.crop_nudge_step * 4 : -AppData.crop_nudge_step, 0);
                        return accept;
                    }
                    if event.text == Key.RightArrow {
                        AppLogic.crop_nudge(event.modifiers.shift ? AppData.crop_nudge_step * 4 : AppData.crop_nudge_step, 0);
                        return accept;
                    }
                    if event.text == Key.UpArrow {
                        AppLogic.crop_nudge(0, event.modifiers.shift ? -AppData.crop_nudge_step * 4 : -AppData.crop_nudge_step);
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        AppLogic.crop_nudge(0, event.modifiers.shift ? AppData.crop_nudge_step * 4 : AppData.crop_nudge_step);
                        return accept;
                    }
                }
                reject
            }

            VerticalLayout {
                // UNIFIED TOP HEADER BAR (Integrated Title Bar + Workspace Tabs + Window Controls)
                Rectangle {
                    height: 44px;
                    background: Theme.header_bg;

                    HorizontalLayout {
                        // Left Section (Above QueuePanel): Brand Identity & Title Bar Text
                        Rectangle {
                            min-width: root.queue_panel_width + 1px;
                            max-width: root.queue_panel_width + 1px;
                            clip: true;

                            animate min-width { duration: 160ms; easing: ease-out; }
                            animate max-width { duration: 160ms; easing: ease-out; }

                            WindowMoveArea {
                                enabled: !AppData.is_window_maximized;

                                HorizontalLayout {
                                    padding-left: AppData.queue_panel_expanded ? 14px : 9px;
                                    spacing: 8px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            width: 20px;
                                            height: 20px;
                                            source: @image-url("icons/brand-logo.png");
                                        }
                                    }

                                    if AppData.queue_panel_expanded : VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 5px;
                                            alignment: start;
                                            Text {
                                                text: "KABOSU";
                                                font-size: 12px;
                                                font-weight: 800;
                                                letter-spacing: 0.8px;
                                                color: Theme.text_primary;
                                            }
                                            Text {
                                                text: "CONVERTER";
                                                font-size: 12px;
                                                font-weight: 500;
                                                letter-spacing: 0.8px;
                                                color: Theme.text_muted;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Spacer aligning Tabs with middle panel content (20px padding)
                        Rectangle {
                            min-width: 20px;
                            max-width: 20px;

                            WindowMoveArea {
                                enabled: !AppData.is_window_maximized;
                            }
                        }

                        // Center-Left: Workspace Navigation Tabs (Segmented Control Pill)
                        tabs_nav_layout := VerticalLayout {
                            alignment: center;

                            Rectangle {
                                height: 32px;
                                border-radius: 9px;
                                background: Theme.tab_container_bg;
                                border-width: 1px;
                                border-color: Theme.tab_container_border;

                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 3px;

                                    // Tab 0: Downloader
                                    t0 := Rectangle {
                                        border-radius: Theme.radius_sm;
                                        background: AppData.active_tab == 0 ? Theme.tab_active_bg : (t0_ta.has-hover ? Theme.tab_inactive_hover : transparent);
                                        border-width: 1px;
                                        border-color: AppData.active_tab == 0 ? Theme.tab_active_border : transparent;

                                        animate background { duration: 140ms; easing: ease-out; }
                                        animate border-color { duration: 140ms; easing: ease-out; }

                                        HorizontalLayout {
                                            padding-left: 11px;
                                            padding-right: 11px;
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/download.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    colorize: AppData.active_tab == 0 ? Theme.tab_active_text : (t0_ta.has-hover ? Theme.text_primary : Theme.tab_inactive_text);
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Downloader";
                                                    font-size: Theme.font_caption;
                                                    font-weight: AppData.active_tab == 0 ? 600 : 500;
                                                    color: AppData.active_tab == 0 ? Theme.tab_active_text : (t0_ta.has-hover ? Theme.text_primary : Theme.tab_inactive_text);
                                                }
                                            }

                                            if AppData.ytdlp_is_downloading : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 3px;
                                                    background: Theme.accent_green;
                                                }
                                            }
                                        }

                                        t0_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppLogic.switch_tab(0); }
                                        }
                                    }

                                    // Tab 1: View & Edit
                                    t1 := Rectangle {
                                        border-radius: Theme.radius_sm;
                                        background: AppData.active_tab == 1 ? Theme.tab_active_bg : (t1_ta.has-hover ? Theme.tab_inactive_hover : transparent);
                                        border-width: 1px;
                                        border-color: AppData.active_tab == 1 ? Theme.tab_active_border : transparent;

                                        animate background { duration: 140ms; easing: ease-out; }
                                        animate border-color { duration: 140ms; easing: ease-out; }

                                        HorizontalLayout {
                                            padding-left: 11px;
                                            padding-right: 11px;
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/film.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    colorize: AppData.active_tab == 1 ? Theme.tab_active_text : (t1_ta.has-hover ? Theme.text_primary : Theme.tab_inactive_text);
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "View & Edit";
                                                    font-size: Theme.font_caption;
                                                    font-weight: AppData.active_tab == 1 ? 600 : 500;
                                                    color: AppData.active_tab == 1 ? Theme.tab_active_text : (t1_ta.has-hover ? Theme.text_primary : Theme.tab_inactive_text);
                                                }
                                            }

                                            if AppData.has_active_trim : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 3px;
                                                    background: Theme.accent_amber;
                                                }
                                            }
                                        }

                                        t1_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppLogic.switch_tab(1); }
                                        }
                                    }

                                    // Tab 2: Settings
                                    t2 := Rectangle {
                                        border-radius: Theme.radius_sm;
                                        background: AppData.active_tab == 2 ? Theme.tab_active_bg : (t2_ta.has-hover ? Theme.tab_inactive_hover : transparent);
                                        border-width: 1px;
                                        border-color: AppData.active_tab == 2 ? Theme.tab_active_border : transparent;

                                        animate background { duration: 140ms; easing: ease-out; }
                                        animate border-color { duration: 140ms; easing: ease-out; }

                                        HorizontalLayout {
                                            padding-left: 11px;
                                            padding-right: 11px;
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("icons/settings.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    colorize: AppData.active_tab == 2 ? Theme.tab_active_text : (t2_ta.has-hover ? Theme.text_primary : Theme.tab_inactive_text);
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Settings";
                                                    font-size: Theme.font_caption;
                                                    font-weight: AppData.active_tab == 2 ? 600 : 500;
                                                    color: AppData.active_tab == 2 ? Theme.tab_active_text : (t2_ta.has-hover ? Theme.text_primary : Theme.tab_inactive_text);
                                                }
                                            }

                                            // Notification dot when an update is available
                                            if AppData.update_status == 3 : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 3px;
                                                    background: Theme.accent_green;
                                                }
                                            }
                                        }

                                        t2_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppLogic.switch_tab(2); }
                                        }
                                    }
                                }
                            }
                        }

                        // Flexible Draggable Space (Right of Tabs)
                        Rectangle {
                            horizontal-stretch: 1;

                            WindowMoveArea {
                                enabled: !AppData.is_window_maximized;
                            }
                        }

                        // Right: Windows Native-Style Control Buttons (Minimize, Maximize/Restore, Close)
                        WindowControls {
                            height: 100%;
                        }
                    }
                }

                // Header Subtle Divider
                Rectangle { height: 1px; background: Theme.header_border; }

                // MAIN BODY (Split Left: Queue, Center: Workspace, Right: Inspector)
                HorizontalLayout {
                    vertical-stretch: 1;

                    // LEFT PANEL: FILE QUEUE
                    QueuePanel {
                        min-width: root.queue_panel_width;
                        max-width: root.queue_panel_width;
                        request_focus => { fs.focus(); }
                        animate min-width { duration: 160ms; easing: ease-out; }
                        animate max-width { duration: 160ms; easing: ease-out; }
                    }

                    // Vertical Split Divider
                    Rectangle { width: 1px; background: Theme.panel_border; }

                    // CENTER WORKSPACE PANEL (Stretch)
                    Rectangle {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        background: Theme.app_bg;
                        clip: true;

                        if AppData.active_tab == 0 : DownloaderTab {}
                        if AppData.active_tab == 1 : PlayerTab {
                            request_focus => { fs.focus(); }
                        }
                        if AppData.active_tab == 2 : TranscoderTab {}
                    }

                    // RIGHT-SIDE EXPANDABLE / COLLAPSIBLE EDITING COLUMN
                    if AppData.active_tab == 1 && AppData.player_has_media : EditPanel {
                        request_focus => { fs.focus(); }
                    }
                }

                // LOG DRAWER (Collapsible Console)
                if AppData.show_logs : Rectangle {
                    height: 132px;
                    background: Theme.card_subtle_bg;

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 10px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("icons/logs.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: Theme.accent_lime;
                                }
                            }
                            Text {
                                text: "FFmpeg Command & Telemetry Stream";
                                font-size: Theme.font_badge;
                                font-weight: 600;
                                color: Theme.text_secondary;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            IconButton {
                                icon_source: @image-url("icons/x.svg");
                                has_icon: true;
                                icon_size: 11px;
                                btn_width: 24px;
                                btn_height: 24px;
                                clicked => { AppLogic.toggle_logs(); }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: Theme.radius_sm;
                            background: Theme.input_bg;
                            border-width: 1px;
                            border-color: Theme.card_border;

                            ScrollView {
                                width: 100%;
                                height: 100%;

                                VerticalLayout {
                                    padding: 8px;
                                    Text {
                                        text: AppData.log_preview == "" ? "Waiting for FFmpeg task output..." : AppData.log_preview;
                                        font-size: Theme.font_badge;
                                        font-family: Theme.font_mono;
                                        color: AppData.log_preview == "" ? Theme.text_muted : Theme.accent_lime;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                // Bottom Divider
                Rectangle { height: 1px; background: Theme.status_bar_border; }

                // BOTTOM STATUS BAR
                Rectangle {
                    height: 40px;
                    background: Theme.status_bar_bg;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 12px;

                        // Left: Live Queue / Encoding Status Telemetry
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 3.5px;
                                    background: AppData.is_processing ? Theme.accent_amber : (AppData.queue.length > 0 ? Theme.accent_green : Theme.text_faint);
                                }
                            }

                            Text {
                                text: AppData.is_processing ? (AppData.progress_text + "  •  " + AppData.speed_text + "  •  " + AppData.fps_text + "  •  " + AppData.time_text) : AppData.status_summary;
                                font-size: Theme.font_badge;
                                font-weight: 600;
                                font-family: AppData.is_processing ? Theme.font_mono : "";
                                color: AppData.is_processing ? Theme.accent_amber : Theme.text_secondary;
                                vertical-alignment: center;
                            }

                            if AppData.is_processing : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 100px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.control_bg;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width * AppData.progress_percent.clamp(0.0, 1.0);
                                        height: 100%;
                                        border-radius: 3px;
                                        background: @linear-gradient(90deg, Theme.accent_primary 0%, Theme.accent_lime 100%);
                                    }
                                }
                            }
                        }

                        // Flexible spacer
                        Rectangle { horizontal-stretch: 1; }

                        // Bottom-Right Engine Subtitle
                        VerticalLayout {
                            alignment: center;
                            padding-right: 4px;
                            Text {
                                text: "Rust + FFmpeg Native Media Engine";
                                font-size: Theme.font_badge;
                                font-weight: 500;
                                color: Theme.text_faint;
                                overflow: elide;
                            }
                        }

                        // Bottom-Right Corner: GPU Acceleration Status and Logs Toggle
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            // GPU Acceleration Status Pill
                            Rectangle {
                                height: 26px;
                                border-radius: Theme.radius_sm;
                                background: AppData.is_gpu_accelerated ? Theme.emerald_surface : Theme.card_secondary_bg;
                                border-width: 1px;
                                border-color: AppData.is_gpu_accelerated ? Theme.emerald_border : Theme.card_border;

                                HorizontalLayout {
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    spacing: 5px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/zap.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: AppData.is_gpu_accelerated ? Theme.accent_green : Theme.text_muted;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: AppData.gpu_status_text;
                                            font-size: Theme.font_badge;
                                            color: AppData.is_gpu_accelerated ? Theme.accent_green : Theme.text_muted;
                                            font-weight: 600;
                                        }
                                    }
                                }
                            }

                            // Compact "Logs" Toggle Button
                            Rectangle {
                                height: 26px;
                                border-radius: Theme.radius_sm;
                                background: AppData.show_logs ? Theme.accent_surface : (logs_ta.has-hover ? Theme.control_hover : Theme.control_bg);
                                border-width: 1px;
                                border-color: AppData.show_logs ? Theme.accent_border : Theme.control_border;

                                animate background { duration: 120ms; easing: ease-out; }
                                animate border-color { duration: 120ms; easing: ease-out; }

                                HorizontalLayout {
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    spacing: 5px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/logs.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: AppData.show_logs ? Theme.accent_lime : (logs_ta.has-hover ? Theme.text_primary : Theme.text_secondary);
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: AppData.show_logs ? "Hide Logs" : "Show Logs";
                                            font-size: Theme.font_badge;
                                            font-weight: 600;
                                            color: AppData.show_logs ? Theme.accent_lime : (logs_ta.has-hover ? Theme.text_primary : Theme.text_secondary);
                                        }
                                    }
                                }

                                logs_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.toggle_logs(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
