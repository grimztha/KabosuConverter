*.exe
*.dll
*.so
*.dylib

# Local User Settings & Runtime Configuration
settings.json
settings.json.bak

# Log files & diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary & Cache files
*.tmp
*.temp
*~
*.swp
*.swo

# OS metadata
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# Editor & IDE configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

