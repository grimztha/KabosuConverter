# Rust / Cargo build, coverage & profiling artifacts
/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata
lcov.info
coverage/
flamegraph.svg
Cargo.toml.orig

# Local executables, dynamic libraries & managed tool binaries
# (FFmpeg suite and yt-dlp exceed GitHub limits and are managed locally)
/bin/
/ffmpeg
/ffprobe
/ffplay
/yt-dlp
*.exe
*.dll
*.so
*.dylib
*.app/
*.dmg
*.msi
*.AppImage

# Release staging, archives & checksums
stage-*/
dist/
release_notes.md
kabosu-converter-*.zip
kabosu-converter-*.tar.gz
*.sha256

# Local user settings & runtime state
settings.json
settings.json.bak
settings.json.tmp
manifest.json
portable
.standalone

