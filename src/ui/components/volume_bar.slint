import { Theme } from "../theme.slint";

export component VolumeBar inherits Rectangle {
    in-out property <float> volume: 1.0;
    in-out property <bool> is_muted: false;
    callback volume_changed(float);
    callback volume_settled(float);
    callback toggle_mute();

    horizontal-stretch: 0;
    height: Theme.btn_height_sm;
    border-radius: Theme.radius_sm;
    background: Theme.input_bg;
    border-width: 1px;
    border-color: Theme.card_secondary_border;

    HorizontalLayout {
        padding-top: 3px;
        padding-bottom: 3px;
        padding-left: 6px;
        padding-right: 7px;
        spacing: 5px;
        alignment: center;

        // Mute / Unmute Button with Speaker Icon
        mute_box := Rectangle {
            width: 18px;
            height: 20px;
            border-radius: 4px;
            background: mute_ta.has-hover ? Theme.control_hover : transparent;

            animate background { duration: 120ms; easing: ease-out; }

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 13px;
                height: 13px;
                source: root.is_muted || root.volume <= 0.01 ? @image-url("../icons/volume-x.svg") : (root.volume > 0.5 ? @image-url("../icons/volume-2.svg") : @image-url("../icons/volume-1.svg"));
                colorize: root.is_muted || root.volume <= 0.01 ? Theme.accent_red_text : (mute_ta.has-hover ? Theme.accent_lime : Theme.text_muted);
            }

            mute_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle_mute(); }
            }
        }

        // Interactive Volume Slider Bar Track
        slider_track := Rectangle {
            width: 50px;
            height: 20px;

            // Background Track
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 100%;
                height: 4px;
                border-radius: 2px;
                background: Theme.slider_track;

                // Filled Track (Kabosu green to Yuzu yellow ramp)
                Rectangle {
                    x: 0px;
                    y: 0px;
                    height: 100%;
                    width: root.is_muted || root.volume <= 0.001 ? 0px : (parent.width * root.volume.clamp(0.0, 1.0));
                    border-radius: 2px;
                    background: root.is_muted ? Theme.text_faint : @linear-gradient(90deg, Theme.accent_primary 0%, Theme.accent_yuzu 100%);
                }
            }

            // Draggable Knob / Thumb
            Rectangle {
                property <float> norm: root.is_muted ? 0.0 : root.volume.clamp(0.0, 1.0);
                x: max(0px, min(parent.width - self.width, (parent.width - self.width) * self.norm));
                y: (parent.height - self.height) / 2;
                width: 11px;
                height: 11px;
                border-radius: 5.5px;
                background: root.is_muted ? Theme.text_muted : (slider_ta.has-hover || slider_ta.pressed ? Theme.accent_lime : Theme.slider_thumb);
                border-width: 1.5px;
                border-color: root.is_muted ? Theme.text_faint : Theme.accent_primary;
            }

            slider_ta := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && parent.width > 0px {
                        let val = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                        root.volume = val;
                        root.volume_changed(val);
                    }
                    if event.kind == PointerEventKind.up && parent.width > 0px {
                        let val = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                        root.volume = val;
                        root.volume_settled(val);
                    }
                }
                clicked => {
                    if parent.width > 0px {
                        let val = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                        root.volume = val;
                        root.volume_settled(val);
                    }
                }
                moved => {
                    if self.pressed && parent.width > 0px {
                        let val = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                        root.volume = val;
                        root.volume_changed(val);
                    }
                }
                scroll-event(event) => {
                    if event.delta-y > 0px {
                        let val = (root.volume + 0.05).clamp(0.0, 1.0);
                        root.volume = val;
                        root.volume_settled(val);
                        return accept;
                    }
                    if event.delta-y < 0px {
                        let val = (root.volume - 0.05).clamp(0.0, 1.0);
                        root.volume = val;
                        root.volume_settled(val);
                        return accept;
                    }
                    reject
                }
            }
        }

        // Percentage Text Readout
        Text {
            width: 30px;
            text: root.is_muted ? "0%" : "\{round(root.volume * 100)}%";
            font-size: Theme.font_badge;
            font-weight: 600;
            font-family: Theme.font_mono;
            color: root.is_muted ? Theme.accent_red_text : Theme.text_secondary;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}
