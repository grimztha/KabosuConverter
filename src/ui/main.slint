                                            current-index <=> AppData.audio_sample_rate_index;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Loudness Normalization (EBU R128)"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        ComboBox {
                                            height: 28px;
                                            model: ["Disabled", "EBU R128 (-23.0 LUFS Broadcast)", "YouTube / Spotify (-14.0 LUFS)", "Apple Music / Podcast (-16.0 LUFS)", "Loud Web (-12.0 LUFS)"];
                                            current-index <=> AppData.normalize_index;
                                        }
                                    }
                                }
                            }
                        }

                        // ACTIVE TRIM STATUS REMINDER BANNER (Compact)
                        Rectangle {
                            border-radius: 6px;
                            background: AppData.has_active_trim ? #d9770622 : #131d31;
                            border-width: 1px;
                            border-color: AppData.has_active_trim ? #f59e0b : #1e293b;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                alignment: center;

                                if AppData.has_active_trim : VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/scissors.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: #fbbf24;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: AppData.has_active_trim ?
                                            "Active Trim Applied: In " + AppData.in_point + " → Out " + AppData.out_point + " (" + AppData.trim_duration_text + ") will be exported." :
                                            "Full Media Export — No trim points set. To trim this clip, use the Media Player & Trimmer tab.";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: AppData.has_active_trim ? #fbbf24 : #94a3b8;
                                    }
                                }

                                ActionButton {
                                    width: 145px;
                                    height: 26px;
                                    border-radius: 5px;
                                    title: AppData.has_active_trim ? "Adjust on Timeline" : "Open Timeline Trimmer";
                                    icon_source: @image-url("icons/scissors.svg");
                                    has_icon: true;
                                    icon_size: 11px;
                                    fill_color: #1e293b;
                                    hover_color: #334155;
                                    font_size: 11px;
                                    clicked => { AppLogic.switch_tab(0); }
                                }
                            }
                        }

                        // OUTPUT DESTINATION CARD (Compact)
                        Rectangle {
                            border-radius: 8px;
                            background: #131d31;
                            border-width: 1px;
                            border-color: #1e293b;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 8px;

                                Text {
                                    text: "Output Container & Destination";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #10b981;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: end;

                                    VerticalLayout {
                                        width: 130px;
                                        spacing: 3px;
                                        Text { text: "Container Format"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        ComboBox {
                                            height: 28px;
                                            model: [".mp4", ".mkv", ".mov", ".webm", ".avi", ".ts", ".mp3", ".wav", ".flac"];
                                            current-index <=> AppData.container_index;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text { text: "Destination Folder"; font-size: 11px; font-weight: 600; color: #94a3b8; }
                                        LineEdit {
                                            height: 28px;
                                            font-size: 11.5px;
                                            text: AppData.output_directory;
                                            read-only: true;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text { text: " "; font-size: 11px; }
                                        ActionButton {
                                            width: 95px;
                                            height: 28px;
                                            border-radius: 5px;
                                            title: "Browse...";
                                            icon_source: @image-url("icons/folder.svg");
                                            has_icon: true;
                                            icon_size: 12px;
                                            font_size: 11px;
                                            fill_color: #1e293b;
                                            hover_color: #334155;
                                            clicked => { AppLogic.select_output_dir(); }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text { text: " "; font-size: 11px; }
                                        ActionButton {
                                            width: 110px;
                                            height: 28px;
                                            border-radius: 5px;
                                            title: "Open Folder";
                                            icon_source: @image-url("icons/folder-open.svg");
                                            has_icon: true;
                                            icon_size: 12px;
                                            font_size: 11px;
                                            fill_color: #1e293b;
                                            hover_color: #334155;
                                            clicked => { AppLogic.open_output_dir(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // LOG DRAWER (Collapsible)
        if AppData.show_logs : Rectangle {
            height: 120px;
            background: #090d16;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                HorizontalLayout {
                    Text { text: "Live FFmpeg Command & Stderr Stream"; font-size: 11px; font-weight: 600; color: #64748b; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        icon_source: @image-url("icons/x.svg");
                        has_icon: true;
                        icon_size: 12px;
                        btn_width: 24px;
                        btn_height: 24px;
                        clicked => { AppLogic.toggle_logs(); }
                    }
                }

                ScrollView {
                    Text {
                        text: AppData.log_preview;
                        font-size: 11px;
                        font-family: "Consolas";
                        color: #a5f3fc;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Bottom Divider
        Rectangle { height: 1px; background: #334155; }

        // BOTTOM ACTION & PROGRESS BAR
        Rectangle {
            height: 80px;
            background: #1e293b;

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                // Progress Indicator Track
                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: #0f172a;

                    // Active progress fill
                    Rectangle {
                        x: 0px;
                        width: parent.width * AppData.progress_percent;
                        height: parent.height;
                        border-radius: 4px;
                        background: @linear-gradient(90deg, #0284c7 0%, #10b981 100%);
                    }
                }

                // Stats, Action Buttons, and Bottom-Right Logs Toggle
                HorizontalLayout {
                    spacing: 12px;

                    // Left stats
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: AppData.progress_text;
                            font-size: 12px;
                            font-weight: 600;
                            color: #f8fafc;
                            vertical-alignment: center;
                        }

                        Badge { label: AppData.time_text; bg_color: #0f172a; fg_color: #38bdf8; }
                        Badge { label: AppData.speed_text; bg_color: #0f172a; fg_color: #a78bfa; }
                        Badge { label: AppData.fps_text; bg_color: #0f172a; fg_color: #34d399; }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Action Controls
                    if !AppData.is_processing : ActionButton {
                        width: 175px;
                        height: 36px;
                        title: "START FUNCTION";
                        icon_source: @image-url("icons/play.svg");
                        has_icon: true;
                        icon_size: 13px;
                        fill_color: #10b981;
                        hover_color: #059669;
                        is_disabled: AppData.queue.length == 0;
                        clicked => { AppLogic.start_processing(); }
                    }

                    if AppData.is_processing : ActionButton {
                        width: 160px;
                        height: 36px;
                        title: "STOP / CANCEL";
                        icon_source: @image-url("icons/stop.svg");
                        has_icon: true;
                        icon_size: 13px;
                        fill_color: #ef4444;
                        hover_color: #dc2626;
                        clicked => { AppLogic.cancel_processing(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Bottom-Right Corner: FFmpeg Engine, GPU Acceleration, and Show Logs Toggle
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Badge {
                            label: "FFmpeg 7.x Engine";
                            bg_color: #0f172a;
                            fg_color: #38bdf8;
                        }

                        Rectangle {
                            height: 24px;
                            border-radius: 4px;
                            background: #0f172a;
                            border-width: 1px;
                            border-color: #34d399.with-alpha(0.3);

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/zap.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: #34d399;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "GPU Accelerated";
                                        font-size: 11px;
                                        color: #34d399;
                                        font-weight: 600;
                                    }
                                }
                            }
                        }

                        // Compact "Show Logs" Toggle in Bottom-Right Corner
                        Rectangle {
                            height: 28px;
                            border-radius: 4px;
                            background: AppData.show_logs ? #334155 : #0f172a;
                            border-width: 1px;
                            border-color: AppData.show_logs ? #38bdf8 : #334155;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/logs.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: AppData.show_logs ? #38bdf8 : #94a3b8;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: AppData.show_logs ? "Hide Logs" : "Show Logs";
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: AppData.show_logs ? #f8fafc : #94a3b8;
                                    }
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.toggle_logs(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
