import { LineEdit, ScrollView } from "std-widgets.slint";
import { AppData, AppLogic, Theme } from "../globals.slint";
import { ActionButton } from "../components/action_button.slint";
import { Badge } from "../components/badge.slint";
import { DownloaderFormatDropdown } from "../components/downloader_format_dropdown.slint";

export component DownloaderTab inherits ScrollView {
    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        padding-bottom: 28px;
        spacing: 18px;
        alignment: start;

        // ==========================================
        // SECTION 1: UNIVERSAL MEDIA DOWNLOADER
        // ==========================================
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "Universal Media Downloader";
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.text_secondary;
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: 8px;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    // URL Input Box with Spacious Action Buttons
                    HorizontalLayout {
                        spacing: 8px;

                        LineEdit {
                            height: 36px;
                            horizontal-stretch: 1;
                            font-size: 12px;
                            text <=> AppData.ytdlp_url;
                            placeholder-text: "Paste stream URL (e.g. https://www.youtube.com/watch?v=... or direct m3u8 playlist)";
                            accepted => { AppLogic.ytdlp_discover(); }
                            edited(val) => { AppLogic.ytdlp_url_changed(val); }
                        }

                        ActionButton {
                            width: 76px;
                            height: 36px;
                            title: "Paste";
                            icon_source: @image-url("../icons/layers.svg");
                            has_icon: true;
                            icon_size: 12px;
                            fill_color: Theme.btn_neutral_bg;
                            hover_color: Theme.btn_neutral_hover;
                            text_color: Theme.accent_cyan;
                            font_size: 11.5px;
                            clicked => { AppLogic.ytdlp_paste_clipboard(); }
                        }

                        ActionButton {
                            width: 76px;
                            height: 36px;
                            title: "Clear";
                            icon_source: @image-url("../icons/trash.svg");
                            has_icon: true;
                            icon_size: 12px;
                            fill_color: Theme.btn_neutral_bg;
                            hover_color: Theme.btn_neutral_hover;
                            text_color: Theme.text_secondary;
                            font_size: 11.5px;
                            clicked => { AppLogic.ytdlp_clear_url(); }
                        }

                        ActionButton {
                            width: 130px;
                            height: 36px;
                            title: AppData.ytdlp_is_discovering ? "Detecting..." : "Discover Media";
                            icon_source: @image-url("../icons/search.svg");
                            has_icon: true;
                            icon_size: 13px;
                            fill_color: #0284c7;
                            hover_color: #0369a1;
                            text_color: #ffffff;
                            font_size: 12px;
                            is_disabled: AppData.ytdlp_url == "" || AppData.ytdlp_is_discovering;
                            clicked => { AppLogic.ytdlp_discover(); }
                        }
                    }

                    // Supported Sites Pill Tags Showcase
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Supported Platforms:";
                            font-size: 10.5px;
                            font-weight: 600;
                            color: Theme.text_muted;
                            vertical-alignment: center;
                        }

                        Badge { label: "YouTube"; bg_color: Theme.card_secondary_bg; fg_color: Theme.accent_red; height: 19px; }
                        Badge { label: "Twitch"; bg_color: Theme.card_secondary_bg; fg_color: Theme.accent_purple; height: 19px; }
                        Badge { label: "Vimeo"; bg_color: Theme.card_secondary_bg; fg_color: Theme.accent_cyan; height: 19px; }
                        Badge { label: "TikTok"; bg_color: Theme.card_secondary_bg; fg_color: #f43f5e; height: 19px; }
                        Badge { label: "Bilibili"; bg_color: Theme.card_secondary_bg; fg_color: Theme.accent_cyan; height: 19px; }
                        Badge { label: "SoundCloud"; bg_color: Theme.card_secondary_bg; fg_color: Theme.accent_amber; height: 19px; }
                        Badge { label: "X / Twitter"; bg_color: Theme.card_secondary_bg; fg_color: Theme.text_primary; height: 19px; }
                        Badge { label: "HLS / M3U8 Livestreams"; bg_color: Theme.card_secondary_bg; fg_color: Theme.accent_green; height: 19px; }
                    }
                }
            }
        }

        // CARD 2: MEDIA INSPECTOR / DISCOVERY STATE / IDLE CAPABILITIES GUIDE
        if AppData.ytdlp_is_discovering : Rectangle {
            vertical-stretch: 0;
            border-radius: 8px;
            background: #0284c715;
            border-width: 1px;
            border-color: #0284c755;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/search.svg");
                        width: 16px;
                        height: 16px;
                        colorize: #38bdf8;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Querying stream metadata and discovering available formats & audio tracks via yt-dlp...";
                        font-size: 12px;
                        font-weight: 600;
                        color: #38bdf8;
                    }
                }
            }
        }

        if AppData.ytdlp_has_error : Rectangle {
            vertical-stretch: 0;
            border-radius: 8px;
            background: #ef444415;
            border-width: 1px;
            border-color: #ef444455;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/x.svg");
                        width: 15px;
                        height: 15px;
                        colorize: #ef4444;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "Discovery Error: " + AppData.ytdlp_error_message;
                        font-size: 11px;
                        font-weight: 600;
                        color: #fca5a5;
                        wrap: word-wrap;
                    }
                }

                ActionButton {
                    width: 68px;
                    height: 28px;
                    title: "Dismiss";
                    fill_color: #ef444433;
                    hover_color: #ef444455;
                    text_color: #fca5a5;
                    font_size: 10.5px;
                    clicked => { AppData.ytdlp_has_error = false; }
                }
            }
        }

        if AppData.ytdlp_has_discovered : VerticalLayout {
            spacing: 6px;

            Text {
                text: "Discovered Media Stream";
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.text_secondary;
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: 8px;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: #34d39966;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    // Header Row: Metadata Badges + Ready Status
                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/film.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #34d399;
                            }
                        }

                        if AppData.ytdlp_uploader != "" : Rectangle {
                        height: 20px;
                        border-radius: 4px;
                        background: Theme.card_secondary_bg;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: "Author:";
                                font-size: 10px;
                                color: Theme.text_muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: AppData.ytdlp_uploader;
                                font-size: 10.5px;
                                font-weight: 600;
                                color: #38bdf8;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if AppData.ytdlp_duration != "" : Rectangle {
                        height: 20px;
                        border-radius: 4px;
                        background: Theme.card_secondary_bg;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/clock.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: Theme.text_muted;
                                }
                            }
                            Text {
                                text: AppData.ytdlp_duration;
                                font-size: 10.5px;
                                font-weight: 600;
                                color: Theme.text_primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if AppData.ytdlp_discovered_id != "" : Rectangle {
                        height: 20px;
                        border-radius: 4px;
                        background: Theme.card_secondary_bg;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text {
                                text: "ID: " + AppData.ytdlp_discovered_id;
                                font-size: 10px;
                                font-weight: 600;
                                color: #71717a;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Ready Status Badge
                    Rectangle {
                        height: 20px;
                        border-radius: 4px;
                        background: #05966922;
                        border-width: 1px;
                        border-color: #34d399;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/check.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: #34d399;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Ready to Download";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #34d399;
                                }
                            }
                        }
                    }
                }

                // Title Text with high prominence
                Text {
                    text: AppData.ytdlp_title;
                    font-size: 13.5px;
                    font-weight: 700;
                    color: #f4f4f5;
                    overflow: elide;
                }

                // CUSTOM SAVE FILE NAME SECTION (Full Width Container)
                Rectangle {
                    border-radius: 6px;
                    background: #101014;
                    border-width: 1px;
                    border-color: #0284c744;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/sliders.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: #38bdf8;
                                }
                            }

                            Text {
                                text: "Custom Output File Name:";
                                font-size: 11px;
                                font-weight: 700;
                                color: #38bdf8;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: "(Appropriate extension will be auto-appended based on selected preset)";
                                font-size: 10px;
                                color: #71717a;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            LineEdit {
                                horizontal-stretch: 1;
                                height: 32px;
                                font-size: 11.5px;
                                placeholder-text: "Enter custom file name (without extension)...";
                                text <=> AppData.ytdlp_custom_filename;
                            }

                            ActionButton {
                                width: 80px;
                                height: 32px;
                                title: "Reset";
                                icon_source: @image-url("../icons/reset.svg");
                                has_icon: true;
                                icon_size: 11px;
                                fill_color: Theme.btn_neutral_bg;
                                hover_color: Theme.btn_neutral_hover;
                                text_color: Theme.text_secondary;
                                font_size: 11px;
                                clicked => { AppData.ytdlp_custom_filename = AppData.ytdlp_title; }
                            }
                        }
                    }
                }
            }
        }
    }

        // ==========================================
        // SECTION: DOWNLOAD FORMAT & TARGET DESTINATION
        // ==========================================
        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Download Format & Target Destination";
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Theme.text_secondary;
                    vertical-alignment: center;
                }

                property <bool> is_audio_format: AppData.ytdlp_format_options.length > 0 && AppData.ytdlp_selected_format_index < AppData.ytdlp_format_options.length && AppData.ytdlp_format_options[AppData.ytdlp_selected_format_index].starts-with("[Audio]");
                Rectangle {
                    height: 18px;
                    border-radius: 4px;
                    background: is_audio_format ? #7c3aed22 : #0284c722;
                    border-width: 1px;
                    border-color: is_audio_format ? Theme.accent_purple.with-alpha(0.5) : Theme.accent_cyan.with-alpha(0.5);
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: is_audio_format ? @image-url("../icons/audio.svg") : @image-url("../icons/video.svg");
                                width: 10px;
                                height: 10px;
                                colorize: is_audio_format ? Theme.accent_purple : Theme.accent_cyan;
                            }
                        }
                        Text {
                            text: is_audio_format ? "Audio Extraction Mode" : "Video + Audio Merge (MP4)";
                            font-size: 9.5px;
                            font-weight: 600;
                            color: is_audio_format ? Theme.accent_purple : Theme.accent_cyan;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: 8px;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 8px;
                    alignment: start;

                    // 2-Column Split: Format Dropdown (Left) and Destination Folder (Right)
                    HorizontalLayout {
                        spacing: 16px;

                        // Left Column: Format Selection (Reduced width)
                        VerticalLayout {
                            width: 320px;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: "Stream Quality & Format Preset:";
                                font-size: 11px;
                                font-weight: 600;
                                color: #a1a1aa;
                            }

                            DownloaderFormatDropdown {
                                height: 32px;
                                model: AppData.ytdlp_format_options;
                                current-index <=> AppData.ytdlp_selected_format_index;
                            }

                            Text {
                                text: "Highest available video and audio streams are muxed without generation quality loss.";
                                font-size: 10px;
                                color: #71717a;
                                wrap: word-wrap;
                            }
                        }

                        // Right Column: Destination Folder (Expanded width)
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: "Save Destination Folder:";
                                font-size: 11px;
                                font-weight: 600;
                                color: #a1a1aa;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                LineEdit {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    font-size: 11.5px;
                                    placeholder-text: "Choose or paste folder path to save downloaded media";
                                    text <=> AppData.ytdlp_output_dir;
                                }

                                ActionButton {
                                    width: 84px;
                                    height: 32px;
                                    title: "Browse...";
                                    icon_source: @image-url("../icons/folder.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    fill_color: Theme.btn_neutral_bg;
                                    hover_color: Theme.btn_neutral_hover;
                                    text_color: Theme.accent_cyan;
                                    font_size: 11px;
                                    clicked => { AppLogic.ytdlp_select_output_dir(); }
                                }

                                ActionButton {
                                    width: 98px;
                                    height: 32px;
                                    title: "Open Folder";
                                    icon_source: @image-url("../icons/folder-open.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    fill_color: Theme.btn_neutral_bg;
                                    hover_color: Theme.btn_neutral_hover;
                                    text_color: Theme.text_secondary;
                                    font_size: 11px;
                                    clicked => { AppLogic.ytdlp_open_output_dir(); }
                                }
                            }

                            Text {
                                text: "Default directory configured in Settings. Changes apply to subsequent downloads.";
                                font-size: 10px;
                                color: #71717a;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // SECTION: DOWNLOAD CONTROLS & STATUS
        // ==========================================
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "Download Controls & Progress";
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.text_secondary;
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: 8px;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    // Status Message + Telemetry Badges + Action Button
                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: AppData.ytdlp_status_message;
                                font-size: 11.5px;
                                font-weight: 600;
                                color: AppData.ytdlp_is_downloading ? Theme.accent_cyan : Theme.text_secondary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            VerticalLayout {
                                alignment: center;
                                Badge { label: AppData.ytdlp_progress_text; bg_color: Theme.card_secondary_bg; fg_color: #38bdf8; height: 22px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Badge { label: AppData.ytdlp_speed_text; bg_color: Theme.card_secondary_bg; fg_color: #a78bfa; height: 22px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Badge { label: AppData.ytdlp_eta_text; bg_color: Theme.card_secondary_bg; fg_color: #34d399; height: 22px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Badge { label: AppData.ytdlp_size_text; bg_color: Theme.card_secondary_bg; fg_color: Theme.text_primary; height: 22px; }
                            }
                        }

                        if !AppData.ytdlp_is_downloading : ActionButton {
                            width: 170px;
                            height: 36px;
                            title: "START DOWNLOAD";
                            icon_source: @image-url("../icons/download.svg");
                            has_icon: true;
                            icon_size: 14px;
                            fill_color: #10b981;
                            hover_color: #059669;
                            font_size: 12px;
                            clicked => { AppLogic.ytdlp_start_download(); }
                        }

                        if AppData.ytdlp_is_downloading : ActionButton {
                            width: 170px;
                            height: 36px;
                            title: "CANCEL DOWNLOAD";
                            icon_source: @image-url("../icons/stop.svg");
                            has_icon: true;
                            icon_size: 14px;
                            fill_color: #ef4444;
                            hover_color: #dc2626;
                            font_size: 12px;
                            clicked => { AppLogic.ytdlp_cancel_download(); }
                        }
                    }

                    // Sleek Modern Progress Bar
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.control_bg;

                        Rectangle {
                            x: 0px;
                            width: parent.width * (AppData.ytdlp_progress / 100.0).clamp(0.0, 1.0);
                            height: parent.height;
                            border-radius: 4px;
                            background: @linear-gradient(90deg, #0284c7 0%, #10b981 100%);
                        }
                    }
                }
            }
        }

        // CARD 5: POST-DOWNLOAD QUICK ACTIONS (Celebration Banner)
        if AppData.ytdlp_download_finished : Rectangle {
            vertical-stretch: 0;
            border-radius: 8px;
            background: #05966915;
            border-width: 1px;
            border-color: #10b98188;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../icons/check.svg");
                            width: 16px;
                            height: 16px;
                            colorize: #34d399;
                        }
                    }

                    Text {
                        text: "Download Completed Successfully!";
                        font-size: 13px;
                        font-weight: 700;
                        color: #34d399;
                        vertical-alignment: center;
                    }

                    if AppData.ytdlp_last_downloaded_file != "" : Text {
                        horizontal-stretch: 1;
                        text: "— Saved: " + AppData.ytdlp_last_downloaded_file;
                        font-size: 11px;
                        color: #d4d4d8;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Quick Action Integration Buttons
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    ActionButton {
                        height: 32px;
                        title: "Load in View & Edit";
                        icon_source: @image-url("../icons/film.svg");
                        has_icon: true;
                        icon_size: 12px;
                        fill_color: #0284c7;
                        hover_color: #0369a1;
                        text_color: #ffffff;
                        font_size: 11.5px;
                        clicked => { AppLogic.ytdlp_load_in_player(); }
                    }

                    ActionButton {
                        height: 32px;
                        title: "Add to Transcoder Queue";
                        icon_source: @image-url("../icons/plus.svg");
                        has_icon: true;
                        icon_size: 12px;
                        fill_color: Theme.btn_neutral_bg;
                        hover_color: Theme.btn_neutral_hover;
                        text_color: Theme.accent_cyan;
                        font_size: 11.5px;
                        clicked => { AppLogic.ytdlp_send_to_queue(); }
                    }

                    ActionButton {
                        height: 32px;
                        title: "Open Folder";
                        icon_source: @image-url("../icons/folder-open.svg");
                        has_icon: true;
                        icon_size: 12px;
                        fill_color: Theme.btn_neutral_bg;
                        hover_color: Theme.btn_neutral_hover;
                        text_color: Theme.text_secondary;
                        font_size: 11.5px;
                        clicked => { AppLogic.ytdlp_open_output_dir(); }
                    }
                }
            }
        }

        // ==========================================
        // SECTION: SESSION DOWNLOAD HISTORY
        // ==========================================
        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Session Download History";
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Theme.text_secondary;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 18px;
                    border-radius: 4px;
                    background: AppData.ytdlp_history.length > 0 ? #0284c722 : Theme.card_secondary_bg;
                    border-width: 1px;
                    border-color: AppData.ytdlp_history.length > 0 ? Theme.accent_cyan.with-alpha(0.4) : Theme.border_color;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: AppData.ytdlp_history.length == 0 ? "0 items" : (AppData.ytdlp_history.length == 1 ? "1 item" : "\{AppData.ytdlp_history.length} items");
                            font-size: 9.5px;
                            font-weight: 600;
                            color: AppData.ytdlp_history.length > 0 ? Theme.accent_cyan : Theme.text_muted;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if AppData.ytdlp_history.length > 0 : ActionButton {
                    width: 96px;
                    height: 22px;
                    title: "Clear History";
                    icon_source: @image-url("../icons/trash.svg");
                    has_icon: true;
                    icon_size: 11px;
                    fill_color: Theme.btn_neutral_bg;
                    hover_color: #ef444422;
                    text_color: Theme.text_secondary;
                    font_size: 10.5px;
                    clicked => { AppLogic.ytdlp_clear_history(); }
                }
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: 8px;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;
                    alignment: start;

                    // Empty state when no downloads yet in this open session
                    if AppData.ytdlp_history.length == 0 : Rectangle {
                    height: 54px;
                    border-radius: 6px;
                    background: Theme.card_subtle_bg;
                    border-width: 1px;
                    border-color: Theme.card_subtle_border;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/download.svg");
                                width: 15px;
                                height: 15px;
                                colorize: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "No files downloaded in this session yet. Completed downloads will appear here with quick reveal and management.";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }
                    }
                }

                // Download History List items
                if AppData.ytdlp_history.length > 0 : VerticalLayout {
                    spacing: 6px;

                    for item[idx] in AppData.ytdlp_history : Rectangle {
                        height: 50px;
                        border-radius: 6px;
                        background: Theme.card_secondary_bg;
                        border-width: 1px;
                        border-color: Theme.card_secondary_border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 10px;

                            // Media File Icon Pill
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 5px;
                                    background: #0284c718;
                                    border-width: 1px;
                                    border-color: Theme.accent_cyan.with-alpha(0.3);
                                    Image {
                                        source: @image-url("../icons/film.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: Theme.accent_cyan;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            // Details (File Name + Size on top row, Saved Path on bottom row)
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: item.file_name;
                                        font-size: 11.5px;
                                        font-weight: 600;
                                        color: Theme.text_primary;
                                        overflow: elide;
                                    }
                                    if item.file_size_formatted != "" : Text {
                                        text: "• " + item.file_size_formatted;
                                        font-size: 10.5px;
                                        color: Theme.accent_cyan;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: item.file_path;
                                    font-size: 10px;
                                    color: Theme.text_muted;
                                    overflow: elide;
                                }
                            }

                            // Action: Open in File Explorer & Select File
                            VerticalLayout {
                                alignment: center;
                                ActionButton {
                                    width: 118px;
                                    height: 30px;
                                    title: "Show in Folder";
                                    icon_source: @image-url("../icons/folder-open.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    fill_color: Theme.btn_neutral_bg;
                                    hover_color: Theme.btn_neutral_hover;
                                    text_color: Theme.accent_cyan;
                                    font_size: 11px;
                                    clicked => { AppLogic.ytdlp_open_history_item(idx); }
                                }
                            }

                            // Action: Remove from History List
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 5px;
                                    background: rem_ta.pressed ? #ef444433 : (rem_ta.has-hover ? #ef44441f : Theme.btn_neutral_bg);
                                    border-width: 1px;
                                    border-color: rem_ta.has-hover ? #ef444455 : Theme.border_color;

                                    animate background { duration: 100ms; }
                                    animate border-color { duration: 100ms; }

                                    Image {
                                        source: @image-url("../icons/trash.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: rem_ta.has-hover ? #f87171 : Theme.text_muted;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    rem_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppLogic.ytdlp_remove_history_item(idx); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}
