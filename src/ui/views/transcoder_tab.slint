import { ComboBox, ScrollView, Slider } from "std-widgets.slint";
import { AppData, AppLogic, Theme } from "../globals.slint";
import { ActionButton } from "../components/action_button.slint";
import { ToggleSwitch } from "../components/toggle_switch.slint";

export component TranscoderTab inherits ScrollView {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 18px;
        padding-bottom: 32px;
        spacing: 18px;
        alignment: start;

        // Page Header
        HorizontalLayout {
            padding-left: 4px;
            padding-bottom: 2px;
            Text {
                text: "Settings";
                font-size: 22px;
                font-weight: 700;
                color: Theme.text_primary;
            }
        }

        // ==========================================
        // SECTION 1: GENERAL
        // ==========================================
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "General";
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.text_secondary;
            }

            Rectangle {
                border-radius: 8px;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    spacing: 0px;

                    // Row: Open Folder on Finish
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/folder-open.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.accent_amber;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Open folder on finish";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Show target destination in Windows File Explorer when export completes";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ToggleSwitch {
                                    checked <=> AppData.open_folder_on_finish;
                                    toggled(v) => { AppLogic.set_open_folder_on_finish(v); }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Play Sound on Finish
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/volume-2.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.accent_purple;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Play sound on finish";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Play an audible notification sound when batch encoding completes";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ToggleSwitch {
                                    checked <=> AppData.play_sound_on_finish;
                                    toggled(v) => { AppLogic.set_play_sound_on_finish(v); }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Default Destination Folder
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/folder.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.text_secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Default destination folder";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: AppData.output_directory == "Same as source" ? "Save exported files alongside source media by default" : AppData.output_directory;
                                font-size: 11px;
                                color: Theme.text_muted;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                ActionButton {
                                    width: 105px;
                                    height: 32px;
                                    title: "Change...";
                                    icon_source: @image-url("../icons/folder.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    font_size: 11px;
                                    fill_color: Theme.btn_neutral_bg;
                                    hover_color: Theme.btn_neutral_hover;
                                    text_color: Theme.text_primary;
                                    clicked => { AppLogic.select_output_dir(); }
                                }

                                ActionButton {
                                    width: 75px;
                                    height: 32px;
                                    title: "Open";
                                    icon_source: @image-url("../icons/folder-open.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    font_size: 11px;
                                    fill_color: Theme.btn_neutral_bg;
                                    hover_color: Theme.btn_neutral_hover;
                                    text_color: Theme.text_secondary;
                                    clicked => { AppLogic.open_output_dir(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // SECTION 2: VIDEO & TRANSCODING
        // ==========================================
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "Video & Transcoding";
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.text_secondary;
            }

            Rectangle {
                border-radius: 8px;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    spacing: 0px;

                    // Row: Primary Video Codec
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/video.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.accent_cyan;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Primary video codec";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Default video encoding workflow and compression codec";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 250px;
                                    height: 32px;
                                    model: [
                                        "H.264 (AVC) — Universal Web",
                                        "H.265 (HEVC) — High Efficiency",
                                        "AV1 — Next-Gen Open Video",
                                        "Apple ProRes — Editing Intermediate",
                                        "Avid DNxHD / DNxHR — Broadcast NLE",
                                        "VP9 — Open Web Codec",
                                        "Rewrap / Remux (No Re-encode)",
                                        "Lossless Cut (Instant Trim)",
                                        "Extract Video Track Only",
                                        "Extract Audio Track Only",
                                        "Audio Normalization (EBU R128)",
                                        "Audio Conversion (AAC/MP3/FLAC)",
                                        "Extract Subtitle Stream (.srt)"
                                    ];
                                    current-index <=> AppData.function_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Hardware Acceleration
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/zap.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.accent_green;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Hardware acceleration";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Accelerate encoding pipelines using dedicated GPU silicon";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 230px;
                                    height: 32px;
                                    model: [
                                        "Auto Detect (Recommended)",
                                        "NVIDIA NVENC (CUDA)",
                                        "Intel QuickSync (QSV)",
                                        "AMD AMF",
                                        "Apple VideoToolbox",
                                        "CPU Software Only"
                                    ];
                                    current-index <=> AppData.hw_accel_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Rate Control Mode
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/sliders.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.text_secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Rate control mode";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Constant Quality (CRF) for fidelity vs Target Bitrate for fixed file size";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 210px;
                                    height: 32px;
                                    model: ["Constant Quality (CRF)", "Target Bitrate (ABR)"];
                                    current-index <=> AppData.rate_control_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Quality Target Tuning (CRF or Bitrate)
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/sliders.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.text_secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: AppData.rate_control_index == 0 ? "Target CRF quality" : "Target video bitrate";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: AppData.rate_control_index == 0 ?
                                    "Visual quality: 0 = lossless, 18 = high fidelity, 23 = balanced, 28 = compact" :
                                    "Average stream bandwidth allocated for encoding";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                if AppData.rate_control_index == 0 : HorizontalLayout {
                                    spacing: 12px;
                                    alignment: end;
                                    Slider {
                                        width: 150px;
                                        minimum: 0;
                                        maximum: 51;
                                        value <=> AppData.crf_value;
                                    }
                                    Rectangle {
                                        width: 54px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: Theme.card_secondary_bg;
                                        border-width: 1px;
                                        border-color: Theme.card_secondary_border;
                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: "CRF " + Math.round(AppData.crf_value);
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Theme.accent_cyan;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if AppData.rate_control_index == 1 : ComboBox {
                                    width: 210px;
                                    height: 32px;
                                    model: [
                                        "12000 kbps (4K/High)",
                                        "8000 kbps (1080p60)",
                                        "6000 kbps (1080p30)",
                                        "4000 kbps (720p)",
                                        "2500 kbps (Web)",
                                        "1500 kbps (Mobile)"
                                    ];
                                    current-index <=> AppData.video_bitrate_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Encoder Preset & Speed
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/clock.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.text_secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Encoder preset & speed";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Trade-off between compression speed and file density (medium recommended)";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 190px;
                                    height: 32px;
                                    model: ["ultrafast", "faster", "fast", "medium", "slow", "veryslow"];
                                    current-index <=> AppData.preset_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Resolution Scaling
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/film.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.text_secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Resolution scaling";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Conform or downscale output frame dimensions";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 210px;
                                    height: 32px;
                                    model: [
                                        "Original Source",
                                        "4K UHD (3840x2160)",
                                        "1440p QHD (2560x1440)",
                                        "1080p Full HD (1920x1080)",
                                        "720p HD (1280x720)",
                                        "480p SD (854x480)"
                                    ];
                                    current-index <=> AppData.resolution_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Framerate Conform
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/monitor.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.text_secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Framerate conform";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Output cadence and target frames per second";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 210px;
                                    height: 32px;
                                    model: [
                                        "Original Source",
                                        "23.976 fps (Cinema)",
                                        "24.0 fps (Film)",
                                        "25.0 fps (PAL)",
                                        "29.97 fps (NTSC)",
                                        "30.0 fps (Standard)",
                                        "50.0 fps (PAL High)",
                                        "59.94 fps (NTSC High)",
                                        "60.0 fps (Smooth)"
                                    ];
                                    current-index <=> AppData.fps_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Deinterlacing Filter
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/layers.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.text_secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Deinterlacing filter";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Eliminate comb artifacts from interlaced television and camera footage";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 210px;
                                    height: 32px;
                                    model: [
                                        "None (Keep Progressive)",
                                        "YADIF (Deinterlace)",
                                        "BBDenoise + Deinterlace"
                                    ];
                                    current-index <=> AppData.deinterlace_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Web FastStart Optimization
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/globe.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.accent_cyan;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Web FastStart optimization";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Moves the MP4 moov atom to the beginning of the file for instant streaming";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ToggleSwitch {
                                    checked <=> AppData.faststart;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Output Container Format
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/film.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.accent_green;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Output container format";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Default container wrapper (.mp4, .mkv, .mov, .webm, .avi, .ts)";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 210px;
                                    height: 32px;
                                    model: [
                                        ".mp4 (Standard MPEG-4)",
                                        ".mkv (Matroska Multi-Track)",
                                        ".mov (Apple QuickTime)",
                                        ".webm (HTML5 WebM)",
                                        ".avi (Legacy Windows)",
                                        ".ts (MPEG-TS Transport)"
                                    ];
                                    current-index <=> AppData.container_index;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // SECTION 3: AUDIO & BROADCAST LOUDNESS
        // ==========================================
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "Audio & Broadcast Loudness";
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.text_secondary;
            }

            Rectangle {
                border-radius: 8px;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    spacing: 0px;

                    // Row: Default Audio Codec
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/audio.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.accent_purple;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Default audio codec";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Compression format for exported audio tracks";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 230px;
                                    height: 32px;
                                    model: [
                                        "AAC (High Quality Standard)",
                                        "MP3 (Universal Compatibility)",
                                        "Opus (Low Latency / High Fidelity)",
                                        "FLAC (Lossless Studio)",
                                        "WAV (Linear PCM Uncompressed)",
                                        "Passthrough Copy (Original Stream)"
                                    ];
                                    current-index <=> AppData.audio_codec_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Target Audio Bitrate
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/sliders.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.text_secondary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Audio encoding bitrate";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Target bitrate allocated per channel for lossy audio formats";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 210px;
                                    height: 32px;
                                    model: [
                                        "320 kbps (Maximum Fidelity)",
                                        "256 kbps (Studio Quality)",
                                        "192 kbps (Standard Quality)",
                                        "128 kbps (Compact Web)",
                                        "96 kbps (Speech Optimized)"
                                    ];
                                    current-index <=> AppData.audio_bitrate_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Sample Rate
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/wave.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.accent_red;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Sample rate frequency";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Audio clock frequency conform (48 kHz is cinema/video standard)";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 210px;
                                    height: 32px;
                                    model: [
                                        "Keep Source Frequency",
                                        "48.0 kHz (Cinema & Video Standard)",
                                        "44.1 kHz (CD Audio Standard)",
                                        "96.0 kHz (Hi-Res Audio Studio)"
                                    ];
                                    current-index <=> AppData.audio_sample_rate_index;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Broadcast Loudness Normalization
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/volume-2.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.accent_purple;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Broadcast loudness normalization";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Conform loudness levels to broadcast and streaming standards (EBU R128 / LUFS)";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                ComboBox {
                                    width: 240px;
                                    height: 32px;
                                    model: [
                                        "Disabled (Preserve Dynamic Range)",
                                        "EBU R128 TV Broadcast (-23 LUFS)",
                                        "YouTube & Web Video (-14 LUFS)",
                                        "Podcasts & Speech (-16 LUFS)",
                                        "Apple Music Standard (-16 LUFS)"
                                    ];
                                    current-index <=> AppData.normalize_index;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // SECTION 4: ABOUT
        // ==========================================
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "About";
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.text_secondary;
            }

            Rectangle {
                border-radius: 8px;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    spacing: 0px;

                    // Row: About Another Encoder
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 9px;
                        padding-bottom: 9px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/brand-logo.png");
                                width: 20px;
                                height: 20px;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: "About Another Encoder";
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "An open-source, high-performance media transcoder and universal video downloader";
                                font-size: 10.5px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                Text {
                                    text: "Version 0.10.0 • Up to date";
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: Theme.text_muted;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: FFmpeg Core Engine
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 9px;
                        padding-bottom: 9px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/zap.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Theme.accent_green;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: "FFmpeg Multimedia Engine";
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Core transcode engine with NVENC, QSV, AMF, ProRes, AV1, and multi-track audio muxing";
                                font-size: 10.5px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                Text {
                                    text: AppData.ffmpeg_version_badge;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: Theme.text_secondary;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: yt-dlp Stream Extractor
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 9px;
                        padding-bottom: 9px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/download.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Theme.accent_red;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: "yt-dlp Downloader Engine";
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Ingests media and livestreams from over 1,000 video, audio, and playlist platforms";
                                font-size: 10.5px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                Text {
                                    text: AppData.ytdlp_version_badge;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: Theme.text_secondary;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.card_secondary_border; }

                    // Row: Slint UI & Rust Core Runtime
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 9px;
                        padding-bottom: 9px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 24px;
                            Image {
                                source: @image-url("../icons/layers.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Theme.accent_cyan;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: "Core Framework & Runtime";
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Slint UI 1.18 Native GUI Toolkit • Rust 2021 Edition • tokio, rodio, image, symphonia";
                                font-size: 10.5px;
                                color: Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                Text {
                                    text: "Slint 1.18 • Rust 2021";
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: Theme.text_secondary;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
