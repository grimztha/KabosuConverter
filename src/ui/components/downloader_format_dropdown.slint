import { ScrollView } from "std-widgets.slint";
import { Theme } from "../globals.slint";

export component DownloaderFormatDropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(int);

    pure function get_tag(s: string) -> string {
        s.starts-with("[Audio]") ? "Audio" : (s.starts-with("[Video]") ? "Video" : "")
    }

    pure function get_tag_color(s: string) -> color {
        s.starts-with("[Audio]") ? Theme.accent_purple : (s.starts-with("[Video]") ? Theme.accent_lime : Theme.text_primary)
    }

    pure function get_tag_bg(s: string) -> color {
        s.starts-with("[Audio]") ? Theme.purple_surface : (s.starts-with("[Video]") ? Theme.accent_surface : Theme.card_secondary_bg)
    }

    pure function get_label(s: string) -> string {
        s.starts-with("[Audio] ") ? s.replace-all("[Audio] ", "") : (s.starts-with("[Video] ") ? s.replace-all("[Video] ", "") : (s.starts-with("[Audio]") ? s.replace-all("[Audio]", "") : (s.starts-with("[Video]") ? s.replace-all("[Video]", "") : s)))
    }

    property <int> safe_index: root.model.length > 0 ? Math.max(0, Math.min(root.current-index, root.model.length - 1)) : 0;
    property <string> current_raw: root.model.length > 0 ? root.model[root.safe_index] : "";
    property <string> current_tag: root.get_tag(root.current_raw);
    property <string> current_label: root.get_label(root.current_raw);
    property <color> current_color: root.get_tag_color(root.current_raw);
    property <color> current_bg: root.get_tag_bg(root.current_raw);

    height: Theme.btn_height_md;
    border-radius: Theme.radius_sm;
    background: ta.has-hover ? Theme.input_hover_bg : Theme.input_bg;
    border-width: fs.has-focus ? 1.5px : 1px;
    border-color: fs.has-focus ? Theme.focus_ring : (ta.has-hover ? Theme.input_hover_border : Theme.input_border);

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;

        // Category Pill Tag (Kabosu Zest for Video, Soft Plum for Audio)
        if root.current_tag != "" : VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                border-radius: 4px;
                background: root.current_bg;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: root.current_tag;
                        font-size: Theme.font_badge;
                        font-weight: 700;
                        color: root.current_color;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Format label text
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.current_label;
                font-size: Theme.font_caption;
                font-weight: 500;
                color: Theme.text_primary;
                overflow: elide;
            }
        }

        // Dropdown Chevron Icon
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../icons/chevron-down.svg");
                width: 11px;
                height: 11px;
                colorize: ta.has-hover ? Theme.text_primary : Theme.text_muted;
            }
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                popup.show();
                return accept;
            }
            reject
        }

        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                fs.focus();
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: Math.max(root.width, 400px);
        height: 284px;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius_md;
            background: Theme.popup_bg;
            border-width: 1px;
            border-color: Theme.popup_border;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000099;
            clip: true;

            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    alignment: start;

                    for opt[idx] in root.model : Rectangle {
                        height: 28px;
                        border-radius: Theme.radius_sm;
                        background: idx == root.safe_index ? Theme.accent_surface : (item_ta.has-hover ? Theme.control_hover : transparent);
                        border-width: idx == root.safe_index ? 1px : 0px;
                        border-color: Theme.accent_border;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 8px;

                            if root.get_tag(opt) != "" : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: root.get_tag_bg(opt);
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        alignment: center;
                                        Text {
                                            text: root.get_tag(opt);
                                            font-size: Theme.font_badge;
                                            font-weight: 700;
                                            color: root.get_tag_color(opt);
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                Text {
                                    text: root.get_label(opt);
                                    font-size: Theme.font_badge;
                                    font-weight: idx == root.safe_index ? 600 : 400;
                                    color: idx == root.safe_index ? Theme.text_primary : (item_ta.has-hover ? Theme.text_primary : Theme.text_secondary);
                                    overflow: elide;
                                }
                            }

                            if idx == root.safe_index : VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/check.svg");
                                    width: 11px;
                                    height: 11px;
                                    colorize: root.get_tag_color(opt);
                                }
                            }
                        }

                        item_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current-index = idx;
                                root.selected(idx);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
