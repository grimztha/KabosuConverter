import { ScrollView } from "std-widgets.slint";
import { AppData, AppLogic, Theme } from "../globals.slint";
import { ActionButton } from "../components/action_button.slint";
import { Badge } from "../components/badge.slint";
import { TextField } from "../components/text_field.slint";
import { DownloaderFormatDropdown } from "../components/downloader_format_dropdown.slint";

export component DownloaderTab inherits ScrollView {
    property <bool> confirm_clear_history: false;

    VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 18px;
        padding-bottom: 28px;
        spacing: 18px;
        alignment: start;

        // ==========================================
        // SECTION 1: UNIVERSAL MEDIA DOWNLOADER
        // ==========================================
        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Universal Media Downloader";
                    font-size: Theme.font_section;
                    font-weight: 700;
                    color: Theme.text_heading;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: Theme.radius_md;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // URL Input Box with Action Controls
                    HorizontalLayout {
                        spacing: 8px;

                        TextField {
                            height: Theme.btn_height_md;
                            horizontal-stretch: 1;
                            font_size: Theme.font_caption;
                            text <=> AppData.ytdlp_url;
                            placeholder: "Paste stream URL (YouTube, Twitch, Vimeo, direct m3u8 playlist...)";
                            accepted => { AppLogic.ytdlp_discover(); }
                            edited(val) => { AppLogic.ytdlp_url_changed(val); }
                        }

                        ActionButton {
                            width: 78px;
                            height: Theme.btn_height_md;
                            title: "Paste";
                            icon_source: @image-url("../icons/layers.svg");
                            has_icon: true;
                            icon_size: 12px;
                            fill_color: Theme.btn_neutral_bg;
                            hover_color: Theme.btn_neutral_hover;
                            text_color: Theme.btn_neutral_text;
                            border_col: Theme.btn_neutral_border;
                            hover_border_col: Theme.input_hover_border;
                            normal_border_width: 1px;
                            font_size: Theme.font_caption;
                            clicked => { AppLogic.ytdlp_paste_clipboard(); }
                        }

                        ActionButton {
                            width: 76px;
                            height: Theme.btn_height_md;
                            title: "Clear";
                            icon_source: @image-url("../icons/trash.svg");
                            has_icon: true;
                            icon_size: 12px;
                            fill_color: Theme.btn_neutral_bg;
                            hover_color: Theme.btn_neutral_hover;
                            text_color: Theme.text_secondary;
                            border_col: Theme.btn_neutral_border;
                            hover_border_col: Theme.input_hover_border;
                            normal_border_width: 1px;
                            font_size: Theme.font_caption;
                            is_disabled: AppData.ytdlp_url == "";
                            clicked => { AppLogic.ytdlp_clear_url(); }
                        }

                        ActionButton {
                            width: 136px;
                            height: Theme.btn_height_md;
                            title: AppData.ytdlp_is_discovering ? "Detecting..." : "Discover Media";
                            icon_source: @image-url("../icons/search.svg");
                            has_icon: true;
                            fill_color: Theme.accent_surface;
                            hover_color: Theme.accent_surface_hover;
                            text_color: Theme.accent_lime;
                            border_col: Theme.accent_border;
                            hover_border_col: Theme.accent_primary;
                            normal_border_width: 1px;
                            font_size: Theme.font_caption;
                            is_disabled: AppData.ytdlp_url == "" || AppData.ytdlp_is_discovering;
                            clicked => { AppLogic.ytdlp_discover(); }
                        }
                    }

                    // Restrained Supported Platforms Reference Line
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/globe.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.text_muted;
                            }
                        }

                        Text {
                            text: "Supports YouTube · Twitch · Vimeo · TikTok · Bilibili · SoundCloud · X · Instagram · Facebook + 1,000 platforms";
                            font-size: Theme.font_badge;
                            font-weight: 500;
                            color: Theme.text_muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // DISCOVERY IN-PROGRESS STATE
        if AppData.ytdlp_is_discovering : Rectangle {
            vertical-stretch: 0;
            border-radius: Theme.radius_md;
            background: Theme.accent_surface;
            border-width: 1px;
            border-color: Theme.accent_border;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/search.svg");
                        width: 15px;
                        height: 15px;
                        colorize: Theme.accent_lime;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Querying stream metadata and available video/audio formats via yt-dlp...";
                        font-size: Theme.font_caption;
                        font-weight: 600;
                        color: Theme.accent_lime;
                    }
                }
            }
        }

        // ERROR BANNER
        if AppData.ytdlp_has_error : Rectangle {
            vertical-stretch: 0;
            border-radius: Theme.radius_md;
            background: Theme.red_surface;
            border-width: 1px;
            border-color: Theme.red_border;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../icons/x.svg");
                        width: 15px;
                        height: 15px;
                        colorize: Theme.accent_red_text;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "Error: " + AppData.ytdlp_error_message;
                        font-size: Theme.font_badge;
                        font-weight: 600;
                        color: Theme.accent_red_text;
                        wrap: word-wrap;
                    }
                }

                ActionButton {
                    width: 72px;
                    height: Theme.btn_height_sm;
                    title: "Dismiss";
                    fill_color: Theme.red_surface_hover;
                    hover_color: Theme.accent_red.with-alpha(0.32);
                    text_color: Theme.accent_red_text;
                    border_col: Theme.red_border;
                    normal_border_width: 1px;
                    font_size: Theme.font_badge;
                    clicked => { AppData.ytdlp_has_error = false; }
                }
            }
        }

        // DISCOVERED MEDIA STREAM CARD
        if AppData.ytdlp_has_discovered : VerticalLayout {
            spacing: 8px;

            Text {
                text: "Discovered Stream";
                font-size: Theme.font_body;
                font-weight: 700;
                color: Theme.text_heading;
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: Theme.radius_md;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    // Header Row: Metadata Pills + Ready Status
                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/film.svg");
                                width: 14px;
                                height: 14px;
                                colorize: Theme.accent_lime;
                            }
                        }

                        if AppData.ytdlp_uploader != "" : Rectangle {
                            height: 22px;
                            border-radius: 5px;
                            background: Theme.card_secondary_bg;
                            border-width: 1px;
                            border-color: Theme.card_border;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: "Channel:";
                                    font-size: Theme.font_badge;
                                    color: Theme.text_muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: AppData.ytdlp_uploader;
                                    font-size: Theme.font_badge;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if AppData.ytdlp_duration != "" : Rectangle {
                            height: 22px;
                            border-radius: 5px;
                            background: Theme.card_secondary_bg;
                            border-width: 1px;
                            border-color: Theme.card_border;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/clock.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.text_muted;
                                    }
                                }
                                Text {
                                    text: AppData.ytdlp_duration;
                                    font-size: Theme.font_badge;
                                    font-weight: 600;
                                    font-family: Theme.font_mono;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if AppData.ytdlp_discovered_id != "" : Rectangle {
                            height: 22px;
                            border-radius: 5px;
                            background: Theme.card_secondary_bg;
                            border-width: 1px;
                            border-color: Theme.card_border;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: "ID: " + AppData.ytdlp_discovered_id;
                                    font-size: Theme.font_badge;
                                    font-weight: 500;
                                    font-family: Theme.font_mono;
                                    color: Theme.text_muted;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // Ready Status Pill
                        Rectangle {
                            height: 22px;
                            border-radius: 5px;
                            background: Theme.emerald_surface;
                            border-width: 1px;
                            border-color: Theme.emerald_border;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/check.svg");
                                        width: 10px;
                                        height: 10px;
                                        colorize: Theme.accent_green;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Ready";
                                        font-size: Theme.font_badge;
                                        font-weight: 700;
                                        color: Theme.accent_green;
                                    }
                                }
                            }
                        }
                    }

                    // Stream Title
                    Text {
                        text: AppData.ytdlp_title;
                        font-size: Theme.font_section;
                        font-weight: 700;
                        color: Theme.text_primary;
                        overflow: elide;
                    }

                    // Custom Output File Name Row
                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "Output File Name";
                                font-size: Theme.font_badge;
                                font-weight: 600;
                                color: Theme.text_secondary;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: "Extension auto-appended from selected format";
                                font-size: Theme.font_badge;
                                color: Theme.text_muted;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            TextField {
                                horizontal-stretch: 1;
                                height: Theme.btn_height_md;
                                font_size: Theme.font_caption;
                                placeholder: "Enter custom file name (without extension)...";
                                text <=> AppData.ytdlp_custom_filename;
                            }

                            ActionButton {
                                width: 82px;
                                height: Theme.btn_height_md;
                                title: "Reset";
                                icon_source: @image-url("../icons/reset.svg");
                                has_icon: true;
                                icon_size: 11px;
                                fill_color: Theme.btn_neutral_bg;
                                hover_color: Theme.btn_neutral_hover;
                                text_color: Theme.btn_neutral_text;
                                border_col: Theme.btn_neutral_border;
                                hover_border_col: Theme.input_hover_border;
                                normal_border_width: 1px;
                                font_size: Theme.font_badge;
                                clicked => { AppData.ytdlp_custom_filename = AppData.ytdlp_title; }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // SECTION 2: FORMAT & DESTINATION
        // ==========================================
        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Format & Destination";
                    font-size: Theme.font_body;
                    font-weight: 700;
                    color: Theme.text_heading;
                    vertical-alignment: center;
                }

                property <bool> is_audio_format: AppData.ytdlp_format_options.length > 0 && AppData.ytdlp_selected_format_index < AppData.ytdlp_format_options.length && AppData.ytdlp_format_options[AppData.ytdlp_selected_format_index].starts-with("[Audio]");
                Rectangle {
                    height: 20px;
                    border-radius: 5px;
                    background: is_audio_format ? Theme.purple_surface : Theme.accent_surface;
                    border-width: 1px;
                    border-color: is_audio_format ? Theme.purple_border : Theme.accent_border;
                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        spacing: 5px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: is_audio_format ? @image-url("../icons/audio.svg") : @image-url("../icons/video.svg");
                                width: 10px;
                                height: 10px;
                                colorize: is_audio_format ? Theme.accent_purple : Theme.accent_lime;
                            }
                        }
                        Text {
                            text: is_audio_format ? "Audio Extraction" : "Video + Audio Mux (MP4)";
                            font-size: Theme.font_badge;
                            font-weight: 600;
                            color: is_audio_format ? Theme.accent_purple : Theme.accent_lime;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: Theme.radius_md;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 16px;

                        // Left Column: Format Selection
                        VerticalLayout {
                            width: 330px;
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: "Stream Quality & Format";
                                font-size: Theme.font_badge;
                                font-weight: 600;
                                color: Theme.text_secondary;
                            }

                            DownloaderFormatDropdown {
                                height: Theme.btn_height_md;
                                model: AppData.ytdlp_format_options;
                                current-index <=> AppData.ytdlp_selected_format_index;
                                selected(_) => { AppLogic.save_settings(); }
                            }

                            Text {
                                text: "Muxes highest-fidelity streams without re-encoding.";
                                font-size: Theme.font_badge;
                                color: Theme.text_muted;
                                wrap: word-wrap;
                            }
                        }

                        // Right Column: Destination Folder
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: "Save Destination Folder";
                                font-size: Theme.font_badge;
                                font-weight: 600;
                                color: Theme.text_secondary;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                TextField {
                                    horizontal-stretch: 1;
                                    height: Theme.btn_height_md;
                                    font_size: Theme.font_caption;
                                    placeholder: "Choose or paste folder path...";
                                    text <=> AppData.ytdlp_output_dir;
                                }

                                ActionButton {
                                    width: 88px;
                                    height: Theme.btn_height_md;
                                    title: "Browse...";
                                    icon_source: @image-url("../icons/folder.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    fill_color: Theme.btn_neutral_bg;
                                    hover_color: Theme.btn_neutral_hover;
                                    text_color: Theme.btn_neutral_text;
                                    border_col: Theme.btn_neutral_border;
                                    hover_border_col: Theme.input_hover_border;
                                    normal_border_width: 1px;
                                    font_size: Theme.font_badge;
                                    clicked => { AppLogic.ytdlp_select_output_dir(); }
                                }

                                ActionButton {
                                    width: 100px;
                                    height: Theme.btn_height_md;
                                    title: "Open Folder";
                                    icon_source: @image-url("../icons/folder-open.svg");
                                    has_icon: true;
                                    icon_size: 12px;
                                    fill_color: Theme.btn_neutral_bg;
                                    hover_color: Theme.btn_neutral_hover;
                                    text_color: Theme.text_secondary;
                                    border_col: Theme.btn_neutral_border;
                                    hover_border_col: Theme.input_hover_border;
                                    normal_border_width: 1px;
                                    font_size: Theme.font_badge;
                                    clicked => { AppLogic.ytdlp_open_output_dir(); }
                                }
                            }

                            Text {
                                text: "Defaults to Settings directory. Overrides apply to subsequent downloads.";
                                font-size: Theme.font_badge;
                                color: Theme.text_muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // SECTION 3: DOWNLOAD CONTROLS & PROGRESS
        // ==========================================
        VerticalLayout {
            spacing: 8px;

            Text {
                text: "Transfer Status";
                font-size: Theme.font_body;
                font-weight: 700;
                color: Theme.text_heading;
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: Theme.radius_md;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: AppData.ytdlp_download_finished ? Theme.emerald_border : Theme.card_border;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;

                            HorizontalLayout {
                                spacing: 7px;

                                if AppData.ytdlp_download_finished : VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../icons/check.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: Theme.accent_green;
                                    }
                                }

                                Text {
                                    text: AppData.ytdlp_status_message;
                                    font-size: Theme.font_caption;
                                    font-weight: 600;
                                    color: AppData.ytdlp_download_finished ? Theme.accent_green : (AppData.ytdlp_is_downloading ? Theme.accent_lime : Theme.text_secondary);
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        // Clean Mono Telemetry Readouts
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            VerticalLayout {
                                alignment: center;
                                Badge { label: AppData.ytdlp_progress_text; bg_color: Theme.card_secondary_bg; fg_color: Theme.accent_lime; mono: true; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Badge { label: AppData.ytdlp_speed_text; bg_color: Theme.card_secondary_bg; fg_color: Theme.text_primary; mono: true; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Badge { label: AppData.ytdlp_eta_text; bg_color: Theme.card_secondary_bg; fg_color: Theme.text_secondary; mono: true; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Badge { label: AppData.ytdlp_size_text; bg_color: Theme.card_secondary_bg; fg_color: Theme.text_secondary; mono: true; }
                            }
                        }

                        // SOLE SOLID PRIMARY CTA IN DOWNLOADER TAB
                        if !AppData.ytdlp_is_downloading : ActionButton {
                            width: 162px;
                            height: Theme.btn_height_md;
                            title: "Start Download";
                            icon_source: @image-url("../icons/download.svg");
                            has_icon: true;
                            icon_size: 14px;
                            fill_color: Theme.accent_primary;
                            hover_color: Theme.accent_primary_hover;
                            pressed_color: Theme.accent_primary_pressed;
                            text_color: Theme.text_on_accent;
                            font_size: Theme.font_caption;
                            clicked => { AppLogic.ytdlp_start_download(); }
                        }

                        if AppData.ytdlp_is_downloading : ActionButton {
                            width: 162px;
                            height: Theme.btn_height_md;
                            title: "Cancel Download";
                            icon_source: @image-url("../icons/stop.svg");
                            has_icon: true;
                            icon_size: 14px;
                            fill_color: Theme.accent_red_solid;
                            hover_color: Theme.accent_red_hover;
                            text_color: #ffffff;
                            font_size: Theme.font_caption;
                            clicked => { AppLogic.ytdlp_cancel_download(); }
                        }
                    }

                    // Progress Track (Kabosu Green -> Yuzu Yellow -> Citrus Orange)
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.slider_track;
                        clip: true;

                        Rectangle {
                            x: 0px;
                            width: parent.width * (AppData.ytdlp_progress / 100.0).clamp(0.0, 1.0);
                            height: parent.height;
                            border-radius: 3px;
                            background: @linear-gradient(90deg, Theme.accent_primary 0%, Theme.accent_yuzu 65%, Theme.accent_orange 100%);
                        }
                    }

                    // Completion Row
                    if AppData.ytdlp_download_finished : HorizontalLayout {
                        padding-top: 4px;
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            alignment: center;

                            Text {
                                text: AppData.ytdlp_last_downloaded_file != "" ? "Saved: " + AppData.ytdlp_last_downloaded_file : "";
                                font-size: Theme.font_badge;
                                font-family: Theme.font_mono;
                                color: Theme.text_secondary;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        ActionButton {
                            height: Theme.btn_height_sm;
                            title: "Add to Queue";
                            icon_source: @image-url("../icons/plus.svg");
                            has_icon: true;
                            icon_size: 12px;
                            fill_color: Theme.accent_surface;
                            hover_color: Theme.accent_surface_hover;
                            text_color: Theme.accent_lime;
                            border_col: Theme.accent_border;
                            normal_border_width: 1px;
                            font_size: Theme.font_badge;
                            clicked => { AppLogic.ytdlp_send_to_queue(); }
                        }
                    }
                }
            }
        }

        // ==========================================
        // SECTION 4: SESSION DOWNLOAD HISTORY
        // ==========================================
        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Session History";
                    font-size: Theme.font_body;
                    font-weight: 700;
                    color: Theme.text_heading;
                    vertical-alignment: center;
                }

                Badge {
                    label: AppData.ytdlp_history.length == 1 ? "1 item" : "\{AppData.ytdlp_history.length} items";
                    bg_color: AppData.ytdlp_history.length > 0 ? Theme.accent_surface : Theme.card_secondary_bg;
                    fg_color: AppData.ytdlp_history.length > 0 ? Theme.accent_lime : Theme.text_muted;
                    border_col: AppData.ytdlp_history.length > 0 ? Theme.accent_border : Theme.card_border;
                    height: 20px;
                }

                Rectangle { horizontal-stretch: 1; }

                if AppData.ytdlp_history.length > 0 : ActionButton {
                    width: 112px;
                    height: Theme.btn_height_sm;
                    title: root.confirm_clear_history ? "Confirm?" : "Clear History";
                    icon_source: @image-url("../icons/trash.svg");
                    has_icon: true;
                    icon_size: 11px;
                    fill_color: root.confirm_clear_history ? Theme.accent_red_solid : Theme.btn_neutral_bg;
                    hover_color: root.confirm_clear_history ? Theme.accent_red_hover : Theme.btn_neutral_hover;
                    text_color: root.confirm_clear_history ? #ffffff : Theme.text_secondary;
                    border_col: root.confirm_clear_history ? Theme.accent_red : Theme.btn_neutral_border;
                    normal_border_width: 1px;
                    font_size: Theme.font_badge;
                    clicked => {
                        if root.confirm_clear_history {
                            root.confirm_clear_history = false;
                            AppLogic.ytdlp_clear_history();
                        } else {
                            root.confirm_clear_history = true;
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 0;
                border-radius: Theme.radius_md;
                background: Theme.card_bg;
                border-width: 1px;
                border-color: Theme.card_border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: start;

                    // Empty state
                    if AppData.ytdlp_history.length == 0 : Rectangle {
                        height: 54px;
                        border-radius: Theme.radius_sm;
                        background: Theme.card_subtle_bg;
                        border-width: 1px;
                        border-color: Theme.card_subtle_border;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/download.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: Theme.text_muted;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Completed downloads in this session will appear here for one-click queue import or folder reveal.";
                                    font-size: Theme.font_badge;
                                    color: Theme.text_muted;
                                }
                            }
                        }
                    }

                    // History rows
                    if AppData.ytdlp_history.length > 0 : VerticalLayout {
                        spacing: 6px;

                        for item[idx] in AppData.ytdlp_history : Rectangle {
                            height: 50px;
                            border-radius: Theme.radius_sm;
                            background: Theme.card_secondary_bg;
                            border-width: 1px;
                            border-color: Theme.card_border;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: Theme.radius_sm;
                                        background: Theme.accent_surface;
                                        border-width: 1px;
                                        border-color: Theme.accent_border;
                                        Image {
                                            source: @image-url("../icons/film.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: Theme.accent_lime;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    spacing: 2px;

                                    Text {
                                        text: item.file_name;
                                        font-size: Theme.font_caption;
                                        font-weight: 600;
                                        color: Theme.text_primary;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: item.file_path;
                                        font-size: Theme.font_badge;
                                        color: Theme.text_muted;
                                        overflow: elide;
                                    }
                                }

                                if item.file_size_formatted != "" : VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: item.file_size_formatted;
                                        font-size: Theme.font_badge;
                                        font-family: Theme.font_mono;
                                        font-weight: 600;
                                        color: Theme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    ActionButton {
                                        width: 120px;
                                        height: Theme.btn_height_sm;
                                        title: "Add to Queue";
                                        icon_source: @image-url("../icons/plus.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: Theme.accent_surface;
                                        hover_color: Theme.accent_surface_hover;
                                        text_color: Theme.accent_lime;
                                        border_col: Theme.accent_border;
                                        normal_border_width: 1px;
                                        font_size: Theme.font_badge;
                                        clicked => { AppLogic.ytdlp_add_history_item_to_queue(idx); }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    ActionButton {
                                        width: 110px;
                                        height: Theme.btn_height_sm;
                                        title: "Show Folder";
                                        icon_source: @image-url("../icons/folder-open.svg");
                                        has_icon: true;
                                        icon_size: 11px;
                                        fill_color: Theme.btn_neutral_bg;
                                        hover_color: Theme.btn_neutral_hover;
                                        text_color: Theme.btn_neutral_text;
                                        border_col: Theme.btn_neutral_border;
                                        normal_border_width: 1px;
                                        font_size: Theme.font_badge;
                                        clicked => { AppLogic.ytdlp_open_history_item(idx); }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 28px;
                                        height: Theme.btn_height_sm;
                                        border-radius: Theme.radius_sm;
                                        background: rem_ta.pressed ? Theme.red_surface_hover : (rem_ta.has-hover ? Theme.red_surface : Theme.btn_neutral_bg);
                                        border-width: 1px;
                                        border-color: rem_ta.has-hover ? Theme.red_border : Theme.btn_neutral_border;

                                        animate background { duration: 100ms; }
                                        animate border-color { duration: 100ms; }

                                        Image {
                                            source: @image-url("../icons/x.svg");
                                            width: 11px;
                                            height: 11px;
                                            colorize: rem_ta.has-hover ? Theme.accent_red_text : Theme.text_muted;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        rem_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppLogic.ytdlp_remove_history_item(idx); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
