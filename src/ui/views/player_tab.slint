import { AppData, AppLogic, Theme } from "../globals.slint";
import { IconButton } from "../components/icon_button.slint";
import { ActionButton } from "../components/action_button.slint";
import { Badge } from "../components/badge.slint";
import { TextField } from "../components/text_field.slint";
import { VolumeBar } from "../components/volume_bar.slint";
import { VolumeMeter } from "../components/volume_meter.slint";
import { VisualTimeline } from "../timeline/visual_timeline.slint";
import { AudioWaveformStudio } from "../timeline/audio_waveform.slint";
import { CropOverlayView } from "./crop_overlay.slint";

export component PlayerTab inherits VerticalLayout {
    callback request_focus();

    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;

    // MEDIA PLAYER & TRIMMING STUDIO EMPTY STATE
    if !AppData.player_has_media : Rectangle {
        vertical-stretch: 1;
        min-height: 240px;
        border-radius: Theme.radius_lg;
        background: Theme.card_bg;
        border-width: 1px;
        border-color: Theme.card_border;

        VerticalLayout {
            padding: 36px;
            spacing: 20px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 60px;
                    height: 60px;
                    border-radius: 16px;
                    background: Theme.accent_surface;
                    border-width: 1px;
                    border-color: Theme.accent_border;
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../icons/film.svg");
                        width: 26px;
                        height: 26px;
                        colorize: Theme.accent_lime;
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                alignment: center;
                Text {
                    text: "View & Edit Studio";
                    font-size: Theme.font_title;
                    font-weight: 700;
                    color: Theme.text_primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Load any audio or video file to inspect frame-by-frame, trim with precision, crop, and tune audio.";
                    font-size: Theme.font_body;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: center;
                ActionButton {
                    width: 224px;
                    height: Theme.btn_height_lg;
                    title: "Open Media File";
                    icon_source: @image-url("../icons/folder-open.svg");
                    has_icon: true;
                    icon_size: 15px;
                    fill_color: Theme.accent_primary;
                    hover_color: Theme.accent_primary_hover;
                    pressed_color: Theme.accent_primary_pressed;
                    text_color: Theme.text_on_accent;
                    font_size: Theme.font_body;
                    btn_radius: Theme.radius_md;
                    clicked => { AppLogic.add_files(); }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Badge { label: "MP4"; bg_color: Theme.accent_surface; fg_color: Theme.accent_lime; border_col: Theme.accent_border; }
                Badge { label: "MKV"; bg_color: Theme.accent_surface; fg_color: Theme.accent_lime; border_col: Theme.accent_border; }
                Badge { label: "MOV"; bg_color: Theme.accent_surface; fg_color: Theme.accent_lime; border_col: Theme.accent_border; }
                Badge { label: "WEBM"; bg_color: Theme.accent_surface; fg_color: Theme.accent_lime; border_col: Theme.accent_border; }
                Badge { label: "MP3"; bg_color: Theme.purple_surface; fg_color: Theme.accent_purple; border_col: Theme.purple_border; }
                Badge { label: "WAV"; bg_color: Theme.purple_surface; fg_color: Theme.accent_purple; border_col: Theme.purple_border; }
                Badge { label: "FLAC"; bg_color: Theme.purple_surface; fg_color: Theme.accent_purple; border_col: Theme.purple_border; }
                Badge { label: "AAC"; bg_color: Theme.purple_surface; fg_color: Theme.accent_purple; border_col: Theme.purple_border; }
            }
        }
    }

    if AppData.player_has_media : Rectangle {
        vertical-stretch: 1;
        border-radius: Theme.radius_md;
        background: Theme.card_bg;
        border-width: 1px;
        border-color: Theme.card_border;

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;

            // Header Row: Media Badge + Filename + Active Trim Readout + VU Meter Toggle
            HorizontalLayout {
                spacing: 8px;

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Theme.radius_sm;
                    background: AppData.selected_is_video ? Theme.accent_surface : Theme.purple_surface;
                    border-width: 1px;
                    border-color: AppData.selected_is_video ? Theme.accent_border : Theme.purple_border;
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: AppData.selected_is_video ? @image-url("../icons/video.svg") : @image-url("../icons/audio.svg");
                        width: 15px;
                        height: 15px;
                        colorize: AppData.selected_is_video ? Theme.accent_lime : Theme.accent_purple;
                    }
                }

                VerticalLayout {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: AppData.selected_file_name;
                        font-size: Theme.font_section;
                        font-weight: 700;
                        color: Theme.text_primary;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                // Active Trim Duration Badge (always cleanly visible, never clipped)
                if AppData.has_active_trim : Rectangle {
                    horizontal-stretch: 0;
                    height: Theme.btn_height_sm;
                    border-radius: Theme.radius_sm;
                    background: Theme.amber_surface;
                    border-width: 1px;
                    border-color: Theme.amber_border;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 5px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/scissors.svg");
                                width: 11px;
                                height: 11px;
                                colorize: Theme.accent_amber;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Trim";
                                font-size: Theme.font_badge;
                                font-weight: 600;
                                color: Theme.accent_amber;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: AppData.trim_duration_text;
                                font-size: Theme.font_badge;
                                font-weight: 700;
                                font-family: Theme.font_mono;
                                color: Theme.accent_amber;
                            }
                        }
                    }
                }

                // Volume Meter Toggle Pill
                meter_toggle_btn := Rectangle {
                    horizontal-stretch: 0;
                    width: 72px;
                    height: Theme.btn_height_sm;
                    border-radius: Theme.radius_sm;
                    background: AppData.show_volume_meter ? Theme.accent_surface : (meter_btn_ta.has-hover ? Theme.control_hover : Theme.btn_neutral_bg);
                    border-width: 1px;
                    border-color: AppData.show_volume_meter ? Theme.accent_border : Theme.btn_neutral_border;

                    animate background { duration: 120ms; easing: ease-out; }
                    animate border-color { duration: 120ms; easing: ease-out; }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: center;

                        // Mini VU Bars Graphic
                        VerticalLayout {
                            alignment: center;
                            vu_icon_box := Rectangle {
                                width: 11px;
                                height: 13px;

                                Rectangle {
                                    x: 0px;
                                    y: parent.height - self.height;
                                    width: 2.5px;
                                    height: 6px;
                                    border-radius: 1px;
                                    background: AppData.show_volume_meter ? Theme.meter_green : Theme.text_muted;
                                }
                                Rectangle {
                                    x: 4px;
                                    y: parent.height - self.height;
                                    width: 2.5px;
                                    height: 9.5px;
                                    border-radius: 1px;
                                    background: AppData.show_volume_meter ? Theme.meter_yellow : Theme.text_muted;
                                }
                                Rectangle {
                                    x: 8px;
                                    y: parent.height - self.height;
                                    width: 2.5px;
                                    height: 13px;
                                    border-radius: 1px;
                                    background: AppData.show_volume_meter ? Theme.meter_red : Theme.text_muted;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Meter";
                                font-size: Theme.font_badge;
                                font-weight: 600;
                                color: AppData.show_volume_meter ? Theme.accent_lime : Theme.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    meter_btn_ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.toggle_volume_meter(); }
                    }
                }
            }

            // Media Screen Area (Dynamic height: stretches to fill available space, reduced by 1/3 when audio queue is selected)
            media_screen := Rectangle {
                vertical-stretch: AppData.selected_is_video ? 3 : 2;
                min-height: 100px;
                border-radius: 8px;
                background: #050706;
                border-width: 1px;
                border-color: Theme.card_border;
                clip: true;

                HorizontalLayout {
                    // Main Viewer Screen (Video canvas or Audio Waveform Studio)
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        // Video Canvas
                        if AppData.selected_is_video : video_screen := Rectangle {
                            property <length> img_box_w: min(self.width, self.height * 16 / 9);
                            property <length> img_box_h: min(self.height, self.width * 9 / 16);
                            property <length> img_box_x: (self.width - self.img_box_w) / 2;
                            property <length> img_box_y: (self.height - self.img_box_h) / 2;

                            property <length> active_vid_x: self.img_box_x + self.img_box_w * AppData.preview_video_norm_x;
                            property <length> active_vid_y: self.img_box_y + self.img_box_h * AppData.preview_video_norm_y;
                            property <length> active_vid_w: max(16px, self.img_box_w * AppData.preview_video_norm_w);
                            property <length> active_vid_h: max(16px, self.img_box_h * AppData.preview_video_norm_h);

                            Image {
                                source: AppData.preview_frame;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.request_focus();
                                    AppLogic.player_play_pause();
                                }
                            }

                            // Interactive Drag & Drop Visual Crop Overlay Box
                            if AppData.crop_enabled : CropOverlayView {
                                x: video_screen.active_vid_x;
                                y: video_screen.active_vid_y;
                                width: video_screen.active_vid_w;
                                height: video_screen.active_vid_h;
                                norm_x: AppData.crop_norm_x;
                                norm_y: AppData.crop_norm_y;
                                norm_w: AppData.crop_norm_w;
                                norm_h: AppData.crop_norm_h;
                                crop_px_w: AppData.crop_width;
                                crop_px_h: AppData.crop_height;
                                crop_px_x: AppData.crop_x;
                                crop_px_y: AppData.crop_y;
                                focus_requested => {
                                    root.request_focus();
                                }
                            }

                            // Loading indicator
                            if AppData.preview_frame_loading : Rectangle {
                                background: Theme.overlay_mask;
                                Text {
                                    text: "Seeking frame...";
                                    font-size: Theme.font_caption;
                                    color: Theme.text_secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Audio Waveform Studio (for audio files)
                        if !AppData.selected_is_video : audio_studio := AudioWaveformStudio {
                            zoom_level <=> AppData.timeline_zoom;
                            duration: AppData.player_duration;
                            current_time: AppData.player_current_time;
                            in_point_norm: AppData.in_point_normalized;
                            out_point_norm: AppData.out_point_normalized;
                            in_point_sec: AppData.in_point_seconds;
                            out_point_sec: AppData.out_point_seconds;
                            has_trim: AppData.has_active_trim;
                            fade_in_sec: AppData.audio_fade_in_seconds;
                            fade_out_sec: AppData.audio_fade_out_seconds;
                            fade_in_text: AppData.audio_fade_in_text;
                            fade_out_text: AppData.audio_fade_out_text;
                            has_audio: AppData.selected_is_audio;
                            scrub(val) => { AppLogic.player_scrub(val); }
                            seek(val) => { AppLogic.player_seek(val); }
                            in_point_dragged(val) => { AppLogic.set_in_point_from_timeline(val); }
                            out_point_dragged(val) => { AppLogic.set_out_point_from_timeline(val); }
                            fade_in_dragged(val) => { AppLogic.set_audio_fade_in(val); }
                            fade_out_dragged(val) => { AppLogic.set_audio_fade_out(val); }
                            fade_settled() => { AppLogic.audio_fade_settled(); }
                        }
                    }

                    // Animated Expand/Collapse Studio Volume Meter Rail
                    meter_expand_container := Rectangle {
                        width: AppData.show_volume_meter ? 70px : 0px;
                        clip: true;
                        animate width { duration: 220ms; easing: ease-out; }

                        VerticalLayout {
                            alignment: end;
                            padding: 7px;

                            VolumeMeter {
                                level_l_db: AppData.audio_meter_l_db;
                                level_r_db: AppData.audio_meter_r_db;
                                peak_l_db: AppData.audio_meter_peak_l_db;
                                peak_r_db: AppData.audio_meter_peak_r_db;
                                opacity: AppData.show_volume_meter ? 1.0 : 0.0;
                                animate opacity { duration: 180ms; easing: ease-out; }
                            }
                        }
                    }
                }
            }

            // Timeline Utility Row & Visual Timeline Track
            VerticalLayout {
                spacing: 8px;

                // Clean Unclipped Utility Bar: Timecode (left) · Volume & Zoom (right)
                HorizontalLayout {
                    spacing: 8px;

                    // Playhead / Duration Readout Pill
                    Rectangle {
                        height: Theme.btn_height_sm;
                        border-radius: Theme.radius_sm;
                        background: Theme.input_bg;
                        border-width: 1px;
                        border-color: Theme.card_secondary_border;
                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            spacing: 5px;
                            alignment: center;
                            Text { text: AppData.player_time_text; font-size: Theme.font_caption; font-weight: 700; font-family: Theme.font_mono; color: Theme.accent_lime; vertical-alignment: center; }
                            Text { text: "/"; font-size: Theme.font_badge; font-weight: 500; color: Theme.text_faint; vertical-alignment: center; }
                            Text { text: AppData.player_duration_text; font-size: Theme.font_caption; font-weight: 600; font-family: Theme.font_mono; color: Theme.text_secondary; vertical-alignment: center; }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Volume Control Bar Pill
                    VolumeBar {
                        volume: AppData.player_volume;
                        is_muted: AppData.player_is_muted;
                        volume_changed(val) => { AppLogic.player_volume_changed(val); }
                        volume_settled(val) => { AppLogic.player_volume_settled(val); }
                        toggle_mute() => { AppLogic.player_toggle_mute(); }
                    }

                    // Timeline Zoom Controls Pill
                    Rectangle {
                        height: Theme.btn_height_sm;
                        border-radius: Theme.radius_sm;
                        background: Theme.input_bg;
                        border-width: 1px;
                        border-color: Theme.card_secondary_border;
                        HorizontalLayout {
                            padding-top: 3px;
                            padding-bottom: 3px;
                            padding-left: 7px;
                            padding-right: 5px;
                            spacing: 2px;
                            alignment: center;

                            Text { text: "Zoom"; font-size: Theme.font_badge; font-weight: 600; color: Theme.text_muted; vertical-alignment: center; }

                            Rectangle { width: 3px; }

                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                background: vzm_ta.has-hover ? Theme.control_hover : transparent;
                                Text { text: "−"; font-size: Theme.font_body; font-weight: 700; color: Theme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                                vzm_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = max(1.0, AppData.timeline_zoom - 0.5); } }
                            }

                            Rectangle {
                                width: 25px;
                                height: 20px;
                                border-radius: 4px;
                                background: AppData.timeline_zoom <= 1.05 ? Theme.accent_surface : (vz1_ta.has-hover ? Theme.control_hover : transparent);
                                border-width: AppData.timeline_zoom <= 1.05 ? 1px : 0px;
                                border-color: Theme.accent_border;
                                Text { text: "1x"; font-size: Theme.font_badge; font-weight: 700; color: AppData.timeline_zoom <= 1.05 ? Theme.accent_lime : Theme.text_muted; horizontal-alignment: center; vertical-alignment: center; }
                                vz1_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = 1.0; } }
                            }

                            Rectangle {
                                width: 25px;
                                height: 20px;
                                border-radius: 4px;
                                background: (AppData.timeline_zoom > 1.95 && AppData.timeline_zoom < 2.05) ? Theme.accent_surface : (vz2_ta.has-hover ? Theme.control_hover : transparent);
                                border-width: (AppData.timeline_zoom > 1.95 && AppData.timeline_zoom < 2.05) ? 1px : 0px;
                                border-color: Theme.accent_border;
                                Text { text: "2x"; font-size: Theme.font_badge; font-weight: 700; color: (AppData.timeline_zoom > 1.95 && AppData.timeline_zoom < 2.05) ? Theme.accent_lime : Theme.text_muted; horizontal-alignment: center; vertical-alignment: center; }
                                vz2_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = 2.0; } }
                            }

                            Rectangle {
                                width: 25px;
                                height: 20px;
                                border-radius: 4px;
                                background: (AppData.timeline_zoom > 3.95 && AppData.timeline_zoom < 4.05) ? Theme.accent_surface : (vz4_ta.has-hover ? Theme.control_hover : transparent);
                                border-width: (AppData.timeline_zoom > 3.95 && AppData.timeline_zoom < 4.05) ? 1px : 0px;
                                border-color: Theme.accent_border;
                                Text { text: "4x"; font-size: Theme.font_badge; font-weight: 700; color: (AppData.timeline_zoom > 3.95 && AppData.timeline_zoom < 4.05) ? Theme.accent_lime : Theme.text_muted; horizontal-alignment: center; vertical-alignment: center; }
                                vz4_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = 4.0; } }
                            }

                            Rectangle {
                                width: 25px;
                                height: 20px;
                                border-radius: 4px;
                                background: (AppData.timeline_zoom > 7.95 && AppData.timeline_zoom < 8.05) ? Theme.accent_surface : (vz8_ta.has-hover ? Theme.control_hover : transparent);
                                border-width: (AppData.timeline_zoom > 7.95 && AppData.timeline_zoom < 8.05) ? 1px : 0px;
                                border-color: Theme.accent_border;
                                Text { text: "8x"; font-size: Theme.font_badge; font-weight: 700; color: (AppData.timeline_zoom > 7.95 && AppData.timeline_zoom < 8.05) ? Theme.accent_lime : Theme.text_muted; horizontal-alignment: center; vertical-alignment: center; }
                                vz8_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = 8.0; } }
                            }

                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                background: vzp_ta.has-hover ? Theme.control_hover : transparent;
                                Text { text: "+"; font-size: Theme.font_body; font-weight: 700; color: Theme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                                vzp_ta := TouchArea { mouse-cursor: pointer; clicked => { AppData.timeline_zoom = min(8.0, AppData.timeline_zoom + 0.5); } }
                            }

                            // Center-on-playhead target icon (drawn vector ring + dot, font-independent)
                            Rectangle {
                                width: 22px;
                                height: 20px;
                                border-radius: 4px;
                                background: vzc_ta.has-hover ? Theme.control_hover : transparent;

                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 11px;
                                    height: 11px;
                                    border-radius: 5.5px;
                                    border-width: 1.5px;
                                    border-color: Theme.accent_lime;

                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 3px;
                                        height: 3px;
                                        border-radius: 1.5px;
                                        background: Theme.accent_lime;
                                    }
                                }

                                vzc_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppData.center_timeline_trigger += 1; }
                                }
                            }
                        }
                    }
                }

                // Full Visual Timeline Track with In/Out Markers & Needle (for Video)
                if AppData.selected_is_video : vid_timeline := VisualTimeline {
                    zoom_level <=> AppData.timeline_zoom;
                    duration: AppData.player_duration;
                    current_time: AppData.player_current_time;
                    in_point_norm: AppData.in_point_normalized;
                    out_point_norm: AppData.out_point_normalized;
                    in_point_sec: AppData.in_point_seconds;
                    out_point_sec: AppData.out_point_seconds;
                    has_trim: AppData.has_active_trim;
                    fade_in_sec: AppData.audio_fade_in_seconds;
                    fade_out_sec: AppData.audio_fade_out_seconds;
                    fade_in_text: AppData.audio_fade_in_text;
                    fade_out_text: AppData.audio_fade_out_text;
                    has_audio: AppData.selected_is_audio;
                    scrub(val) => { AppLogic.player_scrub(val); }
                    seek(val) => { AppLogic.player_seek(val); }
                    in_point_dragged(val) => { AppLogic.set_in_point_from_timeline(val); }
                    out_point_dragged(val) => { AppLogic.set_out_point_from_timeline(val); }
                    fade_in_dragged(val) => { AppLogic.set_audio_fade_in(val); }
                    fade_out_dragged(val) => { AppLogic.set_audio_fade_out(val); }
                    fade_settled() => { AppLogic.audio_fade_settled(); }
                }
            }

            // Row 1: Playback Transport Deck
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                IconButton {
                    btn_width: 56px;
                    btn_height: Theme.btn_height_md;
                    icon_source: @image-url("../icons/chevrons-left.svg");
                    has_icon: true;
                    text: "-1s";
                    font_size: Theme.font_badge;
                    text_color: Theme.btn_neutral_text;
                    normal_bg: Theme.btn_neutral_bg;
                    hover_bg: Theme.btn_neutral_hover;
                    pressed_bg: Theme.btn_neutral_pressed;
                    normal_border: Theme.btn_neutral_border;
                    hover_border: Theme.input_hover_border;
                    normal_border_width: 1px;
                    clicked => { AppLogic.player_step(-1.0); }
                }
                IconButton {
                    btn_width: 58px;
                    btn_height: Theme.btn_height_md;
                    icon_source: @image-url("../icons/chevron-left.svg");
                    has_icon: true;
                    icon_size: 12px;
                    text: "-0.1s";
                    font_size: Theme.font_badge;
                    text_color: Theme.btn_neutral_text;
                    normal_bg: Theme.btn_neutral_bg;
                    hover_bg: Theme.btn_neutral_hover;
                    pressed_bg: Theme.btn_neutral_pressed;
                    normal_border: Theme.btn_neutral_border;
                    hover_border: Theme.input_hover_border;
                    normal_border_width: 1px;
                    clicked => { AppLogic.player_step(-0.1); }
                }

                // Primary Transport CTA: Play / Pause
                ActionButton {
                    width: 92px;
                    height: Theme.btn_height_md;
                    title: AppData.player_is_playing ? "Pause" : "Play";
                    icon_source: AppData.player_is_playing ? @image-url("../icons/pause.svg") : @image-url("../icons/play.svg");
                    has_icon: true;
                    icon_size: 12px;
                    fill_color: AppData.player_is_playing ? Theme.accent_surface : Theme.accent_primary;
                    hover_color: AppData.player_is_playing ? Theme.accent_surface_hover : Theme.accent_primary_hover;
                    pressed_color: AppData.player_is_playing ? Theme.control_pressed : Theme.accent_primary_pressed;
                    text_color: AppData.player_is_playing ? Theme.accent_lime : Theme.text_on_accent;
                    border_col: AppData.player_is_playing ? Theme.accent_border : transparent;
                    hover_border_col: AppData.player_is_playing ? Theme.accent_primary : transparent;
                    normal_border_width: AppData.player_is_playing ? 1px : 0px;
                    font_size: Theme.font_caption;
                    clicked => { AppLogic.player_play_pause(); }
                }

                IconButton {
                    btn_width: 36px;
                    btn_height: Theme.btn_height_md;
                    icon_source: @image-url("../icons/stop.svg");
                    has_icon: true;
                    text_color: Theme.btn_neutral_text;
                    normal_bg: Theme.btn_neutral_bg;
                    hover_bg: Theme.btn_neutral_hover;
                    pressed_bg: Theme.btn_neutral_pressed;
                    normal_border: Theme.btn_neutral_border;
                    hover_border: Theme.input_hover_border;
                    normal_border_width: 1px;
                    clicked => { AppLogic.player_stop(); }
                }

                IconButton {
                    btn_width: 58px;
                    btn_height: Theme.btn_height_md;
                    icon_source: @image-url("../icons/chevron-right.svg");
                    has_icon: true;
                    icon_size: 12px;
                    text: "+0.1s";
                    font_size: Theme.font_badge;
                    text_color: Theme.btn_neutral_text;
                    normal_bg: Theme.btn_neutral_bg;
                    hover_bg: Theme.btn_neutral_hover;
                    pressed_bg: Theme.btn_neutral_pressed;
                    normal_border: Theme.btn_neutral_border;
                    hover_border: Theme.input_hover_border;
                    normal_border_width: 1px;
                    clicked => { AppLogic.player_step(0.1); }
                }
                IconButton {
                    btn_width: 56px;
                    btn_height: Theme.btn_height_md;
                    icon_source: @image-url("../icons/chevrons-right.svg");
                    has_icon: true;
                    text: "+1s";
                    font_size: Theme.font_badge;
                    text_color: Theme.btn_neutral_text;
                    normal_bg: Theme.btn_neutral_bg;
                    hover_bg: Theme.btn_neutral_hover;
                    pressed_bg: Theme.btn_neutral_pressed;
                    normal_border: Theme.btn_neutral_border;
                    hover_border: Theme.input_hover_border;
                    normal_border_width: 1px;
                    clicked => { AppLogic.player_step(1.0); }
                }
            }

            // Row 2: In/Out Trim Markers & Range Deck
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                ActionButton {
                    width: 72px;
                    height: Theme.btn_height_sm;
                    title: "[ Set In";
                    fill_color: Theme.amber_surface;
                    hover_color: Theme.amber_surface_hover;
                    text_color: Theme.accent_amber;
                    border_col: Theme.amber_border;
                    hover_border_col: Theme.accent_amber;
                    normal_border_width: 1px;
                    font_size: Theme.font_badge;
                    clicked => { AppLogic.set_in_point_current(); }
                }

                ActionButton {
                    width: 76px;
                    height: Theme.btn_height_sm;
                    title: "Set Out ]";
                    fill_color: Theme.amber_surface;
                    hover_color: Theme.amber_surface_hover;
                    text_color: Theme.accent_amber;
                    border_col: Theme.amber_border;
                    hover_border_col: Theme.accent_amber;
                    normal_border_width: 1px;
                    font_size: Theme.font_badge;
                    clicked => { AppLogic.set_out_point_current(); }
                }

                IconButton {
                    btn_width: 48px;
                    btn_height: Theme.btn_height_sm;
                    icon_source: @image-url("../icons/chevrons-left.svg");
                    has_icon: true;
                    icon_size: 11px;
                    text: "In";
                    font_size: Theme.font_badge;
                    text_color: Theme.btn_neutral_text;
                    normal_bg: Theme.btn_neutral_bg;
                    hover_bg: Theme.btn_neutral_hover;
                    pressed_bg: Theme.btn_neutral_pressed;
                    normal_border: Theme.btn_neutral_border;
                    hover_border: Theme.input_hover_border;
                    normal_border_width: 1px;
                    clicked => { AppLogic.jump_to_in_point(); }
                }

                IconButton {
                    btn_width: 54px;
                    btn_height: Theme.btn_height_sm;
                    icon_source: @image-url("../icons/chevrons-right.svg");
                    has_icon: true;
                    icon_size: 11px;
                    text: "Out";
                    font_size: Theme.font_badge;
                    text_color: Theme.btn_neutral_text;
                    normal_bg: Theme.btn_neutral_bg;
                    hover_bg: Theme.btn_neutral_hover;
                    pressed_bg: Theme.btn_neutral_pressed;
                    normal_border: Theme.btn_neutral_border;
                    hover_border: Theme.input_hover_border;
                    normal_border_width: 1px;
                    clicked => { AppLogic.jump_to_out_point(); }
                }

                ActionButton {
                    width: 88px;
                    height: Theme.btn_height_sm;
                    title: "Play Trim";
                    icon_source: @image-url("../icons/play.svg");
                    has_icon: true;
                    icon_size: 10px;
                    fill_color: Theme.emerald_surface;
                    hover_color: Theme.emerald_surface_hover;
                    text_color: Theme.accent_green;
                    border_col: Theme.emerald_border;
                    hover_border_col: Theme.accent_green;
                    normal_border_width: 1px;
                    font_size: Theme.font_badge;
                    clicked => { AppLogic.play_trimmed_range(); }
                }

                IconButton {
                    btn_width: 62px;
                    btn_height: Theme.btn_height_sm;
                    icon_source: @image-url("../icons/reset.svg");
                    has_icon: true;
                    icon_size: 11px;
                    text: "Reset";
                    font_size: Theme.font_badge;
                    text_color: Theme.btn_neutral_text;
                    normal_bg: Theme.btn_neutral_bg;
                    hover_bg: Theme.red_surface;
                    pressed_bg: Theme.red_surface_hover;
                    normal_border: Theme.btn_neutral_border;
                    hover_border: Theme.red_border;
                    normal_border_width: 1px;
                    clicked => { AppLogic.clear_trim_points(); }
                }
            }

            // Row 3: Precision In/Out Timecodes & Instant Actions Deck
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                Text {
                    text: "In";
                    font-size: Theme.font_badge;
                    font-weight: 700;
                    color: Theme.accent_amber;
                    vertical-alignment: center;
                }

                TextField {
                    width: 96px;
                    height: Theme.btn_height_sm;
                    font_size: Theme.font_badge;
                    font_family: Theme.font_mono;
                    text <=> AppData.in_point;
                    placeholder: "00:00:00.000";
                    edited(txt) => { AppLogic.in_point_text_changed(txt); }
                }

                Text {
                    text: "Out";
                    font-size: Theme.font_badge;
                    font-weight: 700;
                    color: Theme.accent_amber;
                    vertical-alignment: center;
                }

                TextField {
                    width: 96px;
                    height: Theme.btn_height_sm;
                    font_size: Theme.font_badge;
                    font_family: Theme.font_mono;
                    text <=> AppData.out_point;
                    placeholder: "00:00:00.000";
                    edited(txt) => { AppLogic.out_point_text_changed(txt); }
                }

                Rectangle { width: 1px; height: 16px; background: Theme.card_border; }

                ActionButton {
                    width: 136px;
                    height: Theme.btn_height_sm;
                    title: "Lossless Cut Now";
                    icon_source: @image-url("../icons/scissors.svg");
                    has_icon: true;
                    icon_size: 12px;
                    fill_color: AppData.has_active_trim ? Theme.emerald_surface : Theme.card_subtle_bg;
                    hover_color: AppData.has_active_trim ? Theme.emerald_surface_hover : Theme.card_subtle_bg;
                    text_color: AppData.has_active_trim ? Theme.accent_green : Theme.text_faint;
                    border_col: AppData.has_active_trim ? Theme.emerald_border : Theme.card_border;
                    hover_border_col: Theme.accent_green;
                    normal_border_width: 1px;
                    font_size: Theme.font_badge;
                    is_disabled: !AppData.has_active_trim;
                    clicked => { AppLogic.quick_lossless_cut(); }
                }

                ActionButton {
                    width: 118px;
                    height: Theme.btn_height_sm;
                    title: "Codec Settings";
                    icon_source: @image-url("../icons/settings.svg");
                    has_icon: true;
                    icon_size: 12px;
                    fill_color: Theme.btn_neutral_bg;
                    hover_color: Theme.btn_neutral_hover;
                    text_color: Theme.btn_neutral_text;
                    border_col: Theme.btn_neutral_border;
                    hover_border_col: Theme.input_hover_border;
                    normal_border_width: 1px;
                    font_size: Theme.font_badge;
                    clicked => { AppLogic.switch_tab(2); }
                }
            }

            // Spacer reducing visual waveform viewer section's height by 1/3 when audio queue is selected
            if !AppData.selected_is_video : Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}
