export global Theme {
    // =========================================================================
    // KABOSU CONVERTER — Neutral Dark & Dark-Grey Studio Theme
    // Pure dark/charcoal app body with crisp white text; Kabosu green, Yuzu
    // yellow, and citrus orange accents focused on headings & interactive UI.
    // =========================================================================

    // Window & Shell Backgrounds (Pure Neutral Dark)
    out property <color> app_bg: #0b0b0d;
    out property <color> window_border: #2a2a32;
    out property <color> header_bg: #101013;
    out property <color> header_border: #202026;
    out property <color> status_bar_bg: #101013;
    out property <color> status_bar_border: #202026;

    // Panels & Surfaces (Pure Neutral Dark Grey — zero green wash on body)
    out property <color> bg_surface: #0b0b0d;
    out property <color> panel_bg: #121215;
    out property <color> panel_border: #202026;
    out property <color> card_subtle_bg: #141418;
    out property <color> card_subtle_border: #1f1f26;
    out property <color> card_bg: #17171b;
    out property <color> card_border: #26262e;
    out property <color> card_secondary_bg: #1e1e24;
    out property <color> card_secondary_border: #32323d;

    // Recessed Form Inputs & Dropdowns (Neutral Dark)
    out property <color> input_bg: #111115;
    out property <color> input_hover_bg: #16161b;
    out property <color> input_border: #32323d;
    out property <color> input_hover_border: #464654;
    out property <color> popup_bg: #18181e;
    out property <color> popup_border: #343440;

    // Controls & Interactive Surfaces
    out property <color> border_color: #32323d;
    out property <color> control_bg: #202027;
    out property <color> control_hover: #2a2a33;
    out property <color> control_border: #32323d;
    out property <color> control_pressed: #33333e;
    out property <color> focus_ring: #9ce04e;
    out property <color> focus_ring_border: #66a625;

    // Tab Bar (Segmented Control Pill in Header)
    out property <color> tab_container_bg: #151519;
    out property <color> tab_container_border: #26262e;
    out property <color> tab_active_bg: #232b1d;
    out property <color> tab_active_border: #7dc43277;
    out property <color> tab_active_text: #9ce04e;
    out property <color> tab_inactive_hover: #1e1e24;
    out property <color> tab_inactive_text: #d0d2d8;

    // Text & Labels (Crisp White body/descriptions + Kabosu Green main headings)
    out property <color> text_heading: #9ce04e;    // 11.2:1 — Main titles & section headers
    out property <color> text_primary: #ffffff;    // 17.9:1 — Pure white primary labels & values
    out property <color> text_secondary: #ececef;  // 15.2:1 — Crisp white secondary text
    out property <color> text_muted: #d0d2d8;      // 11.8:1 — Soft white minor & description text
    out property <color> text_faint: #8c8e96;      // Disabled icons & subtle ticks
    out property <color> text_on_accent: #0b1107;  //  8.9:1 — Deep ink on citrus buttons

    // Kabosu Citrus Green Accent Ramp (Buttons, Switches, Active Controls)
    out property <color> accent_primary: #7dc432;
    out property <color> accent_primary_hover: #90d644;
    out property <color> accent_primary_pressed: #66a625;
    out property <color> accent_lime: #9ce04e;
    out property <color> accent_cyan: #9ce04e;     // Alias mapped to Kabosu Zest
    out property <color> accent_surface: #232b1d;
    out property <color> accent_surface_hover: #2d3824;
    out property <color> accent_border: #7dc43277;

    // Yuzu Yellow & Citrus Orange Complementary Ramp (Progress, Sliders, Trim)
    out property <color> accent_yuzu: #f2c94c;
    out property <color> accent_amber: #f2b830;
    out property <color> accent_amber_hover: #f7c952;
    out property <color> accent_orange: #f08a2e;
    out property <color> amber_surface: #2b2416;
    out property <color> amber_surface_hover: #382f1c;
    out property <color> amber_border: #f2b83066;

    // Fresh Mint / Jade — Success, Ready, GPU Active, Lossless Export
    out property <color> accent_green: #4ad09b;
    out property <color> accent_emerald: #2fa677;
    out property <color> accent_emerald_hover: #3aba88;
    out property <color> emerald_surface: #142720;
    out property <color> emerald_surface_hover: #1b362c;
    out property <color> emerald_border: #2fa67766;

    // Studio Crimson — Destructive Actions, Errors, Stop/Cancel
    out property <color> accent_red: #d94b4b;
    out property <color> accent_red_solid: #c83e3e;
    out property <color> accent_red_hover: #dc4e4e;
    out property <color> accent_red_text: #f59494;
    out property <color> red_surface: #2b1819;
    out property <color> red_surface_hover: #3a1f21;
    out property <color> red_border: #d94b4b66;

    // Soft Plum / Lavender — Audio Track & Codec Distinction
    out property <color> accent_purple: #b2a4f4;
    out property <color> purple_surface: #211d30;
    out property <color> purple_border: #b2a4f455;

    // Platform Brand Accents
    out property <color> brand_vimeo: #5bc0de;
    out property <color> brand_bilibili: #52b8db;
    out property <color> brand_instagram: #df6d95;
    out property <color> brand_facebook: #679ce8;

    // Action Button Neutrals (Pure Dark Grey + Crisp White Text)
    out property <color> btn_neutral_bg: #202027;
    out property <color> btn_neutral_hover: #2a2a33;
    out property <color> btn_neutral_pressed: #33333e;
    out property <color> btn_neutral_border: #32323d;
    out property <color> btn_neutral_text: #ffffff;

    // Audio Meter & Visualizer
    out property <color> meter_bg: #0f0f13;
    out property <color> meter_border: #26262f;
    out property <color> meter_green: #7dc432;
    out property <color> meter_green_dim: #192412;
    out property <color> meter_yellow: #f2c94c;
    out property <color> meter_yellow_dim: #2b2410;
    out property <color> meter_red: #f06045;
    out property <color> meter_red_dim: #2d1412;

    // Track & Sliders
    out property <color> slider_track: #2c2c36;
    out property <color> slider_thumb: #ffffff;
    out property <color> slider_thumb_active: #9ce04e;

    // Typographic Scale (Floored at 11px to ensure legibility)
    out property <length> font_title: 18px;
    out property <length> font_section: 14px;
    out property <length> font_body: 13px;
    out property <length> font_caption: 12px;
    out property <length> font_badge: 11px;
    out property <string> font_mono: "Consolas";

    // Standard Spacing Scale (4px base rhythm)
    out property <length> space_xs: 4px;
    out property <length> space_sm: 8px;
    out property <length> space_md: 12px;
    out property <length> space_lg: 16px;
    out property <length> space_xl: 24px;

    // Standard Interactive Button Heights
    out property <length> btn_height_sm: 28px;
    out property <length> btn_height_md: 34px;
    out property <length> btn_height_lg: 40px;

    // Concentric Radii Standards (outer = inner + padding)
    out property <length> radius_sm: 6px;
    out property <length> radius_md: 10px;
    out property <length> radius_lg: 14px;

    // Overlay, Mask & Timeline Specific Tokens
    out property <color> overlay_mask: #000000b8;
    out property <color> timeline_track_bg: #0b0b0e;
    out property <color> timeline_border: #22222a;
    out property <color> trim_in_marker: #7dc432;
    out property <color> trim_out_marker: #f2b830;
    out property <color> playhead_marker: #9ce04e;
}
