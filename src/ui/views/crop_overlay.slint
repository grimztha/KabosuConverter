import { AppLogic } from "../globals.slint";
import { Theme } from "../theme.slint";

export component CropOverlayView inherits Rectangle {
    in property <float> norm_x: 0.0;
    in property <float> norm_y: 0.0;
    in property <float> norm_w: 1.0;
    in property <float> norm_h: 1.0;
    in property <int> crop_px_w: 1920;
    in property <int> crop_px_h: 1080;
    in property <int> crop_px_x: 0;
    in property <int> crop_px_y: 0;
    callback focus_requested();

    property <length> box_x: root.width * root.norm_x.clamp(0.0, 1.0);
    property <length> box_y: root.height * root.norm_y.clamp(0.0, 1.0);
    property <length> box_w: max(16px, root.width * root.norm_w.clamp(0.02, 1.0));
    property <length> box_h: max(16px, root.height * root.norm_h.clamp(0.02, 1.0));

    // Top dark mask outside crop area
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: max(0px, root.box_y);
        background: Theme.overlay_mask;
    }

    // Bottom dark mask outside crop area
    Rectangle {
        x: 0px;
        y: root.box_y + root.box_h;
        width: root.width;
        height: max(0px, root.height - (root.box_y + root.box_h));
        background: Theme.overlay_mask;
    }

    // Left dark mask outside crop area
    Rectangle {
        x: 0px;
        y: root.box_y;
        width: max(0px, root.box_x);
        height: root.box_h;
        background: Theme.overlay_mask;
    }

    // Right dark mask outside crop area
    Rectangle {
        x: root.box_x + root.box_w;
        y: root.box_y;
        width: max(0px, root.width - (root.box_x + root.box_w));
        height: root.box_h;
        background: Theme.overlay_mask;
    }

    // Crop Box Frame
    crop_box := Rectangle {
        x: root.box_x;
        y: root.box_y;
        width: root.box_w;
        height: root.box_h;
        border-width: 2px;
        border-color: Theme.accent_cyan;
        background: Theme.accent_cyan.with-alpha(0.04);

        // Rule of thirds vertical lines
        Rectangle {
            x: parent.width / 3;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: #ffffff.with-alpha(0.27);
        }
        Rectangle {
            x: (parent.width * 2) / 3;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: #ffffff.with-alpha(0.27);
        }

        // Rule of thirds horizontal lines
        Rectangle {
            x: 0px;
            y: parent.height / 3;
            width: parent.width;
            height: 1px;
            background: #ffffff.with-alpha(0.27);
        }
        Rectangle {
            x: 0px;
            y: (parent.height * 2) / 3;
            width: parent.width;
            height: 1px;
            background: #ffffff.with-alpha(0.27);
        }

        // Center Crosshair
        Rectangle {
            x: (parent.width - 12px) / 2;
            y: (parent.height - 1px) / 2;
            width: 12px;
            height: 1px;
            background: Theme.accent_cyan.with-alpha(0.66);
        }
        Rectangle {
            x: (parent.width - 1px) / 2;
            y: (parent.height - 12px) / 2;
            width: 1px;
            height: 12px;
            background: Theme.accent_cyan.with-alpha(0.66);
        }

        // Live Dimensions & Coordinates Readout Pill inside Crop Box
        if parent.width > 95px && parent.height > 32px : Rectangle {
            x: 6px;
            y: 6px;
            height: 20px;
            width: dim_txt.preferred-width + 12px;
            border-radius: 4px;
            background: Theme.card_bg.with-alpha(0.8);
            border-width: 1px;
            border-color: Theme.accent_cyan.with-alpha(0.53);

            dim_txt := Text {
                x: 6px;
                y: (parent.height - self.height) / 2;
                text: "\{root.crop_px_w} × \{root.crop_px_h}  (\{root.crop_px_x}, \{root.crop_px_y})";
                font-size: Theme.font_badge;
                font-family: Theme.font_mono;
                font-weight: 700;
                color: Theme.accent_cyan;
            }
        }

        // Interior Drag TouchArea to move the crop box around
        move_ta := TouchArea {
            mouse-cursor: move;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_box_drag_start(
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_box_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_box_drag_move(
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // 8 Resize Handles (0=TL, 1=TR, 2=BL, 3=BR, 4=Top, 5=Bottom, 6=Left, 7=Right)
    // Top-Left Corner (0)
    Rectangle {
        x: root.box_x - 6px;
        y: root.box_y - 6px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: tl_ta.has-hover || tl_ta.pressed ? Theme.accent_amber : #ffffff;
        border-width: 2px;
        border-color: Theme.accent_primary;
        tl_ta := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_handle_drag_start(
                            0,
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_handle_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        0,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Top-Right Corner (1)
    Rectangle {
        x: root.box_x + root.box_w - 6px;
        y: root.box_y - 6px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: tr_ta.has-hover || tr_ta.pressed ? Theme.accent_amber : #ffffff;
        border-width: 2px;
        border-color: Theme.accent_primary;
        tr_ta := TouchArea {
            mouse-cursor: nesw-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_handle_drag_start(
                            1,
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_handle_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        1,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Bottom-Left Corner (2)
    Rectangle {
        x: root.box_x - 6px;
        y: root.box_y + root.box_h - 6px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: bl_ta.has-hover || bl_ta.pressed ? Theme.accent_amber : #ffffff;
        border-width: 2px;
        border-color: Theme.accent_primary;
        bl_ta := TouchArea {
            mouse-cursor: nesw-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_handle_drag_start(
                            2,
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_handle_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        2,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Bottom-Right Corner (3)
    Rectangle {
        x: root.box_x + root.box_w - 6px;
        y: root.box_y + root.box_h - 6px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: br_ta.has-hover || br_ta.pressed ? Theme.accent_amber : #ffffff;
        border-width: 2px;
        border-color: Theme.accent_primary;
        br_ta := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_handle_drag_start(
                            3,
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_handle_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        3,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Top Edge (4)
    Rectangle {
        x: root.box_x + (root.box_w - 24px) / 2;
        y: root.box_y - 4px;
        width: 24px;
        height: 8px;
        border-radius: 2px;
        background: t_ta.has-hover || t_ta.pressed ? Theme.accent_amber : Theme.accent_cyan;
        t_ta := TouchArea {
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_handle_drag_start(
                            4,
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_handle_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        4,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Bottom Edge (5)
    Rectangle {
        x: root.box_x + (root.box_w - 24px) / 2;
        y: root.box_y + root.box_h - 4px;
        width: 24px;
        height: 8px;
        border-radius: 2px;
        background: b_ta.has-hover || b_ta.pressed ? Theme.accent_amber : Theme.accent_cyan;
        b_ta := TouchArea {
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_handle_drag_start(
                            5,
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_handle_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        5,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Left Edge (6)
    Rectangle {
        x: root.box_x - 4px;
        y: root.box_y + (root.box_h - 24px) / 2;
        width: 8px;
        height: 24px;
        border-radius: 2px;
        background: l_ta.has-hover || l_ta.pressed ? Theme.accent_amber : Theme.accent_cyan;
        l_ta := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_handle_drag_start(
                            6,
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_handle_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        6,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }

    // Right Edge (7)
    Rectangle {
        x: root.box_x + root.box_w - 4px;
        y: root.box_y + (root.box_h - 24px) / 2;
        width: 8px;
        height: 24px;
        border-radius: 2px;
        background: r_ta.has-hover || r_ta.pressed ? Theme.accent_amber : Theme.accent_cyan;
        r_ta := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.focus_requested();
                    if root.width > 0px && root.height > 0px {
                        AppLogic.crop_handle_drag_start(
                            7,
                            ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                            ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                        );
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    AppLogic.crop_handle_drag_end();
                }
            }
            moved => {
                if self.pressed && root.width > 0px && root.height > 0px {
                    AppLogic.crop_handle_drag(
                        7,
                        ((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width).clamp(0.0, 1.0),
                        ((self.absolute-position.y + self.mouse-y - root.absolute-position.y) / root.height).clamp(0.0, 1.0)
                    );
                }
            }
        }
    }
}
